---
// ═══════════════════════════════════════════════════════════════════════════
// ΑΓΟΡΑ ΑΠΟ ΤΟ ΕΞΩΤΕΡΙΚΟ — «Εσείς κάνετε δύο πράγματα.»
//
// ΓΙΑΤΙ ΑΞΙΖΕΙ ΤΗ ΘΕΣΗ ΤΟΥ: το 70% της κίνησής μας είναι Βουλγαρία, Σερβία,
// Ρουμανία, Γερμανία. Αυτός ο επισκέπτης δεν φοβάται το σπίτι — φοβάται τη
// ΔΙΑΔΙΚΑΣΙΑ σε ξένη χώρα, με ξένη γλώσσα και ξένο δίκαιο.
//
// 🔴 Η ΜΟΡΦΗ ΑΛΛΑΞΕ 28/7 (επιλογή George από 3 mockups): από τέσσερα βήματα σε
// **δύο στήλες, «Εσείς» απέναντι σε «Εμείς»**. Ο λόγος είναι επικοινωνιακός και
// φαίνεται σε ένα δευτερόλεπτο: **η διαφορά όγκου**. Δύο γραμμές στη στήλη του
// πελάτη, πέντε στη δική μας — και η δική μας είναι μαύρη, δηλαδή προφανώς η
// βαριά. Μια λίστα βημάτων έλεγε «να τι πρέπει να κάνεις»· αυτό λέει «να τι
// ΔΕΝ θα κάνεις».
//
// ΤΡΕΙΣ ΔΙΟΡΘΩΣΕΙΣ ΤΟΥ GEORGE ΠΑΝΩ ΣΤΟ MOCKUP:
//  1. Το πληρεξούσιο πάει **στους νομικούς ΤΗΣ ΕΤΑΙΡΕΙΑΣ**, όχι «σε δικηγόρο
//     που εγκρίνετε εσείς». Είναι δική μας ομάδα, και αυτό είναι το επιχείρημα.
//  2. Ο έλεγχος τίτλων γίνεται από το **«Νομικό τμήμα Halkidiki Properties»**,
//     όχι από γενικό «δικηγόρο».
//  3. ⛔ Η **συντήρηση ΑΦΑΙΡΕΘΗΚΕ**: «δεν το αναλαμβάνουμε». Μένει μόνο η
//     παράδοση και οι λογαριασμοί.
// ═══════════════════════════════════════════════════════════════════════════
import { t, prefix, type Lang } from '../lib/i18n';
import { company } from '../lib/company';
import { waHref, viberHref } from '../lib/contact';

interface Props { lang: Lang }
const { lang } = Astro.props;

// Τα δύο μέρη είναι δεδομένα, όχι markup: αν αύριο προστεθεί βήμα, μπαίνει εδώ.
const YOU = [['ab.you1_t', 'ab.you1_d'], ['ab.you2_t', 'ab.you2_d']];
const US = [
  ['ab.us1_t', 'ab.us1_d'], ['ab.us2_t', 'ab.us2_d'], ['ab.us3_t', 'ab.us3_d'],
  ['ab.us4_t', 'ab.us4_d'], ['ab.us5_t', 'ab.us5_d'],
];

// 🛡️ Αν η σελίδα «Επικοινωνία» δεν έχει ακόμη κείμενο, ο σύνδεσμος **δεν σβήνει** —
//    γίνεται τηλέφωνο. Εδώ το κάλεσμα είναι το προϊόν: κενό κουμπί θα ήταν χαμένος
//    πελάτης, όχι απλώς λείπουσα σελίδα.
// #101: the heading keeps its first sentence; the second half is now the dark band's own
// heading («We do the rest for you.»). The close splits into a line and a heading.
const sentences = (x: string) => x.split(/(?<=[.!?])\s+/);
const [h2a] = sentences(t(lang, 'ab.h2'));
const [c1, ...cRest] = sentences(t(lang, 'ab.close'));
const c2 = cRest.join(' ');
// Sergei 08/11: two working options for the close, to choose from — ?close=slices | ?close=stage
// (local review only; without the parameter the block is as before).
// Sergei chose «stage» (08/11): it is the default now; ?close=slices still shows the other option
// and ?close=plain the block without motion, until the choice is final.
const closeQ = Astro.url.searchParams.get('close') ?? '';
const closeV = closeQ === 'plain' ? '' : closeQ === 'slices' ? 'slices' : 'stage';
// Sergei 08/11: the close's key words in bold (as «The land … begins» above), in every language.
const CLOSE_BOLD: Record<Lang, string[]> = {
  en: ['no risk', 'checked'], el: ['κανένα ρίσκο', 'ελέγξει'], bg: ['риск', 'проверили'],
  sr: ['nijedan rizik', 'proverili'], de: ['kein Risiko', 'geprüft'], ro: ['niciun risc', 'verificat'],
  tr: ['hiçbir riski', 'kontrol'], he: ['שום סיכון', 'בדקנו'], ru: ['ни одного риска', 'проверили'],
};
const c2parts = (() => {
  const out: { s: string; b: boolean }[] = [];
  let rest = c2;
  for (;;) {
    const hits = (CLOSE_BOLD[lang] ?? []).map((w) => ({ w, i: rest.indexOf(w) })).filter((h) => h.i >= 0).sort((x, y) => x.i - y.i);
    if (!hits.length) { if (rest) out.push({ s: rest, b: false }); return out; }
    const { w, i } = hits[0];
    if (i) out.push({ s: rest.slice(0, i), b: false });
    out.push({ s: w, b: true });
    rest = rest.slice(i + w.length);
  }
})();

const co = await company();
// Sergei 08/11: the close offers the three direct channels (audit: WhatsApp/Viber lived only on /contact).
const waLink = waHref(undefined, co.whatsappE164);
const viberLink = viberHref(co.whatsappE164);
---
{/* #101 desktop (George 2026-11-02): two half-height bands — «One signature from
    you.» (white) and «We do the rest for you.» (dark) — each turning its own steps
    every 3 s on one shared clock (a pointer over either band holds both), then the
    close: George's last two sentences and a gilded «Speak to us».
    Phone: the same two blocks, every step listed. */}
{/* Sergei 03/11: the two stacks keep turning under the pointer (no data-rot-hold any more) */}
<div class="ab3">
  <section class="abroad abroad--you" aria-labelledby="abroad-h">
    <div class="wrap ab__grid">
      <div class="abroad__head">
        <p class="t-label abroad__eyebrow">{t(lang, 'abroad.eyebrow')}</p>
        <h2 id="abroad-h" class="t-h2 abroad__h">{h2a}</h2>
        <p class="abroad__sub">{t(lang, 'ab.sub')}</p>
      </div>
      <div class="ab__rot" role="region" aria-label={t(lang, 'ab.you_h')}>
        <ul class="two__l h-stack" data-rot="ab">
          {YOU.map(([tk, dk], i) => (
            <li class:list={['h-sx', i === 0 && 'on']}><b>{t(lang, tk)}</b><i>{t(lang, dk)}</i></li>
          ))}
        </ul>
        <div class="h-bars" role="group" aria-label={t(lang, 'ab.you_h')}>
          {YOU.map(([tk], i) => (
            <button type="button" class:list={['h-bar', i === 0 && 'on']} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={t(lang, tk)}><span></span></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Η μαύρη στήλη ΕΙΝΑΙ το μήνυμα: όγκος και βάρος με μια ματιά. */}
  <section class="abroad abroad--us" aria-labelledby="abroad-h2">
    <div class="wrap ab__grid">
      <div>
        <h2 id="abroad-h2" class="t-h2 abroad__h abroad__h--we">{t(lang, 'ab.h2_we')}</h2>
      </div>
      <div class="ab__rot" role="region" aria-label={t(lang, 'ab.us_h')}>
        <ul class="two__l h-stack" data-rot="ab">
          {US.map(([tk, dk], i) => (
            <li class:list={['h-sx', i === 0 && 'on']}><b>{t(lang, tk)}</b><i>{t(lang, dk)}</i></li>
          ))}
        </ul>
        <div class="h-bars h-bars--dk" role="group" aria-label={t(lang, 'ab.us_h')}>
          {US.map(([tk], i) => (
            <button type="button" class:list={['h-bar', i === 0 && 'on']} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={t(lang, tk)}><span></span></button>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

<div class:list={['abc-stage', closeV && `abc-stage--${closeV}`]} data-close={closeV || undefined}>
<section class="abc" aria-labelledby="abc-h">
  <div class="wrap abc__in">
    <p class="abc__p">{c1}</p>
    {/* Sergei 08/11: a big line, not an H2 — the home page's H2s follow George's SEO spec (P01). */}
    {c2 && <p id="abc-h" class="abc__h">{c2parts.map((x) => (x.b ? <b>{x.s}</b> : x.s))}</p>}
    <p class="abc__acts">
      <a class="btn abc__btn" href={waLink} rel="noopener" target="_blank" data-ev="abroad:whatsapp">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12Z"/><path d="M9 9.5c.3 1.8 1.7 3.7 3.6 4.6l1.2-1.1 1.9.8-.4 1.6c-3.4.2-6.6-3.2-6.8-6.5l1.6-.4.8 1.9Z"/></svg>
        WhatsApp</a>
      <a class="btn abc__btn" href={viberLink} data-ev="abroad:viber">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c5 0 8 2.4 8 7.5S17 18 12 18l-3.5 3v-3.4C5.6 16.6 4 14.2 4 10.5 4 5.4 7 3 12 3Z"/><path d="M12.5 7.5a3 3 0 0 1 3 3"/></svg>
        Viber</a>
      <a class="btn abc__btn" href={co.phoneHref} data-ev="abroad:call">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
        <span dir="ltr">{co.phone}</span></a>
    </p>
  </div>
</section>
</div>


<script>
  // Sergei 08/11 (desktop): every big line of the two bands stays on ONE line. Where a language's
  // line is longer than its column, the font shrinks just enough — one size for the two left
  // headings and one for all the steps on the right, so nothing jumps when a step turns.
  const desk = window.matchMedia('(min-width: 1024px)');
  const groups = [
    () => Array.from(document.querySelectorAll<HTMLElement>('.ab3 .abroad__h, .abc__h')),   // the close's line keeps the headings' size
    () => Array.from(document.querySelectorAll<HTMLElement>('.ab3 .two__l b')),
  ];
  const fit = () => {
    for (const get of groups) {
      const els = get();
      els.forEach((el) => el.style.removeProperty('font-size'));
      if (!desk.matches || !els.length) continue;
      const base = parseFloat(getComputedStyle(els[0]).fontSize);
      let k = 1;
      for (const el of els) {
        const room = (el.closest('.ab__grid > *') as HTMLElement | null)?.clientWidth ?? el.clientWidth;
        if (el.scrollWidth > room) k = Math.min(k, room / el.scrollWidth);
      }
      if (k < 1) els.forEach((el) => { el.style.fontSize = `${Math.floor(base * k * 10) / 10}px`; });
    }
    // centre each band's text group: from the label (or the big line) to the lowest text
    document.querySelectorAll<HTMLElement>('.ab3 .abroad').forEach((band) => {
      band.style.removeProperty('--abp');
      if (!desk.matches) return;
      const r = band.getBoundingClientRect();
      const pad = parseFloat(getComputedStyle(band).paddingTop);
      const parts = Array.from(band.querySelectorAll<HTMLElement>('.abroad__eyebrow, .abroad__h, .abroad__sub, .two__l .h-sx.on b, .two__l .h-sx.on i'))
        .filter((e) => e.getClientRects().length).map((e) => e.getBoundingClientRect());
      if (!parts.length) return;
      const top = Math.min(...parts.map((q) => q.top)) - r.top, bottom = Math.max(...parts.map((q) => q.bottom)) - r.top;
      const lift = top - pad;                     // the label hangs above the padding line
      band.style.setProperty('--abp', `${Math.round((r.height - (bottom - top)) / 2 - lift)}px`);
    });
  };
  fit();
  document.fonts?.ready.then(fit);
  window.addEventListener('resize', fit);
  desk.addEventListener('change', fit);
</script>


<script>
  // ── Close options (Sergei 08/11), desktop, motion allowed ─────────────────────────────────
  // slices: the block is cut into vertical strips (copies of it, each clipped to its strip);
  //   while the block comes up the screen the strips fly in from above and below and meet; on the
  //   way back they part again. The real block stays underneath (readable, clickable), shown
  //   once the strips have met.
  // stage: the block is pinned and fills the screen for one screen of scrolling; its line grows
  //   a little and the small text and button come forward; then the footer scrolls in.
  {
    const host = document.querySelector<HTMLElement>('.abc-stage[data-close]');
    const desk = window.matchMedia('(min-width: 1024px)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    if (host) {
      const kind = host.dataset.close;
      const sec = host.querySelector<HTMLElement>('.abc')!;
      const inner = sec.querySelector<HTMLElement>('.abc__in')!;
      let strips: HTMLElement[] = [];
      const N = 14;
      if (kind === 'slices') {
        const layer = document.createElement('div');
        layer.className = 'abc__strips'; layer.setAttribute('aria-hidden', 'true');
        for (let i = 0; i < N; i++) {
          const s = document.createElement('div');
          s.className = 'abc__strip';
          s.style.clipPath = `inset(0 ${(100 * (N - i - 1)) / N}% 0 ${(100 * i) / N}%)`;
          const c = inner.cloneNode(true) as HTMLElement;
          c.querySelectorAll('[id]').forEach((e) => e.removeAttribute('id'));
          c.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
          s.appendChild(c); layer.appendChild(s); strips.push(s);
        }
        sec.appendChild(layer);
      }
      let queued = false;
      const place = () => {
        queued = false;
        const on = desk.matches && !still.matches;
        host.classList.toggle('is-live', on);
        if (!on) { strips.forEach((s) => (s.style.transform = '')); sec.style.removeProperty('--p'); return; }
        const vh = window.innerHeight;
        if (kind === 'slices') {
          const r = sec.getBoundingClientRect();
          // 0 when the block's top reaches the bottom of the screen, 1 when its top has come up 45 % of
          // the screen (it is the last block before the footer, so its middle may never reach the screen's)
          const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.45)));
          const k = 1 - ease(p);
          strips.forEach((s, i) => { s.style.transform = `translate3d(0, ${(i % 2 ? 1 : -1) * k * (r.height + 80)}px, 0)`; });
          sec.classList.toggle('is-met', p >= 1);
        } else {
          const r = host.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, -r.top / (r.height - vh)));
          sec.style.setProperty('--p', ease(p).toFixed(3));
        }
      };
      const ask = () => { if (!queued) { queued = true; requestAnimationFrame(place); } };
      window.addEventListener('scroll', ask, { passive: true });
      window.addEventListener('resize', ask);
      desk.addEventListener('change', ask); still.addEventListener('change', ask);
      place();
    }
  }
</script>

<style>
  /* ── Phone / tablet: George's two blocks, one under the other ─────────── */
  .abroad { padding: var(--s6) 0; }
  .abroad--you { background: var(--paper-2); border-top: 1px solid var(--line); padding-top: var(--s7); }
  .abroad--us { background: var(--ink-deep); color: #fff; }
  .abroad__head { max-width: 52ch; }
  .abroad__eyebrow { color: var(--faint); }
  .abroad__h { margin: var(--s2) 0 0; }
  .abroad__h--we { margin: 0 0 var(--s3); }
  .abroad__sub { margin: var(--s3) 0 var(--s4); color: var(--muted); font-size: var(--fs-s0); max-width: 58ch; }

  .two__l { list-style: none; margin: 0; padding: 0; }
  .two__l li { padding: 11px 0; border-top: 1px solid var(--line); font-size: var(--fs-s0); line-height: 1.4; }
  .abroad--us .two__l li { border-top-color: rgba(255,255,255,.14); }
  .two__l li:first-child { border-top: 0; }
  .two__l b { display: block; font-weight: 600; }
  .two__l i { display: block; font-style: normal; font-size: var(--fs-s-1); color: var(--muted); margin-top: 3px; }
  .abroad--us .two__l i { color: rgba(255,255,255,.5); }
  .h-bars { display: none; }

  .abc { padding: var(--s6) 0 var(--s7); background: var(--paper-2); }
  .abc__p { margin: 0; font-size: var(--fs-s0); max-width: 64ch; line-height: 1.55; }
  .abc__h { margin: 0 0 var(--s4); font-size: var(--fs-s0); font-weight: 600; line-height: 1.55; }
  .abc__acts { display: flex; flex-wrap: wrap; gap: var(--s2); margin: 0; }
  .abc__btn { display: inline-flex; align-items: center; gap: 8px; }

  @media (min-width: 760px) and (max-width: 1023px) {
    .abroad { padding: var(--s7) 0; }
    .ab__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s6); }
  }

  /* ── #101 desktop ─────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .abroad { min-height: 280px; box-sizing: border-box; display: flex; align-items: center; padding: 36px 0; }
    .abroad--you { background: var(--paper); border-top: 0; }
    /* Sergei 03/11: it follows the light Design & construction band — no centring gap above it */
    .abroad--you { padding-top: 36px; }   /* a little more air under the cards (Sergei 03/11); Sergei 08/11: the same 280 px height as the dark band below */
    .ab__grid { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; align-items: center; }   /* Sergei 03/11: both sides centred on one height */
    .abroad__head { max-width: none; }
    .abroad__h { margin: 14px 0 0; font-size: var(--fs-s4); line-height: 1.1; }   /* Sergei 03/11: the same size as «The land is where it begins.» */
    .abroad__h--we { margin: 0; color: #fff; }   /* Sergei 08/11: every text centred on the band's height */
    .abroad__sub { margin: 18px 0 0; line-height: 1.65; max-width: 60ch; }
    .ab__rot { padding-top: 0; }

    .two__l li { padding: 0; border: 0; }
    .two__l b { font-size: var(--fs-s3); font-weight: 300; line-height: 1.16; letter-spacing: -.016em; }
    .abroad__h, .two__l b { white-space: nowrap; }   /* Sergei 08/11: one line; the script above shrinks a line that is too long */
    .two__l i { margin-top: 12px; font-size: var(--fs-s0); color: var(--muted); }
    .abroad--us .two__l i { color: rgba(255,255,255,.6); }
    .h-bars { display: flex; }
    /* Sergei 08/11: the switches sit in the band's top-right corner, as in the other blocks */
    .abroad { position: relative; }
    .abroad .h-bars { position: absolute; margin: 0; top: 20px; right: max(var(--gut), calc((100% - var(--max)) / 2 + var(--gut))); }
    /* Sergei 08/11: the BIG lines of both columns on one line, through the band's middle; the small
       text hangs above (label) or below (sub, role) and no longer pushes them. 116 px = 140 (half of
       280) − half the 46 px heading line. The columns share the heading's baseline. */
    /* Sergei 08/11: both bands the same height (--abh) and the big lines on the middle of each:
       padding-top = half the band − half the 46 px line. --abh leaves room for three lines of
       17 px text under the line in every language. */
    /* Sergei 08/11 (2): the WHOLE text group of each band (label, big line, text under it) sits on
       the band's middle, not the big line alone — the label above made the group look low. The
       script measures the group and sets --abp per band; both bands 300 px. */
    .ab3 { --abh: 300px; }
    .abroad, .abroad--you { min-height: var(--abh); height: var(--abh); align-items: flex-start; padding-top: var(--abp, 80px); padding-bottom: 0; }
    .ab__grid { align-items: baseline; }
    .abroad__head { position: relative; }
    .abroad__eyebrow { position: absolute; left: 0; bottom: 100%; margin: 0 0 14px; }
    .abroad__h { margin-top: 0; }

    /* the close: George's two last sentences and a contact button (ink outline: the gilded edge is only for calls to register, Sergei 03/11) */
    .abc { min-height: 300px; box-sizing: border-box; display: flex; align-items: center; text-align: center; padding: 40px 0; background: var(--paper); }
    .abc .wrap { width: 100%; }
    .abc__p { margin: 0 auto; max-width: 62ch; font-size: var(--fs-s0); line-height: 1.65; color: var(--muted); }
    .abc__h { margin: 14px 0 0; font-size: var(--fs-s4); font-weight: 300; line-height: 1.1; letter-spacing: -.016em; color: var(--ink); }   /* Sergei 08/11: the size of «We do the rest for you.» */
    .abc__h b { font-weight: 600; }
    .abc__acts { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin: 30px 0 0; }
    .abc__btn {
      display: inline-flex; align-items: center; gap: 10px;
      min-height: 48px; padding: 0 26px; margin-top: 0; font-size: var(--fs-s-1);
      background: transparent; color: var(--ink); border: 1px solid var(--ink);
      transition: background .2s ease, color .2s ease;
    }
    .abc__btn:hover, .abc__btn:focus-visible { background: var(--ink); color: var(--paper); opacity: 1; }
    .abc__btn:focus-visible { outline-color: var(--ink); outline-offset: 3px; }

    /* ── Close option «slices» ── */
    .abc-stage--slices .abc { position: relative; overflow: hidden; }
    :global(.abc__strips) { display: none; }   /* built by the script → not scoped, hence :global */
    .abc-stage--slices.is-live :global(.abc__strips) { display: block; position: absolute; inset: 0; pointer-events: none; }
    :global(.abc__strip) { position: absolute; inset: 0; display: flex; align-items: center; background: var(--paper); will-change: transform; }
    :global(.abc__strip > .abc__in) { width: 100%; }
    .abc-stage--slices.is-live .abc > .abc__in { visibility: hidden; }
    .abc-stage--slices.is-live .abc.is-met > .abc__in { visibility: visible; }
    .abc-stage--slices.is-live .abc.is-met :global(.abc__strips) { display: none; }

