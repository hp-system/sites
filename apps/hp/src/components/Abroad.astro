---
// ═══════════════════════════════════════════════════════════════════════════
// ΑΓΟΡΑ ΑΠΟ ΤΟ ΕΞΩΤΕΡΙΚΟ — «Εσείς κάνετε δύο πράγματα.»
//
// ΓΙΑΤΙ ΑΞΙΖΕΙ ΤΗ ΘΕΣΗ ΤΟΥ: το 70% της κίνησής μας είναι Βουλγαρία, Σερβία,
// Ρουμανία, Γερμανία. Αυτός ο επισκέπτης δεν φοβάται το σπίτι — φοβάται τη
// ΔΙΑΔΙΚΑΣΙΑ σε ξένη χώρα, με ξένη γλώσσα και ξένο δίκαιο.
//
// 🔴 Η ΜΟΡΦΗ ΑΛΛΑΞΕ 28/7 (επιλογή George από 3 mockups): από τέσσερα βήματα σε
// **δύο στήλες, «Εσείς» απέναντι σε «Εμείς»**. Ο λόγος είναι επικοινωνιακός και
// φαίνεται σε ένα δευτερόλεπτο: **η διαφορά όγκου**. Δύο γραμμές στη στήλη του
// πελάτη, πέντε στη δική μας — και η δική μας είναι μαύρη, δηλαδή προφανώς η
// βαριά. Μια λίστα βημάτων έλεγε «να τι πρέπει να κάνεις»· αυτό λέει «να τι
// ΔΕΝ θα κάνεις».
//
// ΤΡΕΙΣ ΔΙΟΡΘΩΣΕΙΣ ΤΟΥ GEORGE ΠΑΝΩ ΣΤΟ MOCKUP:
//  1. Το πληρεξούσιο πάει **στους νομικούς ΤΗΣ ΕΤΑΙΡΕΙΑΣ**, όχι «σε δικηγόρο
//     που εγκρίνετε εσείς». Είναι δική μας ομάδα, και αυτό είναι το επιχείρημα.
//  2. Ο έλεγχος τίτλων γίνεται από το **«Νομικό τμήμα Halkidiki Properties»**,
//     όχι από γενικό «δικηγόρο».
//  3. ⛔ Η **συντήρηση ΑΦΑΙΡΕΘΗΚΕ**: «δεν το αναλαμβάνουμε». Μένει μόνο η
//     παράδοση και οι λογαριασμοί.
// ═══════════════════════════════════════════════════════════════════════════
import { t, prefix, type Lang } from '../lib/i18n';
import { pageExists } from '../lib/pages';
import { company } from '../lib/company';

interface Props { lang: Lang }
const { lang } = Astro.props;

// Τα δύο μέρη είναι δεδομένα, όχι markup: αν αύριο προστεθεί βήμα, μπαίνει εδώ.
const YOU = [['ab.you1_t', 'ab.you1_d'], ['ab.you2_t', 'ab.you2_d']];
const US = [
  ['ab.us1_t', 'ab.us1_d'], ['ab.us2_t', 'ab.us2_d'], ['ab.us3_t', 'ab.us3_d'],
  ['ab.us4_t', 'ab.us4_d'], ['ab.us5_t', 'ab.us5_d'],
];

// 🛡️ Αν η σελίδα «Επικοινωνία» δεν έχει ακόμη κείμενο, ο σύνδεσμος **δεν σβήνει** —
//    γίνεται τηλέφωνο. Εδώ το κάλεσμα είναι το προϊόν: κενό κουμπί θα ήταν χαμένος
//    πελάτης, όχι απλώς λείπουσα σελίδα.
// #101: the heading keeps its first sentence; the second half is now the dark band's own
// heading («We do the rest for you.»). The close splits into a line and a heading.
const sentences = (x: string) => x.split(/(?<=[.!?])\s+/);
const [h2a] = sentences(t(lang, 'ab.h2'));
const [c1, ...cRest] = sentences(t(lang, 'ab.close'));
const c2 = cRest.join(' ');

const contactHref = pageExists('contact') ? `${prefix(lang)}/contact` : (await company()).phoneHref;
---
{/* #101 desktop (George 2026-11-02): two half-height bands — «One signature from
    you.» (white) and «We do the rest for you.» (dark) — each turning its own steps
    every 3 s on one shared clock (a pointer over either band holds both), then the
    close: George's last two sentences and a gilded «Speak to us».
    Phone: the same two blocks, every step listed. */}
{/* Sergei 03/11: the two stacks keep turning under the pointer (no data-rot-hold any more) */}
<div class="ab3">
  <section class="abroad abroad--you" aria-labelledby="abroad-h">
    <div class="wrap ab__grid">
      <div class="abroad__head">
        <p class="t-label abroad__eyebrow">{t(lang, 'abroad.eyebrow')}</p>
        <h2 id="abroad-h" class="t-h2 abroad__h">{h2a}</h2>
        <p class="abroad__sub">{t(lang, 'ab.sub')}</p>
      </div>
      <div class="ab__rot" role="region" aria-label={t(lang, 'ab.you_h')}>
        <ul class="two__l h-stack" data-rot="ab">
          {YOU.map(([tk, dk], i) => (
            <li class:list={['h-sx', i === 0 && 'on']}><b>{t(lang, tk)}</b><i>{t(lang, dk)}</i></li>
          ))}
        </ul>
        <div class="h-bars" role="group" aria-label={t(lang, 'ab.you_h')}>
          {YOU.map(([tk], i) => (
            <button type="button" class:list={['h-bar', i === 0 && 'on']} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={t(lang, tk)}><span></span></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Η μαύρη στήλη ΕΙΝΑΙ το μήνυμα: όγκος και βάρος με μια ματιά. */}
  <section class="abroad abroad--us" aria-labelledby="abroad-h2">
    <div class="wrap ab__grid">
      <div>
        <h2 id="abroad-h2" class="t-h2 abroad__h abroad__h--we">{t(lang, 'ab.h2_we')}</h2>
      </div>
      <div class="ab__rot" role="region" aria-label={t(lang, 'ab.us_h')}>
        <ul class="two__l h-stack" data-rot="ab">
          {US.map(([tk, dk], i) => (
            <li class:list={['h-sx', i === 0 && 'on']}><b>{t(lang, tk)}</b><i>{t(lang, dk)}</i></li>
          ))}
        </ul>
        <div class="h-bars h-bars--dk" role="group" aria-label={t(lang, 'ab.us_h')}>
          {US.map(([tk], i) => (
            <button type="button" class:list={['h-bar', i === 0 && 'on']} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={t(lang, tk)}><span></span></button>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

<section class="abc" aria-labelledby="abc-h">
  <div class="wrap">
    <p class="abc__p">{c1}</p>
    {c2 && <h2 id="abc-h" class="abc__h">{c2}</h2>}
    <a class="btn abc__btn" href={contactHref} data-ev="contact:abroad">{t(lang, 'ab.cta')}</a>
  </div>
</section>

<style>
  /* ── Phone / tablet: George's two blocks, one under the other ─────────── */
  .abroad { padding: var(--s6) 0; }
  .abroad--you { background: var(--paper-2); border-top: 1px solid var(--line); padding-top: var(--s7); }
  .abroad--us { background: var(--ink-deep); color: #fff; }
  .abroad__head { max-width: 52ch; }
  .abroad__eyebrow { color: var(--faint); }
  .abroad__h { margin: var(--s2) 0 0; }
  .abroad__h--we { margin: 0 0 var(--s3); }
  .abroad__sub { margin: var(--s3) 0 var(--s4); color: var(--muted); font-size: 15px; max-width: 58ch; }

  .two__l { list-style: none; margin: 0; padding: 0; }
  .two__l li { padding: 11px 0; border-top: 1px solid var(--line); font-size: 15px; line-height: 1.4; }
  .abroad--us .two__l li { border-top-color: rgba(255,255,255,.14); }
  .two__l li:first-child { border-top: 0; }
  .two__l b { display: block; font-weight: 600; }
  .two__l i { display: block; font-style: normal; font-size: 12.5px; color: var(--muted); margin-top: 3px; }
  .abroad--us .two__l i { color: rgba(255,255,255,.5); }
  .h-bars { display: none; }

  .abc { padding: var(--s6) 0 var(--s7); background: var(--paper-2); }
  .abc__p { margin: 0; font-size: 15px; max-width: 64ch; line-height: 1.55; }
  .abc__h { margin: 0 0 var(--s4); font-size: 15px; font-weight: 600; line-height: 1.55; }

  @media (min-width: 760px) and (max-width: 1023px) {
    .abroad { padding: var(--s7) 0; }
    .ab__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s6); }
  }

  /* ── #101 desktop ─────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .abroad { min-height: 280px; box-sizing: border-box; display: flex; align-items: center; padding: 36px 0; }
    .abroad--you { background: var(--paper); border-top: 0; }
    /* Sergei 03/11: it follows the light Design & construction band — no centring gap above it */
    .abroad--you { min-height: 0; padding-top: 36px; }   /* a little more air under the cards (Sergei 03/11) */
    .ab__grid { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; align-items: center; }   /* Sergei 03/11: both sides centred on one height */
    .abroad__head { max-width: none; }
    .abroad__h { margin: 14px 0 0; font-size: 42px; line-height: 1.1; }   /* Sergei 03/11: the same size as «The land is where it begins.» */
    .abroad__h--we { margin: 29px 0 0; color: #fff; }
    .abroad__sub { margin: 18px 0 0; line-height: 1.65; max-width: 60ch; }
    .ab__rot { padding-top: 29px; }

    .two__l li { padding: 0; border: 0; }
    .two__l b { font-size: 36px; font-weight: 300; line-height: 1.16; letter-spacing: -.016em; }
    .two__l i { margin-top: 12px; font-size: 15px; color: var(--muted); }
    .abroad--us .two__l i { color: rgba(255,255,255,.6); }
    .h-bars { display: flex; }

    /* the close: George's two last sentences and a contact button (ink outline: the gilded edge is only for calls to register, Sergei 03/11) */
    .abc { min-height: 300px; box-sizing: border-box; display: flex; align-items: center; text-align: center; padding: 40px 0; background: var(--paper); }
    .abc .wrap { width: 100%; }
    .abc__p { margin: 0 auto; max-width: 62ch; font-size: 16px; line-height: 1.65; color: var(--muted); }
    .abc__h { margin: 14px 0 0; font-size: 36px; font-weight: 300; line-height: 1.16; letter-spacing: -.016em; color: var(--ink); }
    .abc__btn {
      min-height: 48px; padding: 0 30px; margin-top: 30px; font-size: 11.5px;
      background: transparent; color: var(--ink); border: 1px solid var(--ink);
      transition: background .2s ease, color .2s ease;
    }
    .abc__btn:hover, .abc__btn:focus-visible { background: var(--ink); color: var(--paper); opacity: 1; }
    .abc__btn:focus-visible { outline-color: var(--ink); outline-offset: 3px; }
  }
</style>
