---
// ═══════════════════════════════════════════════════════════════════════════
// ARTICLE LIST — /en/articles/{all-news | business-news | buyers | constructors-news}.
// Approved mockup (George 20/10/2026): one large article on top, then a 3-column grid.
// No count anywhere (no "46 Results"). Page 2+ is noindex, follow and canonical to itself.
// ═══════════════════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Footer from './Footer.astro';
import { listUrl, prefix, type Lang } from '../lib/i18n';
import { brand } from '../brand/index';
import {
  CATEGORIES, PER_PAGE, articleUrl, categoryName, categoryUrl, inCategory, readingMinutes,
  dateText, excerptOf,
} from '../lib/articles';

interface Props { category: string; page: number }
const { category, page } = Astro.props;
const lang: Lang = 'en';

const all = await inCategory(category);
const pages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const items = all.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const [first, ...rest] = page === 1 ? items : [null, ...items];

const url = categoryUrl(category, page);
const pathFor = (l: Lang) => (l === 'en' ? url : listUrl(l));
const name = categoryName(category);
const title = category === 'all-news'
  ? `Articles about buying property in Halkidiki and Greece${page > 1 ? ` — page ${page}` : ''} | ${brand.name}`
  : `${name} — articles${page > 1 ? ` — page ${page}` : ''} | ${brand.name}`;
const description = category === 'all-news'
  ? 'Guides, taxes, market trends and practical advice for buying, owning and selling property in Halkidiki and Greece.'
  : `${name}: guides and news about property in Halkidiki and Greece.`;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: brand.name, item: `${site}${prefix(lang) || '/'}` },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: `${site}${categoryUrl('all-news')}` },
    ...(category !== 'all-news' ? [{ '@type': 'ListItem', position: 3, name, item: `${site}${categoryUrl(category)}` }] : []),
  ],
}];
const img = (a: (typeof all)[number]) => a.data.hero_image || a.data.og_image;
---
<Base lang={lang} title={title} description={description} pathFor={pathFor} langs={['en']}
      noindex={page > 1} jsonLd={jsonLd}>
  <Header lang={lang} solid pathFor={pathFor} />
  <MobileMenu lang={lang} pathFor={pathFor} munis={[]} total={0} />

  <main id="main" class="al">
    <header class="wrap al-top">
      <nav class="crumb" aria-label="breadcrumb">
        <a href={prefix(lang) || '/'}>{brand.name}</a>
        <span aria-hidden="true">·</span>
        <span>Articles</span>
      </nav>
      <h1 class="t-display al-h1">{category === 'all-news' ? 'Articles' : name}</h1>
      <nav class="tabs" aria-label="Categories">
        {CATEGORIES.map((c) => (
          <a href={categoryUrl(c.key)} aria-current={c.key === category ? 'page' : undefined}>{c.name}</a>
        ))}
      </nav>
    </header>

    <section class="wrap al-body">
      {items.length === 0 ? (
        <div class="al-empty" data-empty>
          <p class="t-h3">No articles in this category yet.</p>
          <p><a href={categoryUrl('all-news')}>See all articles</a></p>
        </div>
      ) : (
        <>
          {first && (
            <a class="feat" href={articleUrl(first)}>
              {img(first) && <img src={img(first)} alt="" width="1200" height="675" fetchpriority="high" decoding="async" />}
              <span class="feat__b">
                <span class="t-label">{categoryName(first.data.category)}</span>
                <span class="feat__t">{first.data.h1}</span>
                <span class="card__x">{excerptOf(first)}</span>
                <span class="meta">{dateText(first.data.updated || first.data.published)} · {readingMinutes(first)} min read</span>
              </span>
            </a>
          )}
          <ul class="grid">
            {rest.filter(Boolean).map((a) => (
              <li>
                <a class="card" href={articleUrl(a!)}>
                  {img(a!) && <img src={img(a!)} alt="" width="600" height="400" loading="lazy" decoding="async" />}
                  <span class="t-label">{categoryName(a!.data.category)}</span>
                  <span class="card__t">{a!.data.h1}</span>
                  <span class="card__x">{excerptOf(a!)}</span>
                  <span class="meta">{dateText(a!.data.updated || a!.data.published)} · {readingMinutes(a!)} min read</span>
                </a>
              </li>
            ))}
          </ul>
          {pages > 1 && (
            <nav class="pager" aria-label="Pages">
              {page > 1 && <a href={categoryUrl(category, page - 1)} rel="prev">Previous</a>}
              {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (
                n === page ? <span aria-current="page">{n}</span> : <a href={categoryUrl(category, n)}>{n}</a>
              ))}
              {page < pages && <a href={categoryUrl(category, page + 1)} rel="next">Next</a>}
            </nav>
          )}
        </>
      )}
    </section>
  </main>

  <Footer lang={lang} munis={[]} />
</Base>

<style>
  .crumb { font-size: 13px; color: var(--muted); display: flex; gap: 7px; flex-wrap: wrap; }
  .crumb a { color: var(--ink-2); text-decoration: none; }
  .al-top { padding-top: var(--s5); }
  .al-h1 { margin: var(--s4) 0 var(--s5); }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; border-bottom: 1px solid var(--line); padding-bottom: var(--s4); }
  .tabs a { border: 1px solid var(--line); padding: 6px 12px; font-size: 14px; color: var(--ink-2); text-decoration: none; }
  .tabs a[aria-current="page"] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .al-body { padding-top: var(--s6); padding-bottom: var(--s8); }
  .al-empty { border: 1px dashed var(--line); padding: var(--s6); }
  .al-empty a { color: var(--ink); }
  .feat { display: grid; gap: var(--s4); text-decoration: none; color: inherit; margin-bottom: var(--s7); }
  @media (min-width: 900px) { .feat { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s6); align-items: center; } }
  .feat img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: #E7E6E2; }
  .feat__b { display: grid; gap: 8px; }
  .feat__t { font-size: clamp(24px, 3.4vw, 32px); font-weight: 300; line-height: 1.2; color: var(--ink); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s6) var(--s4); }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 520px) and (max-width: 759px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .card { display: grid; gap: 6px; text-decoration: none; color: inherit; align-content: start; }
  .card img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block; background: #E7E6E2; }
  .card .t-label, .feat .t-label { color: var(--faint); }
  .card__t { font-size: 19px; line-height: 1.3; color: var(--ink); }
  .card__x { font-size: 14px; color: var(--muted); }
  .meta { font-size: 13px; color: var(--faint); font-variant-numeric: tabular-nums; }
  .card:hover .card__t, .feat:hover .feat__t { text-decoration: underline; text-underline-offset: 3px; }
  .pager { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--s7); }
  .pager a, .pager span { border: 1px solid var(--line); padding: 6px 12px; font-size: 14px; color: var(--ink); text-decoration: none; }
  .pager span[aria-current] { background: var(--ink); color: #fff; border-color: var(--ink); }
</style>
