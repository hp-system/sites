---
// ═══════════════════════════════════════════════════════════════════════════
// ARTICLE LIST — /en/articles/{all-news | business-news | buyers | constructors-news}.
// Approved mockup (George 20/10/2026): one large article on top, then a 3-column grid.
// No count anywhere (no "46 Results"). Page 2+ is noindex, follow and canonical to itself.
// On the kit since 2026-11-11 (Sergei: the structure of the Rewize blog, not its look, «следуй нашим канонам»):
// the top with an eyebrow, the H1, the lead and a search over every article; the categories as square tabs
// (no counts: George's rule above); on page 1 the lead article large with the next two beside it, then «All
// articles» in the grid. Colours only from the palette, corners 0.
// ═══════════════════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Footer from './Footer.astro';
import { listUrl, t, prefix, type Lang } from '../lib/i18n';
import { brand } from '../brand/index';
import { redirectFor } from '../lib/redirects';
import {
  CATEGORIES, PER_PAGE, articleUrl, categoryName, categoryUrl, inCategory, readingMinutes,
  dateText, excerptOf,
} from '../lib/articles';

interface Props { category: string; page: number }
const { category, page } = Astro.props;
const lang: Lang = 'en';

const all = await inCategory(category);
const pages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const items = all.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const [first, ...rest] = page === 1 ? items : [null, ...items];

const url = categoryUrl(category, page);
const pathFor = (l: Lang) => (l === 'en' ? url : listUrl(l));
const name = categoryName(category);
const title = category === 'all-news'
  ? `Articles about buying property in Halkidiki and Greece${page > 1 ? ` — page ${page}` : ''} | ${brand.name}`
  : `${name} — articles${page > 1 ? ` — page ${page}` : ''} | ${brand.name}`;
const description = category === 'all-news'
  ? 'Guides, taxes, market trends and practical advice for buying, owning and selling property in Halkidiki and Greece.'
  : `${name}: guides and news about property in Halkidiki and Greece.`;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: brand.name, item: `${site}${prefix(lang) || '/'}` },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: `${site}${categoryUrl('all-news')}` },
    ...(category !== 'all-news' ? [{ '@type': 'ListItem', position: 3, name, item: `${site}${categoryUrl(category)}` }] : []),
  ],
}];
const img = (a: (typeof all)[number]) => a.data.hero_image || a.data.og_image;
// page 1: the lead article and the two beside it; the grid takes the rest
const side = page === 1 ? rest.filter(Boolean).slice(0, 2) : [];
const grid = page === 1 ? rest.filter(Boolean).slice(2) : rest.filter(Boolean);
// the search reads every article (all categories), not only this page
const every = await inCategory('all-news');
const index = every.map((a) => ({ t: a.data.h1, x: excerptOf(a), u: articleUrl(a), c: categoryName(a.data.category) }));
---
<Base lang={lang} title={title} description={description} pathFor={pathFor} langs={['en']}
      noindex={page > 1} jsonLd={jsonLd}>
  <Header lang={lang} solid pathFor={pathFor} />
  <MobileMenu lang={lang} pathFor={pathFor} munis={[]} total={0} />

  <main id="main" class="al">
    <header class="wrap al-top">
      <nav class="crumb" aria-label={t(lang, 'a11y.crumb')}>
        <a href={prefix(lang) || '/'}>{brand.name}</a>
        <span aria-hidden="true">·</span>
        <span>Articles</span>
      </nav>
      <div class="al-hd">
        <div>
          <p class="t-label al-eb">Blog</p>
          <h1 class="t-display al-h1">{category === 'all-news' ? 'Articles' : name}</h1>
          <p class="al-lead">{description}</p>
        </div>
        <div class="al-q" role="search">
          <label class="al-q__box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
            <span class="sr-only">Search the articles</span>
            <input type="search" placeholder="Search the articles, e.g. ENFIA, Golden Visa" autocomplete="off" data-alq />
          </label>
          <ul class="al-q__res" data-alq-res hidden></ul>
          <script type="application/json" data-alq-idx set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
        </div>
      </div>
      <nav class="tabs" aria-label="Categories">
        {CATEGORIES.filter((c) => !redirectFor(categoryUrl(c.key))).map((c) => (
          <a href={categoryUrl(c.key)} aria-current={c.key === category ? 'page' : undefined}>{c.name}</a>
        ))}
      </nav>
    </header>

    <section class="wrap al-body">
      {items.length === 0 ? (
        <div class="al-empty" data-empty>
          <p class="t-h3">No articles in this category yet.</p>
          <p><a href={categoryUrl('all-news')}>See all articles</a></p>
        </div>
      ) : (
        <>
          {first && (
            <div class:list={['top3', { 'top3--one': side.length === 0 }]}>
            <a class="feat" href={articleUrl(first)}>
              {img(first) && <img src={img(first)} alt={first.data.h1} width="1200" height="675" fetchpriority="high" decoding="async" />}
              <span class="feat__b">
                <span class="t-label">{categoryName(first.data.category)}</span>
                <span class="feat__t">{first.data.h1}</span>
                <span class="card__x">{excerptOf(first)}</span>
                <span class="meta">{dateText(first.data.updated || first.data.published)} · {readingMinutes(first)} min read</span>
              </span>
            </a>
            {side.length > 0 && (
              <ul class="duo">
                {side.map((a) => (
                  <li>
                    <a class="mini" href={articleUrl(a!)}>
                      {img(a!) && <img src={img(a!)} alt={a!.data.h1} width="600" height="400" loading="lazy" decoding="async" />}
                      <span class="mini__b">
                        <span class="t-label">{categoryName(a!.data.category)}</span>
                        <span class="card__t">{a!.data.h1}</span>
                        <span class="meta">{dateText(a!.data.updated || a!.data.published)} · {readingMinutes(a!)} min read</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            </div>
          )}
          {grid.length > 0 && <p class="al-all" data-h>All articles</p>}
          <ul class="grid">
            {grid.map((a) => (
              <li>
                <a class="card" href={articleUrl(a!)}>
                  {img(a!) && <img src={img(a!)} alt={a!.data.h1} width="600" height="400" loading="lazy" decoding="async" />}
                  <span class="t-label">{categoryName(a!.data.category)}</span>
                  <span class="card__t">{a!.data.h1}</span>
                  <span class="card__x">{excerptOf(a!)}</span>
                  <span class="meta">{dateText(a!.data.updated || a!.data.published)} · {readingMinutes(a!)} min read</span>
                </a>
              </li>
            ))}
          </ul>
          {pages > 1 && (
            <nav class="pager" aria-label="Pages">
              {page > 1 && <a href={categoryUrl(category, page - 1)} rel="prev">Previous</a>}
              {Array.from({ length: pages }, (_, i) => i + 1).map((n) => (
                n === page ? <span aria-current="page">{n}</span> : <a href={categoryUrl(category, n)}>{n}</a>
              ))}
              {page < pages && <a href={categoryUrl(category, page + 1)} rel="next">Next</a>}
            </nav>
          )}
        </>
      )}
    </section>
  </main>

  <Footer lang={lang} munis={[]} />
</Base>

<script>
  // the search: every article (title and excerpt), as you type; Enter opens the first result
  const box = document.querySelector<HTMLInputElement>('[data-alq]');
  const res = document.querySelector<HTMLUListElement>('[data-alq-res]');
  const raw = document.querySelector('[data-alq-idx]')?.textContent ?? '[]';
  if (box && res) {
    const idx = JSON.parse(raw) as { t: string; x: string; u: string; c: string }[];
    const norm = (v: string) => v.toLocaleLowerCase('en').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const run = () => {
      const words = norm(box.value).split(/\s+/).filter(Boolean);
      if (!words.length) { res.hidden = true; res.innerHTML = ''; return; }
      const hits = idx.filter((a) => { const h = norm(`${a.t} ${a.x} ${a.c}`); return words.every((w) => h.includes(w)); }).slice(0, 8);
      res.innerHTML = '';
      if (!hits.length) { const li = document.createElement('li'); li.className = 'al-q__none'; li.textContent = 'No article matches.'; res.append(li); }
      for (const a of hits) {
        const li = document.createElement('li'); const link = document.createElement('a'); link.href = a.u;
        const c = document.createElement('span'); c.className = 't-label'; c.textContent = a.c;
        const t = document.createElement('span'); t.textContent = a.t;
        link.append(c, t); li.append(link); res.append(li);
      }
      res.hidden = false;
    };
    box.addEventListener('input', run);
    box.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const a = res.querySelector('a'); if (a) location.href = a.href; } if (e.key === 'Escape') { box.value = ''; run(); } });
    document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.al-q')) res.hidden = true; });
  }
</script>

<style>
  .crumb { font-size: var(--fs-s-1); color: var(--muted); display: flex; gap: 7px; flex-wrap: wrap; }
  .crumb a { color: var(--ink-2); text-decoration: none; }
  .al-top { padding-top: var(--s5); }
  .al-hd { display: grid; gap: var(--s5); margin: var(--s5) 0 var(--s5); }
  @media (min-width: 900px) { .al-hd { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: end; gap: var(--s6); } }
  .al-eb { margin: 0; color: var(--faint); }
  .al-h1 { margin: var(--s3) 0 var(--s4); }
  .al-lead { margin: 0; max-width: 60ch; font-size: var(--fs-s0); line-height: 1.6; color: var(--muted); }
  .al-q { position: relative; }
  .al-q__box { display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 16px; border: 1px solid var(--line); background: var(--paper); color: var(--muted); }
  .al-q__box:focus-within { border-color: var(--ink); }
  .al-q__box input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; font-size: var(--fs-s0); color: var(--ink); }
  .al-q__res { position: absolute; z-index: 5; inset-inline: 0; top: calc(100% + 4px); margin: 0; padding: 6px 0; list-style: none; background: var(--paper);
    border: 1px solid var(--line); box-shadow: 0 18px 40px rgba(11,14,16,.12); max-height: 60vh; overflow: auto; }
  .al-q__res :global(a) { display: grid; gap: 2px; padding: 10px 16px; color: var(--ink); text-decoration: none; font-size: var(--fs-s0); line-height: 1.35; }
  .al-q__res :global(a:hover), .al-q__res :global(a:focus-visible) { background: var(--paper-2); outline: 0; }
  .al-q__res :global(.t-label) { color: var(--faint); }
  .al-q__res :global(.al-q__none) { padding: 10px 16px; font-size: var(--fs-s0); color: var(--muted); }
  /* the categories: square tabs of the kit, the current one in ink (no counts, George 20/10) */
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid var(--line); padding-bottom: var(--s4); }
  .tabs a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 1px solid var(--line); font-size: var(--fs-s-1); font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); text-decoration: none; transition: border-color .15s ease, background .15s ease; }
  .tabs a:hover { border-color: var(--ink); }
  .tabs a[aria-current="page"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .tabs a:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  /* page 1: the lead article large, the next two beside it */
  .top3 { display: grid; gap: var(--s5); margin-bottom: var(--s7); }
  @media (min-width: 900px) { .top3 { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--s6); align-items: start; } .top3--one { grid-template-columns: 1fr; } }
  .top3 .feat { margin-bottom: 0; grid-template-columns: 1fr; }
  .duo { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s5); }
  .mini { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--s4); text-decoration: none; color: inherit; align-items: start; }
  .mini img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; background: var(--paper-2); }
  .mini__b { display: grid; gap: 6px; align-content: start; }
  .mini .t-label { color: var(--faint); }
  .mini:hover .card__t { text-decoration: underline; text-underline-offset: 3px; }
  .al-all { margin: 0 0 var(--s5); padding-top: var(--s5); border-top: 1px solid var(--line); font-size: var(--fs-s3); font-weight: 300; line-height: 1.15; color: var(--ink); }
  .al-body { padding-top: var(--s6); padding-bottom: var(--s8); }
  .al-empty { border: 1px solid var(--line); padding: var(--s6); }
  .al-empty a { color: var(--ink); }
  .feat { display: grid; gap: var(--s4); text-decoration: none; color: inherit; margin-bottom: var(--s7); }
  @media (min-width: 900px) { .feat { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s6); align-items: center; } }
  .feat img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: var(--paper-2); }
  .feat__b { display: grid; gap: 8px; }
  .feat__t { font-size: var(--fs-s3); font-weight: 300; line-height: 1.2; color: var(--ink); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s6) var(--s4); }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 520px) and (max-width: 759px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .card { display: grid; gap: 6px; text-decoration: none; color: inherit; align-content: start; }
  .card img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block; background: var(--paper-2); }
  .card .t-label, .feat .t-label { color: var(--faint); }
  .card__t { font-size: var(--fs-s0); line-height: 1.3; color: var(--ink); }
  .card__x { font-size: var(--fs-s0); color: var(--muted); }
  .meta { font-size: var(--fs-s-1); color: var(--faint); font-variant-numeric: tabular-nums; }
  .card:hover .card__t, .feat:hover .feat__t { text-decoration: underline; text-underline-offset: 3px; }
  .pager { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--s7); }
  .pager a, .pager span { border: 1px solid var(--line); padding: 6px 12px; font-size: var(--fs-s0); color: var(--ink); text-decoration: none; }
  .pager span[aria-current] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
</style>
