---
// In the panel frame (PanelShell, design E3 — Sergei 2026-11-11 «AFTER main v3»)
import PanelShell from './PanelShell.astro';
// ═══════════════════════════════════════════════════════════════════════════
// Η ΚΛΕΙΣΤΗ ΣΥΛΛΟΓΗ — `/panel/collection`
//
// Το κίνητρο ολόκληρης της εγγραφής. Η αρχική σελίδα τη διαφημίζει· μέχρι σήμερα
// δεν υπήρχε πουθενά να τη δει ο πελάτης αφού μπει.
//
// 🎚️ ΤΡΙΑ ΕΠΙΠΕΔΑ, ΚΑΙ ΤΟ ΦΙΛΤΡΟ ΓΙΝΕΤΑΙ ΣΤΟΝ ΔΙΑΚΟΜΙΣΤΗ, ΟΧΙ ΕΔΩ:
//      επισκέπτης → δεν φτάνει καν εδώ (ο δρομολογητής τον στέλνει στην είσοδο)
//      μέλος      → βλέπει `secret_portfolio`, ΟΧΙ `ultra_secret`
//      exclusive  → βλέπει και τα δύο
//    Το `allProperties(600, token)` επιστρέφει **ήδη** μόνο ό,τι δικαιούται. Εδώ
//    απλώς ξεχωρίζουμε τα κρυφά από τα δημόσια για να τα δείξουμε μαζί.
//
// ⛔ ΜΗΝ ΠΡΟΣΘΕΣΕΙΣ ΕΔΩ ΔΙΚΟ ΣΟΥ ΦΙΛΤΡΟ ΕΠΙΠΕΔΟΥ. Αν το site κρίνει ποιος βλέπει τι,
//    τότε υπάρχουν δύο κανόνες — και μόλις αποκλίνουν, ο ένας διαρρέει ακίνητα.
//    Ο κανόνας ζει στο `publicConds()` του API. Εδώ μόνο εμφάνιση.
//
// 🪤 `isSecretFlag`, ΟΧΙ `=== true`: δύο ακίνητα έχουν την τιμή **«on»** (HTML
//    checkbox). Με `=== true` αυτή η σελίδα θα έδειχνε **άδεια** σε πελάτη που
//    δικαιούται να δει — και θα φαινόταν ότι δεν έχουμε τίποτα κρυφό.
// ═══════════════════════════════════════════════════════════════════════════
import PropertyCard from './PropertyCard.astro';
import { prefix, t, type Lang } from '../lib/i18n';
import { allProperties, visitorCountry, refOf, type SiteProperty } from '../lib/api';
import { blurSrc } from '../lib/photos';
import { viewerFor, isSecretFlag, municipalityOf } from '../lib/gate';
import { company } from '../lib/company';
import type { Member } from '../lib/member';

interface Props { lang: Lang; me: Member; token?: string }
const { lang, me, token } = Astro.props;
const p = prefix(lang);
const co = await company();
const viewer = viewerFor(me.level);
const isExclusive = me.level === 'exclusive';
// Everyone opens the closed collection (Sergei 2026-11-23); only Exclusive members see the homes. For the rest each
// card is locked: the 24-pixel copy blurred (lib/blur — no real photo address in the page), a lock, the municipality.
const open = isExclusive;

let secret: SiteProperty[] = [];
let ultra: SiteProperty[] = [];
let failed = false;
try {
  const all = await allProperties(token, visitorCountry(Astro.request));   // #18
  for (const it of all) {
    const a = it.attributes ?? {};
    if (isSecretFlag(a.ultra_secret)) ultra.push(it);
    else if (isSecretFlag(a.secret_portfolio) || it.locked) secret.push(it);
  }
} catch {
  failed = true;
}
const total = secret.length + ultra.length;
---

<PanelShell lang={lang} me={me} current={'collection'} title={t(lang, 'pnl.collection')} description={t(lang, 'cl.meta_desc')}>
  <div class="cl">

      <h1 class="t-h2 cl__h">{t(lang, 'pnl.collection')}</h1>
      <p class="cl__s">{t(lang, 'cl.sub')}</p>

      {!isExclusive && !failed && (
        /* the Exclusive door (E3 card), now here at the top, over the cards, across the whole width, for everyone not
           Exclusive (Sergei 2026-11-23: «только на страницу closed collection под карточками на всю ширину», then «перенеси вверх») */
        <div class="xb">
          <svg class="xb__lock" width="64" height="72" viewBox="0 0 64 72" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 34V22a14 14 0 0 1 28 0v12"></path><rect x="8" y="34" width="48" height="34"></rect><path d="M32 48v8"></path></svg>
          <div class="xb__t">
            <span class="xb__l">Exclusive</span>
            <span class="xb__h">{t(lang, 'pnl.ex_h')} <b><bdi>{t(lang, 'pnl.ex_price')}</bdi></b></span>
          </div>
          <a class="xb__go" href={`${p}/panel/exclusive`} data-ev="register:collection_band">{t(lang, 'pnl.ex_cta')}</a>
        </div>
      )}

      {failed ? (
        <p class="say">{t(lang, 'cl.fail')}</p>
      ) : total === 0 ? (
        <div class="empty">
          <p class="empty__h">{t(lang, 'cl.empty_h')}</p>
          <p class="empty__s">{t(lang, 'cl.empty_s')}</p>
          <a class="btn" href={co.phoneHref}><bdi dir="ltr">{co.phone}</bdi></a>
        </div>
      ) : (
        <>
          {/* No count here either: "never property counts" (George 17/10; q14 21/10). */}
          <div class="grid">
            {open
              ? [...ultra, ...secret].map((it, i) => <PropertyCard p={it} lang={lang} viewer={viewer} eager={i < 2} />)
              : [...ultra, ...secret].map((it) => {
                  const muni = municipalityOf(it.attributes ?? {}, lang);
                  return (
                    <a class="lk" href={`${p}/panel/exclusive`} data-ev="register:collection_locked">
                      <span class="lk__ph">
                        {!it.locked && <img src={blurSrc(refOf(it), 0)} alt="" width="800" height="533" loading="lazy" decoding="async" />}
                        <span class="lk__over">
                          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10"></rect><path d="M8 11V7.5a4 4 0 0 1 8 0V11"></path></svg>
                          <b>{t(lang, 'cl.lock')}</b>
                        </span>
                      </span>
                      {muni && <span class="lk__m">{muni}</span>}
                    </a>
                  );
                })}
          </div>
        </>
      )}

    </div>
</PanelShell>

<style>
  .cl { padding: var(--s6) 0 var(--s9); }
  .cl .wrap { max-width: 1180px; }
  .crumb { font-size: var(--fs-s-1); color: var(--faint); display: flex; gap: 7px; align-items: center;
           margin-bottom: 10px; }
  .crumb a { color: var(--muted); }
  .crumb span { color: var(--line); }
  .cl__h { margin: 0 0 8px; }
  .cl__s { font-size: var(--fs-s0); color: var(--ink-2); margin: 0 0 6px; max-width: 58ch; }
  .say { font-size: var(--fs-s0); color: var(--faint); margin: 0 0 22px; }

  .grid { display: grid; gap: var(--s4);
          grid-template-columns: repeat(auto-fill, minmax(272px, 1fr)); }
  .grid > :global(*) { min-width: 0; }

  .empty { border: 1px solid var(--line); padding: 26px 22px; max-width: 46ch; margin-top: 18px; }
  .empty__h { margin: 0 0 8px; font-size: var(--fs-s0); font-weight: 400; }
  .empty__s { margin: 0 0 18px; font-size: var(--fs-s0); color: var(--muted); }

  /* a locked card: the destroyed copy blurred (a dark plate when even that is not ours to send), a lock and a line */
  .lk { display: flex; flex-direction: column; gap: 10px; color: var(--ink); text-decoration: none; }
  .lk__ph { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--ink-deep); }
  .lk__ph img { width: 100%; height: 100%; object-fit: cover; display: block; filter: blur(7px) saturate(.92); transform: scale(1.08); }
  .lk__over { position: absolute; inset: 0; display: grid; place-content: center; gap: 8px; padding: 14px; text-align: center;
    color: #fff; background: rgba(10,14,16,.46); transition: background .25s ease; }
  .lk__over svg { margin: 0 auto; }
  .lk__over b { font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .lk:hover .lk__over { background: rgba(10,14,16,.6); }
  .lk:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  .lk__m { font-size: var(--fs-s-1); color: var(--muted); }

  /* the Exclusive band: the side card of E3, laid across the content width */
  .xb { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: var(--s5);
    margin: var(--s4) 0 var(--s5); padding: 32px 36px; background: var(--ink-deep); color: var(--paper); }
  .xb__t { position: relative; display: flex; flex-direction: column; gap: 12px; }
  .xb__l { font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: rgba(255,255,255,.62); }
  .xb__h { font-size: var(--fs-s3); font-weight: 300; line-height: 1.2; letter-spacing: -.012em; }
  .xb__h b { font-weight: 600; }
  .xb__lock { position: absolute; right: 30%; top: 50%; transform: translateY(-50%); color: rgba(255,255,255,.1); }
  .xb__go { position: relative; flex: none; display: flex; align-items: center; justify-content: center; height: 48px; padding: 0 28px;
    border: 1px solid var(--gold-dk); color: var(--gold-dk-text); font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; text-decoration: none; transition: color .3s ease, border-color .3s ease; }
  .xb__go:hover, .xb__go:focus-visible { color: var(--gold-dk-hover); border-color: var(--gold-dk-hi); }
  @media (max-width: 760px) { .xb { flex-direction: column; align-items: stretch; padding: 24px 20px; } .xb__lock { right: 16px; top: 24px; transform: none; } }
</style>
