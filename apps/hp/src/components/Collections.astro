---
// ΜΠΛΟΚ 7 — Συλλογές. Τέσσερα πλακίδια, έτοιμες αναζητήσεις.
// Αντικαθιστούν τις πέντε «κατηγορίες» του σημερινού site, που ήταν
// προ-φτιαγμένα φίλτρα με φωτογραφίες αρχείου.
// 🔒 ΥΔΑΤΟΓΡΑΦΗΜΕΝΑ (George, 5/8) — ΑΝΑΤΡΟΠΗ ΤΗΣ ΑΠΟΦΑΣΗΣ ΤΗΣ 30/7.
//
// Στις 30/7 είχε πει «ούτε εδώ, γιατί αφορά κατηγορίες και όχι συγκεκριμένο
// ακίνητο» — και ως σκεπτικό ήταν σωστό: το πλακίδιο διαφημίζει μια αναζήτηση.
//
// ⚠️ ΤΟ ΠΡΟΒΛΗΜΑ ΔΕΝ ΗΤΑΝ ΤΟ ΣΚΕΠΤΙΚΟ, ΗΤΑΝ ΤΟ ΑΡΧΕΙΟ. Η φωτογραφία του
//    πλακιδίου ΕΙΝΑΙ πραγματική φωτογραφία πραγματικού ακινήτου — απλώς
//    χρησιμοποιείται ως εικόνα τόπου. Μετρήθηκε 5/8: το site εξέθετε **6 καθαρές**
//    (4 πλακίδια + το μεγάλο ακίνητο + η εικόνα κοινοποίησης).
//
// 🪤 ΚΑΙ ΔΕΝ ΛΥΝΟΤΑΝ ΜΕ ΕΞΑΙΡΕΣΗ ΣΤΟ CLOUDFLARE: τα πλακίδια επιλέγονται
//    ΔΥΝΑΜΙΚΑ (`pickPhoto` στο HomePage.astro) και αλλάζουν με το απόθεμα.
//    Στατική λίστα εξαιρέσεων δεν μπορεί να τα προλάβει ΠΟΤΕ.
// ⏭️ Το σωστό τελικό είναι ξεχωριστές φωτογραφίες τοπίου για τις συλλογές
//    (επιλογή George) — τότε ξαναγυρίζουν σε καθαρές, νόμιμα.
import { marked, altOf, markedSrcSet, type Photo, markedSrcSetSmall} from '../lib/photos';
import { t, listUrl, type Lang } from '../lib/i18n';
import { num } from '../lib/format';

export type Collection = { key: string; title: string; sub: string; href: string; photo: Photo | null };
interface Props { items: Collection[]; lang: Lang }
const { items, lang } = Astro.props;
---
<section class="section" aria-labelledby="coll-h">
  <div class="wrap">
    <div class="shead">
      <div>
        <h2 id="coll-h" class="t-h2">{t(lang, 'coll.h2')}</h2>
        <p>{t(lang, 'coll.sub')}</p>
      </div>
    </div>

    <ul class="colls">
      {items.map((c) => (
        <li>
          <a class="coll" href={c.href}>
            {/* 🪤 ΤΟ ΣΧΟΛΙΟ ΜΕΝΕΙ ΕΞΩ ΑΠΟ ΤΟ `{cond && ( … )}` — μέσα του το Astro
                σκάει με «Expected ")" but found $$render».
                Το πλακίδιο ΕΙΧΕ ΜΟΝΟ `src`: σέρβιρε πάντα `_800w` ακόμα και στα
                291 CSS px που πιάνει σε desktop — 576 KB περιττά ανά φόρτωση.
                Το `cardSrcSet` υπήρχε ήδη στο lib/photos.ts, απλώς δεν είχε συνδεθεί. */}
            {/* 📐 ΚΑΙ ΤΟ `sizes` ΕΛΕΓΕ ΨΕΜΑΤΑ ΣΤΟ ΚΙΝΗΤΟ: δήλωνε «μισή οθόνη» (`/2`) ενώ
                το CSS δίνει **μία στήλη** κάτω από 760px (`.colls` χωρίς
                `grid-template-columns`, γρ. 64). Ο φυλλομετρητής διάλεγε αρχείο για
                170px σε πλακίδιο 353px ⇒ **θολές εικόνες σε κάθε κινητό**. Και το
                `srcset` έφτανε ως 1920w — μισό megabyte για ένα πλακίδιο.
                (Ναι, ξαναπάτησα την παγίδα του σχολίου δύο γραμμές πιο πάνω.) */}
            {c.photo && (
              <img src={marked(c.photo.url, 800)} alt={altOf(c.photo, lang, c.title)}
                   srcset={markedSrcSetSmall(c.photo.url)}
                   sizes="(min-width: 760px) calc((100vw - 132px) / 4), calc(100vw - 40px)"
                   width="800" height="533" loading="lazy" decoding="async" />
            )}
            <span class="coll__t">
              <b set:html={c.title}></b>
              <span>{c.sub}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .colls { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); }
  .coll { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); }
  .coll img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .coll:hover img { transform: scale(1.03); }
  .coll__t {
    position: absolute; inset: auto 0 0 0; padding: var(--s4); color: #fff;
    background: linear-gradient(0deg, rgba(0,0,0,.7), rgba(0,0,0,0));
  }
  .coll__t b { display: block; font-size: 21px; font-weight: 300; }
  .coll__t span { font-size: 11.5px; opacity: .82; letter-spacing: .06em; }
  @media (min-width: 760px) { .colls { grid-template-columns: repeat(4, 1fr); } }
</style>
