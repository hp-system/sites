---
// ΜΠΛΟΚ 7 — Συλλογές. Τέσσερα πλακίδια, έτοιμες αναζητήσεις.
// Αντικαθιστούν τις πέντε «κατηγορίες» του σημερινού site, που ήταν
// προ-φτιαγμένα φίλτρα με φωτογραφίες αρχείου.
// 🔒 ΥΔΑΤΟΓΡΑΦΗΜΕΝΑ (George, 5/8) — ΑΝΑΤΡΟΠΗ ΤΗΣ ΑΠΟΦΑΣΗΣ ΤΗΣ 30/7.
//
// Στις 30/7 είχε πει «ούτε εδώ, γιατί αφορά κατηγορίες και όχι συγκεκριμένο
// ακίνητο» — και ως σκεπτικό ήταν σωστό: το πλακίδιο διαφημίζει μια αναζήτηση.
//
// ⚠️ ΤΟ ΠΡΟΒΛΗΜΑ ΔΕΝ ΗΤΑΝ ΤΟ ΣΚΕΠΤΙΚΟ, ΗΤΑΝ ΤΟ ΑΡΧΕΙΟ. Η φωτογραφία του
//    πλακιδίου ΕΙΝΑΙ πραγματική φωτογραφία πραγματικού ακινήτου — απλώς
//    χρησιμοποιείται ως εικόνα τόπου. Μετρήθηκε 5/8: το site εξέθετε **6 καθαρές**
//    (4 πλακίδια + το μεγάλο ακίνητο + η εικόνα κοινοποίησης).
//
// 🪤 ΚΑΙ ΔΕΝ ΛΥΝΟΤΑΝ ΜΕ ΕΞΑΙΡΕΣΗ ΣΤΟ CLOUDFLARE: τα πλακίδια επιλέγονται
//    ΔΥΝΑΜΙΚΑ (`pickPhoto` στο HomePage.astro) και αλλάζουν με το απόθεμα.
//    Στατική λίστα εξαιρέσεων δεν μπορεί να τα προλάβει ΠΟΤΕ.
// ⏭️ Το σωστό τελικό είναι ξεχωριστές φωτογραφίες τοπίου για τις συλλογές
//    (επιλογή George) — τότε ξαναγυρίζουν σε καθαρές, νόμιμα.
import { clean, altOf, cleanSrcSet, type Photo, cleanSrcSetSmall } from '../lib/photos';
import { t, listUrl, type Lang } from '../lib/i18n';
import { num } from '../lib/format';

export type Collection = { key: string; title: string; sub: string; href: string; photo: Photo | null };
interface Props { items: Collection[]; lang: Lang }
const { items, lang } = Astro.props;
const pages = Math.ceil(items.length / 4);
---
<section class="section hz hz--beige colls-sec" aria-labelledby="coll-h">
  <div class="wrap">
    {/* #101 (George 2026-11-02): eight tiles — the four ready-made searches and every
        type of property — in a row of four that turns a page every 5 s on desktop
        (dashes top right). Every tile is in the HTML. Phone: the row is swiped. */}
    <div class="shead hz-head">
      <div>
        {/* Sergei 2026-11-24: a real H2 with George's P01 headings («Houses, apartments, villas and land», «Seafront
            property in Halkidiki»); the line under it carries the keywords. Was «Collections» in a <p>. */}
        <h2 data-h id="coll-h" class="t-h2">{t(lang, 'home.coll_h2')}</h2>
        <p>{t(lang, 'home.coll_sub')}</p>
      </div>
      {pages > 1 && (
        <div class="h-dash" role="group" aria-label={t(lang, 'home.pages')} data-dash-for="railCl">
          {Array.from({ length: pages }).map((_, i) => (
            <button type="button" class={i === 0 ? 'on' : undefined} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={t(lang, 'home.page', { n: i + 1 })} data-page={i}><span></span></button>
          ))}
        </div>
      )}
    </div>

    <ul class="colls h-rail" id="railCl" data-hrail data-gap="12">
      {items.map((c) => (
        <li>
          <a class="coll" href={c.href}>
            {/* 🪤 ΤΟ ΣΧΟΛΙΟ ΜΕΝΕΙ ΕΞΩ ΑΠΟ ΤΟ `{cond && ( … )}` — μέσα του το Astro
                σκάει με «Expected ")" but found $$render».
                Το πλακίδιο ΕΙΧΕ ΜΟΝΟ `src`: σέρβιρε πάντα `_800w` ακόμα και στα
                291 CSS px που πιάνει σε desktop — 576 KB περιττά ανά φόρτωση.
                Το `cardSrcSet` υπήρχε ήδη στο lib/photos.ts, απλώς δεν είχε συνδεθεί. */}
            {/* 📐 ΚΑΙ ΤΟ `sizes` ΕΛΕΓΕ ΨΕΜΑΤΑ ΣΤΟ ΚΙΝΗΤΟ: δήλωνε «μισή οθόνη» (`/2`) ενώ
                το CSS δίνει **μία στήλη** κάτω από 760px (`.colls` χωρίς
                `grid-template-columns`, γρ. 64). Ο φυλλομετρητής διάλεγε αρχείο για
                170px σε πλακίδιο 353px ⇒ **θολές εικόνες σε κάθε κινητό**. Και το
                `srcset` έφτανε ως 1920w — μισό megabyte για ένα πλακίδιο.
                (Ναι, ξαναπάτησα την παγίδα του σχολίου δύο γραμμές πιο πάνω.) */}
            {/* #101: desktop tiles are ¼ of the column, phone ~80% (swiped row). */}
            {c.photo && (
              <img src={clean(c.photo.url, 800)} alt={altOf(c.photo, lang, c.title)}
                   srcset={cleanSrcSetSmall(c.photo.url)}
                   sizes="(min-width: 1024px) calc((min(100vw, 1280px) - 116px) / 4), 80vw"
                   width="800" height="533" loading="lazy" decoding="async" />
            )}
            <span class="coll__t">
              <b set:html={c.title}></b>
              {/* Sergei 2026-11-24: no «Show properties» line (c.sub) under the title */}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .colls { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); }
  .coll { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-2); }
  .coll img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .coll:hover img { transform: scale(1.03); }
  .coll__t {
    position: absolute; inset: auto 0 0 0; padding: var(--s4); color: #fff; text-align: center;   /* the name centred at the bottom (Sergei 2026-11-24) */
    background: linear-gradient(0deg, rgba(0,0,0,.7), rgba(0,0,0,0));
  }
  .coll__t b { display: block; font-size: var(--fs-s1); font-weight: 300; }
  .coll__t span { font-size: var(--fs-s-1); opacity: .82; letter-spacing: .06em; }
  .hz-head .h-dash { display: none; }

  /* Phone / tablet: eight tiles do not stack — the row is swiped, as the cards' photos. */
  @media (max-width: 1023px) {
    .colls {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      overscroll-behavior-x: contain; margin: 0 calc(-1 * var(--gut)); padding: 0 var(--gut);
      scroll-padding: 0 var(--gut);
    }
    .colls::-webkit-scrollbar { display: none; }
    .colls > li { flex: none; width: 80%; scroll-snap-align: start; }
  }
  @media (min-width: 760px) and (max-width: 1023px) { .colls > li { width: calc((100% - 24px) / 2.4); } }

  /* ── #101 desktop ─────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .hz-head { display: flex; justify-content: space-between; align-items: flex-end; }
    /* Sergei 2026-11-24: the keyword line on one row (no 56ch limit on desktop) */
    .hz-head p:not([data-h]) { max-width: none; }
    .hz-head .h-dash { display: flex; }
    .colls {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
      scrollbar-width: none; overscroll-behavior-x: contain;
    }
    .colls::-webkit-scrollbar { display: none; }
    .colls > li { flex: none; width: calc((100% - 36px) / 4); scroll-snap-align: start; }
    .coll { aspect-ratio: auto; height: 100%; background: var(--paper-3); }
    /* captions float above the photo: soft lifted shadow + a taller dark fade */
    .coll__t { padding-top: 56px; background: linear-gradient(0deg, rgba(0,0,0,.62) 0%, rgba(0,0,0,.32) 45%, rgba(0,0,0,0) 100%); }
    .coll__t b { text-shadow: 0 1px 2px rgba(0,0,0,.35), 0 6px 22px rgba(0,0,0,.55); transition: transform .35s ease; }
    .coll__t span { opacity: .95; text-shadow: 0 1px 2px rgba(0,0,0,.45), 0 4px 14px rgba(0,0,0,.5); }
    .coll:hover .coll__t b { transform: translateY(-2px); }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) { .colls { scroll-behavior: auto; } }
  /* one row where the widest language (Greek, ~1080 px) fits beside the arrows; narrower desktops wrap */
  @media (min-width: 1360px) { .hz-head p:not([data-h]) { white-space: nowrap; } }
</style>
