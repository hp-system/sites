---
// ═══════════════════════════════════════════════════════════════════════════
// ΜΕΛΕΤΗ & ΚΑΤΑΣΚΕΥΗ — νέο μπλοκ, 28/7 (αίτημα George).
//
// «Είμαστε ΚΑΙ κατασκευαστική εταιρεία. Κάποιος μπορεί να πάρει από εμάς μια γη
//  και εμείς να την αναπτύξουμε στον ανώτατο βαθμό — είτε για το προσωπικό του
//  όνειρο, είτε για επαγγελματική δραστηριότητα. Είναι πολύ μεγάλο κομμάτι της
//  εταιρείας και θέλω να το προβάλουμε σε πολύ καλό σημείο.»
//
// ΓΙΑΤΙ ΕΔΩ, ΑΜΕΣΩΣ ΜΕΤΑ ΤΙΣ ΣΥΛΛΟΓΕΣ: η μία από τις τέσσερις συλλογές είναι
// «Γη & οικόπεδα», και **207 από τα 527 ακίνητά μας (39%) είναι γη**. Ο
// επισκέπτης μόλις είδε οικόπεδα και η επόμενη σκέψη του είναι «και μετά τι;».
// Αυτό το μπλοκ είναι η απάντηση. Δεν είναι διαφημιστικό παρένθετο — είναι το
// επόμενο βήμα της ίδιας σκέψης.
//
// ΤΟ ΠΕΡΙΕΧΟΜΕΝΟ ΕΙΝΑΙ ΑΛΗΘΙΝΟ: οι έξι δυνατότητες είναι σύνοψη των 23
// υπηρεσιών που ήδη δημοσιεύει το σημερινό site στη σελίδα «Υπηρεσίες
// Κατασκευαστή» — γεωθερμία, βιοκλιματικές, φωτοβολταϊκά, ζωντανή επίβλεψη με
// βίντεο, εγγύηση κατασκευής, πισίνες, άδειες δόμησης, ΜΠΕ. Δεν εφευρέθηκε τίποτα.
//
// 📍 ΤΑ ΕΡΓΑ ΔΕΝ ΜΠΑΙΝΟΥΝ ΕΔΩ (George, 28/7): «για τα projects που έχουμε χτίσει
//    στο παρελθόν θα κάνουμε ειδική σελίδα που θα οδηγεί εκεί.»
//    Άρα αυτό το μπλοκ λέει **τι μπορούμε**, και η ΑΠΟΔΕΙΞΗ — φωτογραφίες,
//    ονόματα, μεγέθη — ζει ένα κλικ παρακάτω, στο `projectsUrl(lang)`.
//    ⛔ ΜΗΝ προσθέσεις εδώ λωρίδα με φωτογραφίες έργων· θα διπλώνει τη σελίδα.
//    ⏳ Η σελίδα των έργων δεν έχει χτιστεί — ο σύνδεσμος δίνει 404 όπως όλοι οι
//       εσωτερικοί σήμερα.
// ═══════════════════════════════════════════════════════════════════════════
import { t, prefix, type Lang } from '../lib/i18n';
import { contentUrl } from '../lib/pages';
import { pageExists } from '../lib/pages';
import { company } from '../lib/company';

interface Props { lang: Lang }
const { lang } = Astro.props;

const CAPS = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6'];
const STRIP = ['s1', 's2', 's3', 's4'];

// 🛡️ Αν η σελίδα «Επικοινωνία» δεν έχει ακόμη κείμενο, ο σύνδεσμος **δεν σβήνει** —
//    γίνεται τηλέφωνο. Εδώ το κάλεσμα είναι το προϊόν: κενό κουμπί θα ήταν χαμένος
//    πελάτης, όχι απλώς λείπουσα σελίδα.
// #101: the heading breaks after its first sentence on desktop (one line each).
const [h2a, ...h2rest] = t(lang, 'cx.h2').split(/(?<=[.!?])\s+/);
const h2b = h2rest.join(' ');

// Desktop redesign (Sergei 03/11, mockup «two home blocks»): the four key words of the heading
// in bold (land · begins · house · build, in each language), and a row of cards you page through.
const BOLD: Record<Lang, string[]> = {
  en: ['land', 'begins', 'house', 'build'], el: ['γη', 'αρχή', 'σπίτι', 'χτίζουμε'],
  bg: ['Земята', 'началото', 'Къщата', 'строим'], sr: ['Zemlja', 'početak', 'Kuću', 'gradimo'],
  de: ['Anfang', 'Grund und Boden', 'Haus', 'bauen'], ro: ['Terenul', 'începutul', 'Casa', 'construim'],
  tr: ['Arazi', 'başlangıçtır', 'Evi', 'inşa ederiz'], he: ['הקרקע', 'ההתחלה', 'הבית', 'בונים'],
  ru: ['Земля', 'начало', 'Дом', 'строим'],
};
/** The sentence cut into plain and bold pieces (each key word where it first stands). */
const bolden = (s: string): { s: string; b: boolean }[] => {
  const words = BOLD[lang] ?? [];
  const out: { s: string; b: boolean }[] = [];
  let rest = s;
  for (;;) {
    const hits = words.map((w) => ({ w, i: rest.indexOf(w) })).filter((h) => h.i >= 0).sort((a, b) => a.i - b.i);
    if (!hits.length) { if (rest) out.push({ s: rest, b: false }); return out; }
    const { w, i } = hits[0];
    if (i) out.push({ s: rest.slice(0, i), b: false });
    out.push({ s: w, b: true });
    rest = rest.slice(i + w.length);
  }
};
// The cards in the row: a fact, two things we take on, a fact … (desktop only).
const ICON: Record<string, string> = {
  c1: '<path d="M3 21h18M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/>',
  c2: '<rect x="3" y="6" width="13" height="12" rx="1"/><path d="M16 10l5-3v10l-5-3"/>',
  c3: '<path d="M2 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 19c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/><path d="M8 13V5a2 2 0 0 1 4 0M14 13V5a2 2 0 0 1 4 0M8 8h6"/>',
  c4: '<path d="M14 4l6 6-3 3-6-6z"/><path d="M11 7L3 15v3h3l8-8"/>',
  c5: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  c6: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
};
const ROW = ['s1', 'c1', 'c2', 's2', 'c3', 'c4', 's3', 'c5', 'c6', 's4'];

const contactHref = pageExists('contact') ? `${prefix(lang)}/contact` : (await company()).phoneHref;
---
<section class="cx" aria-labelledby="cx-h">
  <div class="wrap">
    {/* #101 desktop (George 2026-11-02): left — the text and the four facts turning
        every 3 s (dashes); right — the six things we take on as the Company page
        accordion (one open, hover or click opens another); the two buttons centred
        under the band. Phone: the same blocks as before (boxes, all open). */}
    <div class="cx__top">
      <div class="cx__lead">
        <p class="t-label cx__eyebrow">{t(lang, 'cx.eyebrow')}</p>
        <h2 id="cx-h" class="cx__h">{bolden(h2a).map((x) => (x.b ? <b>{x.s}</b> : x.s))}{h2b && <><br class="cx__br" /> {bolden(h2b).map((x) => (x.b ? <b>{x.s}</b> : x.s))}</>}</h2>
        <p class="cx__p">{t(lang, 'cx.p')}</p>
      </div>

      <p class="cx__acts">
        {/* «Δείτε τι χτίζουμε» → η ΣΕΛΙΔΑ ΤΩΝ ΕΡΓΩΝ (George, 28/7: «για τα
            projects που έχουμε χτίσει θα κάνουμε ειδική σελίδα που θα οδηγεί
            εκεί»). Γι' αυτό το μπλοκ εδώ ΔΕΝ χρειάζεται φωτογραφίες έργων:
            λέει τι μπορούμε, και η απόδειξη ζει ένα κλικ παρακάτω. */}
        <a class="btn cx__btn" href={contentUrl('projects', lang)} data-ev="construction:portfolio">
          {t(lang, 'cx.cta1')}
        </a>
        {/* Ο ιδιοκτήτης οικοπέδου είναι ΑΛΛΟ κοινό από τον αγοραστή — δικό του κουμπί. */}
        <a class="btn btn--ghost cx__btn cx__btn--ghost" href={contactHref}
           data-ev="construction:have_land">{t(lang, 'cx.cta2')}</a>
      </p>

      {/* desktop: the row of cards (the same texts as the boxes below, which stay for phones) */}
      <div class="cx__rw">
        <button type="button" class="cx__arw cx__arw--l" data-cx-prev aria-label="‹" hidden>‹</button>
        <button type="button" class="cx__arw cx__arw--r" data-cx-next aria-label="›">›</button>
        <div class="cx__rail" data-cx-rail>
          {ROW.map((k) => k.startsWith('s') ? (
            <article class="cd cd--fact"><h3>{t(lang, `cx.${k}_t`)}</h3><p>{t(lang, `cx.${k}_d`)}</p></article>
          ) : (
            <article class="cd">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[k]}></svg>
              <h3>{t(lang, `cx.${k}_t`)}</h3><p>{t(lang, `cx.${k}_d`)}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="cx__caps" data-acc>
        {CAPS.map((k, i) => (
          <div class:list={['cap', i === 0 && 'on']}>
            <button type="button" class="cap__b">
              <span class="cap__t">{t(lang, `cx.${k}_t`)}</span>
              <svg class="cap__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.8" aria-hidden="true"><path d="M5 9l7 7 7-7"></path></svg>
            </button>
            <div class="cap__w"><div><span class="cap__d">{t(lang, `cx.${k}_d`)}</span></div></div>
          </div>
        ))}
      </div>

      <div class="cx__strip" role="region" aria-label={t(lang, 'home.why')}>
        <div class="h-stack" data-rot="cx">
          {STRIP.map((k, i) => (
            <div class:list={['st', 'h-sx', i === 0 && 'on']}>
              <b>{t(lang, `cx.${k}_t`)}</b>
              <span>{t(lang, `cx.${k}_d`)}</span>
            </div>
          ))}
        </div>
        <div class="h-bars h-bars--dk" role="group" aria-label={t(lang, 'home.why')}>
          {STRIP.map((k, i) => (
            <button type="button" class:list={['h-bar', i === 0 && 'on']} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={t(lang, `cx.${k}_t`)}><span></span></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Desktop row: the arrows page by two cards and hide at the ends; the row's left edge sits on
  // the page's left line (the window's scrollbar width is measured for that).
  document.querySelectorAll<HTMLElement>('[data-cx-rail]').forEach((rail) => {
    const box = rail.parentElement!;
    const prev = box.querySelector<HTMLButtonElement>('[data-cx-prev]')!;
    const next = box.querySelector<HTMLButtonElement>('[data-cx-next]')!;
    const sbw = () => document.documentElement.style.setProperty('--sbw', `${window.innerWidth - document.documentElement.clientWidth}px`);
    const step = () => ((rail.querySelector('.cd')?.getBoundingClientRect().width ?? 300) + 16) * 2;
    const ends = () => { prev.hidden = rail.scrollLeft < 4; next.hidden = rail.scrollLeft + rail.clientWidth > rail.scrollWidth - 4; };
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    rail.addEventListener('scroll', ends, { passive: true });
    window.addEventListener('resize', () => { sbw(); ends(); });
    sbw(); ends();
  });
</script>

<style>
  /* Μαύρο, όπως το Secret Portfolio: είναι τα δύο μπλοκ που δεν πουλάνε ακίνητο
     αλλά ΙΚΑΝΟΤΗΤΑ. Το χρώμα τα δένει και τα ξεχωρίζει από τη ροή των καρτών. */
  .cx { background: var(--ink-deep); color: #fff; padding: var(--s7) 0; }
  .cx__top { display: grid; gap: var(--s6); }
  .cx__eyebrow { color: rgba(255,255,255,.5); }
  .cx__h {
    margin: var(--s2) 0 0; font-weight: 300; letter-spacing: -.02em; line-height: 1.08;
    font-size: clamp(28px, 5.4vw, 44px); max-width: 16ch;
  }
  .cx__br { display: none; }
  .cx__p {
    margin: var(--s4) 0 0; font-size: 15.5px; line-height: 1.6;
    color: rgba(255,255,255,.78); max-width: 48ch;
  }
  /* Phone: the buttons stay right under the text, as before. */
  .cx__acts { display: flex; flex-wrap: wrap; gap: var(--s3); margin: calc(-1 * var(--s3)) 0 0; }
  .cx__btn { background: #fff; color: var(--ink-deep); border-color: #fff; }
  .cx__btn--ghost { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.4); }

  .cx__caps {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1px;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.14);
  }
  .cap { background: var(--ink-deep); padding: var(--s4); min-width: 0; }
  /* Phone: every box open — the title is a label, not a control. */
  .cap__b { all: unset; display: block; pointer-events: none; }
  .cap__t { display: block; font-size: 14px; font-weight: 600; }
  .cap__chev { display: none; }
  .cap__d { display: block; margin-top: 3px; font-size: 12px; color: rgba(255,255,255,.5); line-height: 1.45; }

  .h-stack {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1px;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.14);
  }
  .h-bars { display: none; }
  .cx__rw { display: none; }
  .cx__h b { font-weight: inherit; }   /* the bold key words are a desktop look; phones keep George's heading */
  /* 🪤 ΕΙΧΕ `padding-left: 0` — το κείμενο ακουμπούσε ΠΑΝΩ στη διαχωριστική
     γραμμή αριστερά (George, 28/7: «δεν τα έχεις κεντρίσει καλά, να μην
     ακουμπάνε τέρμα αριστερά»). Ίσο padding σε όλες τις πλευρές. */
  .st { background: var(--ink-deep); padding: var(--s4); min-width: 0; }
  .st b { display: block; font-size: clamp(18px, 3.4vw, 24px); font-weight: 300; letter-spacing: -.01em; line-height: 1.15; }
  .st span { display: block; margin-top: 5px; font-size: 12px; color: rgba(255,255,255,.5); line-height: 1.45; }

  @media (min-width: 760px) and (max-width: 1023px) {
    .cx { padding: 74px 0; }
    .cx__top { grid-template-columns: 1.05fr 1fr; gap: var(--s7); align-items: start; }
    .cx__lead { grid-column: 1; grid-row: 1; }
    .cx__acts { grid-column: 1; grid-row: 2; margin: 0; }
    .cx__caps { grid-column: 2; grid-row: 1 / span 2; }
    .cx__strip { grid-column: 1 / -1; }
    .h-stack { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* ── #101 desktop ─────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .cx { padding: 44px 0 56px; }
    .cx__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 64px; row-gap: 0;
      grid-template-areas: "lead acc" "facts acc" "acts acts"; align-items: center;
    }
    .cx__lead { grid-area: lead; align-self: end; }
    .cx__strip { grid-area: facts; align-self: start; margin-top: 30px; }
    .cx__caps { grid-area: acc; }
    .cx__acts { grid-area: acts; justify-content: center; margin: 32px 0 0; }
    .cx__h { margin-top: 14px; font-size: 38px; line-height: 1.14; max-width: none; }
    .cx__br { display: inline; }
    .cx__p { margin-top: 22px; line-height: 1.65; max-width: 50ch; }

    /* the accordion (Company page component) on the dark band */
    .cx__caps { display: block; background: none; border: 0; min-height: 372px; }
    .cap { padding: 0; background: none; border-bottom: 1px solid rgba(255,255,255,.14); }
    .cap:last-child { border-bottom: 0; }
    .cap__b {
      pointer-events: auto; cursor: pointer; box-sizing: border-box; width: 100%;
      display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 0;
      color: rgba(255,255,255,.6);
    }
    .cap__b:focus-visible { outline: 2px solid var(--gold-dk); outline-offset: 2px; }
    .cap__t { font-size: 20px; font-weight: 300; letter-spacing: -.012em; line-height: 1.2; color: #fff; }
    .cap__b:hover .cap__t { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
    .cap__chev { display: block; flex: none; transition: transform .4s ease; }
    .cap.on .cap__chev { transform: rotate(180deg); }
    .cap__w {
      display: grid; grid-template-rows: 0fr; opacity: 0;
      transition: grid-template-rows .28s cubic-bezier(.4,0,.2,1), opacity .2s ease;
    }
    .cap.on .cap__w { grid-template-rows: 1fr; opacity: 1; }
    .cap__w > div { overflow: hidden; min-height: 0; }
    .cap__d { margin: 0; padding: 0 36px 16px 0; font-size: 15px; line-height: 1.6; color: rgba(255,255,255,.72); }

    /* the four facts: one at a time (stack, dashes and clock are in HomePage.astro) */
    .h-stack { background: none; border: 0; gap: 0; grid-template-columns: 1fr; justify-items: start; }
    .st { background: none; padding: 0; }
    .st b { font-size: 26px; font-weight: 300; line-height: 1.16; letter-spacing: -.016em; }
    .st span { margin-top: 8px; font-size: 14.5px; color: rgba(255,255,255,.6); line-height: 1.55; }
    .st span::first-letter { text-transform: uppercase; }
    .h-bars { display: flex; }
  }

  /* ── Sergei 03/11 (mockup «two home blocks»): light band — heading and buttons on top,
        a row of cards you page through, the paragraph under it. The accordion and the
        turning facts stay for phones only. ── */
  @media (min-width: 1024px) {
    .cx { padding: 40px 0 36px; background: var(--paper); color: var(--ink); overflow: hidden; }
    .cx .cx__top {
      grid-template-columns: minmax(0, 1fr) auto; column-gap: 48px; row-gap: 0;
      grid-template-areas: "eb eb" "p p" "h acts" "rail rail"; align-items: end;   /* Sergei 03/11: the paragraph right under the label, full width */
    }
    .cx .cx__lead { display: contents; }
    .cx .cx__eyebrow { grid-area: eb; color: var(--muted); }
    .cx .cx__h { grid-area: h; margin-top: 14px; font-size: 42px; line-height: 1.1; color: var(--ink); }
    .cx .cx__h b { font-weight: 600; }
    .cx .cx__p { grid-area: p; margin: 10px 0 0; max-width: none; font-size: 16px; line-height: 1.65; color: var(--ink-2); }
    .cx .cx__acts { grid-area: acts; justify-content: flex-end; margin: 0; }
    .cx .cx__btn { background: var(--ink); color: #fff; border: 1px solid var(--ink); }
    .cx .cx__btn:hover { background: var(--ink-hover); border-color: var(--ink-hover); }
    .cx .cx__btn--ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
    .cx .cx__btn--ghost:hover { background: var(--ink); color: #fff; }
    .cx .cx__caps, .cx .cx__strip { display: none; }

    /* the row bleeds to the window's right edge and starts on the page's left line */
    .cx__rw { --off: max(var(--gut), calc((100vw - var(--sbw, 0px) - var(--max)) / 2 + var(--gut)));
              display: block; grid-area: rail; position: relative; margin: 22px 0 0 calc(-1 * var(--off)); width: calc(100vw - var(--sbw, 0px)); }
    .cx__rail { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
                padding: 4px var(--off) 18px; scroll-padding-inline: var(--off); }
    .cx__rail::-webkit-scrollbar { display: none; }
    .cd { flex: none; width: 300px; min-height: 250px; scroll-snap-align: start;
          background: var(--paper-2); padding: 22px 24px; display: flex; flex-direction: column; gap: 14px;
          transition: transform .35s cubic-bezier(.4,0,.2,1), box-shadow .35s ease; }
    .cd:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(10,14,16,.10); }
    .cd svg { width: 34px; height: 34px; color: var(--ink); flex: none; }
    .cd h3 { margin: 6px 0 0; font-size: 21px; font-weight: 600; letter-spacing: -.01em; line-height: 1.2; }
    .cd p { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--ink-2); }
    .cd p::first-letter { text-transform: uppercase; }
    .cd--fact { background: var(--ink-deep); color: #fff; justify-content: flex-end; }
    .cd--fact h3 { font-size: 26px; font-weight: 300; }
    .cd--fact p { color: rgba(255,255,255,.72); }
    .cx__arw { all: unset; box-sizing: border-box; position: absolute; z-index: 3; top: calc(50% - 7px); transform: translateY(-50%);
               width: 48px; height: 48px; display: grid; place-items: center; cursor: pointer; color: var(--ink); font-size: 22px;
               background: rgba(255,255,255,.92); border: 1px solid var(--line); box-shadow: 0 8px 24px rgba(10,14,16,.14);
               transition: border-color .2s ease; }
    .cx__arw[hidden] { display: none; }
    .cx__arw--l { left: 24px; }
    .cx__arw--r { right: 24px; }
    .cx__arw:hover { border-color: var(--ink); }
    .cx__arw:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) { .cd { transition: none; } }
</style>
