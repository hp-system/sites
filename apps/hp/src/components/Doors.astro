---
// ΜΠΛΟΚ 9 — Τρεις πόρτες.
//
// Αντικαθιστούν τα έξι banner του σημερινού site. Τρία προβλήματα είχαν:
// όλα φωτογραφίες αρχείου, έξι ισοδύναμες προτροπές ακυρώνονταν μεταξύ τους,
// και το έκτο έβγαζε τον επισκέπτη ΕΚΤΟΣ site (villanatalia.eu).
// Τρεις πόρτες, γιατί τρεις είναι και οι πραγματικοί επισκέπτες.
//
// 🔴 28/7 — ΚΑΝΕΝΑΣ ΑΡΙΘΜΟΣ (George): «δεν θέλω να γράφουμε νούμερα, πόσα
// properties έχουμε, γιατί είναι πολύ δεσμευτικό». Έφυγαν τα {n}/{min}/{max}
// από την πόρτα του αγοραστή — μαζί τους και τα props που τα τροφοδοτούσαν.
//
// Και η πόρτα του ΠΩΛΗΤΗ ξαναγράφηκε από την αρχή: απαριθμούσε τι κάνουμε ΕΜΕΙΣ
// (φωτογράφιση, drone, κείμενα ×5, ΠΕΑ, «χωρίς προκαταβολή») — «δεν είναι ωραίο
// motivation αυτό για έναν owner». Τώρα μιλά για ΑΓΟΡΑΣΤΕΣ: ότι ο κατάλληλος
// μπορεί να είναι ήδη στο πελατολόγιό μας. Οι υπηρεσίες ζουν πίσω από το CTA.
import { t, listUrl, prefix, type Lang } from '../lib/i18n';
import { contentUrl } from '../lib/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = prefix(lang);
// Data, not markup (#101): the three doors in one loop, same links and words as before.
const DOORS = [
  { k: 'buy', href: listUrl(lang) },
  { k: 'sell', href: contentUrl('sell', lang) },
  { k: 'partner', href: contentUrl('partners', lang) },
];
---
<section class="section doors-sec" aria-label={t(lang, 'doors.eyebrow')}>
  <div class="wrap">
    {/* #101 desktop (George 2026-11-02): on the beige band; the door under the pointer
        grows and turns dark, the first one is open at rest. The whole door is a
        click target, but the LINK stays the CTA words (stretched link) — the anchor
        text search engines read does not change. */}
    {/* Sergei 2026-11-27: on a desktop the label stands upright left of the doors and travels from their top to their
        bottom while the band crosses the screen (the script below); phones keep it hidden as before */}
    <div class="doors-w" data-doors-w>
    <p class="t-label doors__lbl" aria-hidden="true" data-doors-lbl>{t(lang, 'doors.eyebrow')}</p>
    <div class="doors" data-doors>
      {DOORS.map((d, i) => (
        <div class:list={['door', i === 0 && 'on']}>
          <div>
            <p data-h class="t-h2 door__h">{t(lang, `doors.${d.k}`)}</p>
            <p>{t(lang, `doors.${d.k}.p`)}</p>
          </div>
          <span class="dl">
            <a class="shead__link door__a" href={d.href}>{t(lang, `doors.${d.k}.cta`)}</a>
            <span class="ar" aria-hidden="true">→</span>
          </span>
        </div>
      ))}
    </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-doors-w]').forEach((w) => {
    const lbl = w.querySelector<HTMLElement>('[data-doors-lbl]');
    if (!lbl) return;
    const desk = matchMedia('(min-width: 1024px)'), still = matchMedia('(prefers-reduced-motion: reduce)');
    let q = false;
    const move = () => {
      q = false;
      if (!desk.matches || still.matches) { lbl.style.transform = ''; return; }
      const r = w.getBoundingClientRect(), vh = window.innerHeight;
      // 0 when the doors' top enters at the bottom of the screen, 1 when their bottom leaves at the top
      const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
      const room = Math.max(0, (w.querySelector<HTMLElement>('[data-doors]')?.offsetHeight ?? w.clientHeight) - lbl.offsetHeight);
      lbl.style.transform = `translateY(${(p * room).toFixed(1)}px)`;
    };
    const on = () => { if (!q) { q = true; requestAnimationFrame(move); } };
    window.addEventListener('scroll', on, { passive: true });
    window.addEventListener('resize', on);
    move();
  });
</script>

<style>
  .doors { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .door { background: var(--paper); padding: var(--s5) var(--s4); }
  .door__h { font-size: var(--fs-s2); }
  .door p:not([data-h]) { margin: var(--s2) 0 var(--s4); color: var(--muted); font-size: var(--fs-s0); }
  .doors__lbl, .ar { display: none; }
  @media (min-width: 760px) {
    .doors { grid-template-columns: repeat(3, 1fr); }
    .door { padding: var(--s6) var(--s5); }
  }

  /* ── #101 desktop ─────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    /* Sergei 03/11 (mockup «two home blocks»): black band, beige doors, the chosen one white */
    /* Sergei 2026-11-27: the band white; the door under the pointer turns dark (the old white-on-black, inverted) */
    .doors-sec { background: var(--paper); padding: 80px 0; }   /* more air, as Collections / by area (Sergei 2026-11-24, was 36 / 40 px) */
    /* the label left of the doors, travelling from their top to their bottom with the scroll (script): in its own narrow
       column, or in the page margin when the screen is wide enough for it (Sergei 2026-11-27: horizontal) */
    .doors-w { display: grid; grid-template-columns: 112px minmax(0, 1fr); column-gap: 24px; align-items: start; }
    .doors__lbl { display: block; margin: 0; color: var(--faint); white-space: nowrap; will-change: transform; }
    @media (min-width: 1520px) {
      .doors-w { display: block; position: relative; }
      .doors__lbl { position: absolute; top: 0; right: calc(100% + 32px); }
    }
    .doors { display: flex; gap: 12px; background: none; border: 0; }
    .door {
      position: relative; flex: 1 1 0; min-width: 0; min-height: 250px;
      display: flex; flex-direction: column; justify-content: space-between; gap: 20px;
      padding: 24px 30px 26px; background: var(--paper); border: 1px solid var(--paper-3); color: var(--ink); overflow: hidden;   /* white, a beige outline (Sergei 2026-11-27) */
      transition: background-color .25s ease, border-color .25s ease, color .25s ease;
    }
    .door p:not([data-h]) { transition: color .25s ease; }
    /* #338 (George via Sergei 2026-11-23: no opening-door animation): the doors keep their width and heading size; the hovered one only changes colour. */
    .door.on { background: var(--ink-deep); border-color: var(--ink-deep); color: #fff; }
    .door.on p:not([data-h]) { color: rgba(255,255,255,.82); }
    .door__h { font-size: var(--fs-s1); line-height: 1.15; }
    .door p:not([data-h]) { margin: 12px 0 0; font-size: var(--fs-s0); line-height: 1.6; color: var(--ink-2); max-width: 40ch; }
    .dl {
      display: flex; justify-content: space-between; align-items: center;
      font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap;
    }
    .door__a { margin: 0; padding: 0; min-height: 0; border: 0; color: inherit; }
    .door__a::after { content: ''; position: absolute; inset: 0; }
    .door__a:focus-visible { outline: 0; }
    .door:has(.door__a:focus-visible) { outline: 2px solid var(--ink); outline-offset: 2px; }
    .ar { display: inline; font-size: var(--fs-s0); letter-spacing: 0; transition: transform .3s ease; }
    /* Sergei 2026-11-24: the CTA words and the arrow show only on the door under the pointer (the white one) */
    .dl { opacity: 0; transition: opacity .2s ease; }
    .door.on .dl, .door:has(.door__a:focus-visible) .dl { opacity: 1; }
    .door.on .ar { transform: translateX(6px); }
    :global([dir='rtl']) .ar { transform: scaleX(-1); }
    :global([dir='rtl']) .door.on .ar { transform: translateX(-6px) scaleX(-1); }
  }
</style>
