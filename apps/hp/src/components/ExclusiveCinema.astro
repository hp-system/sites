---
// Exclusive top (Sergei 2026-11-16, «давай попробуем Медленное кино»): instead of one landscape, the covers of the
// dearest open properties cross-fade slowly while the camera drifts in (Ken Burns), as a luxury hotel's front page.
// Desktop only, as the photo it replaces (phones never download it). Watermarked files (rule 4), open photos only.
// Every frame loads from the script, on a desktop only (phones never download them); each one a turn ahead. Still with reduced motion.
import { marked, type Photo } from '../lib/photos';
interface Props { shots: { photo: Photo; alt: string }[] }
const { shots } = Astro.props;
---
{shots.length > 0 && (
  <div class="cin" data-cin aria-hidden="true">
    {shots.map((s, i) => (
      <img class:list={['cin__f', i === 0 && 'on']} data-src={marked(s.photo.url, 1920)} alt={s.alt} width="1920" height="1280"
           decoding="async" />
    ))}
  </div>
)}

<script>
  // One frame every 7 s: the next one is loaded a turn ahead, then fades in over 2.4 s while it drifts.
  document.querySelectorAll<HTMLElement>('[data-cin]').forEach((box) => {
    const frames = Array.from(box.querySelectorAll<HTMLImageElement>('.cin__f'));
    if (!matchMedia('(min-width: 1024px)').matches) return;
    const load = (f?: HTMLImageElement) => { if (f?.dataset.src) { f.src = f.dataset.src; delete f.dataset.src; } };
    load(frames[0]);
    if (frames.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let k = 0;
    load(frames[1]);
    window.setInterval(() => {
      if (document.hidden) return;
      const next = (k + 1) % frames.length;
      frames[next].classList.add('on');
      frames[k].classList.remove('on');
      k = next;
      load(frames[(k + 1) % frames.length]);
    }, 7000);
  });
</script>

<style>
  .cin { position: relative; overflow: hidden; aspect-ratio: 4 / 3; background: var(--ink-deep); }
  .cin__f { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
            opacity: 0; transform: scale(1.0); transition: opacity 2.4s ease-in-out; }
  .cin__f.on { opacity: 1; animation: cin-drift 9.4s linear forwards; }
  @keyframes cin-drift { from { transform: scale(1.0) translate3d(0, 0, 0); } to { transform: scale(1.08) translate3d(-1.2%, -.8%, 0); } }
  @media (prefers-reduced-motion: reduce) { .cin__f.on { animation: none; } }
</style>
