---
// Exclusive (P52): what the club gives and how to join, right under the top — as George's old /en/vip showed it
// («What to expect» · «How it works» · «Your time is the most valuable thing»). Sergei 2026-11-16: «нам нужно
// написать на странице ексклюзив тоже чтото что б юзеры понимали что ето за страница».
// The words come from the approved P52 brief (sites#301) and George's VIP page; Sergei approves the English,
// Greek and Russian are faithful translations (D-20261112-SS-1). Labels are not headings: the H2 outline stays
// the brief's (spec rule 9), the full texts stay in the sections below.
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; cta?: { href: string; text: string } | null }
const { lang, cta } = Astro.props;

type T = { give: string; how: string; time: string; items: [string, string][]; steps: string[] };
const TX: Partial<Record<Lang, T>> = {
  en: {
    give: 'What Exclusive gives you', how: 'How to join', time: 'Your time is the most valuable thing, and we respect that.',
    items: [
      ['The Secret Portfolio', 'Homes whose owners never advertise them, shown only to members.'],
      ['Early access', 'New properties and price drops reach you before the market, with a notification on your phone.'],
      ['Your own agent', 'One agent who knows what you look for, answers you first and takes you to the contract.'],
      ['Discretion', 'Your details and requests are stored encrypted. No other agent or company can see them.'],
    ],
    steps: ['Create a member account', 'Press «Join Exclusive» in your account', 'Our team reviews your request', 'We open your access and introduce your agent'],
  },
  el: {
    give: 'Τι σας δίνει το Exclusive', how: 'Πώς γίνεστε μέλος', time: 'Ο χρόνος σας είναι το πιο πολύτιμο πράγμα και τον σεβόμαστε.',
    items: [
      ['Το Secret Portfolio', 'Κατοικίες που οι ιδιοκτήτες τους δεν διαφημίζουν ποτέ, μόνο για τα μέλη.'],
      ['Πρώτη πρόσβαση', 'Τα νέα ακίνητα και οι μειώσεις τιμών φτάνουν σε εσάς πριν από την αγορά, με ειδοποίηση στο κινητό σας.'],
      ['Ο δικός σας σύμβουλος', 'Ένας σύμβουλος που γνωρίζει τι αναζητάτε, σας απαντά πρώτα και σας συνοδεύει μέχρι το συμβόλαιο.'],
      ['Διακριτικότητα', 'Τα στοιχεία και τα αιτήματά σας αποθηκεύονται κρυπτογραφημένα. Κανένας άλλος μεσίτης ή εταιρεία δεν τα βλέπει.'],
    ],
    steps: ['Δημιουργήστε λογαριασμό μέλους', 'Πατήστε «Γίνετε μέλος του Exclusive» στον λογαριασμό σας', 'Η ομάδα μας εξετάζει το αίτημά σας', 'Ανοίγουμε την πρόσβασή σας και σας γνωρίζουμε τον σύμβουλό σας'],
  },
  ru: {
    give: 'Что даёт Exclusive', how: 'Как вступить', time: 'Ваше время — самое ценное, и мы это уважаем.',
    items: [
      ['Secret Portfolio', 'Дома, которые владельцы никогда не рекламируют, — только для участников.'],
      ['Ранний доступ', 'Новые объекты и снижения цен приходят к вам раньше, чем на рынок, с уведомлением на телефон.'],
      ['Ваш личный агент', 'Один агент, который знает, что вы ищете, отвечает вам в первую очередь и ведёт до договора.'],
      ['Конфиденциальность', 'Ваши данные и запросы хранятся в зашифрованном виде. Ни один другой агент или компания их не видит.'],
    ],
    steps: ['Создайте личный кабинет участника', 'Нажмите «Вступить в Exclusive» в личном кабинете', 'Наша команда рассматривает заявку', 'Мы открываем доступ и знакомим вас с вашим агентом'],
  },
};
const tx = TX[lang] ?? TX.en!;
// line icons: a hidden folder, a bell, a person, a lock
const ICONS = [
  'M3 7h6l2 2h10v10H3zM3 7V5h6l2 2',
  'M6 16v-5a6 6 0 0 1 12 0v5l2 2H4l2-2ZM10 21h4',
  'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 21a8 8 0 0 1 16 0',
  'M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4',
];
---
<section class="xi" aria-label={tx.give}>
  <div class="wrap">
    <p class="xi__lbl">{tx.give}</p>
    <ul class="xi__give">
      {tx.items.map(([h, s], i) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONS[i]} /></svg>
          <b>{h}</b>
          <span>{s}</span>
        </li>
      ))}
    </ul>
    <div class="xi__row">
      <div class="xi__how">
        <p class="xi__lbl">{tx.how}</p>
        <ol>{tx.steps.map((s) => <li>{s}</li>)}</ol>
      </div>
      <div class="xi__time">
        <p>{tx.time}</p>
        {cta && <a class="k-act k-gild k-gild--dk" href={cta.href} data-ev="register:info">{cta.text}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .xi { background: var(--paper-2); padding-block: var(--s7); }
  .xi__lbl { margin: 0 0 var(--s4); font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .xi__give { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); grid-template-columns: minmax(0, 1fr); }
  .xi__give li { background: var(--paper); padding: var(--s5); display: grid; gap: var(--s2); align-content: start; }
  .xi__give svg { width: 32px; height: 32px; color: var(--gold); margin-bottom: var(--s2); }
  .xi__give b { font-size: var(--fs-s1); font-weight: 300; line-height: 1.2; letter-spacing: -.012em; }
  .xi__give span { font-size: var(--fs-s0); line-height: 1.55; color: var(--ink-2); }
  .xi__row { display: grid; gap: var(--s5); margin-top: var(--s6); }
  .xi__how ol { margin: 0; padding: 0; list-style: none; counter-reset: st; display: grid; gap: var(--s3); }
  .xi__how li { counter-increment: st; display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: var(--s3); align-items: baseline; font-size: var(--fs-s0); }
  .xi__how li::before { content: counter(st); font-size: var(--fs-s1); font-weight: 300; color: var(--gold); }
  .xi__time { background: var(--ink); color: var(--paper); padding: var(--s5); display: grid; gap: var(--s4); align-content: center; }
  .xi__time p { margin: 0; font-size: var(--fs-s1); font-weight: 300; line-height: 1.3; }
  .xi__time .k-act { justify-self: start; padding: 0 28px; }
  @media (min-width: 760px) {
    .xi__give { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .xi__give { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
    .xi__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
    .xi__time { padding: var(--s6); }
  }
</style>
