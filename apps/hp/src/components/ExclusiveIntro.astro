---
// Exclusive (P52): what the club gives and how to join, right under the top — as George's old /en/vip showed it
// («What to expect» · «How it works» · «Your time is the most valuable thing»). Sergei 2026-11-16: «нам нужно
// написать на странице ексклюзив тоже чтото что б юзеры понимали что ето за страница», then «етот блок сделай
// также как на главной» — the home Construction bento (Construction.astro): on a desktop a full-width beige window
// onto a bento fixed to the screen. Only the four white tiles go in it («только ети части остаються в етой 3д
// области, все остальное верни обратно»); the steps and the dark closing line stay under it as before.
// Phones: the tiles one under the other.
// The words come from the approved P52 brief (sites#301) and George's VIP page; Sergei approves the English,
// Greek and Russian are faithful translations (D-20261112-SS-1). No headings: the H2 outline stays the brief's
// (spec rule 9), the full texts stay in the sections below.
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; cta?: { href: string; text: string } | null }
const { lang, cta } = Astro.props;

type T = { give: string; how: string; time: string; items: [string, string][]; steps: string[] };
const TX: Partial<Record<Lang, T>> = {
  en: {
    give: 'What Exclusive gives you',
    how: 'How to join',
    time: 'Your time is the most valuable thing, and we respect that.',
    items: [
      ['The Secret Portfolio', 'Homes whose owners never advertise them, shown only to members.'],
      ['Early access', 'New properties and price drops reach you before the market, with a notification on your phone.'],
      ['Your own agent', 'One agent who knows what you look for, answers you first and takes you to the contract.'],
      ['Discretion', 'Your details and requests are stored encrypted. No other agent or company can see them.'],
    ],
    steps: ['Create a member account', 'Send your Exclusive request from your account', 'Our team reviews it and opens your access'],
  },
  el: {
    give: 'Τι σας δίνει το Exclusive',
    how: 'Πώς γίνεστε μέλος',
    time: 'Ο χρόνος σας είναι το πιο πολύτιμο πράγμα και τον σεβόμαστε.',
    items: [
      ['Το Secret Portfolio', 'Κατοικίες που οι ιδιοκτήτες τους δεν διαφημίζουν ποτέ, μόνο για τα μέλη.'],
      ['Πρώτη πρόσβαση', 'Τα νέα ακίνητα και οι μειώσεις τιμών φτάνουν σε εσάς πριν από την αγορά, με ειδοποίηση στο κινητό σας.'],
      ['Ο δικός σας σύμβουλος', 'Ένας σύμβουλος που γνωρίζει τι αναζητάτε, σας απαντά πρώτα και σας συνοδεύει μέχρι το συμβόλαιο.'],
      ['Διακριτικότητα', 'Τα στοιχεία και τα αιτήματά σας αποθηκεύονται κρυπτογραφημένα. Κανένας άλλος μεσίτης ή εταιρεία δεν τα βλέπει.'],
    ],
    steps: ['Δημιουργήστε λογαριασμό μέλους', 'Στείλτε το αίτημά σας για το Exclusive από τον λογαριασμό σας', 'Η ομάδα μας το εξετάζει και ανοίγει την πρόσβασή σας'],
  },
  ru: {
    give: 'Что даёт Exclusive',
    how: 'Как вступить',
    time: 'Ваше время — самое ценное, и мы это уважаем.',
    items: [
      ['Secret Portfolio', 'Дома, которые владельцы никогда не рекламируют, — только для участников.'],
      ['Ранний доступ', 'Новые объекты и снижения цен приходят к вам раньше, чем на рынок, с уведомлением на телефон.'],
      ['Ваш личный агент', 'Один агент, который знает, что вы ищете, отвечает вам в первую очередь и ведёт до договора.'],
      ['Конфиденциальность', 'Ваши данные и запросы хранятся в зашифрованном виде. Ни один другой агент или компания их не видит.'],
    ],
    steps: ['Создайте личный кабинет участника', 'Отправьте заявку в Exclusive из личного кабинета', 'Наша команда рассматривает её и открывает доступ'],
  },
};
const tx = TX[lang] ?? TX.en!;
---
<section class="xi" aria-label={tx.give}>
  {/* #374 (George via Sergei 2026-11-27: «less loud» — the site is calm and assured, it does not shout): no window, no
      white tiles, no icons, no big titles. The four points as a quiet list on the page's ground: a small label, a hairline
      between rows, the name at text size and the line under it in muted ink; two columns on a desktop. */}
  <div class="wrap xi__gv">
    <p class="xi__lbl">{tx.give}</p>
    <ul class="xi__list">
      {tx.items.map(([h, s]) => <li><b>{h}</b><span>{s}</span></li>)}
    </ul>
  </div>
  {/* Sergei 2026-11-16: one black box for the steps and the closing line, drifting down its white band on scroll as
      the property page About / Prices cards do (PropertyPage.astro drift()) */}
  <div class="wrap xi__row" data-xi-band>
    <div class="xi__box" data-xi-box>
    {/* as the home Secret Portfolio band (OffMarket.astro): a big faint lock that drifts down the box on scroll */}
    <svg class="xi__lock" data-xi-lock viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4.5" y="10.5" width="15" height="11"></rect><path d="M7.5 10.5V7a4.5 4.5 0 0 1 9 0v3.5"></path>
      <circle cx="12" cy="15.4" r="1.3"></circle><path d="M12 16.7v2.1"></path>
    </svg>
    <div class="xi__how">
      <p class="xi__lbl">{tx.how}</p>
      <ol>{tx.steps.map((s) => <li>{s}</li>)}</ol>
    </div>
    <div class="xi__time">
      <p>{tx.time}</p>
      {cta && (
        <a class="btn k-gild k-gild--dk xi__join" href={cta.href} data-ev="register:info">
          {/* the lock as on the home page's Secret Portfolio button (OffMarket.astro), Sergei 2026-11-27 (#374) */}
          <svg class="xi__jl" width="14" height="18" viewBox="0 0 24 30" aria-hidden="true">
            <path d="M6 13V8.5a6 6 0 0 1 12 0V13" fill="none" stroke="currentColor" stroke-width="2" />
            <rect x="2.5" y="13" width="19" height="15" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="12" cy="19.5" r="1.8" fill="currentColor" />
          </svg>
          {cta.text}
        </a>
      )}
    </div>
    </div>
  </div>
</section>

<script>
  // The black box drifts from the top of its white band to the bottom while the band crosses the screen, and the
  // faint lock down the box (the same formula as the property page About / Prices cards); desktop only, none with
  // reduced motion. Kept with the band sliding over the bento (Sergei 2026-11-19 «почему потерял анимацию?»).
  document.querySelectorAll<HTMLElement>('[data-xi-band]').forEach((band) => {
    const box = band.querySelector<HTMLElement>('[data-xi-box]');
    if (!box) return;
    const lock = box.querySelector<SVGElement>('[data-xi-lock]');
    const desk = matchMedia('(min-width: 1024px)'), still = matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;
    const drift = () => {
      ticking = false;
      if (!desk.matches || still.matches) { box.style.transform = ''; if (lock) lock.style.transform = ''; return; }
      const vh = window.innerHeight, rect = band.getBoundingClientRect();
      const room = Math.max(0, band.clientHeight - box.offsetHeight);
      const p = Math.min(1, Math.max(0, (vh - rect.height - rect.top) / Math.max(1, vh - rect.height - 96)));
      box.style.transform = `translateY(${(p * room).toFixed(1)}px)`;
      if (lock) lock.style.transform = `translateY(${(p * Math.max(0, box.clientHeight - 100)).toFixed(1)}px)`;
    };
    const on = () => { if (!ticking) { ticking = true; requestAnimationFrame(drift); } };
    window.addEventListener('scroll', on, { passive: true });
    window.addEventListener('resize', on);
    drift();
  });
</script>

<style>
  /* phones and tablets: the four tiles one under the other (two columns from 760), then the steps and the closing line */
  .xi { background: var(--paper); padding-block: var(--s7); }   /* white under «How to join» (Sergei 2026-11-16) */
  .xi__lbl { margin: 0 0 var(--s4); font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .xi__lbl.xi__lbl { margin: 0 0 var(--s2); }
  .xi__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .xi__list li { display: grid; gap: var(--s1); padding-block: var(--s4); min-width: 0; }
  .xi__list li + li { border-top: 1px solid var(--line); }
  .xi__list b { font-size: var(--fs-s0); font-weight: 600; line-height: 1.4; color: var(--ink); }
  .xi__list span { font-size: var(--fs-s0); line-height: 1.55; color: var(--muted); max-width: 52ch; }
  .xi__row { margin-top: var(--s7); }   /* the same space above and below (Sergei 2026-11-16) */
  .xi__box { position: relative; overflow: hidden; background: var(--ink-deep); color: #fff; padding: var(--s5); display: grid; gap: var(--s5); will-change: transform; }
  .xi__box > :not(.xi__lock) { position: relative; z-index: 1; }
  .xi__box .xi__lbl { color: rgba(255,255,255,.62); letter-spacing: .22em; }
  .xi__lock { display: none; }
  .xi__how ol { margin: 0; padding: 0; list-style: none; counter-reset: st; display: grid; gap: var(--s3); }
  .xi__how li { counter-increment: st; display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: var(--s3); align-items: baseline; font-size: var(--fs-s0); color: rgba(255,255,255,.88); }
  .xi__how li::before { content: counter(st); font-size: var(--fs-s1); font-weight: 300; color: var(--gold-dk-text); }
  .xi__time { display: grid; gap: var(--s4); align-content: center; }
  .xi__time p { margin: 0; font-size: var(--fs-s1); font-weight: 300; line-height: 1.3; letter-spacing: -.016em; }
  /* the home band's button: .btn with the gilded edge on the dark ground */
  .xi__time .btn { justify-self: start; }
  .xi__join { display: inline-flex; align-items: center; gap: 10px; }
  .xi__jl { flex: none; width: 14px; height: 18px; margin-top: -3px; }
  /* the gilded edge turns when the pointer is anywhere over this band, not only over the button (Sergei 2026-11-16) */
  .xi__row:hover .k-gild { opacity: 1; color: var(--gold-dk-hover); --gilda: 675deg; }
  @media (prefers-reduced-motion: reduce) { .xi__row:hover .k-gild { --gilda: 315deg; } }

  /* desktop: only the four tiles in the home bento window (Sergei 2026-11-16) — a full-width beige window onto a
     2 × 2 bento fixed to the screen (Construction.astro technique); the steps and the closing line under it */
  @media (min-width: 1024px) {
    .xi { padding-block: var(--s8) 0; }
    /* two columns, rows level across them; hairlines between rows only (as the SEO block below) */
    .xi__list { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 80px; }
    .xi__list li { padding-block: 20px; }
    .xi__list li + li { border-top: 0; }
    .xi__list li:nth-child(n+3) { border-top: 1px solid var(--line); }
    .xi__row { margin-top: var(--s7); min-height: 340px; }   /* the white band is taller than the box: the box has room to drift */
    .xi__box { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; padding: 44px 48px; align-items: center; }
    .xi__time p { font-size: var(--fs-s3); line-height: 1.14; text-wrap: balance; }
    .xi__lock { display: block; position: absolute; left: calc(50% - 50px); top: 0; width: 100px; height: 100px;
                color: #fff; opacity: .07; pointer-events: none; z-index: 0; will-change: transform; }
  }
</style>
