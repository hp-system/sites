---
// Exclusive (P52): what the club gives and how to join, right under the top — as George's old /en/vip showed it
// («What to expect» · «How it works» · «Your time is the most valuable thing»). Sergei 2026-11-16: «нам нужно
// написать на странице ексклюзив тоже чтото что б юзеры понимали что ето за страница», then «етот блок сделай
// также как на главной» — the home Construction bento (Construction.astro): on a desktop a full-width beige window
// onto a bento fixed to the screen, white tiles with icons (what members get) and black tiles with large lines
// (who it is for · how to join · the closing line with the call). Phones: the same tiles one under the other.
// The words come from the approved P52 brief (sites#301) and George's VIP page; Sergei approves the English,
// Greek and Russian are faithful translations (D-20261112-SS-1). No headings: the H2 outline stays the brief's
// (spec rule 9), the full texts stay in the sections below.
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; cta?: { href: string; text: string } | null }
const { lang, cta } = Astro.props;

type T = { give: string; who: [string, string]; how: string; time: [string, string]; items: [string, string][]; steps: string[] };
const TX: Partial<Record<Lang, T>> = {
  en: {
    give: 'What Exclusive gives you',
    who: ['From €1 million', 'Seafront villas, estates, large plots by the sea and special properties.'],
    how: 'How to join',
    time: ['Your time is the most valuable thing', 'and we respect that.'],
    items: [
      ['The Secret Portfolio', 'Homes whose owners never advertise them, shown only to members.'],
      ['Early access', 'New properties and price drops reach you before the market, with a notification on your phone.'],
      ['Your own agent', 'One agent who knows what you look for, answers you first and takes you to the contract.'],
      ['Discretion', 'Your details and requests are stored encrypted. No other agent or company can see them.'],
    ],
    steps: ['Create a member account', 'Press «Join Exclusive» in your account', 'Our team reviews your request', 'We open your access and introduce your agent'],
  },
  el: {
    give: 'Τι σας δίνει το Exclusive',
    who: ['Από 1 εκατ. €', 'Παραθαλάσσιες βίλες, κτήματα, μεγάλα οικόπεδα δίπλα στη θάλασσα και ξεχωριστά ακίνητα.'],
    how: 'Πώς γίνεστε μέλος',
    time: ['Ο χρόνος σας είναι το πιο πολύτιμο πράγμα', 'και τον σεβόμαστε.'],
    items: [
      ['Το Secret Portfolio', 'Κατοικίες που οι ιδιοκτήτες τους δεν διαφημίζουν ποτέ, μόνο για τα μέλη.'],
      ['Πρώτη πρόσβαση', 'Τα νέα ακίνητα και οι μειώσεις τιμών φτάνουν σε εσάς πριν από την αγορά, με ειδοποίηση στο κινητό σας.'],
      ['Ο δικός σας σύμβουλος', 'Ένας σύμβουλος που γνωρίζει τι αναζητάτε, σας απαντά πρώτα και σας συνοδεύει μέχρι το συμβόλαιο.'],
      ['Διακριτικότητα', 'Τα στοιχεία και τα αιτήματά σας αποθηκεύονται κρυπτογραφημένα. Κανένας άλλος μεσίτης ή εταιρεία δεν τα βλέπει.'],
    ],
    steps: ['Δημιουργήστε λογαριασμό μέλους', 'Πατήστε «Γίνετε μέλος του Exclusive» στον λογαριασμό σας', 'Η ομάδα μας εξετάζει το αίτημά σας', 'Ανοίγουμε την πρόσβασή σας και σας γνωρίζουμε τον σύμβουλό σας'],
  },
  ru: {
    give: 'Что даёт Exclusive',
    who: ['От 1 млн €', 'Виллы на первой линии, поместья, большие участки у моря и особые объекты.'],
    how: 'Как вступить',
    time: ['Ваше время — самое ценное', 'и мы это уважаем.'],
    items: [
      ['Secret Portfolio', 'Дома, которые владельцы никогда не рекламируют, — только для участников.'],
      ['Ранний доступ', 'Новые объекты и снижения цен приходят к вам раньше, чем на рынок, с уведомлением на телефон.'],
      ['Ваш личный агент', 'Один агент, который знает, что вы ищете, отвечает вам в первую очередь и ведёт до договора.'],
      ['Конфиденциальность', 'Ваши данные и запросы хранятся в зашифрованном виде. Ни один другой агент или компания их не видит.'],
    ],
    steps: ['Создайте личный кабинет участника', 'Нажмите «Вступить в Exclusive» в личном кабинете', 'Наша команда рассматривает заявку', 'Мы открываем доступ и знакомим вас с вашим агентом'],
  },
};
const tx = TX[lang] ?? TX.en!;
// line icons as on the home bento: a hidden folder, a bell, a person, a lock
const ICONS = [
  '<path d="M3 7h6l2 2h10v10H3z"/><path d="M3 7V5h6l2 2"/>',
  '<path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4l2-2Z"/><path d="M10 21h4"/>',
  '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  '<rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
];
---
<section class="xi" aria-label={tx.give}>
  <div class="wrap"><p class="xi__lbl">{tx.give}</p></div>
  <div class="xi__win" data-xi-win>
    <div class="xi__bento">
      <div class="xd xd--f xd--f1"><b>{tx.who[0]}</b><span>{tx.who[1]}</span></div>
      {tx.items.map(([h, s], i) => (
        <div class={`xd xd--c${i + 1}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[i]}></svg>
          <b>{h}</b><span>{s}</span>
        </div>
      ))}
      <div class="xd xd--f xd--f2">
        <b>{tx.how}</b>
        <ol>{tx.steps.map((s) => <li>{s}</li>)}</ol>
      </div>
      <div class="xd xd--f xd--f3">
        <b>{tx.time[0]}</b><span>{tx.time[1]}</span>
        {cta && <a class="k-act k-gild k-gild--dk xd__go" href={cta.href} data-ev="register:info">{cta.text}</a>}
      </div>
    </div>
    <div class="xi__shade" aria-hidden="true"></div>
  </div>
</section>

<script>
  // The window onto the bento, as on the home page (Construction.astro): the bento is fixed to the screen (CSS) and
  // the page scrolls the window across it; only the page's width without the scrollbar is measured here.
  document.querySelectorAll<HTMLElement>('[data-xi-win]').forEach((win) => {
    const pw = () => win.style.setProperty('--pw', `${document.documentElement.clientWidth}px`);
    window.addEventListener('resize', pw);
    pw();
  });
</script>

<style>
  /* phones and tablets: the tiles one under the other (two columns from 760) */
  .xi { background: var(--paper-2); padding-block: var(--s7); }
  .xi__lbl { margin: 0 0 var(--s4); font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .xi__bento { display: grid; gap: 12px; padding-inline: var(--gut); }
  .xi__shade { display: none; }
  .xd { min-width: 0; background: var(--paper); padding: var(--s5); display: flex; flex-direction: column; gap: var(--s2); }
  .xd svg { width: 40px; height: 40px; color: var(--ink); flex: none; margin-bottom: var(--s2); }
  .xd b { font-size: var(--fs-s0); font-weight: 600; line-height: 1.25; letter-spacing: -.01em; }
  .xd span, .xd li { font-size: var(--fs-s0); line-height: 1.5; color: var(--ink-2); }
  .xd--f { background: var(--ink-deep); color: #fff; justify-content: flex-end; }
  .xd--f b { font-size: var(--fs-s3); font-weight: 300; line-height: 1.08; letter-spacing: -.02em; }
  .xd--f span, .xd--f li { color: rgba(255,255,255,.72); }
  .xd ol { margin: var(--s2) 0 0; padding: 0; list-style: none; counter-reset: st; display: grid; gap: var(--s2); }
  .xd ol li { counter-increment: st; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: var(--s2); align-items: baseline; }
  .xd ol li::before { content: counter(st); font-size: var(--fs-s1); font-weight: 300; color: var(--gold-dk-text); }
  .xd__go { align-self: flex-start; margin-top: var(--s3); padding: 0 28px; }
  @media (min-width: 760px) and (max-width: 1023px) {
    .xi__bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .xd--f1, .xd--f2, .xd--f3 { grid-column: 1 / -1; }
  }

  /* desktop: the home bento — a full-width beige window onto tiles fixed to the screen */
  @media (min-width: 1024px) {
    .xi { background: var(--paper); padding: 40px 0 0; }
    .xi__win { --pw: 100vw; --off: max(var(--gut), calc((var(--pw) - var(--max)) / 2 + var(--gut)));
               position: relative; width: var(--pw); height: 480px; overflow: hidden; clip-path: inset(0); background: var(--paper-3); }
    .xi__bento { --tw: calc(var(--pw) - 2 * var(--off)); --th: clamp(600px, calc(var(--tw) * .6), 100vh);
                 box-sizing: border-box; padding: 0; position: fixed; left: var(--off); width: var(--tw); height: var(--th); top: calc(50vh - var(--th) / 2);
                 grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(0, 1fr));
                 grid-template-areas: "f1 f1 c1 c2" "c3 c4 f2 f2" "f3 f3 f2 f2"; }
    .xi__shade { display: block; position: absolute; inset: 0; pointer-events: none;
                 box-shadow: inset 0 22px 26px -20px rgba(14,18,20,.28), inset 0 -22px 26px -20px rgba(14,18,20,.28); }
    .xd { padding: 22px 24px; overflow: hidden; }
    .xd b { margin-top: auto; }
    .xd--f { padding: 26px 28px; }
    .xd--f1 { grid-area: f1; } .xd--f2 { grid-area: f2; } .xd--f3 { grid-area: f3; }
    .xd--c1 { grid-area: c1; } .xd--c2 { grid-area: c2; } .xd--c3 { grid-area: c3; } .xd--c4 { grid-area: c4; }
    .xd--f2 { justify-content: center; }
    .xd--f2 b { margin-top: 0; }
    .xd--f2 ol { margin-top: var(--s4); gap: var(--s3); }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .xi__win { height: auto; clip-path: none; overflow: visible; padding-block: 40px; }
    .xi__bento { position: static; height: auto; grid-template-rows: none; grid-auto-rows: 250px; margin-inline: var(--off); }
  }
</style>
