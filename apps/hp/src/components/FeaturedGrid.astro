---
// ΜΠΛΟΚ 3 — Επιλεγμένα ακίνητα. Έξι κάρτες σε πλέγμα.
// Δουλειά του: να τον πάει στη σελίδα ακινήτου — εκεί γίνεται το 95% των
// αιτημάτων (μετρήθηκε: 4.583 από 4.973 αφορούν συγκεκριμένο ακίνητο).
// ⛔ Χωρίς carousel: δεν το γυρίζει κανείς και δεν το διαβάζουν οι μηχανές.
// ↪ SUPERSEDED on desktop by the approved redesign (#101, George 2026-11-02): a row
//   of four that turns by itself. The objection above is answered: every card stays
//   in the HTML (moved, never loaded), and the row turns without anyone touching it.
import type { SiteProperty } from '../lib/api';
import { t, type Lang } from '../lib/i18n';
import PropertyCard from './PropertyCard.astro';

import type { Viewer } from '../lib/gate';
interface Props {
  items: SiteProperty[]; lang: Lang; total?: number; viewer: Viewer;
  /** A section of George's SEO spec (P01) shown as this block's head (Sergei 08/11): its H2 and text. */
  spec?: { h2: string; html: string };
}
const { items, lang, viewer, spec } = Astro.props;
const pages = Math.ceil(items.length / 4);
---
<section class="section np" aria-labelledby="featured-h">
  <div class="wrap">
    {/* #101 (George 2026-11-02): «New properties in Halkidiki» — the six newest.
        Desktop: one row of four that turns a page every 5 s (dashes top right).
        Every card is in the HTML — the row is moved, never loaded — so search
        engines see every link. Phone/tablet: the same grid as before. */}
    <div class="shead np__head">
      <div>
        <h2 id="featured-h" class="t-h2">{spec?.h2 ?? t(lang, 'home.new_h2')}</h2>
        {spec?.html && <div class="spec-sub" set:html={spec.html} />}
      </div>
      {pages > 1 && (
        <div class="h-dash" role="group" aria-label={t(lang, 'home.pages')} data-dash-for="railNp">
          {Array.from({ length: pages }).map((_, i) => (
            <button type="button" class={i === 0 ? 'on' : undefined} aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-label={t(lang, 'home.page', { n: i + 1 })} data-page={i}><span></span></button>
          ))}
        </div>
      )}
    </div>

    <div class="grid h-rail" id="railNp" data-hrail data-gap="20">
      {items.map((p, i) => <PropertyCard p={p} lang={lang} viewer={viewer} eager={i < 2} />)}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 30px; }
  @media (min-width: 760px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px 26px; }
  }
  .np__head .h-dash { display: none; }

  /* ── #101 desktop ─────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .np { padding: 40px 0; }
    .np__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin: 0 0 28px; }
    .np__head .h-dash { display: flex; }
    .grid {
      display: flex; gap: 20px;
      overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
      scrollbar-width: none; overscroll-behavior-x: contain;
    }
    .grid::-webkit-scrollbar { display: none; }
    .grid > :global(.card) { flex: none; width: calc((100% - 60px) / 4); scroll-snap-align: start; }

    /* the card, as in the mockup: lighter price, quieter rows */
    .grid :global(.row1) { align-items: center; gap: 12px; }
    .grid :global(.price) { font-size: var(--fs-s1); line-height: 1.2; }
    .grid :global(.sea) { padding: 4px 8px; letter-spacing: .12em; }
    .grid :global(.title) { margin-top: 6px; }
    .grid :global(.facts) { margin-top: 4px; }
    .grid :global(.card:hover .title a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    /* heart: white, a touch bigger and beige on hover — as Save / Share on the property page */
    .grid :global(.heart) { background: var(--paper); transition: background .2s ease; }
    .grid :global(.heart svg) { width: 16px; height: 16px; transition: transform .25s ease, color .2s ease, fill .25s ease; }
    .grid :global(.card:hover .heart svg), .grid :global(.heart:hover svg) { transform: scale(1.12); color: var(--gold-soft); }
    .grid :global(.heart:hover svg) { fill: var(--gold-soft); }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) { .grid { scroll-behavior: auto; } }
</style>
