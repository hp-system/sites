---
// ΜΠΛΟΚ 11 — Υποσέλιδο. Πλοήγηση και νομιμότητα.
// Η δομή των τριών στηλών του σημερινού site είναι σωστή — αλλάζει η μορφή.
import Logo from './Logo.astro';
import { t, listUrl, prefix, type Lang } from '../lib/i18n';
// 🏢 Τηλέφωνο, email, επωνυμία, ΓΕΜΗ και έτος έναρξης έρχονται από το CMS —
//    με τις σημερινές τιμές ως δίχτυ. Δες lib/company.ts.
import { company } from '../lib/company';
// 🔎 ΟΙ ΘΕΜΑΤΙΚΟΙ ΣΥΝΔΕΣΜΟΙ SEO ΖΟΥΝ ΕΔΩ (George, 30/7: «αν είναι για SEO,
//    τράβα και βάλ' τα στο footer»). Ήταν σειρά από κουμπάκια κάτω από τη
//    σελιδοποίηση της λίστας — «φαίνονται πάρα πολύ άσχημα». Στο υποσέλιδο
//    κερδίζουν κιόλας: είναι σε ΚΑΘΕ σελίδα, όχι μόνο στη λίστα, και δείχνουν
//    στα ΚΑΘΑΡΑ URLs των θεματικών (`/ακινητα/κασσανδρα`), όχι σε παραμέτρους
//    `?municipality=` που η μηχανή αγνοεί.
import { FACETS, facetUrl, MIN_LIVE } from '../lib/listing';
import { pageExists, contentUrl, type PageKey } from '../lib/pages';
import { brand } from '../brand/index';
import { EN_MOVED } from '../lib/infopages';
interface Props { lang: Lang; munis?: { name: string; key?: string }[] }
const { lang } = Astro.props;
const p = prefix(lang);
// English: the old site's URL /en/about-us (the info page); other languages keep /about.
const aboutHref = contentUrl('about', lang);   // #262: each language's own URL
// Same for services and projects: English links the old site's URLs (no redirect hop).
// Other languages: the translated projects slug (/εργα, /proiecte…) — linking `/projects` was a 301 hop (#69).
const moved = (k: string) => (lang === 'en' && EN_MOVED[k]) || contentUrl(k as PageKey, lang);
const co = await company();
// «Map» instead of «head office» (Sergei 2026-11-25): opens the directions to the office, as the contact page's «Get directions»
const mapUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${brand.name}, ${(brand.addressLatin ?? brand.address).street} ${brand.address.postalCode}, ${(brand.addressLatin ?? brand.address).city}`)}`;
// Δήμοι πρώτα, μετά οι συλλογές — ό,τι δείχνει και η αρχική.
// Never a page that is always noindex (MIN_LIVE Infinity: Detached houses, withdrawn 2026-11-12, D-20261112-SS-1;
// Sergei 2026-11-16 saw it in the footer).
const seoLinks = FACETS.filter((f) => MIN_LIVE[f.key] !== Infinity).map((f) => ({ href: facetUrl(lang, f.key), name: f.name[lang], muni: !!f.q.municipality }));
// Sergei 2026-11-24: shorter groups — the areas apart from the property types
const areaLinks = seoLinks.filter((x) => x.muni), typeLinks = seoLinks.filter((x) => !x.muni);

// 🛡️ ΔΙΧΤΥ: ΔΕΝ ΔΕΙΧΝΟΥΜΕ ΣΥΝΔΕΣΜΟ ΓΙΑ ΣΕΛΙΔΑ ΠΟΥ ΔΕΝ ΥΠΑΡΧΕΙ.
//    Έτσι γεννήθηκαν οι 124 νεκροί σύνδεσμοι: τα μενού γράφτηκαν πριν τις σελίδες και
//    κανείς δεν ξαναπέρασε. Τώρα η ύπαρξη κρίνεται από το `lib/pages.ts` — αν λείπει
//    το κείμενο, λείπει και ο σύνδεσμος. Δεν μπορεί να ξανασυμβεί σιωπηλά.
const has = (k: string) => pageExists(k as any);
import { consentText } from '../lib/consent';
---
<footer class="site-footer">
  <div class="wrap">
    <div class="fcols">
      <div class="fbrand">
        {/* ΤΟ ΠΡΑΓΜΑΤΙΚΟ ΣΗΜΑ. Εδώ ήταν ζωγραφισμένο ένα γενικό σπιτάκι με στέγη —
            διαφορετικό λογότυπο από την κεφαλίδα, στην ΙΔΙΑ σελίδα. */}
        <a class="brand" href={p || '/'} aria-label={brand.name}>
          <Logo variant="mono" size="md" />
        </a>
        {/* Τρεις γραμμές, μία πληροφορία η καθεμία (George, 28/7). Πριν, η
            διεύθυνση και το τηλέφωνο μοιράζονταν γραμμή χωρισμένα με τελεία και
            έσπαγαν σε τυχαίο σημείο ανάλογα με το πλάτος. */}
        <p class="fbrand__addr">
          <span class="fbrand__hq">{t(lang, 'foot.addr')} <i>·</i> <a class="fmap" href={mapUrl} target="_blank" rel="noopener" data-ev="map:footer">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14.5s4.5-4.3 4.5-8a4.5 4.5 0 0 0-9 0c0 3.7 4.5 8 4.5 8Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="8" cy="6.5" r="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>{t(lang, 'foot.map')} <span class="far" aria-hidden="true">→</span></a></span>
          <a class="num" href={co.phoneHref} data-ev="call:footer"><bdi dir="ltr">{co.phone}</bdi></a>
          <a href={`mailto:${co.email}`}>{co.email}</a>
        </p>
        {/* Company under the contact facts, so the footer is one row (Sergei 2026-11-25) */}
        <nav class="fco" aria-label={t(lang, 'foot.company')}>
          <p data-h class="fcol__h">{t(lang, 'foot.company')}</p>
          {has('about') && <a href={aboutHref}>{t(lang, 'foot.about')} <span class="far" aria-hidden="true">→</span></a>}
          {has('team') && <a href={`${p}/team`}>{t(lang, 'foot.team')} <span class="far" aria-hidden="true">→</span></a>}
          {/* «Projects» is gone: merged into construction services (#340, Sergei 2026-11-23), listed under Services */}
          {has('contact') && <a href={contentUrl('contact', lang)}>{t(lang, 'foot.contact')} <span class="far" aria-hidden="true">→</span></a>}
        </nav>
      </div>

      <nav aria-label={t(lang, 'foot.areas')}>
        <p data-h class="fcol__h">{t(lang, 'foot.areas')}</p>
        {areaLinks.map((x) => (<a href={x.href}>{x.name} <span class="far" aria-hidden="true">→</span></a>))}
        <a href={listUrl(lang)}>{t(lang, 'foot.properties')} <span class="far" aria-hidden="true">→</span></a>
      </nav>

      <nav aria-label={t(lang, 'foot.types')}>
        <p data-h class="fcol__h">{t(lang, 'foot.types')}</p>
        {typeLinks.map((x) => (<a href={x.href}>{x.name} <span class="far" aria-hidden="true">→</span></a>))}
      </nav>

      <nav aria-label={t(lang, 'foot.services')}>
        <p data-h class="fcol__h">{t(lang, 'foot.services')}</p>
        {has('services/buyers') && <a href={moved('services/buyers')}>{t(lang, 'foot.buyers')} <span class="far" aria-hidden="true">→</span></a>}
        {has('services/owners') && <a href={moved('services/owners')}>{t(lang, 'foot.owners')} <span class="far" aria-hidden="true">→</span></a>}
        {has('services/investors') && <a href={moved('services/investors')}>{t(lang, 'foot.investors')} <span class="far" aria-hidden="true">→</span></a>}
        {has('services/developers') && <a href={moved('services/developers')}>{t(lang, 'foot.builders')} <span class="far" aria-hidden="true">→</span></a>}
      </nav>

      {/* Guides, as on the live site (#69): its three most-read articles + the hub. English-only for now. */}
      <nav aria-label={t(lang, 'foot.guides')}>
        <p data-h class="fcol__h">{t(lang, 'foot.guides')}</p>
        <a href="/en/properties/homes-for-sale">{t(lang, 'foot.g_houses')} <span class="far" aria-hidden="true">→</span></a>
        <a href="/en/buying-property-in-greece">{t(lang, 'foot.g_buy')} <span class="far" aria-hidden="true">→</span></a>
        <a href="/en/articles/all-news">{t(lang, 'foot.all_articles')} <span class="far" aria-hidden="true">→</span></a>
      </nav>

    </div>

    {/* 🪤 ΤΟ ΤΡΕΧΟΝ ΕΤΟΣ ΗΤΑΝ ΚΑΡΦΩΤΟ (`const year = 2026`). Την 1η Ιανουαρίου
        το υποσέλιδο θα έγραφε περασμένη χρονιά σε ΚΑΘΕ σελίδα και στις 9 γλώσσες,
        και δεν θα το πρόσεχε κανείς για μήνες. Τώρα υπολογίζεται ανά αίτημα.
        Το έτος ΕΝΑΡΞΗΣ, η επωνυμία και το ΓΕΜΗ έρχονται από το CMS. */}
    <p class="fbot">© {co.foundedYear}–{co.year} {co.legalName} · {t(lang, 'foot.reg')} {co.gemi}
      · <button type="button" class="fcookie" data-cookie-settings>{consentText(lang).footerLink}</button></p>
  </div>
</footer>

<style>
  .site-footer { background: var(--paper-2); padding: var(--s7) 0 var(--s5); border-top: 1px solid var(--line); }
  .fcols { display: grid; gap: var(--s5); }
  .brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: var(--fs-s0); letter-spacing: .2em; text-transform: uppercase; color: var(--ink);
  }
  .brand svg { width: 24px; height: 24px; flex: none; }
  /* Κάθε στοιχείο επικοινωνίας σε δική του γραμμή — δεν σπάει σε τυχαίο σημείο. */
  .fbrand__addr {
    margin: var(--s3) 0 0; color: var(--muted); font-size: var(--fs-s-1); max-width: 34ch; line-height: 1.8;   /* compact (Sergei 2026-11-24) */
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .fbrand__hq i { font-style: normal; color: var(--faint); }
  .fcol__h {
    font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
    color: var(--faint); margin: 0 0 var(--s2);
  }
  /* compact (Sergei 2026-11-24): 13 px, rows 24 px apart — was 17 px in 40 px rows */
  .fcols nav a { display: block; padding: 3px 0; font-size: var(--fs-s-1); line-height: 1.4; color: var(--muted); }   /* grey at rest, as «Contact us» (Sergei 2026-11-25) */
  /* hover as «Contact us» (Sergei 2026-11-25): ink, a thin underline, an arrow that fades in and slides;
     every link the same, «Properties» and «All articles» too (no arrow at rest) */
  .fcols a { transition: color .15s ease; }
  .fcols nav a:is(:hover, :focus-visible), .fbrand__addr a:is(:hover, :focus-visible) { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .far { display: inline-block; opacity: 0; transform: translateX(-4px); transition: opacity .2s ease, transform .3s ease; }
  .fcols nav a:is(:hover, :focus-visible) .far, .fmap:is(:hover, :focus-visible) .far { opacity: 1; transform: translateX(4px); }
  .fmap { display: inline-flex; align-items: center; gap: 4px; color: var(--muted); }
  .fmap svg { width: 13px; height: 13px; flex: none; }
  :global([dir='rtl']) .far { transform: translateX(4px) scaleX(-1); }
  :global([dir='rtl']) .fcols nav a:is(:hover, :focus-visible) .far { transform: translateX(-4px) scaleX(-1); }
  @media (prefers-reduced-motion: reduce) { .far, .fcols a { transition: none; } }
  .fco { margin-top: var(--s5); }
  .fbot {
    margin: var(--s5) 0 0; padding-top: var(--s4); border-top: 1px solid var(--line);
    font-size: var(--fs-s-1); color: var(--faint);
  }
  .fcookie { appearance: none; background: none; border: 0; padding: 0; font: inherit; color: inherit; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
  @media (min-width: 760px) { .fcols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); } }
  @media (min-width: 1024px) { .fcols { grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr)); gap: var(--s5); } }
</style>
