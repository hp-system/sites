---
// The guides (P03 Greece hub, P19 buying guide, P20 Golden Visa, P21 Halkidiki guide) and the own pages served
// here (P52 Exclusive…) — George's spec word for word, in every language the spec has.
// On the kit since 2026-11-11 (D-20261110-SS-1 order; before: plain text, Sergei 08/11 «пусть у них нет дизайна,
// зато есть контент»): the Sell / listing canon — the top (crumbs, H1, intro, the call, a photo), the H2 sections
// as posts with the side panel, open property photos and the links as tiles, the FAQ after the text (rule 9), then
// the sub pages, the form and the by-area block. Same words, H1/H2, schema and links: only the layout changed.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SpecText from './SpecText.astro';
import { specOf, specTitle, crumbPath, type SpecPage } from '../lib/seo-pages';
import { prefix, t, type Lang } from '../lib/i18n';
import { brand } from '../brand/index';
import InfoForm from './InfoForm.astro';
import { findInfoPage } from '../lib/infopages';
import { HERO_SHOTS } from '../lib/hero';
import { cleanSrcSet } from '../lib/photos';
import { privacyPath } from '../lib/legal';
import registry from '../data/page-registry.json';
import SpecPosts from './SpecPosts.astro';
import PageBlocks from './PageBlocks.astro';
import ExclusiveIntro from './ExclusiveIntro.astro';
import { pageBlocks } from '../lib/list-blocks';
import Areas from './Areas.astro';
import { FAQ_H } from '../lib/seo-pages';
import { allProperties, visitorCountry, type SiteProperty } from '../lib/api';
import { postPhotos } from '../lib/post-photos';
import { buildAreaTiles } from '../lib/area-tiles';
import { listUrl } from '../lib/i18n';

interface Props { page: SpecPage }
const { page } = Astro.props;
const lang = page.lang as Lang;

const LANGS: Lang[] = ['el', 'en', 'de', 'sr', 'bg', 'ro', 'tr', 'he', 'ru'];
const own = LANGS.filter((l) => specOf(page.id, l)?.id === page.id);   // P03 has no sr/bg/ro of its own
const pathFor = (l: Lang) => specOf(page.id, l)?.path ?? page.path;

const siteRoot = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Own pages P22+ (batch briefs) replace the text of an old page at the same URL, but keep what
// that page did besides text (D-20261106-SS-2 is about texts only): its lead form, its share
// image, and links to its subpages from the registry. Their titles come from the subpages.
const old = Number(page.id.slice(1)) > 21 ? await findInfoPage(page.path) : null;
const form = old?.data.form ?? null;
const image = old?.data.image || HERO_SHOTS[0]?.url || '';
// photo sizes 2026-11-11: the hero took the full 1920 file on every desktop; it is half the page wide
const heroSet = /_1920w\.jpg$/.test(image) ? `${image.replace(/_1920w\.jpg$/, '_800w.jpg')} 800w, ${image} 1920w`
  : image === HERO_SHOTS[0]?.url ? cleanSrcSet(image) : image;
const imageAlt = page.heroAlt || HERO_SHOTS[0]?.alt.en || page.h1;
const kidsReg = (registry as { pages: { id: string; parent?: string; status: string; paths?: Record<string, string> }[] }).pages
  .filter((r) => r.parent === page.id && r.status === 'live' && r.paths?.[lang]);
const kids = (await Promise.all(kidsReg.map(async (r) => {
  const d = (await findInfoPage(r.paths![lang]))?.data;
  return d ? { href: r.paths![lang], name: d.h1 || d.title } : null;
}))).filter((k): k is { href: string; name: string } => !!k);
const abs = (u: string) => siteRoot + encodeURI(u);
// the listings: open photos for the posts and the tiles, the by-area block (none when the CRM is down)
const memberToken = Astro.cookies.get('member_token')?.value;
let items: SiteProperty[] = [];
try { items = await allProperties(memberToken, visitorCountry(Astro.request)); } catch { items = []; }
// fixed photos per post win (as on Sell: a CC0 stock photo of the topic, not a property, so no watermark; Exclusive since
// 2026-11-16 «на каждый артикл нужна картинка подходящая»); the others take an open property photo as before
const autoPhotos = postPhotos(items as any, (page.body.match(/<h2>/g) ?? []).length, lang);
const photos = page.postPhotos?.length
  ? (page.body.match(/<h2>[\s\S]*?<\/h2>/g) ?? []).map((h, i) => {
      const pp = page.postPhotos!.find((x) => x.after === h.replace(/<[^>]+>/g, '').trim());
      return pp ? { src: `${pp.file}_960w.webp`, srcset: `${pp.file}_640w.webp 640w, ${pp.file}_960w.webp 960w`, alt: pp.alt, style: '' } : autoPhotos[i] ?? null;
    })
  : autoPhotos;
const areas = buildAreaTiles(items as any, lang, undefined, 5);
// #275 (Sergei 2026-11-12): the home-style Collections and «by area» above the text (they were under the form at the
// bottom); George's links they show leave the sections
const blocks = pageBlocks(items as any, lang, [], page.linksOut.map((l) => ({ href: l.href, text: l.anchor })), page.path);
// the page's call in the side panel: the club page asks to register (gold edge, B-11 event), the others call
// their own page (no gold: it is not a registration)
const cta = page.ctaHref && page.cta
  ? page.id === 'P52'
    ? { text: page.cta, href: page.ctaHref, ev: 'register:info' as const, gild: true }
    : { text: page.cta, href: form ? '#gp-form' : page.ctaHref, ev: 'content:sell' as const, gild: false }
  : null;
// Exclusive (Sergei 2026-11-16): the luxury face of the company — a black top, large thin type, gold only on the call,
// slow motion; no photo behind the words (Sergei 2026-11-16, ExclusiveCinema no longer used).
const lux = page.id === 'P52';
const luxH1 = lux && /^[^:]{2,30}:\s+\S/.test(page.h1) ? [page.h1.split(/:\s+/)[0], page.h1.replace(/^[^:]+:\s+/, '')] as [string, string] : null;
// Buying property in Greece (Sergei 2026-11-19 «давай линию, но на весь экран на всю ширину, тогда эти части текстов
// можно убрать с SEO-блока; сделай это сразу под шапкой»): the step list of the guide — a line before it and six or more
// points that each open with their name in bold — leaves its post and is drawn as one path across the screen right
// under the top; the post keeps its heading and its other paragraphs. Only where the language's text has such a list
// (each language has its own text).
const stepSrc = page.id === 'P19'
  ? (page.body.split(/(?=<h2>)/).map((sc) => {
      const m = sc.match(/<p>([^<]*)<\/p>\s*<ul>([\s\S]*?)<\/ul>/);
      if (!sc.startsWith('<h2>') || !m) return null;
      const lis = [...m[2].matchAll(/<li>\s*<strong>([\s\S]*?)<\/strong>\s*([\s\S]*?)<\/li>/g)];
      const all = (m[2].match(/<li>/g) ?? []).length;
      return lis.length >= 6 && lis.length === all
        ? { h: sc.match(/<h2>([\s\S]*?)<\/h2>/)![1], lead: m[1], cut: m[0], steps: lis.map((x) => ({ t: x[1].replace(/[.:]\s*$/, ''), d: x[2].trim() })) }
        : null;
    }).find(Boolean) ?? null)
  : null;
// the heading split at its colon: the first part large, the rest as a small line under it
const stepH: [string, string] = stepSrc
  ? (stepSrc.h.includes(':') ? [stepSrc.h.slice(0, stepSrc.h.indexOf(':')).trim(), stepSrc.h.slice(stepSrc.h.indexOf(':') + 1).trim()] : [stepSrc.h, ''])
  : ['', ''];
const postsPage = stepSrc ? { ...page, body: page.body.replace(stepSrc.cut, '') } : page;
const crumbs = page.breadcrumb.map((name, i, a) => ({ name, url: i === 0 ? (prefix(lang) || '/') : i === a.length - 1 ? page.path : crumbPath(name, lang) }));

const jsonLd: unknown[] = [
  ...(page.schema.includes('CollectionPage') ? [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: page.h1, url: abs(page.path), inLanguage: lang }] : []),
  { '@context': 'https://schema.org', '@type': 'Article', headline: page.h1, inLanguage: lang, url: abs(page.path),
    author: { '@type': 'Organization', name: brand.name, url: siteRoot }, publisher: { '@type': 'Organization', name: brand.name } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, ...(c.url ? { item: abs(c.url) } : {}) })) },
  ...(page.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base lang={lang} title={specTitle(page.title, brand.name)} description={page.meta} pathFor={pathFor} langs={own}
      ogTitle={page.ogTitle} jsonLd={jsonLd} ogImage={image ? (image.startsWith('/') ? siteRoot + image : image) : undefined} ogImageAlt={imageAlt}>
  <Header lang={lang} solid pathFor={pathFor} />
  <main id="main" class:list={['gp', lux && 'gp--lux']}>
    <header class="wrap gp__top">
      <div class="gp__txt">
        <nav class="gp__crumb" aria-label={t(lang, 'a11y.crumb')}>
          {crumbs.map((c, i, a) => (<>{i > 0 && <span aria-hidden="true"> · </span>}{c.url && i < a.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current={i === a.length - 1 ? 'page' : undefined}>{c.name}</span>}</>))}
        </nav>
        {/* Exclusive: «Exclusive» small on top, the rest large on one line (Sergei 2026-11-16); the H1 text stays whole */}
        {luxH1 ? <h1 class="t-display gp__h1 gp__h1--split"><span class="gp__h1k">{luxH1[0]}</span><span class="sr-only">: </span><span class="gp__h1m">{luxH1[1]}</span></h1>
               : <h1 class="t-display gp__h1">{page.h1}</h1>}
        {page.editorialLine && <p class="gp__ed">{page.editorialLine}</p>}
        <SpecText page={page} part="intro" lang={lang} />
        {/* existing event names only (B-11, lib/track.ts): the club page is a sign-in call, the sell pages a seller call */}
        {cta && <p class="gp__cta"><a class:list={['k-act', cta.gild && 'k-gild', lux && 'k-gild--dk']} href={cta.href} data-ev={cta.ev === 'register:info' ? 'register:info' : 'content:sell'}>{cta.text}</a></p>}
      </div>
      {/* Sergei 2026-11-16: no photo behind the words (the watermarked covers full-width did not suit) — black, a slow
          light and the home Secret Portfolio's thin lock */}
      {lux ? (
        <div class="gp__dark" aria-hidden="true">
          <svg class="gp__lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".35" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4.5" y="10.5" width="15" height="11"></rect><path d="M7.5 10.5V7a4.5 4.5 0 0 1 9 0v3.5"></path>
            <circle cx="12" cy="15.4" r="1.3"></circle><path d="M12 16.7v2.1"></path>
          </svg>
        </div>
      ) : image && (
        /* desktop only: phones get a 1-pixel placeholder and never download the photo */
        <picture class="gp__img">
          <source media="(min-width: 1024px)" srcset={heroSet} sizes="(min-width: 1440px) 680px, 47vw" />
          <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt={imageAlt} width="1920" height="1280" fetchpriority="high" decoding="async" />
        </picture>
      )}
    </header>
    {/* Exclusive (Sergei 2026-11-16): what the club is, right under the top, instead of the general Collections / by-area
        tiles (homes from €25,000 on a €1M club page); their links stay in the sections below (no drop) */}
    {stepSrc && (
      <section class="gst" aria-labelledby="gst-h" data-gst>
        <div class="gst__in" data-gst-in>
          {/* Sergei 2026-11-19: «Step by step» centred and large, «from viewing to the notary» small under it; the line
              «The usual path looks like this:» is not shown */}
          <p id="gst-h" class="gst__h">{stepH[0]}{stepH[1] && <><span class="sr-only">: </span><span class="gst__sub">{stepH[1]}</span></>}</p>
          <ol class="gst__path" style={`--n: ${stepSrc.steps.length}`}>
            {stepSrc.steps.map((x, i) => (
              <li class:list={['gst__st', i % 2 ? 'gst__st--lo' : 'gst__st--hi', i === stepSrc.steps.length - 1 && 'gst__st--end']} style={`--c: ${i + 1}`} tabindex="0" data-gst-i={i}>
                <span class="gst__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="gst__tx"><b>{x.t}</b><span set:html={x.d} /></span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
    {page.id === 'P52' ? <ExclusiveIntro lang={lang} cta={cta} /> : <PageBlocks lang={lang} cats={blocks.cats} areas={blocks.areas} areasFrom={blocks.areasFrom} />}
    <SpecPosts page={postsPage} lang={lang} photos={photos} faqH={FAQ_H[lang]} member={Boolean(memberToken)} items={items as any} cta={cta} drop={page.id === 'P52' ? undefined : blocks.consumed} />
    {kids.length > 0 && (
      <section class="wrap gp__kids" aria-labelledby="gp-kids-h">
        {/* the internal note in the name («Exclusive (ex VIP)») is not shown (Sergei 2026-11-27) */}
        <p data-h id="gp-kids-h" class="gp__label">{page.name.replace(/\s*\([^)]*\)\s*$/, '')}</p>
        <ul>{kids.map((k) => <li><a href={k.href}>{k.name} <span class="gp__ar" aria-hidden="true">→</span></a></li>)}</ul>
      </section>
    )}
    {form && (
      <section class="wrap gp__form" id="gp-form">
        <InfoForm source={form.source} title={form.title || undefined} message={form.message} terms="/en/terms-of-services" privacy={privacyPath(lang)} />
      </section>
    )}
    {/* #275: the areas block moved above the text (PageBlocks) */}
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .gp__top { display: grid; gap: var(--s4); padding-block: var(--s6); }
  .gp__txt { display: grid; gap: var(--s4); align-content: center; min-width: 0; }
  .gp__img { display: none; overflow: hidden; }
  .gp__img img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  @media (min-width: 1024px) {
    .gp__top { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: center; padding-block: 40px 56px; }
    .gp__img { display: block; }
    .gp__h1 { font-size: var(--fs-s5); font-weight: 300; line-height: 1.06; letter-spacing: -.021em; }
  }
  .gp__cta .k-act { width: auto; display: inline-flex; padding: 0 24px; }
  .gp__crumb { font-size: var(--fs-s-1); color: var(--muted); }
  .gp__crumb a { color: var(--muted); }
  .gp__h1 { max-width: 22ch; }
  .gp__ed { margin: 0; font-size: var(--fs-s-1); color: var(--muted); }
  .gp :global(.st-intro) { max-width: 68ch; }
  .gp__cta { margin: 0; }
  .gp__kids, .gp__form { padding-block: var(--s6); }
  /* centred, and the links as the footer's (Sergei 2026-11-27): grey at rest; on hover ink, a thin underline and an
     arrow that fades in and slides (Footer.astro .far) */
  .gp__kids { text-align: center; }
  .gp__kids ul { margin: var(--s3) 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s2) var(--s6); }
  .gp__kids a { color: var(--muted); text-decoration: none; transition: color .15s ease; }
  .gp__kids a:is(:hover, :focus-visible) { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .gp__ar { display: inline-block; opacity: 0; transform: translateX(-4px); transition: opacity .2s ease, transform .3s ease; }
  .gp__kids a:is(:hover, :focus-visible) .gp__ar { opacity: 1; transform: translateX(4px); }
  :global([dir='rtl']) .gp__ar { transform: translateX(4px) scaleX(-1); }
  :global([dir='rtl']) .gp__kids a:is(:hover, :focus-visible) .gp__ar { transform: translateX(-4px) scaleX(-1); }
  @media (prefers-reduced-motion: reduce) { .gp__ar, .gp__kids a { transition: none; } }
  .gp__label { margin: 0; font-size: var(--fs-s-1); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

  /* ── Exclusive, the luxury face (Sergei 2026-11-16): a white header bar; the first screen black (--ink-deep, the
     Secret Portfolio black) with a soft light that drifts slowly and a big faint thin lock behind the words — no photo
     («чёрный без фото»: the watermarked covers full-width did not suit); everything centred, large thin type, gold only
     on the registration call, slow motion. ── */
  .gp--lux { overflow-x: clip; }
  /* Exclusive: the blocks after the bento slide over it (ExclusiveIntro, 2026-11-19) — above it, with a ground */
  @media (min-width: 1024px) {
    :global(.gp--lux > .xi ~ *) { position: relative; z-index: 1; }
    /* the black top stays and the bento «What Exclusive gives you» slides over it from below (Sergei 2026-11-19 «пусть
       наезжает скроллом 3D наверх»); the script dims the top as it is covered */
    /* #338 (George via Sergei 2026-11-23: no 3D «the block below slides over» effect): no longer sticky, no shadow. */
    .gp.gp--lux .gp__top { position: relative; z-index: 0; }
    .gp--lux .gp__top::after { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 100vw; transform: translateX(-50%);
                               background: #000; opacity: var(--lux-dim, 0); pointer-events: none; z-index: 1; }
    /* a block without a ground of its own gets white at the full width (a .wrap block is narrower than the screen) */
    :global(:where(.gp--lux > .xi ~ *)) { background: var(--paper); box-shadow: 0 0 0 100vmax var(--paper); clip-path: inset(0 -100vmax); }
  }
  .gp--lux .gp__top { position: relative; isolation: isolate; color: #fff; min-height: min(86vh, 860px); box-sizing: border-box;
                      display: grid; grid-template-columns: minmax(0, 1fr); place-items: center; text-align: center; padding-block: 72px; }
  .gp__dark { position: absolute; top: 0; bottom: 0; left: 50%; width: 100vw; transform: translateX(-50%); z-index: -1; overflow: hidden;
              background: var(--ink-deep); color: #fff; }
  /* the light: one soft white glow, far larger than the screen, wandering slowly (24 s a lap) */
  .gp__dark::before { content: ''; position: absolute; inset: -40%;
    background: radial-gradient(closest-side, rgba(255,255,255,.075), rgba(255,255,255,0) 70%) 50% 50% / 60% 60% no-repeat; }
  /* the light stands still in the middle (Sergei 2026-11-19 «плавает кружочек, просто центрируй его»); the drift (gp-glow)
     is no longer used */
  @keyframes gp-glow { 0% { transform: translate(-6%, -4%); } 50% { transform: translate(8%, 6%); } 100% { transform: translate(-2%, 8%); } }
  .gp__lock { position: absolute; left: 50%; top: 50%; width: min(70vh, 560px); height: auto; transform: translate(-50%, -52%); opacity: .06; }
  @media (prefers-reduced-motion: reduce) { .gp__dark::before { animation: none; } }
  .gp--lux .gp__txt { justify-items: center; max-width: 1180px; margin-inline: auto; }   /* wider, not squeezed (Sergei 2026-11-16) */
  .gp--lux .gp__crumb, .gp--lux .gp__crumb a { color: rgba(255,255,255,.7); }
  .gp--lux .gp__h1 { color: #fff; max-width: 26ch; margin-inline: auto; }
  .gp--lux .gp__top :global(.st-intro) { max-width: 112ch; margin-inline: auto; }
  /* the paragraph in even lines (three on a desktop) */
  .gp--lux .gp__top :global(.st-intro p) { text-wrap: balance; }
  .gp__h1--split { display: grid; justify-items: center; gap: var(--s3); }
  .gp__h1k { font-size: var(--fs-s1); font-weight: 300; letter-spacing: .02em; color: rgba(255,255,255,.84); }
  .gp__h1m { text-wrap: balance; }
  .gp--lux .gp__top :global(.st-intro), .gp--lux .gp__top :global(.st-intro p) { color: rgba(255,255,255,.84); }
  /* slow, expensive motion: the words come up one after another */
  @media (prefers-reduced-motion: no-preference) {
    .gp--lux .gp__txt > * { opacity: 0; transform: translateY(14px); animation: gp-rise 1.4s cubic-bezier(.2,.7,.2,1) forwards; }
    .gp--lux .gp__txt > :nth-child(2) { animation-delay: .25s; }
    .gp--lux .gp__txt > :nth-child(3) { animation-delay: .55s; }
    .gp--lux .gp__txt > :nth-child(4) { animation-delay: .85s; }
    .gp--lux .gp__txt > :nth-child(5) { animation-delay: 1.1s; }
  }
  @keyframes gp-rise { to { opacity: 1; transform: none; } }
  @media (min-width: 1024px) {
    .gp--lux .gp__top { padding-block: 96px; gap: 0; }
    .gp--lux .gp__h1 { font-size: var(--fs-s5); font-weight: 300; line-height: 1.04; letter-spacing: -.024em; }
    .gp--lux .gp__h1--split { max-width: none; font-size: var(--fs-s4); }
  }

  /* ── the guide's steps as one path across the screen (Sergei 2026-11-19); phones: a numbered column ── */
  .gst { background: var(--paper); border-top: 1px solid var(--line-soft); }
  .gst__in { padding: var(--s6) var(--gut); }
  .gst__h { margin: 0; text-align: center; font-size: var(--fs-s3); font-weight: 300; line-height: 1.12; letter-spacing: -.016em; color: var(--ink); }
  .gst__sub { display: block; margin-top: 10px; font-size: var(--fs-s0); font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .gst__path { list-style: none; margin: var(--s5) 0 0; padding: 0; display: grid; gap: 0; }
  .gst__st { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); }
  .gst__n { font-size: var(--fs-s3); font-weight: 300; line-height: 1; letter-spacing: -.02em; color: var(--ink); }
  .gst__st--end .gst__n { justify-self: start; align-self: start; padding: 4px 8px; background: var(--ink); color: var(--paper); }
  .gst__tx b { display: block; font-size: var(--fs-s0); font-weight: 600; line-height: 1.3; color: var(--ink); }
  .gst__tx > span { display: block; margin-top: 6px; font-size: var(--fs-s-1); line-height: 1.55; color: var(--ink-2); }
  @media (min-width: 1000px) {
    /* depth (Sergei 2026-11-19 «сделай эту секцию в глубину как 3D эффект, пусть сайт скроллится над ней»): the band
       stays where it is and the page slides over it with a soft shadow; the script sinks it a little as it is covered */
    /* #338 (George via Sergei 2026-11-23: no 3D «the block below slides over» effect): no longer sticky, no shadow */
    .gst { position: relative; z-index: 0; overflow: hidden; }
    .gst__in { transform-origin: 50% 0; will-change: transform; }
    .gst::after { content: ""; position: absolute; inset: 0; background: var(--ink-deep); opacity: var(--gst-dim, 0); pointer-events: none; }
    :global(.gp > .gst ~ *) { position: relative; z-index: 1; }
    :global(:where(.gp > .gst ~ *)) { background: var(--paper); }   /* only where a block has no ground of its own (zero specificity) */
    .gst__in { padding: 56px max(var(--gut), 4vw) 64px; }
    .gst__h { font-size: var(--fs-s4); }
    /* one line across the whole width, a station per step; the steps stand above and below it in turn */
    .gst__path { position: relative; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); grid-template-rows: auto 64px auto; column-gap: 24px; margin-top: 48px; }
    .gst__st { grid-column: var(--c); grid-row: 1 / 4; display: grid; grid-template-rows: subgrid; grid-template-columns: minmax(0, 1fr); gap: 0; padding: 0; border: 0; }
    .gst__n { grid-row: 2; grid-column: 1; align-self: center; justify-self: start; position: relative; z-index: 1; padding-inline-end: 12px; background: var(--paper); font-size: var(--fs-s3); }
    /* the line runs through the numbers' row, across each column and its gap */
    .gst__st::before { content: ""; grid-row: 2; grid-column: 1; align-self: center; height: 1px; margin-inline-end: -24px; background: var(--ink); }
    .gst__st:last-child::before { margin-inline-end: 0; }
    .gst__st--end .gst__n { padding: 6px 12px; background: var(--ink); color: var(--paper); align-self: center; }
    .gst__tx { padding-inline-start: 14px; border-inline-start: 1px solid var(--line); }
    .gst__st--hi .gst__tx { grid-row: 1; align-self: end; padding-bottom: 20px; }
    .gst__st--lo .gst__tx { grid-row: 3; align-self: start; padding-top: 20px; }
    .gst__tx > span { font-size: var(--fs-s0); font-weight: 300; line-height: 1.5; }
    /* pointing at a step (Sergei 2026-11-19): the path up to it stays, the steps after it fade — how far to the notary */
    .gst__st { transition: opacity .25s ease; cursor: default; }
    .gst__st:focus-visible { outline: 2px solid var(--brand); outline-offset: 6px; }
    .gst__path.is-on .gst__st:not(.on) { opacity: .22; }
    .gst__path.is-on .gst__st.at .gst__tx b { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  }
  @media (prefers-reduced-motion: reduce) { .gst__st { transition: none; } }
</style>

<script>
  // Exclusive: the black top dims as the bento slides over it (desktop; none with reduced motion)
  document.querySelectorAll<HTMLElement>('.gp--lux .gp__top').forEach((top) => {
    const win = document.querySelector<HTMLElement>('.gp--lux [data-xi-win]');
    const desk = matchMedia('(min-width: 1024px)'), still = matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0;
    const place = () => top.style.setProperty('--lux-top', `${Math.min(0, innerHeight - top.offsetHeight)}px`);
    const tick = () => {
      raf = 0;
      if (!win || !desk.matches || still.matches) { top.style.setProperty('--lux-dim', '0'); return; }
      const r = top.getBoundingClientRect();
      const covered = Math.min(1, Math.max(0, (r.bottom - win.getBoundingClientRect().top) / r.height));
      top.style.setProperty('--lux-dim', String(covered * 0.5));
    };
    const ask = () => { if (!raf) raf = requestAnimationFrame(tick); };
    place(); tick();
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', () => { place(); ask(); });
  });
  // pointing at a step (or focusing it): the steps up to it stay, the ones after it fade
  document.querySelectorAll<HTMLElement>('.gst__path').forEach((path) => {
    const sts = [...path.querySelectorAll<HTMLElement>('[data-gst-i]')];
    const show = (k: number) => { path.classList.add('is-on'); sts.forEach((x, i) => { x.classList.toggle('on', i <= k); x.classList.toggle('at', i === k); }); };
    const clear = () => { path.classList.remove('is-on'); sts.forEach((x) => x.classList.remove('on', 'at')); };
    sts.forEach((x, i) => { x.addEventListener('pointerenter', () => show(i)); x.addEventListener('focus', () => show(i)); });
    path.addEventListener('pointerleave', clear);
    path.addEventListener('focusout', (e) => { if (!path.contains(e.relatedTarget as Node)) clear(); });
  });
  // the steps band sinks as the page slides over it (desktop; none with reduced motion): it sticks where its bottom meets
  // the screen's bottom, then scales down to 94% and dims to 35% while the next block covers it
  const band = document.querySelector<HTMLElement>('[data-gst]');
  const inner = band?.querySelector<HTMLElement>('[data-gst-in]');
  if (band && inner) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = matchMedia('(min-width: 1000px)');
    let raf = 0;
    const place = () => { band.style.setProperty('--gst-top', `${Math.min(0, innerHeight - band.offsetHeight)}px`); };
    const tick = () => {
      raf = 0;
      if (!wide.matches || still) { inner.style.transform = ''; band.style.setProperty('--gst-dim', '0'); return; }
      const next = band.nextElementSibling as HTMLElement | null;
      if (!next) return;
      const b = band.getBoundingClientRect();
      const covered = Math.min(1, Math.max(0, (b.bottom - next.getBoundingClientRect().top) / b.height));
      inner.style.transform = `scale(${1 - covered * 0.06})`;
      band.style.setProperty('--gst-dim', String(covered * 0.35));
    };
    const ask = () => { if (!raf) raf = requestAnimationFrame(tick); };
    place(); tick();
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', () => { place(); ask(); });
  }
</script>
