---
// The guides (P03 Greece hub, P19 buying guide, P20 Golden Visa, P21 Halkidiki guide) and the own pages served
// here (P52 Exclusive…) — George's spec word for word, in every language the spec has.
// On the kit since 2026-11-11 (D-20261110-SS-1 order; before: plain text, Sergei 08/11 «пусть у них нет дизайна,
// зато есть контент»): the Sell / listing canon — the top (crumbs, H1, intro, the call, a photo), the H2 sections
// as posts with the side panel, open property photos and the links as tiles, the FAQ after the text (rule 9), then
// the sub pages, the form and the by-area block. Same words, H1/H2, schema and links: only the layout changed.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SpecText from './SpecText.astro';
import { specOf, specTitle, crumbPath, type SpecPage } from '../lib/seo-pages';
import { prefix, t, type Lang } from '../lib/i18n';
import { brand } from '../brand/index';
import InfoForm from './InfoForm.astro';
import { findInfoPage } from '../lib/infopages';
import { HERO_SHOTS } from '../lib/hero';
import { cleanSrcSet } from '../lib/photos';
import { privacyPath } from '../lib/legal';
import registry from '../data/page-registry.json';
import SpecPosts from './SpecPosts.astro';
import PageBlocks from './PageBlocks.astro';
import ExclusiveIntro from './ExclusiveIntro.astro';
import ExclusiveCinema from './ExclusiveCinema.astro';
import { coverOf, heroReady, altOf } from '../lib/photos';
import { priceOf, priceVisible } from '../lib/api';
import { pageBlocks } from '../lib/list-blocks';
import Areas from './Areas.astro';
import { FAQ_H } from '../lib/seo-pages';
import { allProperties, visitorCountry, type SiteProperty } from '../lib/api';
import { postPhotos } from '../lib/post-photos';
import { buildAreaTiles } from '../lib/area-tiles';
import { listUrl } from '../lib/i18n';

interface Props { page: SpecPage }
const { page } = Astro.props;
const lang = page.lang as Lang;

const LANGS: Lang[] = ['el', 'en', 'de', 'sr', 'bg', 'ro', 'tr', 'he', 'ru'];
const own = LANGS.filter((l) => specOf(page.id, l)?.id === page.id);   // P03 has no sr/bg/ro of its own
const pathFor = (l: Lang) => specOf(page.id, l)?.path ?? page.path;

const siteRoot = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Own pages P22+ (batch briefs) replace the text of an old page at the same URL, but keep what
// that page did besides text (D-20261106-SS-2 is about texts only): its lead form, its share
// image, and links to its subpages from the registry. Their titles come from the subpages.
const old = Number(page.id.slice(1)) > 21 ? await findInfoPage(page.path) : null;
const form = old?.data.form ?? null;
const image = old?.data.image || HERO_SHOTS[0]?.url || '';
// photo sizes 2026-11-11: the hero took the full 1920 file on every desktop; it is half the page wide
const heroSet = /_1920w\.jpg$/.test(image) ? `${image.replace(/_1920w\.jpg$/, '_800w.jpg')} 800w, ${image} 1920w`
  : image === HERO_SHOTS[0]?.url ? cleanSrcSet(image) : image;
const imageAlt = page.heroAlt || HERO_SHOTS[0]?.alt.en || page.h1;
const kidsReg = (registry as { pages: { id: string; parent?: string; status: string; paths?: Record<string, string> }[] }).pages
  .filter((r) => r.parent === page.id && r.status === 'live' && r.paths?.[lang]);
const kids = (await Promise.all(kidsReg.map(async (r) => {
  const d = (await findInfoPage(r.paths![lang]))?.data;
  return d ? { href: r.paths![lang], name: d.h1 || d.title } : null;
}))).filter((k): k is { href: string; name: string } => !!k);
const abs = (u: string) => siteRoot + encodeURI(u);
// the listings: open photos for the posts and the tiles, the by-area block (none when the CRM is down)
const memberToken = Astro.cookies.get('member_token')?.value;
let items: SiteProperty[] = [];
try { items = await allProperties(memberToken, visitorCountry(Astro.request)); } catch { items = []; }
const photos = postPhotos(items as any, (page.body.match(/<h2>/g) ?? []).length, lang);
const areas = buildAreaTiles(items as any, lang, undefined, 5);
// #275 (Sergei 2026-11-12): the home-style Collections and «by area» above the text (they were under the form at the
// bottom); George's links they show leave the sections
const blocks = pageBlocks(items as any, lang, [], page.linksOut.map((l) => ({ href: l.href, text: l.anchor })), page.path);
// the page's call in the side panel: the club page asks to register (gold edge, B-11 event), the others call
// their own page (no gold: it is not a registration)
const cta = page.ctaHref && page.cta
  ? page.id === 'P52'
    ? { text: page.cta, href: page.ctaHref, ev: 'register:info' as const, gild: true }
    : { text: page.cta, href: form ? '#gp-form' : page.ctaHref, ev: 'content:sell' as const, gild: false }
  : null;
// Exclusive (Sergei 2026-11-16): the luxury face of the company — a black top, large thin type, gold only on the call,
// slow motion, and the photo replaced by a slow film of the dearest open properties (sea first), €1M and up.
const lux = page.id === 'P52';
const cinema = (() => {
  if (!lux) return [];
  const sea = (a: any) => a?.sea_access === 'front' || (Array.isArray(a?.views) && a.views.includes('sea'));
  const pool = items.filter((p) => { const a = (p.attributes ?? {}) as any; return priceVisible(a) && priceOf(a) >= 1_000_000 && heroReady(a); })
    .sort((x, y) => Number(sea(y.attributes)) - Number(sea(x.attributes)) || priceOf((y.attributes ?? {}) as any) - priceOf((x.attributes ?? {}) as any));
  const seen = new Set<string>();
  const out: { photo: NonNullable<ReturnType<typeof coverOf>>; alt: string }[] = [];
  for (const p of pool) {
    const c = coverOf((p.attributes ?? {}) as any);
    if (!c || seen.has(c.url)) continue;
    seen.add(c.url);
    out.push({ photo: c, alt: altOf(c, lang, imageAlt) });
    if (out.length === 5) break;
  }
  return out;
})();
const crumbs = page.breadcrumb.map((name, i, a) => ({ name, url: i === 0 ? (prefix(lang) || '/') : i === a.length - 1 ? page.path : crumbPath(name, lang) }));

const jsonLd: unknown[] = [
  ...(page.schema.includes('CollectionPage') ? [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: page.h1, url: abs(page.path), inLanguage: lang }] : []),
  { '@context': 'https://schema.org', '@type': 'Article', headline: page.h1, inLanguage: lang, url: abs(page.path),
    author: { '@type': 'Organization', name: brand.name, url: siteRoot }, publisher: { '@type': 'Organization', name: brand.name } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, ...(c.url ? { item: abs(c.url) } : {}) })) },
  ...(page.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base lang={lang} title={specTitle(page.title, brand.name)} description={page.meta} pathFor={pathFor} langs={own}
      ogTitle={page.ogTitle} jsonLd={jsonLd} ogImage={image ? (image.startsWith('/') ? siteRoot + image : image) : undefined} ogImageAlt={imageAlt}>
  <Header lang={lang} solid pathFor={pathFor} />
  <main id="main" class:list={['gp', lux && 'gp--lux']}>
    <header class="wrap gp__top">
      <div class="gp__txt">
        <nav class="gp__crumb" aria-label={t(lang, 'a11y.crumb')}>
          {crumbs.map((c, i, a) => (<>{i > 0 && <span aria-hidden="true"> · </span>}{c.url && i < a.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current={i === a.length - 1 ? 'page' : undefined}>{c.name}</span>}</>))}
        </nav>
        <h1 class="t-display gp__h1">{page.h1}</h1>
        {page.editorialLine && <p class="gp__ed">{page.editorialLine}</p>}
        <SpecText page={page} part="intro" lang={lang} />
        {/* existing event names only (B-11, lib/track.ts): the club page is a sign-in call, the sell pages a seller call */}
        {cta && <p class="gp__cta"><a class:list={['k-act', cta.gild && 'k-gild', lux && 'k-gild--dk']} href={cta.href} data-ev={cta.ev === 'register:info' ? 'register:info' : 'content:sell'}>{cta.text}</a></p>}
      </div>
      {lux && cinema.length > 0 ? <div class="gp__img" aria-hidden="true"><ExclusiveCinema shots={cinema} /></div> : image && (
        /* desktop only: phones get a 1-pixel placeholder and never download the photo */
        <picture class="gp__img">
          <source media="(min-width: 1024px)" srcset={heroSet} sizes="(min-width: 1440px) 680px, 47vw" />
          <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt={imageAlt} width="1920" height="1280" fetchpriority="high" decoding="async" />
        </picture>
      )}
    </header>
    {/* Exclusive (Sergei 2026-11-16): what the club is, right under the top, instead of the general Collections / by-area
        tiles (homes from €25,000 on a €1M club page); their links stay in the sections below (no drop) */}
    {page.id === 'P52' ? <ExclusiveIntro lang={lang} cta={cta} /> : <PageBlocks lang={lang} cats={blocks.cats} areas={blocks.areas} areasFrom={blocks.areasFrom} />}
    <SpecPosts page={page} lang={lang} photos={photos} faqH={FAQ_H[lang]} member={Boolean(memberToken)} items={items as any} cta={cta} drop={page.id === 'P52' ? undefined : blocks.consumed} />
    {kids.length > 0 && (
      <section class="wrap gp__kids" aria-labelledby="gp-kids-h">
        <p data-h id="gp-kids-h" class="gp__label">{page.name}</p>
        <ul>{kids.map((k) => <li><a href={k.href}>{k.name}</a></li>)}</ul>
      </section>
    )}
    {form && (
      <section class="wrap gp__form" id="gp-form">
        <InfoForm source={form.source} title={form.title || undefined} message={form.message} terms="/en/terms-of-services" privacy={privacyPath(lang)} />
      </section>
    )}
    {/* #275: the areas block moved above the text (PageBlocks) */}
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .gp__top { display: grid; gap: var(--s4); padding-block: var(--s6); }
  .gp__txt { display: grid; gap: var(--s4); align-content: center; min-width: 0; }
  .gp__img { display: none; overflow: hidden; }
  .gp__img img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  @media (min-width: 1024px) {
    .gp__top { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 56px; align-items: center; padding-block: 40px 56px; }
    .gp__img { display: block; }
    .gp__h1 { font-size: var(--fs-s5); font-weight: 300; line-height: 1.06; letter-spacing: -.021em; }
  }
  .gp__cta .k-act { width: auto; display: inline-flex; padding: 0 24px; }
  .gp__crumb { font-size: var(--fs-s-1); color: var(--muted); }
  .gp__crumb a { color: var(--muted); }
  .gp__h1 { max-width: 22ch; }
  .gp__ed { margin: 0; font-size: var(--fs-s-1); color: var(--muted); }
  .gp :global(.st-intro) { max-width: 68ch; }
  .gp__cta { margin: 0; }
  .gp__kids, .gp__form { padding-block: var(--s6); }
  .gp__kids ul { margin: var(--s3) 0 0; padding: 0; list-style: none; display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .gp__label { margin: 0; font-size: var(--fs-s-1); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

  /* ── Exclusive, the luxury face (Sergei 2026-11-16): a white header bar; the first screen a full-width film of the
     dearest properties (ExclusiveCinema) under a dark veil, everything centred, large thin type, gold only on the
     registration call, slow motion. George's tokens only: --ink-deep for the veil, white text, k-gild--dk. ── */
  .gp--lux { overflow-x: clip; }
  .gp--lux .gp__top { position: relative; isolation: isolate; color: #fff; min-height: min(86vh, 860px); box-sizing: border-box;
                      display: grid; grid-template-columns: minmax(0, 1fr); place-items: center; text-align: center; padding-block: 72px; }
  .gp--lux .gp__img { display: block; position: absolute; top: 0; bottom: 0; left: 50%; width: 100vw; transform: translateX(-50%);
                      z-index: -2; overflow: hidden; }
  .gp--lux .gp__top::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 100vw; transform: translateX(-50%); z-index: -1;
                              background: linear-gradient(180deg, rgba(11,14,16,.62) 0%, rgba(11,14,16,.46) 45%, rgba(11,14,16,.7) 100%); }
  .gp--lux .gp__txt { justify-items: center; max-width: 880px; margin-inline: auto; }
  .gp--lux .gp__crumb, .gp--lux .gp__crumb a { color: rgba(255,255,255,.7); }
  .gp--lux .gp__h1 { color: #fff; max-width: 18ch; margin-inline: auto; }
  .gp--lux .gp__top :global(.st-intro) { max-width: 60ch; margin-inline: auto; }
  .gp--lux .gp__top :global(.st-intro), .gp--lux .gp__top :global(.st-intro p) { color: rgba(255,255,255,.84); }
  /* slow, expensive motion: the words come up one after another */
  @media (prefers-reduced-motion: no-preference) {
    .gp--lux .gp__txt > * { opacity: 0; transform: translateY(14px); animation: gp-rise 1.4s cubic-bezier(.2,.7,.2,1) forwards; }
    .gp--lux .gp__txt > :nth-child(2) { animation-delay: .25s; }
    .gp--lux .gp__txt > :nth-child(3) { animation-delay: .55s; }
    .gp--lux .gp__txt > :nth-child(4) { animation-delay: .85s; }
    .gp--lux .gp__txt > :nth-child(5) { animation-delay: 1.1s; }
  }
  @keyframes gp-rise { to { opacity: 1; transform: none; } }
  @media (min-width: 1024px) {
    .gp--lux .gp__top { padding-block: 96px; gap: 0; }
    .gp--lux .gp__h1 { font-size: var(--fs-s5); font-weight: 300; line-height: 1.04; letter-spacing: -.024em; }
  }
</style>
