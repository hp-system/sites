---
// Κεφαλίδα — διαφανής πάνω από τη φωτογραφία του hero.
// Δουλειά της: να μη σε εμποδίζει.
//
// 🔴 ΚΑΙ ΓΙ' ΑΥΤΟ ΑΚΡΙΒΩΣ ΕΞΑΦΑΝΙΖΟΤΑΝ ΣΤΗ ΛΙΣΤΑ (George, 30/7: «το λογότυπο
//    και όλο γενικά το header δεν υπάρχει»). ΥΠΗΡΧΕ — απλώς είναι φτιαγμένη να
//    επιπλέει πάνω σε φωτογραφία: `position: absolute` (δεν πιάνει χώρο) και
//    `color: #fff`. Στη λίστα δεν υπάρχει φωτογραφία, άρα **λευκά γράμματα σε
//    λευκό φόντο** — αόρατη, και από πάνω σκέπαζε και τα πρώτα 60px της σελίδας.
//    Ο διακόπτης `solid` τη γυρίζει σε κανονική μπάρα: μέσα στη ροή, με φόντο
//    και σκούρα γράμματα. Η αρχική μένει ΑΚΡΙΒΩΣ όπως ήταν.
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { listUrl, prefix, t, type Lang } from '../lib/i18n';
import { company } from '../lib/company';
import { memberOf } from '../lib/member';
import { pageExists, contentUrl } from '../lib/pages';
import { brand } from '../brand/index';
import { PAGES, pathOf } from '../lib/skeleton';
interface Props {
  lang: Lang; solid?: boolean;
  /** Η ίδια σελίδα σε άλλη γλώσσα — μόνο όπου το slug ΜΕΤΑΦΡΑΖΕΤΑΙ (λίστα, ακίνητο).
      Αλλού ο διακόπτης το βρίσκει μόνος του από τη διεύθυνση. Δες `LangSwitch.astro`. */
  pathFor?: (l: Lang) => string;
}
const { lang, solid = false, pathFor } = Astro.props;
const p = prefix(lang);
// English: the old site's URL /en/about-us (the info page); other languages keep /about.
const aboutHref = lang === 'en' ? '/en/about-us' : `${p}/about`;
const co = await company();
// Sergei 08/11 — portion 4, English first (plan: languages one by one): the 7-section menu of the
// page registry (Buy · Sell · Halkidiki · Services · About us · Exclusive · Contact), each section a
// list of its pages. Pages not built yet stay out (Team P49 and Exclusive P52 wait for their text;
// a menu link to a 404 is what made the 124 dead links). Other languages keep the old menu until
// their stage: most new pages have no URL in them yet.
// Sergei with George 2026-11-25 (#370): the header carries only Buy · Sell · Build · Exclusive · Contact; the phone
// moves into Contact on desktop (the mobile header keeps its call button). Everything else moved:
//   Halkidiki's areas and the buying guide → Buy (three columns: types, areas, guides; the blog is a guide),
//   buyer services → Buy, seller services and property management → Sell, construction → Build,
//   about us and our story → Contact. Footer only: the services hub, partners, careers, investors / Golden Visa
//   (linked also from their related pages). Replaces the 7-section menu of 08/11 (#250 kept its «fewer choices» rule).
// Languages whose menu pages all exist (#262, #265) get the dropdowns; the others the same five as plain links.
const MENU_LANGS: Lang[] = ['en', 'el', 'ru'];
const LABEL: Record<string, string> = {
  P04: 'Houses', P19: 'Buying property in Greece', P40: 'Property management', P57: 'Online meeting', P23: 'Pre-published properties',
};
const LABEL_RU: Record<string, string> = {
  P02: 'Вся недвижимость', P04: 'Дома', P05: 'Квартиры', P07: 'Виллы', P08: 'Земля', P09: 'У моря', P19: 'Как купить недвижимость в Греции',
  P24: 'Продать', P26: 'Добавить объект',
  P21: 'Гид по Халкидики', P11: 'Кассандра', P12: 'Ситония', P13: 'Неа-Пропонтида', P14: 'Аристотелис', P58: 'Полигирос',
  P36: 'Покупателям', P37: 'Продавцам', P40: 'Управление недвижимостью', P39: 'Строительные услуги',
  P43: 'О нас', P44: 'Наша история',
  P52: 'Exclusive', P23: 'Объекты до публикации', P53: 'Зачем регистрироваться',
  P56: 'Контакты', P57: 'Онлайн-встреча',
};
const LABEL_EL: Record<string, string> = {
  P02: 'Όλα τα ακίνητα', P04: 'Σπίτια', P05: 'Διαμερίσματα', P07: 'Βίλες', P08: 'Γη', P09: 'Παραθαλάσσια', P19: 'Αγορά ακινήτου στην Ελλάδα',
  P24: 'Πώληση', P26: 'Πρόσθεσε το ακίνητό σου',
  P21: 'Οδηγός Χαλκιδικής', P11: 'Κασσάνδρα', P12: 'Σιθωνία', P13: 'Νέα Προποντίδα', P14: 'Αριστοτέλης', P58: 'Πολύγυρος',
  P36: 'Για αγοραστές', P37: 'Για πωλητές', P40: 'Διαχείριση ακινήτων', P39: 'Κατασκευαστικές υπηρεσίες',
  P43: 'Η εταιρεία', P44: 'Η ιστορία μας',
  P52: 'Exclusive', P23: 'Προ-δημοσιευμένα ακίνητα', P53: 'Γιατί να εγγραφείτε',
  P56: 'Επικοινωνία', P57: 'Online ραντεβού',
};
type Item = { href: string; label: string; tel?: boolean };
type Sec = { label: string; items?: Item[]; groups?: { h: string; items: Item[] }[] };
const nameOf = (id: string) => (PAGES.find((r) => r.id === id)?.name ?? id).replace(/\s*\(.*\)\s*$/, '');
const item = (id: string): Item => ({
  href: pathOf(id, lang) ?? '#',
  label: (lang === 'el' ? LABEL_EL[id] : lang === 'ru' ? LABEL_RU[id] : undefined) ?? LABEL[id] ?? nameOf(id),
});
const nav5: Sec[] | null = MENU_LANGS.includes(lang) ? [
  { label: t(lang, 'nav.buy'), groups: [
    { h: t(lang, 'nav.g_types'), items: ['P02', 'P04', 'P05', 'P07', 'P08', 'P09'].map(item) },
    { h: t(lang, 'nav.g_areas'), items: ['P11', 'P12', 'P13', 'P14', 'P58', 'P21'].map(item) },
    { h: t(lang, 'nav.g_guides'), items: [item('P19'), item('P36'), { href: '/en/articles/all-news', label: t(lang, 'nav.blog') }] },
  ] },
  { label: t(lang, 'nav.sell'), items: ['P24', 'P26', 'P37', 'P40'].map(item) },
  { label: t(lang, 'nav.build'), items: [item('P39')] },
  { label: t(lang, 'nav.exclusive'), items: ['P52', 'P23', 'P53'].map(item) },
  { label: t(lang, 'nav.contact'), items: [item('P56'), item('P57'), { href: co.phoneHref, label: co.phone, tel: true }, item('P43'), item('P44')] },
] : null;

// ── ΕΙΝΑΙ ΜΕΣΑ; ────────────────────────────────────────────────────────────
// 🔴 ΤΟ ΚΕΝΟ ΠΟΥ ΚΛΕΙΝΕΙ ΕΔΩ: η κεφαλίδα έλεγε **πάντα** «Σύνδεση», ακόμη και σε
//    συνδεδεμένο μέλος, και **κανένας σύνδεσμος προς `/panel` δεν υπήρχε σε όλο το
//    site**. Το μέλος έπρεπε να γράψει τη διεύθυνση με το χέρι — και επειδή η
//    «Αποσύνδεση» ζούσε μόνο μέσα στον πίνακα, δεν μπορούσε ούτε να βγει.
//
// 💰 ΜΗΔΕΝ ΚΟΣΤΟΣ ΓΙΑ ΤΟΝ ΕΠΙΣΚΕΠΤΗ: χωρίς cookie το `memberOf` γυρίζει `null`
//    **χωρίς καμία κλήση** (member.ts:63). Για το μέλος, η απάντηση είναι στη μνήμη
//    30΄΄. Δεν προστίθεται καθυστέρηση σε καμία δημόσια σελίδα.
//
// 🪤 ΤΟ ΕΠΙΠΕΔΟ ΔΕΝ ΔΙΑΒΑΖΕΤΑΙ ΑΠΟ ΤΟ COOKIE — έρχεται από τη βάση μέσω `memberOf`.
//    Το εισιτήριο είναι απλό base64: όποιος το επεξεργαστεί θα «γινόταν» exclusive.
const me = await memberOf(Astro.cookies.get('member_token')?.value);
const inside = !!me && !me.blocked;
// Μόνο το μικρό όνομα: «Ο λογαριασμός μου» σε κάθε γλώσσα χωράει, το ονοματεπώνυμο όχι.
const who = (me?.name || '').trim().split(/\s+/)[0] || '';

// 🛡️ ΔΙΧΤΥ: ΔΕΝ ΔΕΙΧΝΟΥΜΕ ΣΥΝΔΕΣΜΟ ΓΙΑ ΣΕΛΙΔΑ ΠΟΥ ΔΕΝ ΥΠΑΡΧΕΙ.
//    Έτσι γεννήθηκαν οι 124 νεκροί σύνδεσμοι: τα μενού γράφτηκαν πριν τις σελίδες και
//    κανείς δεν ξαναπέρασε. Τώρα η ύπαρξη κρίνεται από το `lib/pages.ts` — αν λείπει
//    το κείμενο, λείπει και ο σύνδεσμος. Δεν μπορεί να ξανασυμβεί σιωπηλά.
const has = (k: string) => pageExists(k as any);
---
<header class:list={['site-header', solid && 'site-header--solid']}>
  <div class="site-header__in">
  <a class="brandlink" href={p || '/'} aria-label={brand.name}>
    <span class="brandlink__sm"><Logo variant="mono" size="sm" /></span>
    <span class="brandlink__md"><Logo variant="mono" size="md" /></span>
  </a>

  {nav5 ? (
  <nav class="navlinks nav7" aria-label={t(lang, 'a11y.nav')}>
    {nav5.map((sec) => !sec.groups && sec.items!.length === 1 ? (
      <a href={sec.items![0].href}>{sec.label}</a>
    ) : (
      <div class="nav7__s">
        <a class="nav7__t" href={(sec.groups ? sec.groups[0].items[0] : sec.items![0]).href} aria-haspopup="true">{sec.label}</a>
        {sec.groups ? (
          <div class="nav7__dd nav7__dd--cols">
            {sec.groups.map((g) => (
              <div class="nav7__g"><p class="nav7__gh">{g.h}</p><ul>{g.items.map((it) => <li><a href={it.href}>{it.label}</a></li>)}</ul></div>
            ))}
          </div>
        ) : (
          <ul class="nav7__dd">{sec.items!.map((it) => <li>{it.tel
            ? <a class="num" href={it.href} data-ev="call:header"><bdi dir="ltr">{it.label}</bdi></a>
            : <a href={it.href}>{it.label}</a>}</li>)}</ul>
        )}
      </div>
    ))}
  </nav>
  ) : (
  <nav class="navlinks" aria-label={t(lang, 'a11y.nav')}>
    {/* languages whose new pages have no URL yet: the same five, as far as their pages exist */}
    <a href={listUrl(lang)}>{t(lang, 'nav.buy')}</a>
    {has('sell') && <a href={`${p}/sell`}>{t(lang, 'nav.sell')}</a>}
    {has('services/developers') && <a href={contentUrl('services/developers', lang)}>{t(lang, 'nav.build')}</a>}
    {has('contact') && <a href={contentUrl('contact', lang)}>{t(lang, 'nav.contact')}</a>}
  </nav>
  )}

  <div class="navright">
    {/* 🪤 ΤΟ ΤΗΛΕΦΩΝΟ ΕΙΝΑΙ ΠΡΩΤΟ ΣΤΟ ΚΙΝΗΤΟ.
        Πριν, το μόνο τηλέφωνο ήταν μέσα στο κλειστό μενού και στο υποσέλιδο —
        δηλαδή μετά από πέντε οθόνες κύλισης. Σε αγορά όπου η απόφαση γίνεται με
        ένα τηλεφώνημα, αυτό είναι χαμένος πελάτης. Ένα πάτημα, από την 1η οθόνη. */}
    <a class="tel" href={co.phoneHref} aria-label={co.phone} data-ev="call:header">
      <svg viewBox="0 0 18 18" aria-hidden="true">
        <path d="M5.2 2.6h2.1l1.1 2.8-1.5 1.1a8.4 8.4 0 0 0 4.6 4.6l1.1-1.5 2.8 1.1v2.1a1.3 1.3 0 0 1-1.4 1.3A12.6 12.6 0 0 1 3.9 4A1.3 1.3 0 0 1 5.2 2.6Z"
              fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
      </svg>
      <span class="tel__n num"><bdi dir="ltr">{co.phone}</bdi></span>
    </a>
    {/* Ο διακόπτης γλώσσας ζει εδώ στο desktop· στο κινητό είναι ΠΡΩΤΟΣ μέσα στο μενού. */}
    <span class="langslot"><LangSwitch lang={lang} tone={solid ? 'plain' : 'onphoto'} pathFor={pathFor} /></span>
    {/* ⚠️ ΣΗΜΑΝΣΗ: κάθε σημείο εγγραφής έχει ΔΙΚΟ ΤΟΥ όνομα συμβάντος.
        Σήμερα το παλιό site μετρά τα πάντα ως ένα «register_link_click», γι' αυτό
        δεν μπορέσαμε να απαντήσουμε ποιο σημείο αποδίδει. Δες lib/track.ts. */}
    {inside
      ? <a class="acct" href={`${p}/panel`} data-ev="panel:header">{who || t(lang, 'pnl.title')}</a>
      : <a href={`${p}/login`} rel="nofollow" data-ev="register:header">{t(lang, 'nav.login')}</a>}
    <button class="burger" type="button" data-menu-open
            aria-label={t(lang, 'ui.menu')} aria-expanded="false" aria-controls="mobile-menu">
      <i></i><i></i><i></i>
    </button>
  </div>
  </div>
</header>

<style>
  /* 🪤 ΤΟ ΜΕΝΟΥ ΕΜΦΑΝΙΖΕΤΑΙ ΜΟΝΟ ΟΤΑΝ ΧΩΡΑΕΙ — στα 1080, όχι στα 760.
     Με το παλιό κατώφλι, στα 760-1080 (tablet, μικρό laptop) οι πέντε σύνδεσμοι
     ακουμπούσαν το λογότυπο και έσπαγαν σε δύο σειρές: το «Η ΕΤΑΙΡΕΙΑ» έπεφτε
     κάτω και η κεφαλίδα φούσκωνε από 60 σε 88px. Κάτω από το 1080 δουλεύει το
     burger — που ήδη υπάρχει και δοκιμάστηκε. Το `gap` εγγυάται ότι τα τρία
     μέρη δεν ακουμπούν ΠΟΤΕ, σε κανένα πλάτος. */
  /* Η κεφαλίδα ήταν το ΜΟΝΟ μπλοκ εκτός της στήλης: το λογότυπο ξεκινούσε στα 40
     ενώ ο H1 από κάτω του στα 120. Τώρα μοιράζεται τη γεωμετρία του `.wrap`. */
  /* Sergei 12/11 (#250): the header's dropdowns opened under page blocks (property map 500–600, sticky
     bar 30, list head 20). The header sits above every page block; dialogs live in the top layer and the
     cookie bar (1000) stays above it. */
  .site-header { position: absolute; top: 0; left: 0; right: 0; z-index: 900; color: #fff; }

  /* ── ΣΥΜΠΑΓΗΣ ΕΚΔΟΧΗ — για σελίδες ΧΩΡΙΣ φωτογραφία από πίσω ──────────────
     `static` αντί για `absolute`: πιάνει τον χώρο της αντί να κάθεται πάνω στο
     περιεχόμενο. Χρώμα μελανιού αντί για λευκό, ώστε να διαβάζεται. Το φόντο
     απλώνεται «πέρα ως πέρα» (George) επειδή μπαίνει στο ΕΞΩΤΕΡΙΚΟ στοιχείο,
     ενώ το περιεχόμενο μένει στη στήλη των 1200 όπως όλη η σελίδα. */
  .site-header--solid {
    position: relative; color: var(--ink);   /* relative, not static: a static box ignores z-index (#250) */
    background: var(--paper); border-bottom: 1px solid var(--line-soft);
  }
  /* Το λογότυπο είναι «mono», δηλαδή παίρνει το χρώμα του γονέα — δεν χρειάζεται
     δεύτερη εκδοχή, αρκεί που άλλαξε το `color`. */
  .site-header--solid .tel:hover, .site-header--solid a:hover { opacity: .7; }

  .site-header__in {
    max-width: var(--max); margin: 0 auto; padding: 14px var(--gut);
    display: flex; align-items: center; justify-content: space-between; gap: var(--s5);
  }
  .brandlink { min-width: 0; display: inline-flex; align-items: center; min-height: 44px; }
  .brandlink__md { display: none; }
  .navlinks { display: none; }
  .navright {
    display: flex; align-items: center; gap: var(--s3); flex: none;
    font-size: var(--fs-s-1); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap;
  }
  .langslot { display: none; }
  /* Ο αριθμός φαίνεται ΚΑΙ στο κινητό: ένα εικονίδιο ακουστικού 17px δεν λέει
     σε κανέναν ότι μπορεί να τηλεφωνήσει. Ο στόχος αφής είναι 44×44 σε κάθε
     περίπτωση — μετρήθηκε 17×44 και ήταν κάτω από το ελάχιστο. */
  .tel {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 44px; min-width: 44px; justify-content: center;
  }
  .tel svg { width: 17px; height: 17px; flex: none; }
  /* Sergei 03/11: a phone number is read, not compared in a column — proportional digits (tabular ones left gaps around each «1») */
  .tel__n { display: inline; font-size: var(--fs-s-1); letter-spacing: .04em; font-variant-numeric: lining-nums proportional-nums; }
  /* Στόχος αφής 44×44 (μετρήθηκε 20×12): οι γραμμές μένουν 20×12 οπτικά, αλλά η
     περιοχή που δέχεται το δάχτυλο είναι ολόκληρη. Αρνητικό margin ώστε να μην
     αλλάξει η στοίχιση της κεφαλίδας. */
  .burger {
    width: 44px; height: 44px; margin: 0 -12px;
    position: relative; background: none; border: 0; padding: 0; cursor: pointer;
  }
  .burger i {
    position: absolute; left: 12px; right: 12px; height: 1.5px; background: currentColor;
  }
  .burger i:nth-child(1) { top: 16px; }
  .burger i:nth-child(2) { top: 21px; }
  .burger i:nth-child(3) { top: 26px; }

  @media (min-width: 760px) {
    .site-header__in { padding: 22px var(--gut); }
    .brandlink__sm { display: none; }
    .brandlink__md { display: inline-flex; }
    .navright { gap: var(--s5); font-size: var(--fs-s-1); letter-spacing: .1em; }
    .langslot { display: inline-flex; }
    .tel__n { font-size: var(--fs-s-1); letter-spacing: .06em; }
  }

  @media (min-width: 1080px) {
    .navlinks {
      display: flex; gap: var(--s6);
      font-size: var(--fs-s-1); letter-spacing: .1em; text-transform: uppercase;
    }
    .burger { display: none; }
    /* the 7-section menu (en): a section opens its list on hover or keyboard focus */
    .nav7 { gap: var(--s5); align-items: center; }
    .nav7__s { position: relative; }
    .nav7__dd {
      position: absolute; top: 100%; left: calc(-1 * var(--s4)); z-index: 30; min-width: 260px;
      list-style: none; margin: 0; padding: var(--s3) 0; background: var(--paper);
      box-shadow: 0 18px 40px rgba(14, 18, 20, .16); text-transform: none; letter-spacing: 0;
      opacity: 0; visibility: hidden; transform: translateY(6px);
      transition: opacity .15s ease, transform .15s ease, visibility 0s .15s;
    }
    .nav7__s:is(:hover, :focus-within) .nav7__dd { opacity: 1; visibility: visible; transform: none; transition: opacity .15s ease, transform .15s ease; }
    .nav7__dd a { display: block; padding: 9px var(--s4); color: var(--ink-2); font-size: var(--fs-s0); white-space: nowrap; text-decoration: none; }
    .nav7__dd a:hover, .nav7__dd a:focus-visible { color: var(--ink); background: var(--paper-2); }
    .nav7__s::after { content: ""; position: absolute; left: 0; right: 0; top: 100%; height: 12px; }   /* hover bridge */
    /* Buy: three columns (types, areas, guides) with small labels, as the page labels */
    .nav7__dd--cols { display: grid; grid-template-columns: repeat(3, max-content); gap: 0 var(--s4); padding: var(--s4) var(--s2); }
    .nav7__dd--cols ul { list-style: none; margin: 0; padding: 0; }
    .nav7__gh { margin: 0 0 var(--s1); padding: 0 var(--s4); font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .12em;
      text-transform: uppercase; color: var(--faint); }
    /* the phone lives in Contact on desktop (#370); below 1080 the header keeps its call button */
    .tel { display: none; }
  }
  /* #262: the Greek menu is ~90px wider than the English one; between 1080 and 1319px the header row would
     overflow (logo + 8 items + phone + language + sign in). Tighter gaps and the phone as its icon only (the
     number stays in its aria-label); from 1320px everything as designed. */
  @media (min-width: 1080px) and (max-width: 1319px) {
    .nav7 { gap: 18px; }
    .navright { gap: var(--s3); }
    .tel__n { display: none; }
  }
</style>

<style>
  /* Ο λογαριασμός ξεχωρίζει διακριτικά από τους υπόλοιπους συνδέσμους — μια τελεία,
     όχι εικονίδιο: το εικονίδιο «άνθρωπος» θα ζητούσε δεύτερο χρώμα και θα τραβούσε
     το μάτι από το τηλέφωνο, που είναι ο πρώτος στόχος της κεφαλίδας. */
  .acct { position: relative; padding-left: 13px; }
  .acct::before {
    content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .55;
  }
</style>

<style is:global>
  /* ── Sergei 03/11: on every page the header leaves when the page scrolls down and comes
        back (solid white, ink text) as soon as it scrolls up; at the top it is itself again ── */
  header.site-header.hdr-pin {
    position: fixed !important; top: 0; left: 0; right: 0; z-index: 900;   /* above every panel of the pages (the property «Nearby» list has 600), #250 */
    background: var(--paper) !important; color: var(--ink) !important;
    border-bottom: 1px solid var(--line-soft); box-shadow: 0 6px 20px rgba(10,14,16,.06);
    transform: translateY(-100%); transition: transform .3s cubic-bezier(.4,0,.2,1);
  }
  header.site-header.hdr-pin.hdr-show { transform: none; }
  header.site-header.hdr-pin .lsw > summary, header.site-header.hdr-pin .lsw > summary:hover { color: var(--ink); }
  .hdr-spacer { display: block; }
  /* while the bar is shown, sticky boxes sit under it, not behind it */
  html.hdr-up .side, html.hdr-up .art-side, html.hdr-up .info-side { top: calc(var(--hdr-h, 88px) + 12px) !important; }
  .art-side, .info-side { transition: top .25s ease; }
  @media (prefers-reduced-motion: reduce) { header.site-header.hdr-pin { transition: none; } }
</style>

<script>
  // Hide on the way down, show on the way up. The header switches to a fixed bar only once it
  // is out of view, so nothing jumps; a static header leaves a spacer of its own height behind.
  const hdr = document.querySelector<HTMLElement>('header.site-header');
  if (hdr) {
    const staticBox = getComputedStyle(hdr).position !== 'absolute';   // the solid bar is in the flow (relative since #250)
    let spacer: HTMLElement | null = null;
    let h = hdr.offsetHeight, last = window.scrollY, pinned = false, tick = false;
    const busy = () => !!hdr.querySelector('details[open]') || document.querySelector('[data-menu-open]')?.getAttribute('aria-expanded') === 'true';
    const pin = (on: boolean) => {
      if (on === pinned) return;
      pinned = on;
      if (on) {
        h = hdr.offsetHeight;
        if (staticBox) { spacer = document.createElement('div'); spacer.className = 'hdr-spacer'; spacer.style.height = `${h}px`; hdr.before(spacer); }
        hdr.classList.add('hdr-pin');
      } else {
        hdr.classList.remove('hdr-pin', 'hdr-show');
        spacer?.remove(); spacer = null;
      }
    };
    const run = () => {
      tick = false;
      const y = window.scrollY, d = y - last;
      if (y <= h) { pin(false); document.documentElement.classList.remove('hdr-up'); last = y; return; }   // at the top: the header as designed
      if (Math.abs(d) < 6) return;                            // ignore jitter
      pin(true);
      if (d < 0) hdr.classList.add('hdr-show');               // going up: it comes back
      else if (!busy()) hdr.classList.remove('hdr-show');     // going down: it leaves
      // sticky boxes (price box, side menus) move down while the bar is shown
      document.documentElement.classList.toggle('hdr-up', hdr.classList.contains('hdr-show'));
      document.documentElement.style.setProperty('--hdr-h', `${h}px`);
      last = y;
    };
    window.addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(run); } }, { passive: true });
  }
</script>
