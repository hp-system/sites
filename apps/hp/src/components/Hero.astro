---
// ΜΠΛΟΚ 2 — Hero: ο τόπος, και η αναζήτηση.
// Δουλειά του: να καταλάβει πού βρίσκεται και να ξεκινήσει αναζήτηση.
//
// Απόφαση George 27/7: «το hero property πρέπει να υπάρχει αλλά όχι σαν κάτι που
// βλέπει μόλις μπει ο πελάτης» → εδώ ήρεμη εικόνα τόπου· το ένα μεγάλο ακίνητο
// μετακινήθηκε πιο κάτω (δες FeatureProperty.astro).
//
// ⛔ ΚΑΜΙΑ υδατογράφηση — ΟΧΙ επειδή είναι μεγάλη, αλλά επειδή είναι **τοπίο**.
// Η φωτογραφία εδώ βγαίνει από το `heroShot()`: δική μας επιλεγμένη εικόνα
// τόπου, όχι εμπόρευμα. Κάθε φωτογραφία ΑΚΙΝΗΤΟΥ υδατογραφείται σε κάθε
// μέγεθος — δες τον κανόνα στο lib/photos.ts (διόρθωση George 29/7).
import { t, type Lang } from '../lib/i18n';
import {
  clean, cleanSrcSet, cleanSrcSetSmall,
  marked, markedSrcSet, markedSrcSetSmall, focalStyle, type Photo,
} from '../lib/photos';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  lang: Lang; photo: Photo | null; alt: string;
  munis: { name: string; n: number; key?: string }[]; total: number;
}
const { lang, photo, alt, munis, total } = Astro.props;

// 🛡️ Η ΤΡΥΠΑ ΤΗΣ ΕΦΕΔΡΕΙΑΣ. Το `home.ts` βάζει `tag: 'hero'` ΜΟΝΟ όταν η
//    φωτογραφία βγαίνει από τον δικό μας πίνακα τοπίων. Αν ο πίνακας αδειάσει,
//    πέφτει σε `coverOf()` — δηλαδή σε φωτογραφία ΑΚΙΝΗΤΟΥ, που ως τις 29/7
//    θα σερβιριζόταν καθαρή στα 1920px. Ο κανόνας κοιτάζει το ΠΕΡΙΕΧΟΜΕΝΟ:
//    τοπίο → καθαρή, ακίνητο → υδατογραφημένη, ό,τι κι αν συμβεί στον πίνακα.
const scenic = photo?.tag === 'hero';
const src = photo ? (scenic ? clean(photo.url) : marked(photo.url, 1920)) : '';
const setBig = photo ? (scenic ? cleanSrcSet(photo.url) : markedSrcSet(photo.url)) : '';
const setSmall = photo ? (scenic ? cleanSrcSetSmall(photo.url) : markedSrcSetSmall(photo.url)) : '';
---
<div class="hero" style={focalStyle(photo)}>
  <div class="hero__bg">
    {/* 🪤 ΤΟ `<source>` ΚΟΒΕΙ ΤΟ 1920 ΑΠΟ ΤΑ ΚΙΝΗΤΑ.
        Με σκέτο srcset + `sizes="100vw"`, ένα DPR3 κινητό (κάθε iPhone Pro)
        ζητούσε 1170px και κατέβαζε το πλήρες **1920×1280, 669 KB** — LCP
        4.405 ms σε Slow 4G. Κάτω από 760px δίνουμε μόνο 400/800.
        Το σχόλιο μένει ΕΞΩ από το `{cond && ()}` — μέσα σπάει το build. */}
    {src && (
      <picture>
        <source media="(max-width: 759px)" srcset={setSmall} sizes="100vw" />
        <img src={src}
             srcset={setBig}
             sizes="100vw" alt={alt} width="1920" height="1280"
             fetchpriority="high" decoding="async" />
      </picture>
    )}
  </div>
  <div class="scrim scrim--bottom"></div>

  <Header lang={lang} />
  <MobileMenu lang={lang} munis={munis} total={total} />

  <div class="hero__copy">
    <h1 class="t-display">{t(lang, 'hero.h1')}</h1>
    <p class="hero__sub">{t(lang, 'hero.sub')}</p>
  </div>
</div>

<style>
  .hero {
    position: relative;
    min-height: 86svh;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .hero__bg { position: absolute; inset: 0; background: var(--paper-2); }
  .hero__bg img {
    width: 100%; height: 100%; object-fit: cover;
    /* ΣΗΜΕΙΟ ΕΣΤΙΑΣΗΣ — ένα αρχείο, σωστό κάδρο σε κάθε οθόνη.
       Δεν χρειάζεται δεύτερη φωτογραφία σε άλλη κοπή. */
    object-position: var(--focal, 50% 50%);
    animation: fadeUp .2s ease-out both;
  }
  @keyframes fadeUp { from { opacity: 0 } to { opacity: 1 } }

  .hero__copy { position: relative; color: #fff; padding: 0 var(--gut) var(--s5); }
  .hero__copy h1 { max-width: 16ch; }
  .hero__sub {
    margin: var(--s3) 0 0; font-size: 15px; line-height: 1.55;
    color: rgba(255,255,255,.88); max-width: 34ch;
  }

  @media (min-width: 760px) {
    .hero { min-height: 82vh; }
    .hero__copy { padding-bottom: var(--s6); max-width: var(--max); margin: 0 auto; width: 100%; }
    .hero__sub { font-size: 17px; }
  }
  @media (min-width: 1100px) { .hero__copy h1 { max-width: 14ch; } }
</style>
