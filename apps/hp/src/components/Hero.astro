---
// ΜΠΛΟΚ 2 — Hero: ο τόπος, και η αναζήτηση.
// Δουλειά του: να καταλάβει πού βρίσκεται και να ξεκινήσει αναζήτηση.
//
// Απόφαση George 27/7: «το hero property πρέπει να υπάρχει αλλά όχι σαν κάτι που
// βλέπει μόλις μπει ο πελάτης» → εδώ ήρεμη εικόνα τόπου· το ένα μεγάλο ακίνητο
// μετακινήθηκε πιο κάτω (δες FeatureProperty.astro).
//
// ⛔ ΚΑΜΙΑ υδατογράφηση — ΟΧΙ επειδή είναι μεγάλη, αλλά επειδή είναι **τοπίο**.
// Η φωτογραφία εδώ βγαίνει από το `heroShot()`: δική μας επιλεγμένη εικόνα
// τόπου, όχι εμπόρευμα. Κάθε φωτογραφία ΑΚΙΝΗΤΟΥ υδατογραφείται σε κάθε
// μέγεθος — δες τον κανόνα στο lib/photos.ts (διόρθωση George 29/7).
import { t, type Lang } from '../lib/i18n';
import {
  clean, cleanSrcSet, cleanSrcSetSmall,
  marked, markedSrcSet, markedSrcSetSmall, focalStyle, type Photo,
} from '../lib/photos';
import { heroMessage } from '../lib/hero-messages';
import { isProd } from '../lib/seo';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  lang: Lang; photo: Photo | null; alt: string;
  munis: { name: string; n: number; key?: string }[]; total: number;
  /** George's SEO spec H1 for the home page (P01, Sergei 08/11); falls back to the i18n H1. */
  h1?: string;
}
const { lang, photo: basePhoto, alt, munis, total, h1 } = Astro.props;
const H1 = h1 || t(lang, 'hero.h1');

// The message slot (lib/hero-messages.ts): a dated message replaces the default copy, and its
// own picture / video / plain ground. `?hero=<id>` previews one off production only.
const msg = heroMessage(lang, new Date(), isProd(Astro.request, Astro.url) ? null : Astro.url.searchParams.get('hero'));
const photo = msg?.look === 'photo' && msg.shot ? { url: msg.shot.url, tag: 'hero', focal: msg.shot.focal } as Photo : basePhoto;
const plain = msg?.look === 'plain';
const video = msg?.look === 'video' ? msg.video : undefined;

// 🛡️ Η ΤΡΥΠΑ ΤΗΣ ΕΦΕΔΡΕΙΑΣ. Το `home.ts` βάζει `tag: 'hero'` ΜΟΝΟ όταν η
//    φωτογραφία βγαίνει από τον δικό μας πίνακα τοπίων. Αν ο πίνακας αδειάσει,
//    πέφτει σε `coverOf()` — δηλαδή σε φωτογραφία ΑΚΙΝΗΤΟΥ, που ως τις 29/7
//    θα σερβιριζόταν καθαρή στα 1920px. Ο κανόνας κοιτάζει το ΠΕΡΙΕΧΟΜΕΝΟ:
//    τοπίο → καθαρή, ακίνητο → υδατογραφημένη, ό,τι κι αν συμβεί στον πίνακα.
const scenic = photo?.tag === 'hero';
const src = photo ? (scenic ? clean(photo.url) : marked(photo.url, 1920)) : '';
const setBig = photo ? (scenic ? cleanSrcSet(photo.url) : markedSrcSet(photo.url)) : '';
const setSmall = photo ? (scenic ? cleanSrcSetSmall(photo.url) : markedSrcSetSmall(photo.url)) : '';
---
<div class:list={['hero', msg && 'hero--msg', plain && 'hero--plain']} style={focalStyle(photo)} data-hero-msg={msg?.id}>
  <div class="hero__bg">
    {/* a video message: muted loop over its poster; data saver / reduced motion keep the poster only */}
    {video && (
      <video class="hero__vid" src={video.mp4} poster={video.poster} muted loop playsinline autoplay preload="metadata" aria-hidden="true"></video>
    )}
    {/* 🪤 ΤΟ `<source>` ΚΟΒΕΙ ΤΟ 1920 ΑΠΟ ΤΑ ΚΙΝΗΤΑ.
        Με σκέτο srcset + `sizes="100vw"`, ένα DPR3 κινητό (κάθε iPhone Pro)
        ζητούσε 1170px και κατέβαζε το πλήρες **1920×1280, 669 KB** — LCP
        4.405 ms σε Slow 4G. Κάτω από 760px δίνουμε μόνο 400/800.
        Το σχόλιο μένει ΕΞΩ από το `{cond && ()}` — μέσα σπάει το build. */}
    {src && !plain && !video && (
      <picture>
        <source media="(max-width: 759px)" srcset={setSmall} sizes="100vw" />
        <img src={src}
             srcset={setBig}
             sizes="100vw" alt={alt} width="1920" height="1280"
             fetchpriority="high" decoding="async" />
      </picture>
    )}
  </div>
  <div class="scrim scrim--bottom"></div>

  <Header lang={lang} />
  <MobileMenu lang={lang} munis={munis} total={total} />

  <div class="hero__copy">
    {msg ? (
      <>
        {/* the H1 never changes (SEO); while a message is on it is the small line above it */}
        <h1 class="hero__h1s">{H1}</h1>
        {msg.eyebrow?.[lang] && <p class="hero__eb">{msg.eyebrow[lang]}</p>}
        <p class="t-display hero__t">{msg.title[lang]}</p>
        {msg.text?.[lang] && <p class="hero__sub">{msg.text[lang]}</p>}
        {msg.cta?.label[lang] && (
          <a class="hero__cta" href={msg.cta.href(lang)} data-ev="hero:cta" data-ev-label={msg.id}>{msg.cta.label[lang]}</a>
        )}
      </>
    ) : (
      <>
        <h1 class="t-display">{H1}</h1>
        <p class="hero__sub">{t(lang, 'hero.sub')}</p>
      </>
    )}
  </div>
  {video && (
    <script is:inline>
      (function () {
        var v = document.querySelector('.hero__vid'); if (!v) return;
        var save = navigator.connection && navigator.connection.saveData;
        if (save || matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); v.preload = 'none'; }
      })();
    </script>
  )}
</div>

<style>
  .hero {
    position: relative;
    min-height: 86svh;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .hero__bg { position: absolute; inset: 0; background: var(--paper-2); }
  .hero__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero--plain .hero__bg { background: var(--ink-deep); }
  .hero__h1s { margin: 0 0 var(--s4); font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.78); }
  .hero__eb { margin: 0 0 var(--s3); font-size: var(--fs-s0); color: rgba(255,255,255,.82); }
  .hero__t { margin: 0; max-width: 20ch; }
  .hero--msg:not(.hero--plain) :is(.hero__h1s, .hero__eb, .hero__sub) { text-shadow: 0 1px 2px rgba(0,0,0,.45), 0 4px 14px rgba(0,0,0,.45); }
  .hero__cta {
    display: inline-flex; align-items: center; height: 48px; margin-top: var(--s5); padding: 0 24px;
    font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; text-decoration: none;
    /* a message button is not a call to register: white outline, never the gilded edge (Sergei 03/11) */
    color: #fff; border: 1px solid rgba(255,255,255,.6); background: rgba(11,14,16,.2);
    transition: background .25s ease, color .25s ease, border-color .25s ease;
  }
  .hero__cta:hover, .hero__cta:focus-visible { background: #fff; color: var(--ink); border-color: #fff; }
  .hero__cta:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  /* the search bar overlaps the hero's bottom (49 px phones, 33 px from 760 px): a message's button stays clear of it */
  .hero--msg .hero__copy { padding-bottom: calc(var(--s5) + 44px); }
  @media (min-width: 760px) { .hero--msg .hero__copy { padding-bottom: calc(var(--s6) + 28px); } }
  .hero__bg img {
    width: 100%; height: 100%; object-fit: cover;
    /* ΣΗΜΕΙΟ ΕΣΤΙΑΣΗΣ — ένα αρχείο, σωστό κάδρο σε κάθε οθόνη.
       Δεν χρειάζεται δεύτερη φωτογραφία σε άλλη κοπή. */
    object-position: var(--focal, 50% 50%);
    animation: fadeUp .2s ease-out both;
  }
  @keyframes fadeUp { from { opacity: 0 } to { opacity: 1 } }

  .hero__copy { position: relative; color: #fff; padding: 0 var(--gut) var(--s5); }
  .hero__copy h1 { max-width: 16ch; }
  .hero__sub {
    margin: var(--s3) 0 0; font-size: var(--fs-s0); line-height: 1.55;
    color: rgba(255,255,255,.88); max-width: 34ch;
  }

  @media (min-width: 760px) {
    .hero { min-height: 82vh; }
    .hero__copy { padding-bottom: var(--s6); max-width: var(--max); margin: 0 auto; width: 100%; }
    .hero__sub { font-size: var(--fs-s0); }
  }
  /* desktop (Sergei 03/11): the first screen ends at the bottom of the first row of photos
     (the bar, «New properties» and the photos take 344 px under the hero), never below 420 px */
  @media (min-width: 1024px) { .hero { min-height: max(420px, calc(100vh - 344px)); } }
  /* desktop: the title in one line (Sergei 02/11) */
  @media (min-width: 1024px) { .hero__copy h1 { max-width: none; } }
  /* #101 desktop redesign: a lighter shade, dark only at the top (menu) and the
     bottom (title) — the middle of the photo stays clear. */
  @media (min-width: 1024px) {
    .hero .scrim--bottom {
      background: linear-gradient(180deg, rgba(10,14,16,.42) 0%, rgba(10,14,16,0) 22%,
                                  rgba(10,14,16,0) 55%, rgba(10,14,16,.42) 100%);
    }
    .hero__sub { max-width: none; }
  }
</style>
