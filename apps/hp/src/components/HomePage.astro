---
// ═══════════════════════════════════════════════════════════════════════════
// Η ΑΡΧΙΚΗ — έντεκα μπλοκ, με τη σειρά των εγκεκριμένων κανόνων.
// Κάθε μπλοκ κάνει μία δουλειά. Το αρχείο μένει λεπτό: η λογική είναι στο lib.
// ═══════════════════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import SearchBar from './SearchBar.astro';
import FilterSheet from './FilterSheet.astro';
import FeaturedGrid from './FeaturedGrid.astro';
import FeatureProperty from './FeatureProperty.astro';
import OffMarket from './OffMarket.astro';
import Collections from './Collections.astro';
import Areas from './Areas.astro';
import Construction from './Construction.astro';
import Valuation from './Valuation.astro';
import Doors from './Doors.astro';
import Abroad from './Abroad.astro';
import Footer from './Footer.astro';
import SpecText from './SpecText.astro';
import { specOf, specTitle } from '../lib/seo-pages';

import { allProperties, visitorCountry, refOf, priceOf, priceVisible } from '../lib/api';
import { buildHome } from '../lib/home';
import { coverOf, marked, clean, heroReady, shareImage, SHARE_W, SHARE_H, type Photo } from '../lib/photos';
import { hasPool, catKey, facetUrl, FACETS } from '../lib/listing';
import { fromPrice } from '../lib/prices';
import { muniKey } from '../lib/gate';
import { AREA_PAGES, areaUrl } from '../content/areas/en';
import { money } from '../lib/format';
import { t, listUrl, DEFAULT_LANG, type Lang } from '../lib/i18n';
import { num } from '../lib/format';
import { viewerOf, municipalityOf } from '../lib/gate';
import { company } from '../lib/company';
import { cmsText, cmsImage } from '../lib/content';
import { brand } from '../brand/index';

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? DEFAULT_LANG;
// Ο κανόνας ορατότητας περνά από ΕΔΩ σε όλα τα components — δες lib/gate.ts:
// ο δήμος είναι δημόσιος, η ΠΕΡΙΟΧΗ μόνο σε μέλη.
const viewer = await viewerOf(Astro.cookies);

// 🔐 ΤΟ TOKEN ΤΟΥ ΜΕΛΟΥΣ ΠΕΡΝΑΕΙ ΣΤΟ API (29/7). Ως τότε δεν περνούσε ποτέ:
//    το `viewer.member` άλλαζε μόνο ΤΙ ΕΜΦΑΝΙΖΑΜΕ, ενώ τα ΔΕΔΟΜΕΝΑ ήταν πάντα
//    το ανώνυμο σύνολο — η ιδιωτική συλλογή δεν ξεκλείδωνε ποτέ, ούτε για μέλος.
//    Η μνήμη είναι πλέον ανά θεατή· δες το σχόλιο στο lib/api.ts.
const memberToken = Astro.cookies.get('member_token')?.value;

let items: Awaited<ReturnType<typeof allProperties>> = [];
let apiDown = false;
try {
  items = await allProperties(memberToken, visitorCountry(Astro.request));   // #18
} catch (e) {
  // Το site δεν πέφτει επειδή έπεσε το API — δείχνει σκελετό και το λέει στα logs.
  apiDown = true;
  console.error('[αρχική] το EALIDA API δεν απάντησε:', (e as Error).message);
}

const d = buildHome(items, lang);

// 🖼️ Η ΕΙΚΟΝΑ ΤΗΣ ΠΡΩΤΗΣ ΟΘΟΝΗΣ — ΤΟ CMS ΥΠΕΡΙΣΧΥΕΙ **ΜΟΝΟ ΟΤΑΝ ΕΧΕΙ ΤΙΜΗ**.
//    Η σημερινή δεν είναι σκληροκωδικοποίηση, είναι ΑΠΟΦΑΣΗ: ο George τη διάλεξε
//    27/7 μέσα από 8.405 φωτογραφίες με 11 κριτές, και το σημείο εστίασης
//    ρυθμίστηκε για το κόψιμο στα 390px. Ένα κατά λάθος ανέβασμα στο CMS δεν
//    επιτρέπεται να τη σβήσει — γι' αυτό η υπερίσχυση είναι μονόδρομη.
//    ⚠️ Σήμερα το `media` γυρίζει `{}` (καμία εικόνα ανεβασμένη), άρα αδρανές.
const cmsHero = await cmsImage('hero.main');
if (cmsHero) {
  d.heroPhoto = { url: cmsHero.url, tag: 'hero',
                  alt: (d.heroPhoto as any)?.alt ?? {}, focal: cmsHero.focal } as any;
}
// Ακίνητα με σημαία «εκτός δημοσίευσης». Μετρήθηκε στη βάση: 81 συνολικά,
// τα 2 είναι δημόσια → 79 πραγματικά εκτός. Στη Φ2 έρχεται από το API.
// ⚠️ Ο αριθμός ΔΕΝ εμφανίζεται πουθενά πια — κρίνει μόνο αν το μπλοκ υπάρχει.
// B-18: the CMS can override it (key `offmarket.count`, a number); 79 stays the fallback.
const offRaw = await cmsText(lang, 'offmarket.count');
const OFF_MARKET = offRaw !== null && /^\d+$/.test(offRaw) ? Number(offRaw) : 79;
// B-13 / D-157: the valuation form is off until its real page exists (M3).
const SHOW_VALUATION = false;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Η ετικέτα του μεγάλου ακινήτου ΕΡΧΕΤΑΙ ΠΛΕΟΝ ΟΝΤΩΣ ΑΠΟ ΤΟ CMS (5/8).
// George: «δεν ξέρω αν θέλω να είναι της εβδομάδας — μπορεί του μήνα, ή να μη λέει
// τίποτα και να διαφημίζουμε ό,τι θέλουμε». Ακριβώς γι' αυτό δεν είναι σταθερά:
//   · γράφει κάτι στο CMS  → αυτό βγαίνει
//   · αφήνει το πεδίο κενό → ΚΑΝΕΝΑ λεκτικό, σκέτο το ακίνητο
// 🪤 ΔΕΝ πέφτει πίσω στο λεξικό. Το `t(lang,'week.eyebrow')` λέει «Το ακίνητο της
//    εβδομάδας» — αν το βάζαμε ως εφεδρεία, το άδειασμα του πεδίου δεν θα έσβηνε
//    ποτέ την ετικέτα και ο George δεν θα είχε τρόπο να την κλείσει.
const FEATURE_LABEL: string | null = await cmsText(lang, 'week.eyebrow');

// ── Οι τέσσερις συλλογές — έτοιμες αναζητήσεις για τα πιο συχνά αιτήματα ──
const url = listUrl(lang);
// Το πλακίδιο συλλογής παίρνει φωτό από ακίνητο που ΠΕΡΝΑΕΙ τη δικλείδα
// «έτοιμο για μεγάλη θέση» — αλλιώς έβγαινε χωματόδρομος για την «πρώτη γραμμή».
// Προτιμάται το ακριβότερο: το πλακίδιο είναι βιτρίνα, όχι δείγμα.
// …και ΠΟΤΕ το ίδιο ακίνητο σε δύο πλακίδια: το 7010 είναι και πρώτη γραμμή
// και με πισίνα, οπότε χωρίς φύλαξη έβγαινε η ίδια φωτογραφία δύο φορές.
//
// 🔴 29/7 — ΤΟ ΦΡΑΓΜΑ ΕΠΕΚΤΑΘΗΚΕ ΣΕ ΟΛΗ ΤΗ ΣΕΛΙΔΑ. Μετρήθηκε ότι η ΙΔΙΑ
//    φωτογραφία (pool-2974737149) κατέβαινε ΔΥΟ ΦΟΡΕΣ: καθαρή `_800.jpg` για
//    το πλακίδιο συλλογής και υδατογραφημένη `_800w.jpg` για την κάρτα του
//    ίδιου ακινήτου. 95 + 99 KB — αλλά το βάρος είναι το μικρό κακό: ο
//    επισκέπτης έβλεπε **την ίδια εικόνα δύο φορές στην ίδια σελίδα**.
//    Το παλιό `usedTiles` έπιανε μόνο τη σύγκρουση ΜΕΤΑΞΥ πλακιδίων.
const usedTiles = new Set<string>([
  ...d.newest.map((p) => p.id),            // οι έξι κάρτες («New properties», #101)
  ...(d.week ? [d.week.id] : []),           // το μεγάλο ακίνητο
]);
const pickPhoto = (f: (a: any) => boolean) => {
  const hit = items
    .filter((p) => !usedTiles.has(p.id) && f(p.attributes ?? {})
                   && heroReady(p.attributes) && priceVisible(p.attributes))
    .sort((a, b) => priceOf(b.attributes) - priceOf(a.attributes))[0]
    ?? items.find((p) => !usedTiles.has(p.id) && f(p.attributes ?? {}));
  if (hit) usedTiles.add(hit.id);
  return hit ? coverOf(hit.attributes) : null;
};
// #101 (George 2026-11-02): eight tiles in two pages of four, in the order of the
// approved mockup. The first four are the old collections (same links); the next
// four are every type of property. A tile with no property behind it is dropped.
const sub = (a: any) => String(a?.subcategory ?? '').toLowerCase();
const COLLS: { key: string; title: string; href: string; keep: (a: any) => boolean }[] = [
  { key: 'sea',  title: t(lang, 'coll.sea'),  href: `${url}?sea_access=front`, keep: (a) => a.sea_access === 'front' },
  // 🪤 ΤΟ ΠΛΑΚΙΔΙΟ ΕΛΕΓΕ **308** ΕΝΩ Η ΑΛΗΘΕΙΑ ΕΙΝΑΙ **103** (διορθώθηκε 30/7).
  //    Το `pools` δεν είναι σημαία ναι/όχι — είναι πολλαπλή επιλογή με κωδικούς,
  //    και ο κωδικός «2» σημαίνει **ΧΩΡΙΣ ΠΙΣΙΝΑ**: τον έχουν 203 ακίνητα.
  //    Το `hasPool()` κοιτάζει ΤΙΜΕΣ (3/4/5/6) — δες lib/listing.ts.
  { key: 'pool', title: t(lang, 'coll.pool'), href: `${url}?pool=1`, keep: (a) => hasPool(a) },
  // 🪤 ΕΔΩ ΗΤΑΝ «Σπάνια & μοναδικά» με σύνδεσμο `?rare=1` — φίλτρο που ΔΕΝ ΥΠΑΡΧΕΙ.
  //    Τα ακίνητα άνω του εκατομμυρίου έχουν 4,23 αιτήματα ανά ακίνητο (μετρήθηκε).
  { key: 'top',  title: t(lang, 'coll.top'),  href: `${url}?price_min=1000000`, keep: (a) => priceOf(a) >= 1_000_000 },
  { key: 'land', title: t(lang, 'coll.land'), href: `${url}?category=land`, keep: (a) => a.category === 'land' },
  { key: 'houses', title: t(lang, 'coll.houses'), href: facetUrl(lang, 'houses'),
    keep: (a) => catKey(a) === 'residency' && sub(a).startsWith('detached house') },
  { key: 'maisonettes', title: t(lang, 'kinds.maisonettes'), href: facetUrl(lang, 'maisonettes'),
    keep: (a) => catKey(a) === 'residency' && sub(a).startsWith('maisonette') },
  { key: 'apartments', title: t(lang, 'kinds.apartments'), href: `${url}?type=apartment`,
    keep: (a) => catKey(a) === 'residency' && sub(a).startsWith('apartment') },
  { key: 'business', title: t(lang, 'coll.hotels'), href: `${url}?category=business`, keep: (a) => catKey(a) === 'business' },
];
// Photos are picked in the OLD order (sea, pool, land, top…): «above one million»
// would otherwise take the dearest land plot and leave «Land & plots» a second-best.
const PICK_ORDER = ['sea', 'pool', 'land', 'top', 'houses', 'maisonettes', 'apartments', 'business'];
const collPhoto = new Map<string, ReturnType<typeof pickPhoto>>();
for (const k of PICK_ORDER) {
  const c = COLLS.find((x) => x.key === k);
  if (c && items.some((p) => c.keep(p.attributes ?? {}))) collPhoto.set(k, pickPhoto(c.keep));
}
const collections = COLLS
  .filter((c) => collPhoto.has(c.key))
  .map((c) => ({ key: c.key, title: c.title, sub: t(lang, 'f.show_all'), href: c.href, photo: collPhoto.get(c.key) ?? null }));

// ── By area (#101): the four municipality pages with their «from €» ──────────
// English links the area pages (/en/property-for-sale/…), other languages the
// municipality facet of the list. Guests see only the municipality — never the area.
const areaTiles = AREA_PAGES.filter((p) => p.kind === 'municipality')
  .map((p) => {
    const facet = FACETS.find((f) => f.q.municipality === p.q.municipality);
    const keep = (a: any) => muniKey(a) === p.q.municipality;
    const from = fromPrice(items, keep);
    const name = facet?.name[lang] ?? p.name;
    return {
      key: p.slug, name, from,
      href: lang === 'en' ? areaUrl(p.slug) : (facet ? facetUrl(lang, facet.key) : url),
      alt: t(lang, 'home.area_alt', { name }),
      keep,
    };
  })
  .filter((x) => x.from > 0)
  .slice(0, 4)
  .map(({ keep, ...x }) => ({ ...x, fromText: t(lang, 'home.from', { price: money(x.from, lang) }), photo: pickPhoto(keep) }));
const areasFrom = areaTiles.length ? Math.min(...areaTiles.map((x) => x.from)) : 0;

// ── Structured data — σήμερα το site έχει ΜΟΝΟ microdata ImageObject ──────
// 🛡️ Η εικόνα κοινοποίησης ΔΕΝ χτίζεται εδώ. Το `shareImage()` κρίνει μόνο του
//    «τοπίο ή ακίνητο» και διαλέγει καθαρή ή υδατογραφημένη — δες lib/photos.ts.
//    Ως τις 29/7 εδώ καθόταν σκέτο `clean()`: αν άδειαζε ο πίνακας τοπίων, κάθε
//    κοινοποίηση σε WhatsApp/Viber μοίραζε το καθαρό πρωτότυπο ενός ακινήτου.
const co = await company();
const ogPhoto = shareImage(d.heroPhoto as Photo | null);
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': ['Organization', 'RealEstateAgent'],   // spec rule 11: Organization + RealEstateAgent
    '@id': `${site}#org`, name: co.legalName, url: site,
    // 🔴 ΑΥΤΑ ΤΑ ΔΙΑΒΑΖΕΙ Η GOOGLE. Κενή τιμή εδώ δεν «δείχνει άσχημα» — βγάζει
    //    το τηλέφωνο από το προφίλ της επιχείρησης. Γι' αυτό κάθε πεδίο περνά
    //    από το `company()`, που κρατά τη σημερινή τιμή όταν το CMS είναι κενό.
    telephone: co.phoneE164, email: co.email,
    areaServed: { '@type': 'AdministrativeArea', name: brand.market.areaServed },
    address: { '@type': 'PostalAddress', streetAddress: co.street, addressLocality: co.city,
               addressRegion: co.region, postalCode: co.postalCode, addressCountry: brand.address.country },
    foundingDate: String(co.foundedYear),
  },
  {
    '@context': 'https://schema.org', '@type': 'WebSite', url: site,
    inLanguage: lang, publisher: { '@id': `${site}#org` },
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${site}${url}?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    // Η λίστα των επιλεγμένων — έτσι το κάνει και το LuxuryEstate, που κατατάσσεται.
    '@context': 'https://schema.org', '@type': 'ItemList',
    name: t(lang, 'home.new_h2'), numberOfItems: d.newest.length,
    itemListElement: d.newest.map((p, i) => {
      const a = p.attributes ?? {};
      const c = coverOf(a);
      return {
        '@type': 'ListItem', position: i + 1,
        item: {
          '@type': 'RealEstateListing',
          url: `${site}/ακινητο/${refOf(p)}`,
          // ⚠️ ΔΗΜΟΣ, όχι περιοχή. Το structured data είναι δημόσιο κείμενο:
          // αν γράψει «Βουρβουρού», το κλείδωμα της γεωγραφίας καταρρέει εδώ.
          name: `${a.subcategory ?? ''} — ${municipalityOf(a, lang)}`.trim(),
          ...(c ? { image: marked(c.url, 800) } : {}),
          ...(priceVisible(a) ? {
            offers: { '@type': 'Offer', price: priceOf(a), priceCurrency: brand.market.currency,
                      availability: 'https://schema.org/InStock' },
          } : {}),
        },
      };
    }),
  },
];

// SEO portion 2 (Sergei 08/11): George's spec P01 for this language — title, meta, og, H1, hero alt,
// intro (between the H1 and the grid), the H2 body + FAQ + links (before «Buying from abroad»).
const spec = specOf('P01', lang);
const meta = {
  // No property counts in public text (George 17/10): title and description carry no number.
  title: spec ? specTitle(spec.title, brand.name) : t(lang, 'meta.title'),
  desc: spec ? spec.meta : t(lang, 'meta.desc'),
};
const heroAlt = spec?.heroAlt || d.heroAlt;
if (spec?.faq.length) jsonLd.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: spec.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} as any);
---
<Base lang={lang} title={meta.title} description={meta.desc} path="/" ogTitle={spec?.ogTitle}
      ogImage={ogPhoto} ogImageW={SHARE_W} ogImageH={SHARE_H} ogImageAlt={heroAlt}
      jsonLd={jsonLd}>
  {/* list → home move (Sergei 02/11): decided before the first paint, only when the visitor comes from
      the list (its note ≤ 10 s old), on desktop, without reduced motion; the class goes away after it. */}
  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem('hpFromList');
        localStorage.removeItem('hpFromList');
        var n = raw ? JSON.parse(raw) : null;
        if (!n || !n.t || Date.now() - n.t > 10000) return;
        if (!matchMedia('(min-width: 1024px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var r = document.documentElement;
        if (n.h) r.style.setProperty('--hf-h', Math.max(120, Math.min(600, Number(n.h) || 242)) + 'px');
        if (n.img && /^https?:\/\//.test(n.img)) r.style.setProperty('--hf-img', 'url("' + String(n.img).replace(/"/g, '') + '")');
        r.classList.add('hp-hfrom', 'hp-hfrom-hide');
        // the home photo fades in over the moving copy just after the move, then the copy goes
        setTimeout(function () { r.classList.remove('hp-hfrom-hide'); }, 1000);
        setTimeout(function () { r.classList.remove('hp-hfrom'); }, 1300);
      } catch (e) { /* storage off: no move */ }
    })();
  </script>
  {/* 1 κεφαλίδα (μέσα στο hero) · 2 hero */}
  <Hero lang={lang} photo={d.heroPhoto as Photo | null} alt={heroAlt} h1={spec?.h1} intro={spec?.intro}
        munis={d.munis.map((m) => ({ name: m.name, n: m.count, key: m.key }))} total={d.total} />
  <SearchBar lang={lang} total={d.total} />
  <FilterSheet lang={lang} total={d.total}
               munis={d.munis.map((m) => ({ name: m.name, n: m.count, key: m.key }))} />

  <main id="main" data-list-path={new URL(url, "http://x").pathname}>
    {apiDown && (
      <div class="wrap" style="padding:var(--s7) 0">
        <p class="t-body">Τα ακίνητα δεν είναι διαθέσιμα αυτή τη στιγμή. Δοκίμασε σε λίγο.</p>
      </div>
    )}

    {/* SEO portion 2: the spec intro is the hero's ticker, right under the H1 (spec rule 9) */}

    {/* 3 επιλεγμένα */}
    {d.newest.length > 0 && (
      <FeaturedGrid items={d.newest} lang={lang} total={d.total} viewer={viewer} />
    )}

    {/* 4 το μεγάλο ακίνητο (ετικέτα προαιρετική, από CMS) */}
    {d.week && <FeatureProperty p={d.week} lang={lang} viewer={viewer} eyebrow={FEATURE_LABEL} />}

    {/* 5 SECRET PORTFOLIO — καμία κάρτα, κανένας γρίφος, και από 28/7 κανένας αριθμός. */}
    <OffMarket lang={lang} count={OFF_MARKET} />

    {/* 6 ⛔ Ο ΧΑΡΤΗΣ ΤΩΝ ΖΩΝΩΝ ΑΦΑΙΡΕΘΗΚΕ (George, 28/7: «όλο αυτό το πράγμα
        θεωρώ ότι πρέπει να φύγει τελείως και να μην υπάρχει»).
        Είναι η ΤΡΙΤΗ εκδοχή του ίδιου μπλοκ που απορρίπτεται — πρώτα οι
        κλειδωμένες κάρτες, μετά οι κωδικοί ζωνών, τώρα και ο χάρτης κάλυψης.
        ⛔ ΜΗΝ ΤΟ ΞΑΝΑΠΡΟΤΕΙΝΕΙΣ σε άλλη μορφή. Το `lib/zones.ts` μένει στον
        δίσκο γιατί το `buildZones` δίνει και τα πλήθη δήμων. */}

    {/* 7 συλλογές — μένουν ακριβώς ως έχουν (George: «μια χαρά είναι»). */}
    <Collections items={collections} lang={lang} />

    {/* 7a #101: by area — the four municipality pages with «from €» (SEO). */}
    {areaTiles.length > 0 && <Areas lang={lang} items={areaTiles} from={areasFrom} />}

    {/* 7b ΜΕΛΕΤΗ & ΚΑΤΑΣΚΕΥΗ — μπαίνει ΑΜΕΣΩΣ μετά τις συλλογές επίτηδες:
        η μία από τις τέσσερις είναι «Γη & οικόπεδα» (207 από τα 527), και η
        επόμενη σκέψη του επισκέπτη είναι «και μετά τι;». Εδώ είναι η απάντηση. */}
    {/* Sergei 03/11: Design & construction now comes after «Three paths» (see below) */}

    {/* 8 εργαλείο ιδιοκτήτη */}
    {/* B-13 / D-157 (George, 2026-10-12): hidden until the real valuation page exists — the form
        posted to /valuation, which no route serves (404). The component stays for M3. */}
    {SHOW_VALUATION && d.benchmarks.length > 0 && (
      <Valuation lang={lang} comparables={d.comparables}
                 benchmarks={d.benchmarks} seafrontPremium={d.seafrontPremium} />
    )}

    {/* 9 τρεις πόρτες */}
    <Doors lang={lang} />

    {/* 7b moved here (Sergei 03/11): Design & construction right after «Three paths» */}
    <Construction lang={lang} />


    {/* George, 28/7: «η αγορά της Χαλκιδικής» και «ποιοι είμαστε» φεύγουν τελείως.
        Μένει ΜΟΝΟ η αγορά από το εξωτερικό — δες Abroad.astro. */}
    {/* SEO portion 2: George's H2 body, FAQ and links, right before «Buying from abroad» */}
    {spec && <SpecText page={spec} part="rest" lang={lang} />}

    <Abroad lang={lang} />
  </main>

  {/* 11 υποσέλιδο */}
  <Footer lang={lang} munis={d.munis} />

  {/* #101 desktop: back to top — a square that appears after the first screen. */}
  <button type="button" id="toTop" class="h-totop" aria-label={t(lang, 'home.top')}>
    <svg width="14" height="16" viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.6"
         stroke-linecap="square" aria-hidden="true"><path d="M7 15V2M1.5 7.5L7 2l5.5 5.5"></path></svg>
  </button>
</Base>

<style>
  /* 🕳️ ΤΟ ΚΕΝΟ ΚΑΤΩ ΑΠΟ ΤΗ ΜΠΑΡΑ ΑΝΑΖΗΤΗΣΗΣ (George, 30/7: «αρκετά μεγάλο,
     μίκρυνέ το κατά 50%»). Ήταν 107px στο desktop και 97px στο κινητό, από ΔΥΟ
     πηγές που καμία δεν ήταν γραμμένη ως «κενό κάτω από τη μπάρα»:
       (α) μισή μπάρα φάντασμα από το `transform` — λύθηκε στο SearchBar.astro
       (β) το κανονικό κενό κάθε τμήματος: 74px desktop, 48px κινητό

     Το (β) είναι ΚΑΘΟΛΙΚΟ — ο ρυθμός ΟΛΗΣ της σελίδας (`.section` στο base.css).
     ⛔ ΜΗΝ το αλλάξεις εκεί: θα μετακινούσε κάθε τμήμα σε κάθε σελίδα.
     Μόνο το ΠΡΩΤΟ τμήμα χρειάζεται λιγότερο, επειδή από πάνω του δεν υπάρχει
     άλλο τμήμα αλλά η μπάρα, που ήδη χωρίζει οπτικά.

     Στο κινητό δεν χρειάζεται τίποτα: μόνο το (α) έφερε ήδη 97 → 48. */
  @media (min-width: 760px) {
    /* 🪤 `:global` ΥΠΟΧΡΕΩΤΙΚΟ: το `<section>` το παράγει ΑΛΛΟ αρχείο
       (FeaturedGrid), οπότε χωρίς αυτό ο κανόνας δεν θα έβρισκε ποτέ στόχο
       και θα «δούλευε» σιωπηλά χωρίς να κάνει τίποτα. */
    #main > :global(section:first-of-type) { padding-top: 54px; }
  }
  /* #101 desktop: the mockup's rhythm — 40px under the bar. */
  @media (min-width: 1024px) {
    #main > :global(section:first-of-type) { padding-top: 40px; }
  }
</style>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════════════
     HOME — DESKTOP REDESIGN (#101, approved by George 2026-11-02).
     The pieces several home blocks share: page dashes, step dashes, the
     one-at-a-time stack, the gilded-edge turn, the half-screen zones and the
     back-to-top square. Every class starts with `h-` / `hz` and exists only on
     the home page; phones (< 1024px) keep George's layout.
     ═══════════════════════════════════════════════════════════════════════ */
  @property --gilda { syntax: '<angle>'; inherits: false; initial-value: 315deg; }
  @keyframes h-gturn { from { --gilda: 315deg; } to { --gilda: 675deg; } }

  .h-totop { display: none; }

  @media (min-width: 1024px) {
    /* page dashes (carousels) and step dashes (stacks): short marks, the active one
       long; the change slides; hovering the group makes them taller — nothing else */
    .h-dash, .h-bars { display: flex; gap: 6px; flex: none; }
    .h-bars { margin-top: 22px; }
    .h-dash button, .h-bar { all: unset; cursor: pointer; padding: 10px 0; }
    .h-dash button span, .h-bar span {
      display: block; width: 6px; height: 2px; background: rgba(14,18,20,.2);
      transition: width .35s cubic-bezier(.4,0,.2,1), transform .25s ease-out, background .2s ease;
    }
    .h-dash button.on span, .h-bar.on span { width: 22px; background: var(--ink); }
    .h-bars--dk .h-bar span { background: rgba(255,255,255,.25); }
    .h-bars--dk .h-bar.on span { background: #fff; }
    .h-dash:hover button span, .h-bars:hover .h-bar span { transform: scaleY(4); }
    .h-dash button:focus-visible, .h-bar:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
    .h-bars--dk .h-bar:focus-visible { outline-color: #fff; }

    /* one item at a time: all in the HTML, stacked in one cell */
    .h-stack { display: grid; }
    .h-stack > .h-sx {
      grid-area: 1 / 1; opacity: 0; transform: translateY(14px);
      transition: opacity .45s ease, transform .45s ease; pointer-events: none;
    }
    .h-stack > .h-sx.on { opacity: 1; transform: none; pointer-events: auto; }
    .h-stack > .h-sx.gone { transform: translateY(-14px); }

    /* gilded edge: the gradient turns once on entering the button's box */
    .h-gild.grun { animation: h-gturn 1.1s ease-in-out 1; }

    /* Collections + by area: together one screen, half each; Collections on beige */
    #main .hz { height: 50vh; min-height: 340px; box-sizing: border-box; padding: 28px 0; display: flex; }
    /* Sergei 02/11 (live, 2nd): every tile of both rows has ONE height — the photo shape of the property
       cards above (3:2) — whatever the screen height; the sections size to their tiles. */
    #main .hz { height: auto; min-height: 0; max-height: none; }
    #main .hz .h-rail, #main .hz .atiles { flex: none; }
    #main .hz .coll, #main .hz .atile { aspect-ratio: 3 / 2; height: auto; }
    #main .hz > .wrap { flex: 1; display: flex; flex-direction: column; min-height: 0; width: 100%; }
    #main .hz .hz-head { margin: 0 0 16px; flex: none; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
    #main .hz .h-rail, #main .hz .atiles { flex: 1; min-height: 0; }
    #main .hz .atiles { grid-template-rows: 100%; }
    #main .hz .atile { aspect-ratio: auto; height: 100%; }
    #main .hz .alinks { flex: none; margin-top: 14px; }
    #main .hz--beige { background: var(--paper-2); }

    /* back to top */
    .h-totop {
      all: unset; box-sizing: border-box; position: fixed; right: 24px; bottom: 24px; z-index: 70;
      width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;
      background: var(--paper); border: 1px solid rgba(14,18,20,.16); color: var(--ink); cursor: pointer;
      box-shadow: 0 8px 24px rgba(0,0,0,.10); opacity: 0; transform: translateY(12px); pointer-events: none;
      transition: opacity .3s ease, transform .3s ease, background .2s ease, border-color .2s ease;
    }
    .h-totop.on { opacity: 1; transform: none; pointer-events: auto; }
    .h-totop:hover { background: var(--paper-2); border-color: var(--ink); }
    .h-totop svg { transition: transform .25s ease; }
    .h-totop:hover svg { transform: translateY(-3px); }
    .h-totop:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
    [dir='rtl'] .h-totop { right: auto; left: 24px; }
  }

  /* ── list → home move: the list's 242 px strip grows into the home photo (same file; its focal point
        returns from the strip's bottom framing), the bar cross-fades (SearchBar), title and blocks come in last ── */
  /* the exact inverse of the home → list move: same photo file the strip showed (cached, no blank start),
     drawn as a background like the strip, the inverse timing curve; the home <img> takes over at the end */
  html.hp-hfrom .hero { animation: h-grow 0.95s cubic-bezier(.75,0,.45,1) both; }
  html.hp-hfrom .hero__bg { background-image: var(--hf-img, none); background-size: cover; background-repeat: no-repeat;
                            animation: h-bgpos 0.95s cubic-bezier(.75,0,.45,1) both; }
  html.hp-hfrom-hide .hero__bg img { opacity: 0 !important; animation: none !important; transition: none !important; }
  html.hp-hfrom .hero__copy { animation: h-in 1.15s ease both; }
  html.hp-hfrom #main { animation: h-in 1.2s ease both; }
  @keyframes h-grow { from { min-height: var(--hf-h, 242px); } to { min-height: max(420px, calc(100vh - 344px)); } }
  @keyframes h-bgpos { from { background-position: 50% 100%; } to { background-position: var(--focal, 50% 50%); } }
  @keyframes h-in { 0%, 65% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: none; } }
</style>

<script>
  // home → list move (Sergei 02/11): a note that lives 10 s, read once by the list page.
  // Desktop only; nothing is sent anywhere and the URL stays clean (no ?from=home).
  {
    const listPath = document.getElementById('main')?.dataset.listPath ?? '';
    const desk = window.matchMedia('(min-width: 1024px)');
    const note = (href: string | null) => {
      if (!desk.matches || !href || !listPath) return;
      try {
        const u = new URL(href, location.href);
        if (!(u.origin === location.origin && decodeURI(u.pathname).startsWith(decodeURI(listPath)))) return;
        // the list starts from this exact frame: the hero's height on screen, its photo and focal point
        const hero = document.querySelector<HTMLElement>('.hero');
        const img = hero?.querySelector<HTMLImageElement>('.hero__bg img');
        const r = hero?.getBoundingClientRect();
        const n: Record<string, unknown> = { t: Date.now() };
        if (r && img && r.top > -40 && r.bottom > 0) {
          n.h = Math.round(r.bottom); n.img = img.currentSrc || img.src; n.pos = getComputedStyle(img).objectPosition;
        }
        localStorage.setItem('hpFromHome', JSON.stringify(n));
      } catch { /* storage off */ }
    };
    document.addEventListener('click', (e) => note((e.target as Element | null)?.closest?.('a[href]')?.getAttribute('href') ?? null), true);
    document.addEventListener('submit', (e) => { const f = e.target as HTMLFormElement; note(f.getAttribute('action') || location.href); }, true);
  }
</script>

<script>
  // ═══════════════════════════════════════════════════════════════════════
  // HOME — DESKTOP BEHAVIOUR (#101). Small and defensive: every piece checks
  // that its elements exist, works only at ≥1024px, and the motion stops for
  // `prefers-reduced-motion`. Nothing here loads content — it only moves what
  // is already in the HTML.
  // ═══════════════════════════════════════════════════════════════════════
  const desk = window.matchMedia('(min-width: 1024px)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const moving = () => desk.matches && !still.matches;

  // ── A sideways swipe (trackpad, or shift + wheel) as one step, the same on every rotating block
  //    (Sergei 03/11): `step(+1 | -1)` is called once per gesture; vertical scrolling is left alone.
  const onSwipe = (el: HTMLElement, step: (dir: 1 | -1) => void) => {
    let at = 0;
    el.addEventListener('wheel', (e) => {
      const dx = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : (e.shiftKey ? e.deltaY : 0);
      if (Math.abs(dx) < 8 || !desk.matches) return;
      e.preventDefault();
      if (Date.now() - at < 650) return;
      at = Date.now();
      const rtl = getComputedStyle(el).direction === 'rtl';
      step((dx > 0) !== rtl ? 1 : -1);
    }, { passive: false });
  };

  // ── Carousels: a page of four every 5 s while on screen; pointer/focus holds;
  //    a dash scrolls to its page and restarts the count; the dash follows the row.
  document.querySelectorAll<HTMLElement>('[data-hrail]').forEach((rail) => {
    const dash = document.querySelector<HTMLElement>(`[data-dash-for="${rail.id}"]`);
    if (!dash) return;
    const btns = Array.from(dash.querySelectorAll<HTMLButtonElement>('button'));
    const gap = Number(rail.dataset.gap || 0);
    const rtl = () => getComputedStyle(rail).direction === 'rtl';
    const pos = () => Math.abs(rail.scrollLeft);            // RTL: scrollLeft is negative
    const max = () => Math.max(0, rail.scrollWidth - rail.clientWidth);
    const to = (x: number) => rail.scrollTo({ left: rtl() ? -x : x, behavior: still.matches ? 'auto' : 'smooth' });
    let t0 = Date.now();
    let hold = false;
    const sync = () => {
      const m = max();
      const k = m ? Math.round((pos() / m) * (btns.length - 1)) : 0;
      btns.forEach((b, i) => { b.classList.toggle('on', i === k); b.setAttribute('aria-pressed', String(i === k)); });
    };
    rail.addEventListener('scroll', sync, { passive: true });
    btns.forEach((b, i) => b.addEventListener('click', () => {
      t0 = Date.now();
      to(Math.min(max(), i * (rail.clientWidth + gap)));
    }));
    rail.addEventListener('mouseenter', () => { hold = true; });
    rail.addEventListener('mouseleave', () => { hold = false; t0 = Date.now(); });
    rail.addEventListener('focusin', () => { hold = true; });
    rail.addEventListener('focusout', () => { hold = false; t0 = Date.now(); });
    rail.addEventListener('pointerdown', () => { t0 = Date.now(); }, { passive: true });
    onSwipe(rail, (d) => { t0 = Date.now(); to(Math.max(0, Math.min(max(), pos() + d * (rail.clientWidth + gap)))); });
    window.setInterval(() => {
      if (!moving() || document.hidden || hold || Date.now() - t0 < 5000) return;
      const r = rail.getBoundingClientRect();
      t0 = Date.now();
      if (r.bottom < 0 || r.top > window.innerHeight) return;
      const m = max();
      to(pos() >= m - 4 ? 0 : Math.min(m, pos() + rail.clientWidth + gap));
    }, 250);
    // Attention: the row starts on its last page and slides back to the first the
    // first time it comes into view.
    if (moving() && 'IntersectionObserver' in window && max() > 0) {
      rail.style.scrollBehavior = 'auto';
      rail.scrollLeft = rtl() ? -max() : max();
      rail.style.scrollBehavior = '';
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        window.setTimeout(() => { t0 = Date.now(); to(0); }, 350);
      }, { threshold: 0.6 });
      io.observe(rail);
    }
    sync();
  });

  // ── Stacks: one item at a time, every 3 s; stacks with the same name share one
  //    clock (the two «Buying from abroad» bands change together); a pointer over
  //    `[data-rot-hold]` holds that clock; a dash shows its item and restarts.
  type Clock = { timer: number | null; held: boolean; steps: (() => void)[]; backs?: (() => void)[] };
  const clocks = new Map<string, Clock>();
  const startClock = (c: Clock) => {
    if (c.timer) window.clearInterval(c.timer);
    c.timer = window.setInterval(() => {
      if (!moving() || document.hidden || c.held) return;
      c.steps.forEach((f) => f());
    }, 3000);
  };
  document.querySelectorAll<HTMLElement>('[data-rot]').forEach((stack) => {
    const name = stack.dataset.rot || 'x';
    const items = Array.from(stack.querySelectorAll<HTMLElement>('.h-sx'));
    const bars = Array.from(stack.parentElement?.querySelectorAll<HTMLButtonElement>('.h-bar') ?? []);
    if (items.length < 2) return;
    let cur = 0;
    const show = (i: number) => {
      const prev = (i + items.length - 1) % items.length;
      items.forEach((el, n) => { el.classList.toggle('on', n === i); el.classList.toggle('gone', n === prev && n !== i); });
      bars.forEach((b, n) => { b.classList.toggle('on', n === i); b.setAttribute('aria-pressed', String(n === i)); });
      cur = i;
    };
    if (!clocks.has(name)) clocks.set(name, { timer: null, held: false, steps: [] });
    const c = clocks.get(name)!;
    c.steps.push(() => show((cur + 1) % items.length));
    bars.forEach((b, n) => b.addEventListener('click', () => { show(n); startClock(c); }));
    c.backs = c.backs ?? [];
    c.backs.push(() => show((cur - 1 + items.length) % items.length));
    // a swipe turns every stack on this clock together (the two «Buying from abroad» bands stay in step)
    onSwipe(stack.parentElement ?? stack, (d) => { (d > 0 ? c.steps : c.backs!).forEach((f) => f()); startClock(c); });
  });
  clocks.forEach((c) => startClock(c));
  document.querySelectorAll<HTMLElement>('[data-rot-hold]').forEach((el) => {
    const c = clocks.get(el.dataset.rotHold || '');
    if (!c) return;
    el.addEventListener('mouseenter', () => { c.held = true; });
    el.addEventListener('mouseleave', () => { c.held = false; });
  });

  // ── Accordion (Design & construction): one open; hover opens after a short pause
  //    (sweeping the mouse across does not flick through every item); click too.
  document.querySelectorAll<HTMLElement>('[data-acc]').forEach((acc) => {
    const caps = Array.from(acc.querySelectorAll<HTMLElement>('.cap'));
    let tmr = 0;
    const open = (i: number) => caps.forEach((c, n) => {
      c.classList.toggle('on', n === i);
      c.querySelector('button')?.setAttribute('aria-expanded', String(n === i));
    });
    const mark = () => { if (desk.matches) open(Math.max(0, caps.findIndex((c) => c.classList.contains('on')))); };
    mark();
    desk.addEventListener?.('change', mark);
    caps.forEach((c, i) => {
      c.querySelector('button')?.addEventListener('click', () => { window.clearTimeout(tmr); if (desk.matches) open(i); });
      c.addEventListener('mouseenter', () => {
        if (!desk.matches) return;
        window.clearTimeout(tmr);
        tmr = window.setTimeout(() => open(i), 60);
      });
      c.addEventListener('mouseleave', () => window.clearTimeout(tmr));
    });
  });

  // ── Three paths: the door under the pointer (or focus) opens; back to the first.
  document.querySelectorAll<HTMLElement>('[data-doors]').forEach((g) => {
    const ds = Array.from(g.querySelectorAll<HTMLElement>('.door'));
    const on = (i: number) => ds.forEach((d, n) => d.classList.toggle('on', n === i));
    ds.forEach((d, i) => { d.addEventListener('mouseenter', () => on(i)); d.addEventListener('focusin', () => on(i)); });
    g.addEventListener('mouseleave', () => on(0));
  });

  // ── Gilded buttons: the gradient turns once on entering the button's box, and
  //    once more on entering the button itself.
  document.querySelectorAll<HTMLElement>('.h-gild').forEach((g) => {
    const run = () => {
      if (!moving()) return;
      g.classList.remove('grun');
      void g.offsetWidth;
      g.classList.add('grun');
    };
    (g.closest('section') ?? g.parentElement)?.addEventListener('mouseenter', run);
    g.addEventListener('mouseenter', run);
  });

  // ── Secret Portfolio: the faint lock drifts top → bottom while the band crosses.
  const lock = document.getElementById('offLock');
  const drift = () => {
    if (!lock || !lock.parentElement || !moving()) return;
    const band = lock.parentElement;
    const r = band.getBoundingClientRect();
    const vh = window.innerHeight || 800;
    const span = Math.max(1, vh - r.height - 96);
    const p = Math.min(1, Math.max(0, (vh - r.height - r.top) / span));
    const travel = Math.max(0, band.clientHeight - (lock.getBoundingClientRect().height || 100));
    lock.style.transform = `translateY(${(p * travel).toFixed(1)}px)`;
  };

  // ── Back to top: after one screen.
  const top = document.getElementById('toTop');
  const onScroll = () => {
    drift();
    top?.classList.toggle('on', window.scrollY > window.innerHeight * 0.8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();
  top?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: still.matches ? 'auto' : 'smooth' }));
</script>
