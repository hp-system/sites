---
// ═══════════════════════════════════════════════════════════════════════════
// CONTACT FORM for the info pages (contact, sell, appointment, careers…).
// Posts to the existing /api/inquiry — no new backend. The page's `source` is put
// in front of the message, so the office sees where the request came from.
// Same anti-spam as the property form: a hidden honeypot field and a 3-second timer.
// ═══════════════════════════════════════════════════════════════════════════
import { memberOf } from '../lib/member';
import WaLink from './WaLink.astro';
import { DIAL, flag } from '../lib/callback';
import { pui } from '../lib/property';
import { t, type Lang } from '../lib/i18n';
import { brand } from '../brand/index';
// `look: 'wave1'` (#105, approved by George 2026-11-02) = the dark desktop band of the Sell page
// (Services and Company next): a left column (eyebrow, title, note, phone · WhatsApp) and the
// form with the names inside the fields, Name and Surname apart, the country-code picker
// (lib/dial.ts) and consent left / Send right. Phones keep George's form exactly. Same endpoint,
// same protections (honeypot, 3-second timer; Origin + rate limit in /api/inquiry).
// `look: 'pop'` (#106, Services, approved by George 2026-11-02) = the same desktop form inside a light
// window (ServicesHub.astro): extra fields of the window go in the default slot (they fill the hidden
// `extra`, sent in front of the message), Cancel · phone · WhatsApp · Send at the bottom. On success the
// form fires `iform:sent` so the window can show its thank-you view.
interface Props { source: string; title?: string; message?: boolean; terms: string; privacy: string;
  look?: 'wave1' | 'pop'; lang?: Lang; eyebrow?: string }
const { source, title = 'Send us a message', message = true, terms, privacy, look, lang = 'en', eyebrow = '' } = Astro.props;
const w1 = look === 'wave1';
const pop = look === 'pop';
// A signed-in member sees their own details already filled in (#64). Guests: empty fields.
const me = await memberOf(Astro.cookies.get('member_token')?.value);
const mine = me && !me.blocked ? me : null;
const id = `f-${source.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const regionName = (() => {
  try { const d = new Intl.DisplayNames([lang], { type: 'region' }); return (cc: string) => d.of(cc) ?? cc; }
  catch { return (cc: string) => cc; }
})();
const dial = w1 || pop ? DIAL.map((d) => ({ ...d, name: regionName(d.cc), flag: flag(d.cc) })) : [];
const full = (mine?.name ?? '').trim();
const cut = full.indexOf(' ');
const first = full ? (cut < 0 ? full : full.slice(0, cut)) : undefined;
const last = full && cut > 0 ? full.slice(cut + 1) : undefined;
---
{pop ? (
<section class="iform iform--pop" data-lang={lang}>
  <form class="iform__f" data-source={source} data-w1 data-in-pop novalidate>
    <div class="pop__body">
      <slot />
      <div class="pop__g">
        <input class="pop__i" name="first" autocomplete="given-name" maxlength="60" placeholder={pui(lang, 'fFirst')} aria-label={pui(lang, 'fFirst')} value={first} />
        <input class="pop__i" name="last" autocomplete="family-name" maxlength="60" placeholder={pui(lang, 'fSurname')} aria-label={pui(lang, 'fSurname')} value={last} />
        <input class="pop__i" name="email" type="email" autocomplete="email" required maxlength="200" placeholder={pui(lang, 'fEmail')} aria-label={pui(lang, 'fEmail')} value={mine?.email || undefined} />
        <div class="iform__ph">
          <button type="button" class="dial" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-pdp`} aria-label={pui(lang, 'cbCountry')}>
            <span data-dial-l>🇬🇷 +30</span>
            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
          </button>
          <input name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder={pui(lang, 'cbPhone')} aria-label={pui(lang, 'cbPhone')} value={mine?.phone || undefined} />
          <div class="dial__pop" id={`${id}-pdp`} hidden>
            <div class="dial__s">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
              <input type="search" data-dial-q placeholder={pui(lang, 'dialSearch')} aria-label={pui(lang, 'dialSearch')} autocomplete="off" />
            </div>
            <div class="dial__l" role="listbox" aria-label={pui(lang, 'cbCountry')}>
              {dial.map((d) => (
                <button type="button" role="option" aria-selected="false" data-cc={d.cc} data-code={d.code} data-q={`${d.name} ${d.cc} ${d.code}`.toLowerCase()}>
                  <span class="dial__f">{d.flag}</span><span class="dial__n">{d.name}</span><span class="dial__c"><bdi dir="ltr">+{d.code}</bdi></span>
                </button>
              ))}
              <p class="dial__none" hidden>{pui(lang, 'dialNone')}</p>
            </div>
          </div>
        </div>
      </div>
      {message && <textarea class="pop__i" name="message" rows="3" maxlength="1900" placeholder={pui(lang, 'msgL')} aria-label={pui(lang, 'msgL')}></textarea>}
      <input type="hidden" name="extra" value="" />
      <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="consent">
        By sending this form you accept the <a href={terms}>Terms of Services</a> and the <a href={privacy}>Privacy Policy</a>.
      </p>
      <p class="iform__msg" role="status" aria-live="polite"></p>
    </div>
    <div class="pop__foot">
      <button type="button" class="pop__x" data-pop-x>{t(lang, 'svc.cancel')}</button>
      <span class="pop__ct"><a class="lnkg" href={brand.contact.phoneHref} data-ev="call:footer"><bdi dir="ltr">{brand.contact.phoneText}</bdi></a><WaLink /></span>
      <button class="btn" type="submit" data-ev="lead:form_submit">{t(lang, 'svc.send')}</button>
    </div>
  </form>
</section>
) : w1 ? (
<section class="iform iform--w1" aria-labelledby={`${id}-h`} data-lang={lang}>
  <div class="iform__intro">
    {eyebrow && <p class="iform__eb">{eyebrow}</p>}
    <h2 id={`${id}-h`}>{title}</h2>
    <p class="iform__note">{`${t(lang, 'info.form_note')} `}<b>{t(lang, 'info.form_priv')}</b>{` ${t(lang, 'info.form_priv2')}`}</p>
    <p class="iform__ct"><a href={brand.contact.phoneHref} data-ev="call:footer"><bdi dir="ltr">{brand.contact.phoneText}</bdi></a><WaLink dark /></p>
  </div>
  <form class="iform__f" data-source={source} data-w1 novalidate>
    <div class="iform__fld iform__m"><label for={`${id}-n`}>Name</label><input id={`${id}-n`} name="name" autocomplete="name" required maxlength="120" value={mine?.name || undefined} /></div>
    <input class="iform__d" name="first" autocomplete="given-name" maxlength="60" placeholder={pui(lang, 'fFirst')} aria-label={pui(lang, 'fFirst')} value={first} />
    <input class="iform__d" name="last" autocomplete="family-name" maxlength="60" placeholder={pui(lang, 'fSurname')} aria-label={pui(lang, 'fSurname')} value={last} />
    <div class="iform__fld"><label class="iform__l" for={`${id}-e`}>Email</label><input id={`${id}-e`} name="email" type="email" autocomplete="email" required maxlength="200" placeholder={pui(lang, 'fEmail')} value={mine?.email || undefined} /></div>
    <div class="iform__fld"><label class="iform__l" for={`${id}-p`}>Phone</label>
      <div class="iform__ph">
        <button type="button" class="dial" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-dp`} aria-label={pui(lang, 'cbCountry')}>
          <span data-dial-l>🇬🇷 +30</span>
          <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
        </button>
        <input id={`${id}-p`} name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder={pui(lang, 'cbPhone')} value={mine?.phone || undefined} />
        <div class="dial__pop" id={`${id}-dp`} hidden>
          <div class="dial__s">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
            <input type="search" data-dial-q placeholder={pui(lang, 'dialSearch')} aria-label={pui(lang, 'dialSearch')} autocomplete="off" />
          </div>
          <div class="dial__l" role="listbox" aria-label={pui(lang, 'cbCountry')}>
            {dial.map((d) => (
              <button type="button" role="option" aria-selected="false" data-cc={d.cc} data-code={d.code} data-q={`${d.name} ${d.cc} ${d.code}`.toLowerCase()}>
                <span class="dial__f">{d.flag}</span><span class="dial__n">{d.name}</span><span class="dial__c"><bdi dir="ltr">+{d.code}</bdi></span>
              </button>
            ))}
            <p class="dial__none" hidden>{pui(lang, 'dialNone')}</p>
          </div>
        </div>
      </div>
    </div>
    {message && <div class="iform__fld wide"><label class="iform__l" for={`${id}-m`}>Message</label><textarea id={`${id}-m`} name="message" rows="5" maxlength="1900" placeholder={pui(lang, 'msgL')}></textarea></div>}
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="wide iform__end">
      <p class="consent">
        By sending this form you accept the <a href={terms}>Terms of Services</a> and the <a href={privacy}>Privacy Policy</a>.
      </p>
      <p class="iform__go"><button class="btn" type="submit" data-ev="lead:form_submit">Send</button></p>
    </div>
    <p class="wide iform__msg" role="status" aria-live="polite"></p>
  </form>
</section>
) : (
<section class="iform" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{title}</h2>
  <form class="iform__f" data-source={source} novalidate>
    <label>Name<input name="name" autocomplete="name" required maxlength="120" value={mine?.name || undefined} /></label>
    <label>Email<input name="email" type="email" autocomplete="email" required maxlength="200" value={mine?.email || undefined} /></label>
    <label>Phone<input name="phone" type="tel" autocomplete="tel" maxlength="40" value={mine?.phone || undefined} /></label>
    {message && <label class="wide">Message<textarea name="message" rows="5" maxlength="1900"></textarea></label>}
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="wide consent">
      By sending this form you accept the <a href={terms}>Terms of Services</a> and the <a href={privacy}>Privacy Policy</a>.
    </p>
    <p class="wide"><button class="btn" type="submit" data-ev="lead:form_submit">Send</button></p>
    <p class="wide iform__msg" role="status" aria-live="polite"></p>
  </form>
</section>
)}

<script>
  import { initDial, guessCc, type Dial } from '../lib/dial';
  const desk = window.matchMedia('(min-width: 1024px)');
  document.querySelectorAll<HTMLFormElement>('.iform__f').forEach((f) => {
    const opened = Date.now();
    const msg = f.querySelector<HTMLElement>('.iform__msg')!;
    // #105 wave 1, desktop: Name + Surname (sent together as `name`), the dialling code in front of the number.
    let dialW: Dial | null = null;
    if (f.dataset.w1 !== undefined) {
      const ph = f.querySelector<HTMLElement>('.iform__ph');
      const lang = f.closest<HTMLElement>('.iform')?.dataset.lang ?? 'en';
      dialW = initDial(ph, guessCc(lang), () => ph?.querySelector<HTMLInputElement>('input[name=phone]')?.focus());
    }
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const popF = f.dataset.inPop !== undefined;
      const w1 = f.dataset.w1 !== undefined && (desk.matches || popF);
      const name = w1 ? `${String(d.get('first') ?? '').trim()} ${String(d.get('last') ?? '').trim()}`.trim()
        : String(d.get('name') ?? '').trim();
      const email = String(d.get('email') ?? '').trim();
      let phone = String(d.get('phone') ?? '').trim();
      if (w1 && phone && !/^(\+|00)/.test(phone)) phone = `+${dialW?.code() ?? '30'} ${phone}`;
      if (!name || !/.+@.+\..+/.test(email)) { msg.textContent = 'Please write your name and a valid email.'; return; }
      const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      try {
        const r = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name, email, phone,
            // #106: the window's extra fields (kind, area, size, day…) go in front of the message.
            message: `[${f.dataset.source}] ${[String(d.get('extra') ?? '').trim(), String(d.get('message') ?? '')].filter(Boolean).join(' · ')}`.trim(),
            website: String(d.get('website') ?? ''), t: opened, lang: 'en',
          }),
        });
        if (!r.ok) throw new Error(String(r.status));
        f.reset();
        msg.textContent = 'Thank you — an adviser will reply soon.';
        if (popF) f.dispatchEvent(new CustomEvent('iform:sent', { bubbles: true }));
      } catch {
        msg.textContent = 'Sending failed. Please call us or try again in a minute.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .iform { border-top: 1px solid var(--ink); padding-top: var(--s4); margin-top: var(--s7); max-width: 68ch; }
  .iform h2 { font-size: clamp(22px, 3.4vw, 28px); font-weight: 400; color: var(--ink); margin: 0 0 var(--s4); }
  .iform__f { display: grid; gap: 14px 16px; }
  @media (min-width: 640px) { .iform__f { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .iform__f label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); min-width: 0; }
  .iform__f input, .iform__f textarea { font: inherit; font-size: 16px; color: var(--ink); background: var(--paper); border: 1px solid var(--line); padding: 10px; width: 100%; min-width: 0; border-radius: 0; }
  .iform__f .wide { grid-column: 1 / -1; margin: 0; }
  .consent { font-size: 13px; color: var(--muted); }
  .consent a { color: var(--ink); }
  .hp { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; padding: 0; }
  /* The honeypot must stay 1 px in every look. The scoped .hp rule above never reached the field
     (it was 1425 px wide), so the absolutely placed field widened Sell and Contact sideways.
     Global on purpose: it targets only honeypot inputs (hotfix 2026-11-02). */
  :global(input.hp) { position: absolute !important; width: 1px !important; height: 1px !important; min-width: 0 !important; max-width: 1px !important; padding: 0 !important; border: 0 !important; margin: 0 !important; overflow: hidden; clip-path: inset(50%); top: 0; left: 0; }
  .iform__msg { font-size: 14px; color: var(--ink); min-height: 1.4em; }
  /* ── look: wave1 (#105). Below 1024px it draws exactly George's form above. ── */
  .iform__fld { display: grid; gap: 4px; font-size: 13px; color: var(--muted); min-width: 0; }
  .iform__d, .iform--w1 .dial, .iform__eb, .iform__note, .iform__ct { display: none; }
  .iform__end { display: grid; gap: 14px; }
  .iform__end p, .iform__intro p { margin: 0; }
  .iform--w1 .iform__f ::placeholder { color: transparent; }
  .dial__pop[hidden] { display: none; }
  @media (min-width: 1024px) {
    .iform--w1 { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 64px; align-items: start;
                 border-top: 0; padding: 0; margin: 0; max-width: none; color: #fff; }
    .iform--w1 .iform__eb { display: block; font-size: 10.5px; font-weight: 600; line-height: 1.4; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.55); }
    .iform--w1 h2 { margin: 14px 0 0; font-size: 36px; font-weight: 300; line-height: 1.14; letter-spacing: -.016em; color: #fff; }
    .iform--w1 .iform__intro p.iform__note { display: block; margin: 18px 0 0; font-size: 15px; line-height: 1.65; color: rgba(255,255,255,.75); max-width: 40ch; }
    .iform__note b { color: #fff; font-weight: 600; }
    .iform--w1 .iform__intro p.iform__ct { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 18px; margin: 22px 0 0; font-size: 14px; }
    .iform__ct > a:first-child { color: #fff; text-underline-offset: 3px; font-variant-numeric: tabular-nums; }
    .iform--w1 .iform__f { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; }
    .iform--w1 .iform__m { display: none; }
    .iform--w1 .iform__d { display: block; }
    .iform--w1 .iform__fld { gap: 0; }
    .iform__l { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
    .iform--w1 .iform__f ::placeholder { color: rgba(255,255,255,.55); opacity: 1; }
    .iform--w1 .iform__f input, .iform--w1 .iform__f textarea { color: #fff; background: transparent; border: 1px solid rgba(255,255,255,.25); padding: 12px;
      box-sizing: border-box; transition: border-color .15s ease; }
    .iform--w1 .iform__f > input, .iform--w1 .iform__fld > input { height: 48px; }
    .iform--w1 .iform__f input:hover, .iform--w1 .iform__f textarea:hover { border-color: rgba(255,255,255,.5); }
    .iform--w1 .iform__f input:focus, .iform--w1 .iform__f textarea:focus { border-color: #fff; outline: none; }
    .iform--w1 .iform__f textarea { resize: vertical; }
    .iform__ph { position: relative; display: flex; height: 48px; border: 1px solid rgba(255,255,255,.25); box-sizing: border-box; transition: border-color .15s ease; }
    .iform__ph:hover { border-color: rgba(255,255,255,.5); }
    .iform__ph:focus-within { border-color: #fff; }
    .iform--w1 .iform__ph input[type=tel] { flex: 1; min-width: 0; height: 100%; border: 0; padding: 0 12px; }
    .iform--w1 .dial { display: flex; flex: none; width: 88px; height: 100%; align-items: center; justify-content: space-between; gap: 4px; padding: 0 8px;
      background: transparent; border: 0; border-inline-end: 1px solid rgba(255,255,255,.25); font: inherit; font-size: 13px; color: #fff; cursor: pointer; }
    .iform--w1 .dial:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    .dial__pop:not([hidden]) { display: block; position: absolute; left: -1px; right: -1px; top: calc(100% + 4px); z-index: 40; background: var(--paper);
      border: 1px solid rgba(14,18,20,.16); box-shadow: 0 12px 28px rgba(10,14,16,.14); }
    .dial__s { display: flex; align-items: center; gap: 8px; padding: 0 10px; height: 38px; border-bottom: 1px solid rgba(14,18,20,.10); color: var(--muted); }
    .dial__s svg { flex: none; }
    .iform--w1 .dial__s input { flex: 1; min-width: 0; height: 100%; border: 0; padding: 0; outline: none; font-size: 14px; color: var(--ink); background: transparent; }
    .iform--w1 .dial__s input::placeholder { color: var(--muted); }
    .dial__l { max-height: 228px; overflow-y: auto; }
    .dial__l button { width: 100%; display: flex; align-items: center; gap: 8px; padding: 8px 10px; background: var(--paper); border: 0;
      font: inherit; font-size: 13.5px; color: var(--ink); text-align: start; cursor: pointer; }
    .dial__l button:hover, .dial__l button[aria-selected='true'] { background: var(--paper-2); }
    .dial__f { width: 22px; }
    .dial__n { flex: 1; }
    .dial__c { color: var(--muted); font-variant-numeric: tabular-nums; }
    .dial__none { margin: 0; padding: 10px; font-size: 13px; color: var(--muted); }
    .iform--w1 .iform__end { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
    .iform--w1 .consent { font-size: 13px; color: rgba(255,255,255,.7); }
    .iform--w1 .consent a { color: #fff; }
    .iform--w1 .iform__go { flex: none; }
    .iform--w1 .btn { background: #fff; color: var(--ink-deep); border-color: #fff; transition: background .2s ease, color .2s ease, border-color .2s ease; }
    .iform--w1 .btn:hover { opacity: 1; background: var(--paper-2); color: var(--ink); border-color: var(--paper-2); }
    .iform--w1 .iform__msg { color: #fff; }
  }
  /* ── look: pop (#106) — the light window of the Services page (desktop only, ServicesHub.astro) ── */
  .iform--pop { border-top: 0; padding: 0; margin: 0; max-width: none; }
  .iform--pop .iform__f { display: block; }
  .pop__body { padding: 18px 28px 20px; display: grid; gap: 16px; }
  .pop__body > p { margin: 0; }
  .pop__g { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .iform--pop .iform__f .pop__i { height: 44px; padding: 0 11px; font-size: 16px; color: var(--ink); background: var(--paper);
    border: 1px solid var(--line); box-sizing: border-box; transition: border-color .15s ease; }
  .iform--pop .iform__f textarea.pop__i { height: auto; padding: 10px 11px; resize: vertical; }
  .iform--pop .iform__f .pop__i:hover { border-color: rgba(14,18,20,.35); }
  .iform--pop .iform__f .pop__i:focus { border-color: var(--ink); outline: none; }
  .iform--pop .iform__f ::placeholder { color: var(--muted); opacity: 1; }
  .iform--pop .iform__ph { position: relative; display: flex; height: 44px; border: 1px solid var(--line); background: var(--paper); box-sizing: border-box; transition: border-color .15s ease; }
  .iform--pop .iform__ph:hover { border-color: rgba(14,18,20,.35); }
  .iform--pop .iform__ph:focus-within { border-color: var(--ink); }
  .iform--pop .iform__ph input[type=tel] { flex: 1; min-width: 0; height: 100%; border: 0; padding: 0 11px; background: transparent; outline: none; }
  .iform--pop .dial { display: flex; flex: none; width: 88px; height: 100%; align-items: center; justify-content: space-between; gap: 4px; padding: 0 8px;
    background: transparent; border: 0; border-inline-end: 1px solid var(--line); font: inherit; font-size: 13px; color: var(--ink); cursor: pointer; }
  .iform--pop .dial:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .iform--pop .dial__pop:not([hidden]) { display: block; position: absolute; left: -1px; right: -1px; top: calc(100% + 4px); z-index: 40; background: var(--paper);
    border: 1px solid rgba(14,18,20,.16); box-shadow: 0 12px 28px rgba(10,14,16,.14); }
  .iform--pop .dial__s { display: flex; align-items: center; gap: 8px; padding: 0 10px; height: 38px; border-bottom: 1px solid rgba(14,18,20,.10); color: var(--muted); }
