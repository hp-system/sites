---
// ═══════════════════════════════════════════════════════════════════════════
// INFO PAGES — DESKTOP REDESIGN, WAVE 1 (#105 Sell, approved by George 2026-11-02;
// Services #6 and Company #7 reuse it). The shared look of a `look: wave1` info page:
// hero with a photo, «Get to know» card row, dark form band, «Related» and area rows,
// page dashes, back-to-top. Every rule sits under `.w1` (the page's <main>) and inside
// the desktop query: pages without `look: wave1` and phones (< 1024px) are unchanged.
// Put once on the page, after <main>.
// ═══════════════════════════════════════════════════════════════════════════
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<button type="button" id="w1Top" class="w1-totop" aria-label={t(lang, 'home.top')}>
  <svg width="14" height="16" viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.6"
       stroke-linecap="square" aria-hidden="true"><path d="M7 15V2M1.5 7.5L7 2l5.5 5.5"></path></svg>
</button>

<style is:global>
  .w1-totop, .w1 .ir-dash, .w1 .w1-d { display: none; }

  @media (min-width: 1024px) {
    .w1 .w1-d { display: revert; }
    .w1 .w1-m { display: none !important; }

    /* ── headings and buttons ───────────────────────────────────────────── */
    .w1 .w1-h2 { margin: 0; font-size: 40px; font-weight: 300; line-height: 1.1; letter-spacing: -.02em; color: var(--ink); white-space: nowrap; flex: none; }
    .w1 .w1-h2--sm { font-size: 28px; letter-spacing: -.014em; }
    .w1 .btn { transition: background .2s ease, color .2s ease, border-color .2s ease; }
    .w1 .btn:hover { opacity: 1; background: var(--paper-2); color: var(--ink); border-color: var(--paper-2); }
    .w1 .lnkg { color: var(--muted); text-decoration: none; transition: color .15s ease; }
    .w1 .lnkg:hover { color: var(--ink); }
    .w1 a:focus-visible, .w1 button:focus-visible, .w1 input:focus-visible, .w1 textarea:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    /* ── page dashes ────────────────────────────────────────────────────── */
    .w1 .ir-dash { display: flex; gap: 6px; flex: none; }
    .w1 .ir-dash button { all: unset; cursor: pointer; padding: 10px 0; }
    .w1 .ir-dash button span {
      display: block; width: 6px; height: 2px; background: rgba(14,18,20,.2);
      transition: width .35s cubic-bezier(.4,0,.2,1), transform .25s ease-out, background .2s ease;
    }
    .w1 .ir-dash button.on span { width: 22px; background: var(--ink); }
    .w1 .ir-dash:hover button span { transform: scaleY(4); }
    .w1 .ir-dash button:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    /* ── a row: three cards a page, scrolled (every card is in the HTML) ── */
    .w1 .ir-rail {
      display: flex; gap: 20px; margin: 0; padding: 0; list-style: none;
      overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
      scrollbar-width: none; overscroll-behavior-x: contain;
    }
    .w1 .ir-rail::-webkit-scrollbar { display: none; }
    .w1 .ir-rail > * { flex: none; width: calc((100% - 40px) / 3); scroll-snap-align: start; min-width: 0; }
    .w1 .ir-head { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin: 0 0 22px; }

    /* ── «Related» / area cards (PageCard) ──────────────────────────────── */
    .w1 .pc { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .w1 .pc__i { display: block; width: 100%; height: 220px; overflow: hidden; background: var(--paper); }
    .w1 .pc__i img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s ease; }
    .w1 .pc:hover .pc__i img { transform: scale(1.03); }
    .w1 .pc__t { margin: 22px 0 0; font-size: 22px; font-weight: 600; line-height: 1.25; letter-spacing: -.012em; max-width: 300px; color: var(--ink); }
    .w1 .pc:hover .pc__t { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .w1 .pc__p { margin: 6px 0 0; font-size: 14.5px; line-height: 1.5; color: var(--ink-2); max-width: 290px; min-height: 44px; }
    .w1 .pc__a { display: flex; align-items: center; justify-content: center; gap: 22px; margin: auto 0 0; padding-top: 20px; }
    .w1 .pc__b { display: inline-flex; align-items: center; height: 40px; padding: 0 20px; background: var(--paper); color: var(--ink);
                 border: 1px solid var(--line); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
                 text-decoration: none; transition: background .2s ease, border-color .2s ease; }
    .w1 .pc__b:hover { background: var(--paper-2); border-color: var(--ink); }
    .w1 .pc__l { font-size: 14.5px; color: var(--muted); text-decoration: none; transition: color .15s ease; }
    .w1 .pc__l:hover { color: var(--ink); }

    /* ── back to top ────────────────────────────────────────────────────── */
    .w1-totop {
      all: unset; box-sizing: border-box; position: fixed; right: 24px; bottom: 24px; z-index: 70;
      width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;
      background: var(--paper); border: 1px solid rgba(14,18,20,.16); color: var(--ink); cursor: pointer;
      box-shadow: 0 8px 24px rgba(0,0,0,.10); opacity: 0; transform: translateY(12px); pointer-events: none;
      transition: opacity .3s ease, transform .3s ease, background .2s ease, border-color .2s ease;
    }
    .w1-totop.on { opacity: 1; transform: none; pointer-events: auto; }
    .w1-totop:hover { background: var(--paper-2); border-color: var(--ink); }
    .w1-totop svg { transition: transform .25s ease; }
    .w1-totop:hover svg { transform: translateY(-3px); }
    .w1-totop:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    [dir='rtl'] .w1-totop { right: auto; left: 24px; }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .w1 .ir-rail { scroll-behavior: auto; }
    .w1 .ir-dash button span, .w1-totop, .w1-totop svg, .w1 .pc__i img { transition: none; }
  }
</style>

<script>
  import { initRails } from '../lib/rail';
  initRails();
  const top = document.getElementById('w1Top');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const onScroll = () => top?.classList.toggle('on', window.scrollY > window.innerHeight * 0.8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  top?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: still.matches ? 'auto' : 'smooth' }));
</script>
