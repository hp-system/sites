<script>
  // Pre-published (Sergei 2026-11-27): the one button opens the form in a popup; back from signing in (?form=1) it
  // opens by itself and the mark leaves the address. A sent form shows the thank-you view.
  const pp = document.getElementById('ppop') as HTMLDialogElement | null;
  if (pp && typeof pp.showModal === 'function') {
    const form = pp.querySelector<HTMLElement>('.ppop__form')!, done = pp.querySelector<HTMLElement>('.ppop__done')!;
    const open = () => { form.hidden = false; done.hidden = true; pp.showModal(); };
    document.querySelectorAll('[data-ppop-open]').forEach((b) => b.addEventListener('click', open));
    pp.querySelectorAll('[data-pop-x]').forEach((b) => b.addEventListener('click', () => pp.close()));
    pp.addEventListener('click', (e) => {           // a click on the dimmed page beside the popup closes it
      if (e.target !== pp) return;
      const r = pp.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) pp.close();
    });
    pp.addEventListener('iform:sent', () => { form.hidden = true; done.hidden = false; });
    if (pp.dataset.auto) {
      const u = new URL(location.href); u.searchParams.delete('form');
      history.replaceState(history.state, '', u.pathname + u.search + u.hash);
      open();
    }
  }
</script>

