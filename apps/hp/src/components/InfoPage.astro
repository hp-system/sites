  .info-cta-top { margin: var(--s4, 24px) 0 0; }
  .info-hero { margin: 0 auto; }
  .info-hero img { width: 100%; height: auto; max-height: 520px; object-fit: cover; display: block; }

  .info-grid { display: grid; gap: var(--s7); padding-top: var(--s5); padding-bottom: var(--s7); }
  @media (min-width: 1000px) { .info-grid { grid-template-columns: minmax(0, 1fr) 300px; } }
  .info-side { display: none; }
  @media (min-width: 1000px) { .info-side { display: block; position: sticky; top: var(--s5); align-self: start; } }
  .side-box { border-top: 1px solid var(--ink); padding: var(--s3) 0 var(--s5); }
  .side-box ul { list-style: none; margin: var(--s2) 0 0; padding: 0; display: grid; gap: 6px; font-size: var(--fs-s0); }
  .side-box a { color: var(--ink-2); text-decoration: none; }
  .side-box a:hover { text-decoration: underline; }

  .prose { max-width: 68ch; font-size: var(--fs-s0); line-height: 1.7; color: var(--ink-2); min-width: 0; }
  .prose :global(h2) { font-size: var(--fs-s2); font-weight: 400; line-height: 1.25; color: var(--ink); margin: var(--s7) 0 var(--s3); scroll-margin-top: var(--s5); }
  .prose :global(h3) { font-size: var(--fs-s0); font-weight: 600; color: var(--ink); margin: var(--s5) 0 var(--s2); }
  .prose :global(h4) { font-size: var(--fs-s0); font-weight: 600; color: var(--ink); margin: var(--s4) 0 var(--s2); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 var(--s4); }
  .prose :global(a) { color: var(--ink); text-underline-offset: 3px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(img) { max-width: 100%; height: auto; display: block; margin: var(--s4) 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: var(--fs-s0); line-height: 1.45; margin: var(--s2) 0 var(--s5); display: block; overflow-x: auto; }
  .prose :global(td), .prose :global(th) { border-bottom: 1px solid var(--line); padding: 8px 10px 8px 0; vertical-align: top; text-align: left; }
  .prose :global(.gallery) { display: grid; gap: var(--s3); grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); margin: var(--s4) 0; }
  .prose :global(.gallery img) { margin: 0; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }

  .ccard { font-style: normal; border-top: 1px solid var(--ink); padding-top: var(--s3); margin: 0 0 var(--s5); }
  .ccard p { margin: 0 0 var(--s2); }
  .ccard .t-label { display: block; }
  .cards { list-style: none; padding: 0; margin: var(--s5) 0; display: grid; gap: var(--s5) var(--s4); }
  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cards li { min-width: 0; }
  .prose .cards :global(img), .cards img { margin: 0 0 var(--s3); width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .prose .cards :is(h2, .cards__t) { font-size: var(--fs-s1); margin: 0 0 var(--s2); }
  .cards :is(h2, .cards__t) a { text-decoration: none; }
