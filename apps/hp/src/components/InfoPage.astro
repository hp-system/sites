          <nav class="side-box">
            <p class="t-label">{ui.onPage}</p>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </nav>
        )}
        {d.related.length > 0 && (
          <div class="side-box">
            <p class="t-label">{ui.related}</p>
            <ul>{d.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
          </div>
        )}
        <div class="side-box">
          <p class="t-label">{ui.forSale}</p>
          <ul>{muniLinks.map((p) => <li><a href={p.href}>{ui.forSaleIn.replace('{m}', p.name)}</a></li>)}</ul>
        </div>
      </aside>
    </div>

    {d.related.length > 0 && (
      <section class:list={['info-band', { 'w1-m': hubLike }]}>
        <div class="wrap">
          <p class="t-label">{ui.related}</p>
          <ul class="links">{relLinks.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
          <p class="t-label info-areas-l">{ui.forSale}</p>
          <ul class="links">{muniLinks.map((p) => <li><a href={p.href}>{ui.forSaleIn.replace('{m}', p.name)}</a></li>)}</ul>
        </div>
      </section>
    )}

    <section class:list={['info-cta', { 'w1-m': hubLike }]}>
      <div class="wrap">
        <HT class="t-h2" data-h>{ui.ctaH}</HT>
        <p>{ui.ctaP}</p>
        <p class="row">
          <a class="btn btn--onphoto" href={contact} data-ev="content:phone">{ui.adviser}</a>
          <a class="btn btn--line" href={listUrl(lang)} data-ev="content:list">{ui.seeAll}</a>
          <a class="phone" href={brand.contact.phoneHref} data-ev="call:footer"><bdi dir="ltr">{brand.contact.phoneText}</bdi></a>
          <a class="phone" href={waHref()} rel="noopener" target="_blank" data-ev="lead:whatsapp_content">WhatsApp</a>
        </p>
      </div>
    </section>
    </>}
  </>
  )}

    {/* Desktop: the breadcrumb again above the footer (mockup «dir» bar). */}
    {w1 && (
    <nav class="w1-dir w1-d" aria-label={t(lang, 'a11y.crumb')}>
      <div class="wrap w1-dir__in">
        <a href={prefix(lang) || '/'} aria-label={brand.name}>{brand.name}</a>
        {d.parents.map((c) => <><span aria-hidden="true">›</span><a href={c.path}>{c.name}</a></>)}
        <span aria-hidden="true">›</span><span aria-current="page">{short}</span>
      </div>
    </nav>
    )}
  </main>

  <Footer lang={lang} munis={munis} />
  {w1 && <InfoKit lang={lang} />}
</Base>

