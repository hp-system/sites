---
// ═══════════════════════════════════════════════════════════════════════════
// INFO PAGE — legal, sell, company and services pages (English first,
// George 20/10/2026). Same reading layout as the articles.
//
//   breadcrumb · H1 · lead · image · text (old site's, faithful) · FAQ · form
//   · related links (side column on desktop, at the end on phones) · CTA
//
// SEO (George 20/10: "full seo optimized"): title = page title + brand, one H1,
// canonical self, hreflang en + x-default, BreadcrumbList + the page's own
// schema.org type, Open Graph image, related internal links.
// ═══════════════════════════════════════════════════════════════════════════
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Footer from './Footer.astro';
import InfoForm from './InfoForm.astro';
import InfoWidget from './InfoWidget.astro';
import { priceTables } from '../lib/prices';
import type { SiteProperty } from '../lib/api';
import { allProperties, visitorCountry } from '../lib/api';
import { muniKey, municipalityOf } from '../lib/gate';
import { subName } from '../lib/property';
import { listUrl, prefix, type Lang } from '../lib/i18n';
import { brand } from '../brand/index';
import { waHref, viberHref } from '../lib/contact';
import { HERO_SHOTS } from '../lib/hero';
import { company } from '../lib/company';
import { infoCluster, findInfoPage, type InfoPage } from '../lib/infopages';
import { FACETS, facetUrl } from '../lib/listing';
import { privacyPath } from '../lib/legal';
import { AREA_PAGES, areaUrl } from '../content/areas/en';
import { PAGE_KEYS, contentUrl, pageExists, pageLangs } from '../lib/pages';
import InfoKit from './InfoKit.astro';
import RailDash from './RailDash.astro';
import PageCard from './PageCard.astro';
import WaLink from './WaLink.astro';
import { areaCards } from '../lib/areacards';
import { buildAreaTiles } from '../lib/area-tiles';
import Areas from './Areas.astro';
import PageBlocks from './PageBlocks.astro';
import { pageBlocks, type BlockTile } from '../lib/list-blocks';
import { coverOf, heroReady } from '../lib/photos';
import ServicesHub, { type Role } from './ServicesHub.astro';
import CompanyHub from './CompanyHub.astro';
import { t } from '../lib/i18n';
import { redirectFor } from '../lib/redirects';
import SpecText from './SpecText.astro';
import SpecPosts from './SpecPosts.astro';
import ReadPage from './ReadPage.astro';
import FaqSearch from './FaqSearch.astro';
import SectionCards from './SectionCards.astro';
import { specByPath, specTitle, specSections, linksBySection } from '../lib/seo-pages';
import { cleanSrcSet, photosOf, isPhotoOpen, marked, markedSrcSet, altOf, focalStyle, shareImage, SHARE_W, SHARE_H } from '../lib/photos';
import type { MosaicPhoto } from './SpecMosaic.astro';

interface Props { page: InfoPage }
const { page } = Astro.props;
// #152: every link from the page's data points at the final address (no redirect hop):
// related links, the CTA and child cards whose target the redirect table moves.
const fin = (h?: string) => { if (!h) return h as string; const r = redirectFor(h.split(/[?#]/)[0]); return r?.status === 301 ? r.to : h; };
const d = { ...page.data,
  related: (page.data.related ?? []).map((r: any) => ({ ...r, href: fin(r.href) })),
  cards: (page.data.cards ?? []).map((c: any) => ({ ...c, href: fin(c.href) })),
  ...(page.data.cta ? { cta: { ...page.data.cta, href: fin(page.data.cta.href) } } : {}),
} as typeof page.data;
const lang: Lang = d.lang;                        // #94: info pages may be in any of the 9 languages

// Page chrome in the page language (#94). Greek in the singular.
const UI: Record<Lang, { onPage: string; related: string; forSale: string; forSaleIn: string; ctaH: string; ctaP: string;
  adviser: string; seeAll: string; faq: string; side: string }> = {
  en: { onPage: 'On this page', related: 'Related', forSale: 'Property for sale in Halkidiki', forSaleIn: 'Property for sale in {m}',
    ctaH: 'Questions about buying or selling in Halkidiki?', ctaP: 'Tell us what you are looking for. An adviser replies with a shortlist and can book a viewing in person or by video call.',
    adviser: 'Contact an adviser', seeAll: 'See properties for sale', faq: 'Frequently asked questions', side: 'Related pages' },
  el: { onPage: 'Σε αυτή τη σελίδα', related: 'Σχετικά', forSale: 'Ακίνητα προς πώληση στη Χαλκιδική', forSaleIn: 'Ακίνητα προς πώληση — {m}',
    ctaH: 'Ερωτήσεις για αγορά ή πώληση στη Χαλκιδική;', ctaP: 'Πες μας τι ψάχνεις. Ένας σύμβουλος σου στέλνει επιλογές και κλείνει επίσκεψη, από κοντά ή με βιντεοκλήση.',
    adviser: 'Μίλα με σύμβουλο', seeAll: 'Δες τα ακίνητα', faq: 'Συχνές ερωτήσεις', side: 'Σχετικές σελίδες' },
  bg: { onPage: 'На тази страница', related: 'Свързани', forSale: 'Имоти за продажба в Халкидики', forSaleIn: 'Имоти за продажба — {m}',
    ctaH: 'Въпроси за покупка или продажба в Халкидики?', ctaP: 'Кажете ни какво търсите. Консултант ще ви изпрати подбор и ще уговори оглед на място или по видео.',
    adviser: 'Свържете се с консултант', seeAll: 'Вижте имотите', faq: 'Често задавани въпроси', side: 'Свързани страници' },
  sr: { onPage: 'Na ovoj stranici', related: 'Povezano', forSale: 'Nekretnine na prodaju na Halkidikiju', forSaleIn: 'Nekretnine na prodaju — {m}',
    ctaH: 'Pitanja o kupovini ili prodaji na Halkidikiju?', ctaP: 'Recite nam šta tražite. Savetnik vam šalje izbor i zakazuje razgledanje uživo ili video-pozivom.',
    adviser: 'Kontaktirajte savetnika', seeAll: 'Pogledajte nekretnine', faq: 'Česta pitanja', side: 'Povezane stranice' },
  de: { onPage: 'Auf dieser Seite', related: 'Verwandte Seiten', forSale: 'Immobilien zum Verkauf auf Chalkidiki', forSaleIn: 'Immobilien zum Verkauf — {m}',
    ctaH: 'Fragen zu Kauf oder Verkauf auf Chalkidiki?', ctaP: 'Sagen Sie uns, was Sie suchen. Ein Berater schickt Ihnen eine Auswahl und vereinbart eine Besichtigung vor Ort oder per Videoanruf.',
    adviser: 'Berater kontaktieren', seeAll: 'Immobilien ansehen', faq: 'Häufige Fragen', side: 'Verwandte Seiten' },
  ro: { onPage: 'Pe această pagină', related: 'Legate', forSale: 'Proprietăți de vânzare în Halkidiki', forSaleIn: 'Proprietăți de vânzare — {m}',
    ctaH: 'Întrebări despre cumpărare sau vânzare în Halkidiki?', ctaP: 'Spuneți-ne ce căutați. Un consultant vă trimite o selecție și programează o vizionare, la fața locului sau prin apel video.',
    adviser: 'Contactați un consultant', seeAll: 'Vedeți proprietățile', faq: 'Întrebări frecvente', side: 'Pagini legate' },
  tr: { onPage: 'Bu sayfada', related: 'İlgili', forSale: "Halkidiki'de satılık mülkler", forSaleIn: 'Satılık mülkler — {m}',
    ctaH: "Halkidiki'de alım veya satım hakkında sorularınız mı var?", ctaP: 'Ne aradığınızı bize söyleyin. Bir danışman size seçenekler gönderir ve yerinde ya da görüntülü görüşmeyle gezi ayarlar.',
    adviser: 'Danışmanla iletişime geçin', seeAll: 'Mülkleri görün', faq: 'Sık sorulan sorular', side: 'İlgili sayfalar' },
  he: { onPage: 'בעמוד זה', related: 'קשור', forSale: 'נכסים למכירה בחלקידיקי', forSaleIn: 'נכסים למכירה — {m}',
    ctaH: 'שאלות על קנייה או מכירה בחלקידיקי?', ctaP: 'ספרו לנו מה אתם מחפשים. יועץ ישלח לכם מבחר ויתאם סיור, במקום או בשיחת וידאו.',
    adviser: 'פנו ליועץ', seeAll: 'לנכסים למכירה', faq: 'שאלות נפוצות', side: 'עמודים קשורים' },
  ru: { onPage: 'На этой странице', related: 'Похожее', forSale: 'Недвижимость на продажу в Халкидиках', forSaleIn: 'Недвижимость на продажу — {m}',
    ctaH: 'Вопросы о покупке или продаже в Халкидиках?', ctaP: 'Расскажите, что вы ищете. Консультант пришлёт подборку и договорится о просмотре на месте или по видеосвязи.',
    adviser: 'Связаться с консультантом', seeAll: 'Смотреть объекты', faq: 'Частые вопросы', side: 'Похожие страницы' },
};
const ui = UI[lang];

const { Content, headings } = await render(page);
const toc = d.toc ? headings.filter((h) => h.depth === 2 && h.text.trim()) : [];
// A text page on the kit (no widget, no own brief; its cards under the text): the reading layout (ReadPage) with every H2 in
// its side list, whatever `toc` says (Sergei 2026-11-11 «все остальное да»).
const readHeads = headings.filter((h) => h.depth === 2 && h.text.trim()).map((h) => ({ slug: h.slug, text: h.text }));
// A Sell page without an own brief (Add your property…): its H2 sections as the paged posts of the Sell canon (SpecPosts
// carousel, side list turns it) instead of one long column (Sergei 2026-11-16: «должно быть перелистываемыми блоками»).
// Only Sell pages that are plain text (legal texts, FAQ and pages with widgets or cards keep the reading layout).
const readHtml: string = (page as any).rendered?.html ?? '';
// Since 2026-11-16 every plain text page but the legal texts (Sergei on Contact: «ети блоки же должны быть блоками
// прокручиваемыми … мы же делали паттерн для етого»); the «Add your property» button only on Sell pages.
// the text before the first H2 (Contact, Careers…) stays above the carousel as the page's intro
const readPre = readHtml.includes('<h2') ? readHtml.slice(0, readHtml.indexOf('<h2')).trim() : '';
const readCar = d.section !== 'legal' && readHeads.length > 1 && !d.widget && d.cards.length === 0 && d.faq.length === 0 && /<h2/.test(readHtml)
  ? ({ body: readHtml.slice(readHtml.indexOf('<h2')).replace(/<h2[^>]*>/g, '<h2>'), faq: [], questionMarks: [], standout: [], path: d.path, linksOut: [] } as any)
  : null;

const url = d.path;
// A page with an approved new text (own page P22+, D-20261106-SS-2) keeps this design (Sergei
// 2026-11-09: «текст в одобренный дизайн»): title, meta, H1, intro, body and FAQ come from the
// new text; the old Markdown body and the old FAQ are not shown.
const ownAt = specByPath(url);
const fresh = ownAt && Number(ownAt.id.slice(1)) > 21 && ownAt.lang === lang ? ownAt : undefined;
// An info page that is the English version of an older content page (about, partners,
// services, contact, sell…) declares that page's translations as its alternates, so every
// member of the hreflang cluster (and the sitemap) lists the same set. Otherwise: English only.
// #262: the Greek info page at George's Greek URL is that page's Greek version too (contentUrl(k, 'el'))
const key = PAGE_KEYS.find((k) => pageExists(k) && (contentUrl(k, 'en') === url || (lang !== 'en' && contentUrl(k, lang) === url)));
// #94: translations of the same info page (`key` in the files) form their own cluster.
const cluster = await infoCluster(page);
const own = new Map(cluster.map((p) => [p.data.lang as Lang, p.data.path]));   // raw: Base encodes once
const langs: Lang[] = key ? pageLangs(key) : [...own.keys()];
const pathFor = (l: Lang) => (key ? contentUrl(key, l) : own.get(l) ?? listUrl(l));
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const abs = (p: string) => (p.startsWith('http') ? p : `${site}${p}`);
const image = d.image || HERO_SHOTS[0]?.url || '';
// The share image when the page has none of its own: the hero shot at 800 × 533 with its size (as the home
// page), never the full original (684 KB: messengers drop the preview). SEO audit 2026-11-10.
const ogFallback = !d.image && HERO_SHOTS[0] ? shareImage({ url: HERO_SHOTS[0].url, tag: 'hero' } as any) : undefined;
const imageAlt = d.image_alt || (d.image ? d.h1 : HERO_SHOTS[0]?.alt.en ?? d.h1);
// Our watermarked media come in _800w and _1920w (3:2): a hero from there gets a srcset.
const heroSrcset = /_1920w\.jpg$/.test(d.image)
  ? `${d.image.replace(/_1920w\.jpg$/, '_800w.jpg')} 800w, ${d.image} 1920w` : '';
const title = fresh ? specTitle(fresh.title, brand.name) : `${d.title} | ${brand.name}`;
const contact = pageExists('contact') && pageLangs('contact').includes(lang) ? contentUrl('contact', lang) : '/en/contact';
const terms = '/en/terms-of-services';
const privacy = privacyPath(lang);
// Area links: the English area guides on English pages, the municipality lists elsewhere.
const muniLinks = lang === 'en'
  ? AREA_PAGES.filter((p) => p.kind === 'municipality').map((p) => ({ href: areaUrl(p.slug), name: p.name }))
  : FACETS.filter((f) => f.q.municipality && Object.keys(f.q).length === 1).map((f) => ({ href: facetUrl(lang, f.key), name: f.name[lang] }));
const co = await company();
const addrLatin = brand.addressLatin ?? { street: brand.address.street, city: brand.address.city, country: brand.address.country };
// #262: the Greek page writes the address in Greek (the brand's own address); every other language in Latin script
const addr = lang === 'el' ? { street: brand.address.street, city: brand.address.city, country: 'Ελλάδα' }
  : lang === 'ru' ? { street: 'Нео-Рисио', city: 'Салоники', country: 'Греция' }   // #265
  : addrLatin;
const CARD = lang === 'ru'
  ? { office: 'Офис', phone: 'Телефон', mail: 'E-mail', map: 'Как добраться до нашего офиса: Google Maps',
      reach: 'Позвонить или написать', hours: 'Часы работы', write: 'Написать нам', mapShort: 'Проложить маршрут',
      days: [['Понедельник – пятница', '09:30 – 19:00'], ['Суббота', '10:00 – 14:00'], ['Воскресенье', 'Выходной']] }
  : lang === 'el'
  ? { office: 'Γραφείο', phone: 'Τηλέφωνο', mail: 'E-mail', map: 'Οδηγίες για το γραφείο μας στο Google Maps',
      reach: 'Τηλέφωνο και μηνύματα', hours: 'Ώρες λειτουργίας', write: 'Στείλτε μας μήνυμα', mapShort: 'Οδηγίες μετάβασης',
      days: [['Δευτέρα – Παρασκευή', '09:30 – 19:00'], ['Σάββατο', '10:00 – 14:00'], ['Κυριακή', 'Κλειστά']] }
  : { office: 'Office', phone: 'Phone', mail: 'E-mail', map: 'Get directions to our office on Google Maps',
      reach: 'Call or write', hours: 'Working hours', write: 'Send us a message', mapShort: 'Get directions',
      days: [['Monday – Friday', '09:30 – 19:00'], ['Saturday', '10:00 – 14:00'], ['Sunday', 'Closed']] };
// the brands' own marks in one colour (Simple Icons, CC0; Sergei 2026-11-16 «иконки оригинальные но чернобелые»)
const ICON_WA = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z';
const ICON_VIBER = 'M11.4 0C9.473.028 5.333.344 3.02 2.467 1.302 4.187.696 6.7.633 9.817.57 12.933.488 18.776 6.12 20.36h.003l-.004 2.416s-.037.977.61 1.177c.777.242 1.234-.5 1.98-1.302.407-.44.972-1.084 1.397-1.58 3.85.326 6.812-.416 7.15-.525.776-.252 5.176-.816 5.892-6.657.74-6.02-.36-9.83-2.34-11.546-.596-.55-3.006-2.3-8.375-2.323 0 0-.395-.025-1.037-.017zm.058 1.693c.545-.004.88.017.88.017 4.542.02 6.717 1.388 7.222 1.846 1.675 1.435 2.53 4.868 1.906 9.897v.002c-.604 4.878-4.174 5.184-4.832 5.395-.28.09-2.882.737-6.153.524 0 0-2.436 2.94-3.197 3.704-.12.12-.26.167-.352.144-.13-.033-.166-.188-.165-.414l.02-4.018c-4.762-1.32-4.485-6.292-4.43-8.895.054-2.604.543-4.738 1.996-6.173 1.96-1.773 5.474-2.018 7.11-2.03zm.38 2.602c-.167 0-.303.135-.304.302 0 .167.133.303.3.305 1.624.01 2.946.537 4.028 1.592 1.073 1.046 1.62 2.468 1.633 4.334.002.167.14.3.307.3.166-.002.3-.138.3-.304-.014-1.984-.618-3.596-1.816-4.764-1.19-1.16-2.692-1.753-4.447-1.765zm-3.96.695c-.19-.032-.4.005-.616.117l-.01.002c-.43.247-.816.562-1.146.932-.002.004-.006.004-.008.008-.267.323-.42.638-.46.948-.008.046-.01.093-.007.14 0 .136.022.27.065.4l.013.01c.135.48.473 1.276 1.205 2.604.42.768.903 1.5 1.446 2.186.27.344.56.673.87.984l.132.132c.31.308.64.6.984.87.686.543 1.418 1.027 2.186 1.447 1.328.733 2.126 1.07 2.604 1.206l.01.014c.13.042.265.064.402.063.046.002.092 0 .138-.008.31-.036.627-.19.948-.46.004 0 .003-.002.008-.005.37-.33.683-.72.93-1.148l.003-.01c.225-.432.15-.842-.18-1.12-.004 0-.698-.58-1.037-.83-.36-.255-.73-.492-1.113-.71-.51-.285-1.032-.106-1.248.174l-.447.564c-.23.283-.657.246-.657.246-3.12-.796-3.955-3.955-3.955-3.955s-.037-.426.248-.656l.563-.448c.277-.215.456-.737.17-1.248-.217-.383-.454-.756-.71-1.115-.25-.34-.826-1.033-.83-1.035-.137-.165-.31-.265-.502-.297zm4.49.88c-.158.002-.29.124-.3.282-.01.167.115.312.282.324 1.16.085 2.017.466 2.645 1.15.63.688.93 1.524.906 2.57-.002.168.13.306.3.31.166.003.305-.13.31-.297.025-1.175-.334-2.193-1.067-2.994-.74-.81-1.777-1.253-3.05-1.346h-.024zm.463 1.63c-.16.002-.29.127-.3.287-.008.167.12.31.288.32.523.028.875.175 1.113.422.24.245.388.62.416 1.164.01.167.15.295.318.287.167-.008.295-.15.287-.317-.03-.644-.215-1.178-.58-1.557-.367-.378-.893-.574-1.52-.607h-.018z';
const mapUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${brand.name}, ${addrLatin.street} ${brand.address.postalCode}, ${addrLatin.city}`)}`;

let munis: { name: string; key: string }[] = [];
const memberToken = Astro.cookies.get('member_token')?.value;
let items: SiteProperty[] = [];
try {
  items = await allProperties(memberToken, visitorCountry(Astro.request));   // #18
  munis = [...new Set(items.map((p) => muniKey(p.attributes ?? {})).filter(Boolean))]
    .slice(0, 4)
    .map((k) => {
      const src = items.find((p) => muniKey(p.attributes ?? {}) === k);
      return { name: municipalityOf(src?.attributes ?? {}, lang) || k, key: k };
    });
} catch {
  munis = [];
}

// ── DESKTOP REDESIGN, WAVE 1 (#105, approved by George 2026-11-02) ──────────
// `look: wave1` in the page file: hero with a photo, the cards as a row, the dark form band,
// «Related» and area rows (InfoKit.astro). Phones (< 1024px) keep George's layout: the same
// markup draws it, the desktop-only pieces are hidden there and load nothing.
const w1 = d.look === 'wave1';
// Contact band look while Sergei chooses (2026-11-18); split = details light, form dark
const ctV = (['split', 'mirror', 'dark', 'light'] as const).find((v) => v === Astro.url.searchParams.get('v')) ?? 'split';
// The page's short name (breadcrumb end, form eyebrow): the menu word of its section.
const NAV_KEY: Partial<Record<typeof d.section, string>> = { sell: 'nav.sell', services: 'nav.services', company: 'nav.company' };
// a sub page with an own brief names itself (its brief's last breadcrumb), not its section
const short = fresh && d.parents.length && fresh.breadcrumb?.length ? fresh.breadcrumb[fresh.breadcrumb.length - 1] : NAV_KEY[d.section] ? t(lang, NAV_KEY[d.section]!) : d.h1;
const HOW_KEY: Partial<Record<typeof d.section, string>> = { sell: 'info.sell_how' };
const howH2 = HOW_KEY[d.section] ? t(lang, HOW_KEY[d.section]!) : '';
// Own pages (Sell): H2 only for the text sections of the brief; the design headings (how, cards, related,
// form, closing call) become p / h3 with the same look (SEO audit 2026-11-10: 15 H2 against 7).
const HT = fresh ? 'p' : 'h2';
const CT = fresh ? 'p' : 'h2';   // the card titles come before the first H2: a design heading, not h3 (heading order)
// #259 (Sergei 12/11, Pre-published: «почему справа просто белое пространство?»): a wave-1 page with no photo of
// its own left the right half of its hero empty. It now takes an open, watermarked photo of a property with a
// sea or outside view, the same one for the same page (chosen by its path). The Contact page puts its contact
// details there instead.
const HERO_TAGS = ['view_sea', 'view_beach', 'exterior_aerial', 'view_panoramic', 'exterior_pool'];
const autoPhoto = (() => {
  if (d.desk_image || !w1 || d.contact_card) return null;
  const pool = items.flatMap((p) => {
    if ((p as { locked?: boolean }).locked) return [];
    const a = p.attributes ?? {};
    const ph = photosOf(a).find((x, i) => isPhotoOpen(x, i) && x.tag && HERO_TAGS.includes(x.tag));
    return ph ? [{ ph, a }] : [];
  });
  if (!pool.length) return null;
  let h = 0; for (const c of d.path) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  const { ph, a } = pool[h % pool.length];
  return { url: marked(ph.url, 1920), alt: altOf(ph, lang, `${subName(a, lang)} — ${municipalityOf(a, lang)}`) };
})();
// no property photo in memory (the CRM down, a local run): the home page's hero shot, never an empty half
const heroFallback = !d.desk_image && !autoPhoto && w1 && !d.contact_card ? HERO_SHOTS[0] : undefined;
const deskImg = d.desk_image || autoPhoto?.url || heroFallback?.url || '';
const deskAlt = d.desk_image ? (d.desk_image_alt || d.h1) : (autoPhoto?.alt || heroFallback?.alt[lang] || heroFallback?.alt.en || d.h1);
const deskSet = heroFallback ? cleanSrcSet(deskImg) : /_1920w\.jpg$/.test(deskImg) ? `${deskImg.replace(/_1920w\.jpg$/, '_800w.jpg')} 800w, ${deskImg} 1920w` : deskImg;
const relCards = w1 ? d.related.map((r) => ({
  ...r, text: r.text.replaceAll('{phone}', brand.contact.phoneText), button: r.button || t(lang, 'info.more'),
})) : [];
const areas = w1 ? areaCards(items, lang) : [];
// Sergei 2026-11-16 («паттерн должен быть для всех одинаковый, просто ссылки разные»): «Related» and «Property for sale in
// Halkidiki» on every info page as the list page's blocks (PageBlocks) — photo tiles with the caption link on the photo,
// no buttons, no «About the area». Related tiles take a watermarked property cover each (a page has no photo of its own).
const infoBlocks = w1 ? pageBlocks(items as any, lang, [], [], d.path) : { cats: [], areas: [], areasFrom: 0, consumed: new Set<string>() };
// the related links once per address (the phones' link band; the tiles below do the same)
const relLinks = d.related.filter((x, i, all) => x.href !== d.path && all.findIndex((y) => y.href === x.href) === i);
const relTiles: BlockTile[] = (() => {
  if (!w1) return [];
  const used = new Set<string>();
  const pool = items.filter((p) => heroReady(p.attributes ?? {}) && !p.locked).map((p) => coverOf((p.attributes ?? {}) as any)).filter((c): c is NonNullable<typeof c> => !!c && !used.has(c.url) && (used.add(c.url), true));
  // one tile per address: George's related links to the folded Sell pages all lead to Sell now (D-20261109-SS-5), and a
  // link to this very page is no tile (Sergei 2026-11-16 saw three tiles to /en/sell)
  const seen = new Set<string>([d.path]);
  return d.related.filter((x) => !seen.has(x.href) && (seen.add(x.href), true))
    .map((x, i) => ({ href: x.href, text: x.label, sub: '', photo: pool.length ? pool[(i * 7 + d.path.length) % pool.length] : null, from: 0 }));
})();
// SEO (Sergei 2026-11-10: «этот блок там для этого»): every municipality, Polygyros too, and the heading links the list
const homeAreas = fresh ? buildAreaTiles(items, lang, undefined, 5) : { tiles: [], from: 0 };
// ── SERVICES HUB, desktop (#106, approved by George 2026-11-02) ─────────────
// A `wave1` page of the services section with cards = the services hub: George's page stays as it
// is on phones (the classic layout below, hidden from 1024px), the desktop draws ServicesHub. Every
// role panel is built from George's own texts: the card (name, short text) and the page it links
// to (H1, lead, watermarked hero photo). All five panels are in the HTML; switching only shows one.
const hub = w1 && d.section === 'services' && d.cards.length > 0;
const roles: Role[] = [];
if (hub) {
  for (const c of d.cards) {
    const sub = (await findInfoPage(c.href))?.data;
    const img = sub?.image || c.image;
    roles.push({
      n: c.title, h: sub?.h1 || c.title, href: c.href,
      lead: sub?.lead || c.text, what: sub?.lead ? c.text : '',
      img, srcset: /_1920w\.jpg$/.test(img) ? `${img.replace(/_1920w\.jpg$/, '_800w.jpg')} 800w, ${img} 1920w` : '',
      alt: (sub?.image ? sub.image_alt : c.image_alt) || c.title,
      source: sub?.form?.source || `Services: ${c.title}`,
    });
  }
}
// The FAQ block of the hub: George's FAQ page in the same language (English: /en/faq).
// ── COMPANY PAGE, desktop (#107, approved by George 2026-11-02) ────────────────
// A `wave1` page of the company section = the company page: the hero (George's H1, the first
// sentence of his text, «Contact us», phone, WhatsApp, the office photo), then CompanyHub (facts,
// values, people, story, partners, doors) and the area row. Phones keep George's layout below.
const coHub = w1 && d.hub === 'company';   // only the about-us page itself (its sub pages are ordinary pages on the kit)
const coLead = coHub ? (page.body ?? '').trim().split(/(?<=[.!?])\s+/)[0] ?? '' : '';
const coContact = coHub ? d.related.find((r) => r.href === contact)?.label || t(lang, 'co.contact') : '';
// «About Halkidiki Properties»: the brand name on its own line on desktop, as the design draws it.
// an H1 that ends with the brand («Contact Halkidiki Properties»): the words before it small, the name large below them
// (Sergei 2026-11-16 «contact сделай мелким и ниже Halkidiki properties большим»); one H1 for search, joined by a space
const h1Pre2 = (h: string) => (h.endsWith(brand.name) && h.length > brand.name.length + 1 ? h.slice(0, -brand.name.length).trim() : '');
const hubLike = hub || coHub;
const faqPage = hub ? (await findInfoPage(`${prefix(lang)}/faq`))?.data ?? null : null;

// ── STRUCTURED DATA ───────────────────────────────────────────────────────
const org = {
  '@type': 'RealEstateAgent', name: brand.name, url: `${site}${prefix(lang) || '/'}`,
  telephone: brand.contact.phoneE164, email: brand.contact.email,
  address: { '@type': 'PostalAddress', streetAddress: brand.address.street, addressLocality: brand.address.city,
    postalCode: brand.address.postalCode, addressRegion: brand.address.region, addressCountry: brand.address.country },
  areaServed: brand.market.areaServed,
  ...(co.foundedYear ? { foundingDate: String(co.foundedYear) } : {}),
};
const crumbs0 = [{ name: brand.name, path: prefix(lang) || '/' }, ...d.parents, { name: fresh?.h1 ?? d.h1, path: url }];
// an own brief names its breadcrumb (rule 15, as George's spec pages: «Home > Services»)
const crumbs = fresh && fresh.breadcrumb?.length === crumbs0.length ? crumbs0.map((c, i) => ({ ...c, name: fresh.breadcrumb[i] })) : crumbs0;
const jsonLd: unknown[] = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.path) })),
  },
];
if (d.schema === 'Service') {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'Service', name: d.h1, description: d.description,
    url: abs(url), serviceType: d.h1, provider: org, areaServed: brand.market.areaServed,
    ...(d.catalog.length ? { hasOfferCatalog: {
      '@type': 'OfferCatalog', name: d.h1,
      itemListElement: d.catalog.map((c) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: c.name, url: abs(c.url) } })),
    } } : {}),
  });
} else if (fresh && ![fresh.schema].flat().includes('CollectionPage')) {
  jsonLd.push({ '@context': 'https://schema.org', '@type': 'Article', headline: fresh.h1, description: fresh.meta, url: abs(url), inLanguage: lang, author: org, publisher: org });
} else if (d.schema !== 'FAQPage') {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': d.schema, name: fresh?.h1 ?? d.h1, description: fresh?.meta ?? d.description, url: abs(url),
    inLanguage: lang, ...(d.schema === 'AboutPage' || d.schema === 'ContactPage' ? { mainEntity: org } : {}),
  });
}
if (d.widget === 'prices') {
  const t = priceTables(items, lang);
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'Dataset', name: d.h1, description: d.description, url: abs(url),
    creator: org, license: abs(url), isAccessibleForFree: true, spatialCoverage: brand.market.areaServed,
    dateModified: new Date().toISOString().slice(0, 10),
    variableMeasured: ['Median asking price per square metre (EUR)', 'Interquartile range (EUR per m²)'],
    hasPart: t.homes.map((r) => ({ '@type': 'Dataset', name: `${r.name}: median €/m² ${r.perSqm}`, description: `Homes in ${r.name}, median asking price per m²` })),
  });
}
const faqItems = fresh ? fresh.faq : d.faq;
// Mosaic photos, one per section by topic (the page's photoThemes, Sergei 2026-11-09: «по тематике,
// а не рандомно»): the first guest property in the site order whose OPEN photo carries one of the
// theme's tags (and is land / at least the minimum price, when the theme says so). Never a locked
// property, never the same property twice; always watermarked (R-007), alt from the photo's own texts.
// Own pages (Sell): the SEO sections whose link is one of the page cards become those cards — photo, the
// section's H2 and text, the link with its spec anchor (Sergei 2026-11-10: «слить с карточками»); they leave
// the posts. The brief puts these sections first, so the H2 order holds (rule 8).
const pathKey = (h: string) => { try { return decodeURI(new URL(h, 'https://x').pathname).replace(/\/+$/, ''); } catch { return h; } };
const secCards: { h2: string; html: string; href: string; anchor: string; img?: string; alt?: string; w?: number; h?: number; dark?: boolean; ask?: boolean }[] = [];
let postsPage = fresh;
let postLinks: { href: string; text: string }[][] | undefined;
if (fresh) {
  const secs = specSections(fresh.body);
  const bySec = linksBySection(fresh);
  const used = new Set<number>(), usedLinks = new Set<string>();
  for (const c of d.cards) {
    const i = bySec.findIndex((ls, k) => !used.has(k) && ls.some((l) => pathKey(l.href) === pathKey(c.href)));
    if (i < 0) continue;
    const l = bySec[i].find((x) => pathKey(x.href) === pathKey(c.href))!;
    used.add(i); usedLinks.add(pathKey(l.href));
    const plain = secs[i].h2.replace(/<[^>]+>/g, '').trim();
    secCards.push({ h2: secs[i].h2, html: secs[i].html, href: l.href, anchor: l.text, img: c.image || undefined, alt: c.image_alt || undefined, w: c.width, h: c.height,
      dark: [fresh.standout].flat().includes(plain), ask: (fresh.questionMarks ?? []).includes(plain) });
  }
  // the cards in the order of the brief (rule 8)
  secCards.sort((a, b) => secs.findIndex((x) => x.h2 === a.h2) - secs.findIndex((x) => x.h2 === b.h2));
  if (secCards.length) {
    const keep = secs.filter((_, k) => !used.has(k));
    postLinks = bySec.filter((_, k) => !used.has(k));   // assigned on the whole page, so a link stays with its own section
    postsPage = { ...fresh,
      body: keep.map((x) => `<h2>${x.h2}</h2>${x.html}`).join(''),
      h2: keep.map((x) => x.h2.replace(/<[^>]+>/g, '')),
      linksOut: fresh.linksOut.filter((l) => !usedLinks.has(pathKey(l.href))) };
  }
}
// Services hub with an own brief (P35, Sergei 2026-11-11 «берем первый вариант»): the sections become the service
// panels instead of cards — the same match by link, the panel shows the section's H2, text and anchor.
if (hub) for (const r of roles) {
  const c = secCards.find((x) => pathKey(x.href) === pathKey(r.href));
  if (c) r.sec = { h2: c.h2, html: c.html, anchor: c.anchor };
}
const mosaicPhotos: (MosaicPhoto | null)[] = [];
// Fixed photos per post win (Sergei 2026-11-10: every post has a picture «найди в интернете»): CC0
// stock photos of the topic (not properties, so no watermark), sources in public/pages/sell/posts/SOURCES.json.
if (fresh?.postPhotos?.length) {
  for (const h of (postsPage!.body.match(/<h2>[\s\S]*?<\/h2>/g) ?? []).map((x) => x.replace(/<[^>]+>/g, '').trim())) {
    const pp = fresh.postPhotos.find((t) => t.after === h);
    mosaicPhotos.push(pp ? { src: `${pp.file}_960w.webp`, srcset: `${pp.file}_640w.webp 640w, ${pp.file}_960w.webp 960w`, alt: pp.alt, style: '' } : null);
  }
} else if (fresh?.photoThemes?.length) {
  const used = new Set<string>();
  const secH2 = (postsPage!.body.match(/<h2>[\s\S]*?<\/h2>/g) ?? []).map((h) => h.replace(/<[^>]+>/g, '').trim());
  for (const h of secH2) {
    const th = fresh.photoThemes.find((t) => t.after === h);
    let hit: MosaicPhoto | null = null;
    if (th) {
      for (const p of items) {
        if (p.locked || used.has(p.id)) continue;
        const a = p.attributes ?? {};
        if (th.category === 'land' && !['land', '2'].includes(String(a.category ?? '').toLowerCase())) continue;
        if (th.minPrice && !(Number(a.public_price) >= th.minPrice)) continue;
        const ph = photosOf(a).find((x, i) => isPhotoOpen(x, i) && x.tag && th.tags.includes(x.tag));
        if (!ph) continue;
        used.add(p.id);
        // #251: not the CRM item title (English, with the village — R-006): type and municipality in the page language
        hit = { src: marked(ph.url, 1920), srcset: markedSrcSet(ph.url), alt: altOf(ph, lang, `${subName(a, lang)} — ${municipalityOf(a, lang)}`), style: focalStyle(ph) };
        break;
      }
    }
    mosaicPhotos.push(hit);
  }
}
if (faqItems.length) {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
