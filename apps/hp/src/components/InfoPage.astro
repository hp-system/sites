---
// ═══════════════════════════════════════════════════════════════════════════
// INFO PAGE — legal, sell, company and services pages (English first,
// George 20/10/2026). Same reading layout as the articles.
//
//   breadcrumb · H1 · lead · image · text (old site's, faithful) · FAQ · form
//   · related links (side column on desktop, at the end on phones) · CTA
//
// SEO (George 20/10: "full seo optimized"): title = page title + brand, one H1,
// canonical self, hreflang en + x-default, BreadcrumbList + the page's own
// schema.org type, Open Graph image, related internal links.
// ═══════════════════════════════════════════════════════════════════════════
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Footer from './Footer.astro';
import InfoForm from './InfoForm.astro';
import InfoWidget from './InfoWidget.astro';
import { priceTables, isPrePublished } from '../lib/prices';
import type { SiteProperty } from '../lib/api';
import { allProperties, visitorCountry } from '../lib/api';
import { muniKey, municipalityOf } from '../lib/gate';
import { subName } from '../lib/property';
import { listUrl, prefix, type Lang } from '../lib/i18n';
import { brand } from '../brand/index';
import { waHref, viberHref } from '../lib/contact';
import { HERO_SHOTS } from '../lib/hero';
import { company } from '../lib/company';
import { infoCluster, findInfoPage, type InfoPage } from '../lib/infopages';
import { FACETS, facetUrl } from '../lib/listing';
import { privacyPath } from '../lib/legal';
import { AREA_PAGES, areaUrl } from '../content/areas/en';
import { PAGE_KEYS, contentUrl, pageExists, pageLangs } from '../lib/pages';
import InfoKit from './InfoKit.astro';
import RailDash from './RailDash.astro';
import PageCard from './PageCard.astro';
import WaLink from './WaLink.astro';
import { areaCards } from '../lib/areacards';
import { buildAreaTiles } from '../lib/area-tiles';
import Areas from './Areas.astro';
import PageBlocks from './PageBlocks.astro';
import { pageBlocks, type BlockTile } from '../lib/list-blocks';
import { coverOf, heroReady } from '../lib/photos';
import ServicesHub, { type Role } from './ServicesHub.astro';
import CompanyHub from './CompanyHub.astro';
import { t } from '../lib/i18n';
import { redirectFor } from '../lib/redirects';
import Construction from './Construction.astro';
import SpecText from './SpecText.astro';
import LogoMarquee from './LogoMarquee.astro';
import SpecPosts from './SpecPosts.astro';
import ReadPage from './ReadPage.astro';
import FaqSearch from './FaqSearch.astro';
import SectionCards from './SectionCards.astro';
import { specByPath, specTitle, specSections, linksBySection } from '../lib/seo-pages';
import { cleanSrcSet, photosOf, isPhotoOpen, clean, altOf, focalStyle, shareImage, SHARE_W, SHARE_H } from '../lib/photos';
import type { MosaicPhoto } from './SpecMosaic.astro';

interface Props { page: InfoPage }
const { page } = Astro.props;
// #152: every link from the page's data points at the final address (no redirect hop):
// related links, the CTA and child cards whose target the redirect table moves.
const fin = (h?: string) => { if (!h) return h as string; const r = redirectFor(h.split(/[?#]/)[0]); return r?.status === 301 ? r.to : h; };
const d = { ...page.data,
  related: (page.data.related ?? []).map((r: any) => ({ ...r, href: fin(r.href) })),
  cards: (page.data.cards ?? []).map((c: any) => ({ ...c, href: fin(c.href) })),
  ...(page.data.cta ? { cta: { ...page.data.cta, href: fin(page.data.cta.href) } } : {}),
} as typeof page.data;
const lang: Lang = d.lang;                        // #94: info pages may be in any of the 9 languages

// Page chrome in the page language (#94). Greek in the singular.
const UI: Record<Lang, { onPage: string; related: string; forSale: string; forSaleIn: string; ctaH: string; ctaP: string;
  adviser: string; seeAll: string; faq: string; side: string }> = {
  en: { onPage: 'On this page', related: 'Related', forSale: 'Property for sale in Halkidiki', forSaleIn: 'Property for sale in {m}',
    ctaH: 'Questions about buying or selling in Halkidiki?', ctaP: 'Tell us what you are looking for. An adviser replies with a shortlist and can book a viewing in person or by video call.',
    adviser: 'Contact an adviser', seeAll: 'See properties for sale', faq: 'Frequently asked questions', side: 'Related pages' },
  el: { onPage: 'Σε αυτή τη σελίδα', related: 'Σχετικά', forSale: 'Ακίνητα προς πώληση στη Χαλκιδική', forSaleIn: 'Ακίνητα προς πώληση — {m}',
    ctaH: 'Ερωτήσεις για αγορά ή πώληση στη Χαλκιδική;', ctaP: 'Πες μας τι ψάχνεις. Ένας σύμβουλος σου στέλνει επιλογές και κλείνει επίσκεψη, από κοντά ή με βιντεοκλήση.',
    adviser: 'Μίλα με σύμβουλο', seeAll: 'Δες τα ακίνητα', faq: 'Συχνές ερωτήσεις', side: 'Σχετικές σελίδες' },
  bg: { onPage: 'На тази страница', related: 'Свързани', forSale: 'Имоти за продажба в Халкидики', forSaleIn: 'Имоти за продажба — {m}',
    ctaH: 'Въпроси за покупка или продажба в Халкидики?', ctaP: 'Кажете ни какво търсите. Консултант ще ви изпрати подбор и ще уговори оглед на място или по видео.',
    adviser: 'Свържете се с консултант', seeAll: 'Вижте имотите', faq: 'Често задавани въпроси', side: 'Свързани страници' },
  sr: { onPage: 'Na ovoj stranici', related: 'Povezano', forSale: 'Nekretnine na prodaju na Halkidikiju', forSaleIn: 'Nekretnine na prodaju — {m}',
    ctaH: 'Pitanja o kupovini ili prodaji na Halkidikiju?', ctaP: 'Recite nam šta tražite. Savetnik vam šalje izbor i zakazuje razgledanje uživo ili video-pozivom.',
    adviser: 'Kontaktirajte savetnika', seeAll: 'Pogledajte nekretnine', faq: 'Česta pitanja', side: 'Povezane stranice' },
  de: { onPage: 'Auf dieser Seite', related: 'Verwandte Seiten', forSale: 'Immobilien zum Verkauf auf Chalkidiki', forSaleIn: 'Immobilien zum Verkauf — {m}',
    ctaH: 'Fragen zu Kauf oder Verkauf auf Chalkidiki?', ctaP: 'Sagen Sie uns, was Sie suchen. Ein Berater schickt Ihnen eine Auswahl und vereinbart eine Besichtigung vor Ort oder per Videoanruf.',
    adviser: 'Berater kontaktieren', seeAll: 'Immobilien ansehen', faq: 'Häufige Fragen', side: 'Verwandte Seiten' },
  ro: { onPage: 'Pe această pagină', related: 'Legate', forSale: 'Proprietăți de vânzare în Halkidiki', forSaleIn: 'Proprietăți de vânzare — {m}',
    ctaH: 'Întrebări despre cumpărare sau vânzare în Halkidiki?', ctaP: 'Spuneți-ne ce căutați. Un consultant vă trimite o selecție și programează o vizionare, la fața locului sau prin apel video.',
    adviser: 'Contactați un consultant', seeAll: 'Vedeți proprietățile', faq: 'Întrebări frecvente', side: 'Pagini legate' },
  tr: { onPage: 'Bu sayfada', related: 'İlgili', forSale: "Halkidiki'de satılık mülkler", forSaleIn: 'Satılık mülkler — {m}',
    ctaH: "Halkidiki'de alım veya satım hakkında sorularınız mı var?", ctaP: 'Ne aradığınızı bize söyleyin. Bir danışman size seçenekler gönderir ve yerinde ya da görüntülü görüşmeyle gezi ayarlar.',
    adviser: 'Danışmanla iletişime geçin', seeAll: 'Mülkleri görün', faq: 'Sık sorulan sorular', side: 'İlgili sayfalar' },
  he: { onPage: 'בעמוד זה', related: 'קשור', forSale: 'נכסים למכירה בחלקידיקי', forSaleIn: 'נכסים למכירה — {m}',
    ctaH: 'שאלות על קנייה או מכירה בחלקידיקי?', ctaP: 'ספרו לנו מה אתם מחפשים. יועץ ישלח לכם מבחר ויתאם סיור, במקום או בשיחת וידאו.',
    adviser: 'פנו ליועץ', seeAll: 'לנכסים למכירה', faq: 'שאלות נפוצות', side: 'עמודים קשורים' },
  ru: { onPage: 'На этой странице', related: 'Похожее', forSale: 'Недвижимость на продажу в Халкидиках', forSaleIn: 'Недвижимость на продажу — {m}',
    ctaH: 'Вопросы о покупке или продаже в Халкидиках?', ctaP: 'Расскажите, что вы ищете. Консультант пришлёт подборку и договорится о просмотре на месте или по видеосвязи.',
    adviser: 'Связаться с консультантом', seeAll: 'Смотреть объекты', faq: 'Частые вопросы', side: 'Похожие страницы' },
};
const ui = UI[lang];

const { Content, headings } = await render(page);
const toc = d.toc ? headings.filter((h) => h.depth === 2 && h.text.trim()) : [];
// A text page on the kit (no widget, no own brief; its cards under the text): the reading layout (ReadPage) with every H2 in
// its side list, whatever `toc` says (Sergei 2026-11-11 «все остальное да»).
const readHeads = headings.filter((h) => h.depth === 2 && h.text.trim()).map((h) => ({ slug: h.slug, text: h.text }));
// A Sell page without an own brief (Add your property…): its H2 sections as the paged posts of the Sell canon (SpecPosts
// carousel, side list turns it) instead of one long column (Sergei 2026-11-16: «должно быть перелистываемыми блоками»).
// Only Sell pages that are plain text (legal texts, FAQ and pages with widgets or cards keep the reading layout).
const readHtmlAll: string = (page as any).rendered?.html ?? '';
// Our partners (Sergei 2026-11-19): a page whose text carries a logo gallery shows it as the floating strip at the full
// width under its centred intro, the video under the strip, then the posts at the normal size, without the logos
const logoBlock = readHtmlAll.match(/<div class="gallery logos">[\s\S]*?<\/div>/)?.[0] ?? '';
const prtLogos = [...logoBlock.matchAll(/<img src="([^"]+)" alt="([^"]*)"/g)].map((m) => ({ src: m[1], alt: m[2] }));
const readHtml0: string = logoBlock ? readHtmlAll.replace(logoBlock, '') : readHtmlAll;
// Construction (Sergei 2026-11-19 «сео блок сделай нормальной высоты»): the section that is a gallery of projects leaves
// the posts and stands as its own block of photo tiles under the top band, its H2 as the block's heading
const projSec = readHtml0.match(/<h2[^>]*>([^<]*)<\/h2>\s*(<div class="gallery projects">[\s\S]*?<\/div>)/);
const projH2 = projSec?.[1] ?? '';
const projFigs = projSec ? [...projSec[2].matchAll(/<figure>[\s\S]*?<\/figure>/g)].map((m) => m[0]) : [];
const readHtml: string = projSec ? readHtml0.replace(projSec[0], '') : readHtml0;
// Since 2026-11-16 every plain text page but the legal texts (Sergei on Contact: «ети блоки же должны быть блоками
// прокручиваемыми … мы же делали паттерн для етого»); the «Add your property» button only on Sell pages.
// the text before the first H2 (Contact, Careers…) stays above the carousel as the page's intro
const readPre = readHtml.includes('<h2') ? readHtml.slice(0, readHtml.indexOf('<h2')).trim() : '';
const readPreAll = readPre;
const prtVid = prtLogos.length ? readPreAll.match(/<figure class="vid"[\s\S]*?<\/figure>/)?.[0] ?? '' : '';
const prtPre = prtLogos.length ? readPreAll.replace(prtVid, '').trim() : '';
// …its top as the home page's dark band «We do the rest for you.» (Sergei 2026-11-19): the H1 on the left, George's
// intro on the right at the text size, every sentence the same («этот текст одинакового размера, не увеличивай»)
// Pre-published (Sergei 2026-11-19 «сделай SEO-блок как он должен быть сейчас»): a page with the pre-published list takes
// the SEO block too; the list stands as its own block above it
// About us (Sergei 2026-11-19 «иди в каждую страницу в about us и сделай блоки SEO как нужно»): the company pages take the
// block too — one section is enough there (Philosophy), and the cards (Careers' open positions) stand as a block under it
const coPage = d.section === 'company';
// a company page without a lead (Careers): its text before the first H2 stands under the H1 (Sergei 2026-11-19 «перенеси к
// заголовку»), not above the posts
const headPre = coPage && !d.lead && !d.contact_card && !d.form_top && readHeads.length > 0 ? readPre : '';
const readCar = d.section !== 'legal' && (readHeads.length > 1 || (coPage && readHeads.length >= 1)) && (!d.widget || d.widget === 'prepublished')
  && (d.cards.length === 0 || coPage) && d.faq.length === 0 && /<h2/.test(readHtml)
  ? ({ body: readHtml.slice(readHtml.indexOf('<h2')).replace(/<h2[^>]*>/g, '<h2>'), faq: [], questionMarks: [], standout: [], path: d.path, linksOut: [] } as any)
  : null;
// two sections under the same H2 (Construction has «Build with us» twice) are one post: the second one's text joins
// the first, nothing is lost, and the menu does not show the same title twice with both marked
if (readCar) {
  const secs: string[] = readCar.body.split(/(?=<h2>)/).filter((x: string) => x.trim());
  const seen = new Map<string, number>();
  const out: string[] = [];
  for (const sc of secs) {
    const h = sc.match(/<h2>([\s\S]*?)<\/h2>/)?.[1].trim() ?? '';
    if (h && seen.has(h)) { out[seen.get(h)!] += sc.replace(/<h2>[\s\S]*?<\/h2>/, ''); continue; }
    if (h) seen.set(h, out.length);
    out.push(sc);
  }
  readCar.body = out.join('');
}
// company pages: a page of one H2 with H3 parts (Values: the values, our people) — the parts are the posts; a video in
// the text stands centred above the block (as on Our partners); a picture standing on its own in a section becomes that
// post's photo; a section with no text (Careers' «Open positions») leaves the posts and heads the cards block instead
let carVid = '';
const secImgs: (MosaicPhoto | null)[] = [];
let cardsH = '';
if (readCar && (coPage || d.section === 'sell')) {
  let b: string = readCar.body;
  // the H3 parts are posts of their own (Values: our people; Responsibility: sports, plans — one post was two screens long)
  if (/<h3[^>]*>/.test(b)) b = b.replace(/<h3[^>]*>/g, '<h2>').replace(/<\/h3>/g, '</h2>');
  carVid = b.match(/<figure class="vid"[\s\S]*?<\/figure>/)?.[0] ?? '';
  if (carVid) b = b.replace(carVid, '');
  const secs = b.split(/(?=<h2>)/).filter((x) => x.trim());
  const kept: string[] = [];
  for (const sc of secs) {
    const rest = sc.replace(/<h2>[\s\S]*?<\/h2>/, '').trim();
    if (!rest) { cardsH ||= sc.match(/<h2>([\s\S]*?)<\/h2>/)?.[1] ?? ''; continue; }
    const im = sc.match(/(?:<p>\s*)?<img\s(?![^>]*pt-ic)[^>]*>(?:\s*<\/p>)?/);   // not a portal's icon in a table
    const inLi = im ? /<li>(?:(?!<\/li>)[\s\S])*$/.test(sc.slice(0, im.index)) : false;
    if (im && !inLi) {
      const src = im[0].match(/src="([^"]+)"/)?.[1] ?? '';
      const alt = im[0].match(/alt="([^"]*)"/)?.[1] ?? '';
      secImgs.push(src ? { src, srcset: '', alt, style: '' } : null);
      kept.push(sc.replace(im[0], ''));
    } else { secImgs.push(null); kept.push(sc); }
  }
  readCar.body = kept.join('');
}
// Our partners (Sergei 2026-11-19 «первая статья может пойти просто заголовком над видео, а статей будет 3»): the first
// section leaves the posts and stands as the heading over the video; the other three get a picture each
const prtFirst = (() => {
  if (!readCar || !prtLogos.length) return null;
  const b: string = readCar.body;
  const i2 = b.indexOf('<h2', 4);
  if (i2 < 0) return null;
  const sec = b.slice(0, i2);
  readCar.body = b.slice(i2);
  return { h2: sec.match(/<h2>([\s\S]*?)<\/h2>/)?.[1] ?? '', html: sec.replace(/<h2>[\s\S]*?<\/h2>/, '').trim() };
})();
const prtHeads = prtFirst ? readHeads.slice(1) : readHeads;
// a CC0 photo per post (Sergei 2026-11-19 «найди фото в хорошем разрешении в интернете … и сразу сео в них тоже делай»):
// a bright kitchen and living room (materials, windows, kitchens, interiors), a builder with the plans in front of a
// house going up (renovate, furnish, build), a handshake (working with us); sources in public/pages/our-partners/posts/
// SOURCES.json. SEO: the file is named after its post, the alt says what the photo shows and ties it to the post, in
// the page's language
const PRT_DIR = '/pages/our-partners/posts/';
const PRT_PH = [
  { f: 'who-our-partners-are', w: [640, 960], alt: {
    en: 'Bright kitchen and dining area with white cabinets, tiles and large windows: materials, kitchens and interiors from our partners',
    el: 'Φωτεινή κουζίνα και τραπεζαρία με λευκά ντουλάπια, πλακάκια και μεγάλα παράθυρα: υλικά, κουζίνες και εσωτερικοί χώροι από τους συνεργάτες μας',
    ru: 'Светлая кухня-столовая с белыми шкафами, плиткой и большими окнами: материалы, кухни и интерьеры от наших партнёров' } },
  { f: 'why-partners-matter-to-our-clients', w: [640, 960], alt: {
    en: 'Builder with the plans in front of a house under construction: building and renovating a home in Halkidiki with trusted partners',
    el: 'Εργοδηγός με τα σχέδια μπροστά σε σπίτι υπό κατασκευή: κατασκευή και ανακαίνιση κατοικίας στη Χαλκιδική με αξιόπιστους συνεργάτες',
    ru: 'Прораб с чертежами у строящегося дома: строительство и ремонт дома в Халкидиках с надёжными партнёрами' } },
  { f: 'working-with-us', w: [640, 960, 1600], alt: {
    en: `Handshake over a table after an agreement: a new partnership with ${brand.name}`,
    el: `Χειραψία πάνω από ένα τραπέζι μετά από συμφωνία: νέα συνεργασία με τη ${brand.name}`,
    ru: `Рукопожатие за столом после договорённости: новое партнёрство с ${brand.name}` } },
];
// Construction (Sergei 2026-11-19 «для двоих статей найди подходящие картинки»): engineers over the plans (build with us),
// an olive grove on a hillside (a plot to build on); CC0, sources in public/pages/construction/posts/SOURCES.json
const CON_DIR = '/pages/construction/posts/';
const CON_PH = [
  { f: 'build-with-us', alt: {
    en: 'Engineers going over the construction plans together: studies, licences and building a home in Halkidiki',
    el: 'Μηχανικοί εξετάζουν μαζί τα κατασκευαστικά σχέδια: μελέτες, άδειες και κατασκευή κατοικίας στη Χαλκιδική',
    ru: 'Инженеры вместе разбирают строительные чертежи: проект, разрешения и строительство дома в Халкидиках' } },
  { f: 'have-a-plot-or-an-idea', alt: {
    en: 'Olive grove on a green hillside: a plot of land to build your home on',
    el: 'Ελαιώνας σε πράσινη πλαγιά: οικόπεδο για να χτίσετε το σπίτι σας',
    ru: 'Оливковая роща на зелёном склоне: участок земли под строительство дома' } },
];
// Pre-published (Sergei 2026-11-19 «дай каждой статье картинку»): papers on a desk (the property made ready before the
// market), a laptop by a window over the sea (who it is for; the couple photo replaced the same day), a laptop and the phone in hand (register, get told first)
const PP_DIR = '/pages/pre-published-properties/posts/';
const PP_PH = [
  { f: 'what-pre-published-means', alt: {
    en: 'Documents and a pen on a desk: a property being made ready before it reaches the market',
    el: 'Έγγραφα και στυλό σε γραφείο: ένα ακίνητο ετοιμάζεται πριν βγει στην αγορά',
    ru: 'Документы и ручка на столе: объект готовят до выхода на рынок' } },
  { f: 'who-it-is-for', alt: {
    en: 'Laptop and coffee by a window over the sea and the mountains: buyers who follow the market from their screen, before the open market',
    el: 'Laptop και καφές δίπλα σε παράθυρο με θέα θάλασσα και βουνά: αγοραστές που παρακολουθούν την αγορά από την οθόνη τους, πριν από την ανοιχτή αγορά',
    ru: 'Ноутбук и кофе у окна с видом на море и горы: покупатели, которые следят за рынком с экрана, ещё до открытого рынка' } },
  { f: 'how-it-works', alt: {
    en: 'Laptop and a phone in hand: register for free and be the first to hear about a matching property',
    el: 'Laptop και κινητό στο χέρι: κάντε δωρεάν εγγραφή και μάθετε πρώτοι για το ακίνητο που σας ταιριάζει',
    ru: 'Ноутбук и телефон в руке: бесплатная регистрация, и вы первыми узнаёте о подходящем объекте' } },
];
// About us pages (Sergei 2026-11-19): a photo per post — CC0 stock (sources in each page's posts/SOURCES.json), the
// company's own pictures where they fit (Our story: the eras' pictures of the About us page; the pages' own banners);
// null = the section's own picture (Philosophy, Book an online appointment)
type PostPh = { f?: string; src?: string; alt: { en: string; el: string; ru: string } } | null;
const stockPh = (f: string, en: string, el: string, ru: string): PostPh => ({ f, alt: { en, el, ru } });
const ownPic = (src: string, en: string, el: string, ru: string): PostPh => ({ src, alt: { en, el, ru } });
const PAGE_PH: Record<string, { dir: string; list: PostPh[] }> = {
  construction: { dir: CON_DIR, list: CON_PH },
  'pre-published-properties': { dir: PP_DIR, list: PP_PH },
  'about-us/our-story': { dir: '', list: [
