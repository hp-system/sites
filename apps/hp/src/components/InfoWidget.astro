---
// ═══════════════════════════════════════════════════════════════════════════
// LIVE DATA BLOCKS for the info pages, computed from the listings the site
// already loads (lib/prices.ts):
//   prices        — median €/m² by municipality and area (homes, land)
//   greece-guide  — "from €" by property type and by municipality
//   prepublished  — pre-published properties (members only; the CRM has no flag yet)
// 🔢 Prices only — never a count of properties (George 17/10/2026).
// ═══════════════════════════════════════════════════════════════════════════
import type { SiteProperty } from '../lib/api';
import { priceOf, priceVisible, refOf } from '../lib/api';
import { money, sqm } from '../lib/format';
import { muniKey } from '../lib/gate';
import { listUrl, propertyUrl, type Lang } from '../lib/i18n';
import { priceTables, fromPrice, TYPE_GUIDE, isPrePublished } from '../lib/prices';
import { AREA_PAGES, areaUrl } from '../content/areas/en';
import { brand } from '../brand/index';

interface Props { kind: 'prices' | 'greece-guide' | 'prepublished'; items: SiteProperty[]; member: boolean; lang?: Lang }
const { kind, items, member, lang = 'en' } = Astro.props;
// #262 languages stage: the blocks speak the page language (Greek first; the others fall back to English)
const W = {
  en: {
    homesH: 'Homes: median price per m² by area', muni: 'Municipality', medSqm: 'Median €/m²', mid: 'Middle half', medPrice: 'Median price',
    homesEmpty: 'The price table is being updated.', villagesH: 'Homes: median €/m² by village and area',
    landH: 'Land: median price per m² of plot', medPlotSqm: 'Median €/m² of plot', medPlot: 'Median plot', landEmpty: 'The land price table is being updated.',
    note: 'Asking prices of our own current listings, not sale prices — computed automatically and updated continuously. Homes with price and floor area; land with price and plot size. Free to quote with "Source: {brand}".',
    typesH: 'What is for sale right now', munisH: 'Properties by municipality', from: 'from', guideNote: 'Prices update automatically from our listings.',
    allLink: 'See all properties for sale in Halkidiki', preH: 'Properties before they reach the market', onRequest: 'Price on request',
    preNoneMember: 'No pre-published properties right now. Tell us what you are looking for and you will be the first to know.',
    preNoneGuest: 'Pre-published properties are shown to registered members. Register for free and tell us what you are looking for: we will tell you first.',
  },
  el: {
    homesH: 'Κατοικίες: διάμεση τιμή ανά τ.μ. ανά περιοχή', muni: 'Δήμος', medSqm: 'Διάμεση €/τ.μ.', mid: 'Μεσαίο εύρος', medPrice: 'Διάμεση τιμή',
    homesEmpty: 'Ο πίνακας τιμών ενημερώνεται.', villagesH: 'Κατοικίες: διάμεση €/τ.μ. ανά χωριό και περιοχή',
    landH: 'Γη: διάμεση τιμή ανά τ.μ. οικοπέδου', medPlotSqm: 'Διάμεση €/τ.μ. οικοπέδου', medPlot: 'Διάμεσο οικόπεδο', landEmpty: 'Ο πίνακας τιμών γης ενημερώνεται.',
    note: 'Ζητούμενες τιμές των δικών μας τρεχουσών αγγελιών, όχι τιμές πώλησης — υπολογίζονται αυτόματα και ενημερώνονται συνεχώς. Κατοικίες με τιμή και εμβαδόν· γη με τιμή και εμβαδόν οικοπέδου. Ελεύθερη αναπαραγωγή με την αναφορά «Πηγή: {brand}».',
    typesH: 'Τι πωλείται αυτή τη στιγμή', munisH: 'Ακίνητα ανά δήμο', from: 'από', guideNote: 'Οι τιμές ενημερώνονται αυτόματα από τις αγγελίες μας.',
    allLink: 'Δείτε όλα τα ακίνητα προς πώληση στη Χαλκιδική', preH: 'Ακίνητα πριν βγουν στην αγορά', onRequest: 'Τιμή κατόπιν επικοινωνίας',
    preNoneMember: 'Δεν υπάρχουν προ-δημοσιευμένα ακίνητα αυτή τη στιγμή. Πείτε μας τι αναζητάτε και θα το μάθετε πρώτοι.',
    preNoneGuest: 'Τα προ-δημοσιευμένα ακίνητα εμφανίζονται στα εγγεγραμμένα μέλη. Εγγραφείτε δωρεάν και πείτε μας τι αναζητάτε: θα σας ενημερώσουμε πρώτους.',
  },
};
const W_RU: typeof W.en = {
  homesH: 'Жильё: медианная цена за м² по районам', muni: 'Муниципалитет', medSqm: 'Медиана €/м²', mid: 'Средняя половина', medPrice: 'Медианная цена',
  homesEmpty: 'Таблица цен обновляется.', villagesH: 'Жильё: медиана €/м² по сёлам и районам',
  landH: 'Земля: медианная цена за м² участка', medPlotSqm: 'Медиана €/м² участка', medPlot: 'Медианный участок', landEmpty: 'Таблица цен на землю обновляется.',
  note: 'Цены предложения по нашим текущим объектам, а не цены сделок — рассчитываются автоматически и обновляются постоянно. Жильё — с ценой и площадью; земля — с ценой и площадью участка. Можно цитировать со ссылкой «Источник: {brand}».',
  typesH: 'Что продаётся сейчас', munisH: 'Недвижимость по муниципалитетам', from: 'от', guideNote: 'Цены обновляются автоматически по нашим объектам.',
  allLink: 'Вся недвижимость на продажу в Халкидики', preH: 'Объекты до выхода на рынок', onRequest: 'Цена по запросу',
  preNoneMember: 'Сейчас объектов до публикации нет. Расскажите, что вы ищете, — вы узнаете первыми.',
  preNoneGuest: 'Объекты до публикации видят зарегистрированные участники. Зарегистрируйтесь бесплатно и расскажите, что вы ищете, — мы сообщим вам первыми.',
};
const w = lang === 'ru' ? W_RU : (W as Record<string, typeof W.en>)[lang] ?? W.en;
const eur = (n: number) => money(n, lang);

const tables = kind === 'prices' ? priceTables(items, lang) : null;
const munis = AREA_PAGES.filter((p) => p.kind === 'municipality');
const muniFrom = kind === 'greece-guide'
  ? munis.map((m) => ({ name: m.name, href: areaUrl(m.slug),
      from: fromPrice(items, (a) => muniKey(a) === m.q.municipality) })).filter((m) => m.from > 0)
  : [];
const typeFrom = kind === 'greece-guide'
  ? TYPE_GUIDE.map((t) => ({ ...t, from: fromPrice(items, t.keep) })).filter((t) => t.from > 0)
  : [];
// texts no longer say «below»: the form opens from the page's one button (Sergei 2026-11-27)
const pre = kind === 'prepublished' && member ? items.filter((p) => isPrePublished(p.attributes ?? {})) : [];
const priceText = (p: SiteProperty) => (priceVisible(p.attributes ?? {}) ? eur(priceOf(p.attributes ?? {})) : w.onRequest);
---
{tables && (
  <section class="pw" aria-labelledby="pw-homes">
    <h2 id="pw-homes">{w.homesH}</h2>
    {tables.homes.length ? (
      <div class="pw-scroll">
        <table>
          <thead><tr><th scope="col">{w.muni}</th><th scope="col">{w.medSqm}</th><th scope="col">{w.mid}</th><th scope="col">{w.medPrice}</th></tr></thead>
          <tbody>
            {tables.homes.map((r) => (
              <tr><th scope="row">{r.name}</th><td>{eur(r.perSqm)}</td><td>{eur(r.low)}–{eur(r.high)}</td><td>{eur(r.typical)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p class="pw-empty">{w.homesEmpty}</p>}

    {tables.homes.some((r) => r.areas.length) && (
      <>
        <h3>{w.villagesH}</h3>
        <div class="pw-areas">
          {tables.homes.filter((r) => r.areas.length).map((r) => (
            <div><p class="t-label">{r.name}</p>
              <ul>{r.areas.map((a) => <li><span>{a.name}</span><span>{eur(a.perSqm)}</span></li>)}</ul></div>
          ))}
        </div>
      </>
    )}

    <h2 id="pw-land">{w.landH}</h2>
    {tables.land.length ? (
      <div class="pw-scroll">
        <table>
          <thead><tr><th scope="col">{w.muni}</th><th scope="col">{w.medPlotSqm}</th><th scope="col">{w.mid}</th><th scope="col">{w.medPlot}</th></tr></thead>
          <tbody>
            {tables.land.map((r) => (
              <tr><th scope="row">{r.name}</th><td>{eur(r.perSqm)}</td><td>{eur(r.low)}–{eur(r.high)}</td><td>{sqm(r.typical, lang)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : <p class="pw-empty">{w.landEmpty}</p>}
    <p class="pw-note">{w.note.replace('{brand}', brand.name)}</p>
  </section>
)}

{kind === 'greece-guide' && (
  <section class="pw" aria-labelledby="pw-types">
    <h2 id="pw-types">{w.typesH}</h2>
    <ul class="pw-guide">
      {typeFrom.map((t) => <li><b>{t.label}</b><span>{t.text}</span><span class="pw-from">{w.from} {eur(t.from)}</span></li>)}
    </ul>
    <h2 id="pw-munis">{w.munisH}</h2>
    <ul class="pw-guide">
      {muniFrom.map((m) => <li><a href={m.href}><b>{m.name}</b></a><span class="pw-from">{w.from} {eur(m.from)}</span></li>)}
    </ul>
    <p class="pw-note">{w.guideNote} <a href={listUrl(lang)}>{w.allLink}</a>.</p>
  </section>
)}

{kind === 'prepublished' && (
  <section class="pw" aria-labelledby="pw-pre">
    <h2 id="pw-pre">{w.preH}</h2>
    {pre.length ? (
      <ul class="pw-pre">
        {pre.map((p) => <li><a href={propertyUrl(lang, refOf(p))}>{p.title}</a> <span>{priceText(p)}</span></li>)}
      </ul>
    ) : (
      <p class="pw-empty">{member ? w.preNoneMember : w.preNoneGuest}</p>
    )}
  </section>
)}

<style>
  .pw { margin: var(--s6, 48px) 0 0; }
  .pw h2 { margin-top: var(--s5, 32px); }
  .pw-scroll { overflow-x: auto; }
  .pw table { display: table; width: 100%; margin: 0; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .pw th, .pw td { text-align: left; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line, #e5e3de); }
  .pw thead th { font-size: var(--fs-s-1); font-weight: 600; color: var(--ink-2, #3c4247); }
  .pw-areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 32px; }
  .pw-areas ul { list-style: none; padding: 0; margin: 6px 0 0; }
  .pw-areas li { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; border-bottom: 1px solid var(--line, #e5e3de); font-variant-numeric: tabular-nums; }
  .pw-guide { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .pw-guide li { display: grid; gap: 4px; border-top: 1px solid var(--ink, #0e1214); padding-top: 10px; }
  .pw-from { font-size: var(--fs-s1); font-variant-numeric: tabular-nums; }
  .pw-note, .pw-empty { color: var(--ink-2, #3c4247); font-size: var(--fs-s0); }
  .pw-pre { list-style: none; padding: 0; }
</style>
