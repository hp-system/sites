---
// The spec's links out as tiles — the SEO blocks standard (D-20261110-SS-3, Sergei 2026-11-10: «нам нужны
// клики … ссылки как картинки»). Used under each SEO section (variant «section») and at the end of a page
// (variant «page»).
//   · a link to a property list (types P02, P04–P10, pairs P15–P18, municipality pages) → a photo tile
//     like the home Collections / by-area: the cover of a listing that page shows (clean since #326), the
//     spec anchor as the caption; a municipality tile also carries «from €»;
//   · «page»: the type tiles in a row of four with dashes, then the five municipalities (the spec anchor
//     where the spec links that area), then the other links as text;
//   · «section»: only the section's own links, small tiles in a row, others as text.
// SEO (rule 15): the caption link is the link's only text = the exact anchor, to the exact target; it is
// stretched over the tile; the photo is decoration; «from €» sits outside the link.
import { redirectFor } from '../lib/redirects';
import { specByPath, LINK_GROUPS } from '../lib/seo-pages';
import { facetBySlug, matches, FACETS, PAIRS, facetUrl, paramsOf } from '../lib/listing';
import { fromPrice } from '../lib/prices';
import { pickCover, buildAreaTiles } from '../lib/area-tiles';
import { clean, cleanSrcSetSmall, altOf, type Photo } from '../lib/photos';
import { t, listUrl, type Lang } from '../lib/i18n';
import { money } from '../lib/format';

type Link = { href: string; text: string };
interface Props {
  lang: Lang; links: Link[]; items: { id: string | number; attributes?: any }[];
  variant?: 'page' | 'section';
  /** the page's own path, never linked to itself */
  self?: string;
  /** #267: the list facets of the page (its topic and/or municipality): the areas row follows the topic, a
   *  municipality page gets its categories */
  facets?: string[];
  /** #267: this section carries the municipality's category collections (one section per page) */
  collections?: boolean;
}
const { lang, links: raw, items, variant = 'section', self = '', facets: pageKeys = [], collections = false } = Astro.props;

const pathOf = (href: string) => { try { return decodeURI(new URL(href, 'https://x').pathname); } catch { return href; } };
// a link whose page moved (301) goes straight to its new address; then never to itself, never twice (#340: the brief's
// «construction projects» link now lands on construction services)
const moved = (h: string) => { const r = redirectFor(pathOf(h)); return r?.status === 301 && r.to ? r.to : h; };
const seen = new Set<string>();
const links = raw.map((l) => ({ ...l, href: moved(l.href) }))
  .filter((l) => pathOf(l.href) !== pathOf(self) && !seen.has(pathOf(l.href)) && !!seen.add(pathOf(l.href)));
const idOf = (href: string) => specByPath(pathOf(href))?.id ?? '';
const base = pathOf(listUrl(lang));
// the facets a list URL shows: its slugs after the list base (/en/properties/kassandra/villas-for-sale)
const facetsOf = (href: string) => {
  const p = pathOf(href);
  if (p !== base && !p.startsWith(base + '/')) return null;
  const segs = p.slice(base.length).split('/').filter(Boolean);
  const fs = segs.map((s) => facetBySlug(lang, s));
  return fs.every(Boolean) ? fs.map((f) => f!) : null;
};
const used = new Set<string>();
const photoFor = (fs: { q: object }[]) => {
  const q = Object.assign({}, ...fs.map((f) => f.q));
  return pickCover(items as any, (a) => matches({ attributes: a } as any, q as any), used as any);
};
// the five municipalities with «from €»; their tile URLs are the area pages
const { tiles: munis, from } = buildAreaTiles(items as any, lang, (f) => pickCover(items as any, f, used as any), 5);
const muniOf = (href: string) => munis.find((m) => pathOf(m.href) === pathOf(href));

type Tile = { href: string; text: string; sub?: string; photo: Photo | null };
const typeTiles: Tile[] = [], areaTiles: Tile[] = [], text: Link[] = [], secTiles: Tile[] = [];
for (const l of links) {
  // #275 (Sergei 2026-11-12): under a SEO section the page's area / category rows are not repeated.
  // Sergei 2026-11-19 («сделай её также как здесь какой-то подходящей картинкой»): a link to a property list
  // is a small photo tile like the home «by area» (a cover of a listing that list shows, clean since #326; the
  // spec anchor as its only text); every other link stays text
  if (variant === 'section') {
    const m = muniOf(l.href);
    if (m) { secTiles.push({ href: l.href, text: l.text, sub: m.fromText, photo: m.photo }); continue; }
    const fs = facetsOf(l.href);
    if (fs || idOf(l.href) === 'P02') { secTiles.push({ href: l.href, text: l.text, photo: photoFor(fs ?? []) }); continue; }
    // every other link a card too (Sergei 2026-11-19 «сделай ссылки как карточки, как везде»): a cover of an open listing
    // (clean since #326, never the same twice on a page), the link's anchor as its only text
    secTiles.push({ href: l.href, text: l.text, photo: photoFor([]) }); continue;
  }
  const m = muniOf(l.href);
  if (m) { areaTiles.push({ href: l.href, text: l.text, sub: m.fromText, photo: m.photo }); continue; }
  const fs = facetsOf(l.href);
  if (fs || idOf(l.href) === 'P02') { typeTiles.push({ href: l.href, text: l.text, photo: photoFor(fs ?? []) }); continue; }
  text.push(l);
}
// where areas show at all, all five municipalities (Sergei 2026-11-10: each link once, next to its text — the
// section about areas carries Polygyros too); the spec's anchor where it links the area, else the name
let pageAreas: Tile[] = variant === 'page' || areaTiles.length > 0
  ? munis.map((m) => areaTiles.find((x) => pathOf(x.href) === pathOf(m.href)) ?? { href: m.href, text: m.name, sub: m.fromText, photo: m.photo })
  : areaTiles;

// ── #267 (Sergei 2026-11-12: «блок по эриям … такими как Property for sale in Halkidiki by area»; «в секциях
//    каждого муниципалитета … коллекции по категориям»). On a list page the tiles follow its topic:
//    · a topic page (seafront, villas, land …): the five areas for THAT topic — the approved pair page where
//      George's sheet has one (Kassandra / Sithonia × villas / seafront), else the topic list filtered to the
//      area (noindex), and «from €» of the topic in that area only (no more «from €25,000» of any plot);
//    · a municipality page: its categories (houses, apartments, villas, seafront, land) with «from €» there.
//    George's links keep their exact anchors: a tile that is his link carries his anchor; his other links
//    (the area pages, the Halkidiki-wide lists) stay as text links under the tiles.
const pageFacets = pageKeys.map((k) => FACETS.find((x) => x.key === k)).filter(Boolean) as typeof FACETS;
const pageMuni = pageFacets.find((x) => x.q.municipality);
const pageTopic = pageFacets.find((x) => !x.q.municipality);
const MUNI_ORDER = ['kassandra', 'sithonia', 'aristotelis', 'propontida', 'polygyros'];   // as the home «by area»
const MUNI_FACETS = MUNI_ORDER.map((k) => FACETS.find((x) => x.key === k)!).filter(Boolean);
const CATS = ['homes', 'apartments', 'villas', 'seafront', 'land'].map((k) => FACETS.find((x) => x.key === k)!).filter(Boolean);
const isPair = (a: string, b: string) => PAIRS.some(([x, y]) => (x === a && y === b) || (x === b && y === a));
const cross = (muni: (typeof FACETS)[number], topic: (typeof FACETS)[number], name: string): Tile & { from: number } | null => {
  const q = { ...muni.q, ...topic.q };
  const keep = (a: any) => matches({ attributes: a } as any, q as any);
  const fromN = fromPrice(items as any, keep);
  if (!fromN) return null;
  const href = isPair(muni.key, topic.key) ? facetUrl(lang, muni.key, topic.key) : facetUrl(lang, topic.key) + paramsOf({ municipality: muni.q.municipality } as any);
  const own = href.includes('?') ? undefined : links.find((l) => pathOf(l.href) === pathOf(href));   // George's link to this very page: his anchor
  return { href, text: own?.text ?? name, sub: t(lang, 'home.from', { price: money(fromN, lang) }), photo: pickCover(items as any, keep, used as any), from: fromN };
};
let rowTiles: Tile[] = [];
let rowAreas = false;
const areaLinked = areaTiles.length > 0 || links.some((l) => facetsOf(l.href)?.some((x) => x.q.municipality));
if (variant === 'section' && pageTopic && !pageMuni && areaLinked && collections) {
  rowTiles = MUNI_FACETS.map((m) => cross(m, pageTopic, m.name[lang])).filter(Boolean) as Tile[];
  rowAreas = rowTiles.length > 0;
} else if (variant === 'section' && pageTopic && !pageMuni && areaLinked) {
  // the areas row is on another section of this page: here George's area links stay as text, once per page in tiles
  const isArea = (h: string) => !!muniOf(h) || !!facetsOf(h)?.some((x) => x.q.municipality);
  for (const x of [...areaTiles, ...typeTiles.filter((y) => isArea(y.href))]) text.push({ href: x.href, text: x.text });
  const keep = typeTiles.filter((y) => !isArea(y.href));
  typeTiles.length = 0; typeTiles.push(...keep);
  pageAreas = [];
}
// a page without a topic (All properties, the guides): the areas as the same one row, the area pages with
// «from €» of the whole area — the right price there; the type tiles stay a row of their own above it
if (variant === 'section' && !pageTopic && !pageMuni && pageAreas.length > 0) {
  rowTiles = pageAreas;
  rowAreas = true;
  pageAreas = [];
}
// a municipality page, other sections: its own pair pages (villas / seafront in this area) are in the
// collections row already — here they stay as text, so no tile repeats
if (variant === 'section' && pageMuni && !collections) {
  const mine = (h: string) => !!facetsOf(h)?.some((x) => x.key === pageMuni.key);
  for (const x of typeTiles.filter((y) => mine(y.href))) text.push({ href: x.href, text: x.text });
  const keep = typeTiles.filter((y) => !mine(y.href));
  typeTiles.length = 0; typeTiles.push(...keep);
}
if (variant === 'section' && pageMuni && collections) {
  rowTiles = CATS.map((c) => cross(pageMuni, c, c.name[lang])).filter(Boolean) as Tile[];
}
if (rowTiles.length && (pageTopic || pageMuni)) {
  // the links the row now carries leave the other groups; George's area pages and Halkidiki-wide lists → text
  // a filtered list (…?muni=) is not George's page: compare whole addresses, query included
  const key = (h: string) => (h.includes('?') ? h : pathOf(h));
  const inRow = new Set(rowTiles.map((x) => key(x.href)));
  const moved = [...areaTiles, ...typeTiles].filter((x) => !inRow.has(key(x.href)));
  for (const x of moved) if (!text.some((l) => pathOf(l.href) === pathOf(x.href))) text.push({ href: x.href, text: x.text });
  typeTiles.length = 0;
  pageAreas = [];
}
// #284: a SEO section shows text links only (#275) — the area / category rows of #268 are the page blocks now
if (variant === 'section') { rowTiles = []; pageAreas = []; typeTiles.length = 0; }
const G = LINK_GROUPS[lang] ?? LINK_GROUPS.en;
const rail = `lt${Math.random().toString(36).slice(2, 8)}`;
const pages = Math.ceil(typeTiles.length / 4);
const tile = (x: Tile, sizes: string) => ({ x, sizes });
---
{variant === 'section' ? (
  (rowTiles.length + secTiles.length + text.length > 0) && (
    <div class="lt lt--sec">
      {secTiles.length > 0 && (
        <ul class="k-tiles lt__sm" style={`--n: ${Math.min(5, Math.max(3, secTiles.length))}`}>
          {secTiles.map((x) => (
            <li class="k-tile">
              {x.photo && <img src={clean(x.photo.url, 400)} srcset={cleanSrcSetSmall(x.photo.url)} sizes="200px" alt={altOf(x.photo, lang, x.text)} width="400" height="267" loading="lazy" decoding="async" />}
              <span class="k-tile__t"><a class="k-tile__l" href={x.href}>{x.text}</a>{x.sub && <span class="k-tile__s">{x.sub}</span>}</span>
            </li>
          ))}
        </ul>
      )}
      {rowTiles.length > 0 && (
        <ul class:list={['k-tiles lt__row', rowAreas ? 'lt__row--areas' : 'lt__row--cats']} style={`--n: ${rowTiles.length}`}>
          {rowTiles.map((x) => (
            <li class="k-tile">
              {x.photo && <img src={clean(x.photo.url, 400)} srcset={cleanSrcSetSmall(x.photo.url)} sizes="(min-width: 1024px) 200px, 45vw" alt={altOf(x.photo, lang, x.text)} width="400" height="267" loading="lazy" decoding="async" />}
              <span class="k-tile__t"><a class="k-tile__l" href={x.href}>{x.text}</a>{x.sub && <span class="k-tile__s">{x.sub}</span>}</span>
            </li>
          ))}
        </ul>
      )}
      {text.length > 0 && <ul class="lt__links">{text.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>}
    </div>
  )
) : (
  <section class="lt lt--page" aria-label={G.join(' · ')}>
    <div class="wrap lt__in">
      {typeTiles.length > 0 && (
        <div class="lt__grp">
          <div class="lt__head">
            <p data-h class="t-h2 lt__h">{G[0]}</p>
            {pages > 1 && (
              <div class="k-dash" role="group" aria-label={t(lang, 'home.pages')} data-lt-dash={rail}>
                {Array.from({ length: pages }).map((_, i) => (
                  <button type="button" class={i === 0 ? 'on' : undefined} aria-pressed={i === 0 ? 'true' : 'false'}
                          aria-label={t(lang, 'home.page', { n: i + 1 })}><span></span></button>
                ))}
              </div>
            )}
          </div>
          <ul class="k-rail" id={rail} data-lt-rail>
            {typeTiles.map((x) => (
              <li class="k-tile">
                {x.photo && <img src={clean(x.photo.url, 800)} srcset={cleanSrcSetSmall(x.photo.url)} sizes="(min-width: 1024px) 300px, 50vw" alt={altOf(x.photo, lang, x.text)} width="800" height="533" loading="lazy" decoding="async" />}
                <span class="k-tile__t"><a class="k-tile__l" href={x.href}>{x.text}</a></span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {pageAreas.length > 0 && (
        <div class="lt__grp">
          <div class="lt__head lt__head--col">
            <h2 data-h class="t-h2 lt__h"><a class="lt__ha" href={listUrl(lang)}>{t(lang, 'home.area_h2')}</a></h2>
            {from > 0 && <p class="lt__sub">{t(lang, 'home.area_sub', { price: money(from, lang) })}</p>}
          </div>
          <ul class="k-tiles lt__areas">
            {pageAreas.map((x) => (
              <li class="k-tile">
                {x.photo && <img src={clean(x.photo.url, 800)} srcset={cleanSrcSetSmall(x.photo.url)} sizes="(min-width: 1024px) 240px, 50vw" alt={altOf(x.photo, lang, x.text)} width="800" height="533" loading="lazy" decoding="async" />}
                <span class="k-tile__t"><a class="k-tile__l" href={x.href}>{x.text}</a>{x.sub && <span class="k-tile__s">{x.sub}</span>}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
      {text.length > 0 && (
        <div class="lt__grp">
          <p class="t-label lt__lbl">{G[2]}</p>
          <ul class="lt__links">{text.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .lt--sec { display: grid; gap: var(--s3); margin-top: var(--s4); container-type: inline-size; }
  .lt__sm { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* by the room the block gets: two a row in a narrow text column, up to four where there is space */
  @container (min-width: 560px) { .lt__sm { grid-template-columns: repeat(var(--n, 4), minmax(0, 260px)); } }   /* never wider than 260px: a wide post keeps them small (2026-11-19) */
  .lt__sm :global(.k-tile__t) { padding: 40px 14px 12px; }
  .lt__sm :global(.k-tile__l) { font-size: var(--fs-s1); line-height: 1.2; }   /* as the home «by area» caption (Sergei 2026-11-19) */
  .lt--page { padding-block: var(--s7); background: var(--paper); }
  .lt__in { display: grid; gap: var(--s7); }
  .lt__grp { display: grid; gap: var(--s4); }
  .lt__head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s4); }
  .lt__head--col { display: grid; gap: var(--s2); }
  .lt__h { margin: 0; }
  .lt__sub { margin: 0; font-size: var(--fs-s0); color: var(--muted); }
  .lt__ha { color: inherit; text-decoration: none; }
  .lt__ha:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .lt__lbl { margin: 0; color: var(--faint); }
  .lt__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 24px; font-size: var(--fs-s0); }
  .lt__links a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  @media (min-width: 1024px) { .lt__areas { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  /* #267: one row like the home «by area» block — equal tiles, name and «from €», as many as the row has */
  .lt__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @container (min-width: 560px) { .lt__row { grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); } }
  .lt__row :global(.k-tile) { aspect-ratio: 3 / 4; }
  .lt__row :global(.k-tile__t) { padding: 40px 12px 12px; }
  .lt__row :global(.k-tile__l) { font-size: var(--fs-s1); line-height: 1.2; }
  .lt__areas > li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 760px) { .lt__areas > li:last-child:nth-child(odd) { grid-column: auto; } }
</style>

<script>
  // The type row (Collections on list pages and guides): four tiles a page, the dashes turn it and follow it.
  // Autoplay as on the home page (Sergei 2026-11-16: «должен автоматически листаться как на главной странице везде»):
  // a page every 5 s while on screen; pointer or focus holds it; a dash, a swipe or a scroll restarts the count;
  // none with reduced motion. Starts again after the listing page swaps its parts in place (hp:swap).
  const initLt = () => document.querySelectorAll<HTMLElement>('[data-lt-rail]:not([data-on])').forEach((rail) => {
    rail.dataset.on = '1';
    const dash = document.querySelector<HTMLElement>(`[data-lt-dash="${rail.id}"]`);
    if (!dash) return;
    const btns = Array.from(dash.querySelectorAll<HTMLButtonElement>('button'));
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rtl = () => getComputedStyle(rail).direction === 'rtl';
    const pos = () => Math.abs(rail.scrollLeft);
    const max = () => Math.max(0, rail.scrollWidth - rail.clientWidth);
    const to = (x: number) => rail.scrollTo({ left: rtl() ? -x : x, behavior: still ? 'auto' : 'smooth' });
    let t0 = Date.now();
    let hold = false;
    const sync = () => {
      const m = max(); const k = m ? Math.round((pos() / m) * (btns.length - 1)) : 0;
      btns.forEach((b, i) => { b.classList.toggle('on', i === k); b.setAttribute('aria-pressed', String(i === k)); });
    };
    rail.addEventListener('scroll', sync, { passive: true });
    btns.forEach((b, i) => b.addEventListener('click', () => { t0 = Date.now(); to(Math.min(max(), i * rail.clientWidth)); }));
    rail.addEventListener('mouseenter', () => { hold = true; });
    rail.addEventListener('mouseleave', () => { hold = false; t0 = Date.now(); });
    rail.addEventListener('focusin', () => { hold = true; });
    rail.addEventListener('focusout', () => { hold = false; t0 = Date.now(); });
    rail.addEventListener('pointerdown', () => { t0 = Date.now(); }, { passive: true });
    rail.addEventListener('touchstart', () => { t0 = Date.now(); }, { passive: true });
    if (!still) {
      const timer = window.setInterval(() => {
        if (!rail.isConnected) { window.clearInterval(timer); return; }   // swapped out (hp:swap)
        if (document.hidden || hold || Date.now() - t0 < 5000) return;
        const r = rail.getBoundingClientRect();
        t0 = Date.now();
        if (r.bottom < 0 || r.top > window.innerHeight || r.width === 0) return;
        const m = max();
        if (!m) return;
        to(pos() >= m - 4 ? 0 : Math.min(m, pos() + rail.clientWidth));
      }, 250);
    }
    sync();
  });
  initLt();
  document.addEventListener('hp:swap', initLt);
</script>
