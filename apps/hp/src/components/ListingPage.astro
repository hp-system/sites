---
// ═══════════════════════════════════════════════════════════════════════════
// Η ΣΕΛΙΔΑ ΛΙΣΤΑΣ. Δύο πρόσωπα, μία σελίδα (απόφαση George, 29/7).
//
//  · Ήρθε από ΑΝΑΖΗΤΗΣΗ (γυμνή λίστα)  → αποτελέσματα αμέσως, φίλτρα ένα κλικ
//  · Ήρθε σε ΘΕΜΑΤΙΚΗ σελίδα (Κασσάνδρα, Βίλες) → editorial κεφαλίδα με τον τόπο
//    ως τίτλο, και μετά το ίδιο πλέγμα.
//
// 📊 Η δομή δεν είναι γούστο — βγήκε από 32 μέρες logs: το 41% δεν αγγίζει
//    κανένα φίλτρο, και όσοι τα αγγίζουν χρησιμοποιούν πέντε από τα δέκα. Μόνιμη
//    πλαϊνή στήλη θα έτρωγε το ένα τέταρτο της οθόνης για μειοψηφία.
//
// ⚠️ ΤΟ ΦΙΛΤΡΑΡΙΣΜΑ ΓΙΝΕΤΑΙ **ΤΟΠΙΚΑ**, ΠΟΤΕ ΜΕ ΠΡΟΩΘΗΣΗ ΣΤΟ API.
//    Το EALIDA API αγνοεί ΣΙΩΠΗΛΑ ό,τι δεν αναγνωρίζει: `?luxury=1` γυρίζει
//    και τα 527 χωρίς σφάλμα, `?pool=1` γυρίζει 0, και ο δήμος σε ονομαστική
//    γυρίζει 3 αντί για 250. Δες τα σχόλια στο lib/listing.ts.
// ═══════════════════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import { subName } from '../lib/property';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import FilterSheet from './FilterSheet.astro';
import Footer from './Footer.astro';
import PropertyCard from './PropertyCard.astro';
import { allProperties, visitorCountry, refOf, priceOf, priceVisible } from '../lib/api';
import { viewerOf, muniKey, municipalityOf } from '../lib/gate';
import { prefix, propertyUrl, t, listUrl, type Lang } from '../lib/i18n';
import { num, seaLabel, money, moneyShort, sqm } from '../lib/format';
import { cmsImage } from '../lib/content';
import { heroShot } from '../lib/hero';
import { clean, marked, coverOf } from '../lib/photos';
import { brand } from '../brand/index';
import SpecText from './SpecText.astro';
import SpecPosts from './SpecPosts.astro';
import Areas from './Areas.astro';
import { postPhotos } from '../lib/post-photos';
import { buildAreaTiles } from '../lib/area-tiles';
import { specByPath, specTitle, FAQ_H } from '../lib/seo-pages';
import {
  runQuery, queryFromParams, paramsOf, indexable as isIndexable,
  facetUrl, ui, FACETS, SORTS, SORT_DEFAULT, PER_PAGE, PER_PAGE_OPTIONS,
  cardsPerPage, SUBTYPES, MUNIS, SEAS, BED_OPTS, defined, matches, minLive,
  type Facet, type Query, type Sort,
} from '../lib/listing';

interface Props { lang: Lang; facets: Facet[] }
const { lang, facets } = Astro.props;

const viewer = await viewerOf(Astro.cookies);
const memberToken = Astro.cookies.get('member_token')?.value;

// ── Το ερώτημα: τα θέματα του URL + οι επιτρεπτές παράμετροι.
// 🛡️ ΡΗΤΗ ALLOW-LIST. Το `queryFromParams` δέχεται ΜΟΝΟ έξι παραμέτρους. Το
//    `area` λείπει σκόπιμα: το EALIDA API φιλτράρει κανονικά σε περιοχή, οπότε
//    ένα «περνάω ό,τι έρθει» θα άφηνε μη συνδεδεμένο να μάθει με `?area=Σάνη`
//    ποια ακίνητα είναι στη Σάνη — παρακάμπτοντας ολόκληρο το lib/gate.ts.
const sp = Astro.url.searchParams;
// `defined()`: a parameter that is NOT in the URL must not wipe the facet's own value
// (the «Kassandra» page listed the whole catalogue before — see lib/listing.ts).
const q: Query = Object.assign({}, ...facets.map((f) => f.q), defined(queryFromParams(sp)));

let items: Awaited<ReturnType<typeof allProperties>> = [];
let apiDown = false;
try {
  // #18: a search by ID opens for everyone, like the property page; any other list follows the country rule.
  items = await allProperties(memberToken, q.id ? undefined : visitorCountry(Astro.request));
} catch {
  apiDown = true;
}

// ── ΠΟΣΑ ΑΝΑ ΣΕΛΙΔΑ, ΚΑΙ ΓΙΑΤΙ ΜΙΑ ΛΙΓΟΤΕΡΗ ΓΙΑ ΤΟΝ ΕΠΙΣΚΕΠΤΗ ─────────────
// 🪤 «Το τελευταίο το έχεις μόνο του» (George, 30/7). Δεν έφταιγε το 24 — είναι
//    πολλαπλάσιο του 3. Έφταιγε ότι το ΚΟΥΤΙ ΕΓΓΡΑΦΗΣ πιάνει κι αυτό ένα κελί
//    του πλέγματος: 24 κάρτες + 1 κουτί = 25 = οκτώ σειρές και ένα ορφανό.
//    Τώρα το κουτί ΠΑΙΡΝΕΙ τη θέση μιας κάρτας αντί να προστίθεται.
const per = q.per ?? PER_PAGE;
const wantsJoin = !viewer.member;
const res = runQuery(items, q, cardsPerPage(per, wantsJoin));

// ── Κεφαλίδα: τα ονόματα των θεμάτων, στη γλώσσα του επισκέπτη.
const names = facets.map((f) => f.name[lang]);
const heading = names.length ? names.join(' · ') : ui(lang, 'all');
const isThemed = facets.length > 0;

// ── SEO ────────────────────────────────────────────────────────────────────
const pathFor = (l: Lang) => facetUrl(l, ...facets.map((f) => f.key));

// ── #160 GEORGE'S SPEC (05/11): this URL's title, meta, H1, texts, FAQ and links, word for word.
const spec = specByPath(pathFor(lang));
const firstPage = res.page === 1;
// Spec rule 10: indexed only with ≥ 6 live listings (≥ 12 for apartments / affordable), counted on
// the anonymous set WITHOUT the country rule — Google must get the same answer from GR and DE.
// The number is used only for this decision; it is never printed (no counts, George 17/10).
let liveAnon = res.total;
try {
  const anon = await allProperties(undefined, undefined);
  const fq: Query = Object.assign({}, ...facets.map((f) => f.q));
  liveAnon = anon.filter((p) => matches(p, fq)).length;
} catch { /* API down: keep the visitor's own count */ }
const thin = liveAnon < minLive(facets.map((f) => f.key));
const noindex = !isIndexable(facets.map((f) => f.key), sp) || thin;
// Decision D8: page N is self-canonical when nothing but `page` is in the URL.
const onlyPage = [...sp.keys()].every((k) => k === 'page');
const selfQuery = !firstPage && onlyPage ? `?page=${res.page}` : '';

// «Page 2», never «2 of 10»: the number of pages would reveal the catalogue size (no counts).
const pageNote = firstPage ? '' : ` – ${t(lang, 'home.page', { n: res.page })}`;
const title = spec
  ? specTitle(spec.title, brand.name) + pageNote
  : (isThemed ? `${heading} — ${ui(lang, 'all')}` : ui(lang, 'all')) + pageNote;
const desc = spec
  ? spec.meta
  : isThemed ? `${heading}. ${ui(lang, 'all')}.` : ui(lang, 'all');
const h1 = spec ? spec.h1 : heading;
// Breadcrumb: the spec's names; links to the home page, the main listing and, on a pair page
// (Kassandra · Villas), the area page.
const crumbLinks = [prefix(lang) || '/', facetUrl(lang), facets.length === 2 ? facetUrl(lang, facets[0].key) : undefined];
const crumbs = spec
  ? spec.breadcrumb.map((name, i, a) => ({ name, url: i === a.length - 1 ? undefined : crumbLinks[i] }))
  : null;

// 🪤 ΤΟ URL ΜΕΣΑ ΣΤΟ JSON-LD ΠΕΡΝΑΕΙ ΑΠΟ `propertyUrl(lang, …)`.
//    Στην αρχική ήταν σκληροκωδικοποιημένο `/ακινητο/<id>` και δήλωνε ΕΛΛΗΝΙΚΟ
//    URL σε ΚΑΙ ΤΙΣ ΕΝΝΕΑ γλώσσες — URL που στην αγγλική εκδοχή δεν υπάρχει καν.
const siteRoot = Astro.site?.toString().replace(/\/$/, '') ?? '';
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: h1,
  itemListElement: res.items.slice(0, 12).map((p, i) => ({
    '@type': 'ListItem', position: i + 1,
    url: `${siteRoot}${propertyUrl(lang, refOf(p))}`,
  })),
};
// #160 spec rule 11 for listing pages: CollectionPage + ItemList + BreadcrumbList + FAQPage
// (the FAQ only where it is shown: page 1). The markup matches what the page shows (Google).
const abs = (u: string) => siteRoot + encodeURI(u);
const jsonLd: unknown[] = spec ? [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: h1, url: abs(spec.path) + selfQuery, inLanguage: lang },
  itemList,
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs!.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, ...(c.url ? { item: abs(c.url) } : {}) })) },
  ...(firstPage && spec.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: spec.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
] : (res.items.length ? [itemList] : []);

// ── Δήμοι για το υποσέλιδο (ίδιο μοτίβο με την αρχική).
const munis = [...new Set(items.map((p) => muniKey(p.attributes ?? {})).filter(Boolean))]
  .slice(0, 4)
  .map((k) => {
    const src = items.find((p) => muniKey(p.attributes ?? {}) === k);
    return { name: municipalityOf(src?.attributes ?? {}, lang) || k, key: k };
  });

// ── Σελιδοποίηση: κρατάει τις παραμέτρους, αλλάζει μόνο τη σελίδα.
const pageUrl = (n: number) => `${pathFor(lang)}${paramsOf({ ...q, page: n })}`;
const sortUrl = (s: Sort) => `${pathFor(lang)}${paramsOf({ ...q, sort: s, page: 1 })}`;
// Αλλαγή «ανά σελίδα» → πάντα πίσω στην πρώτη σελίδα: η σελίδα 7 των 12 δεν
// αντιστοιχεί σε τίποτα όταν γίνουν 48.
const perUrl = (n: number) => `${pathFor(lang)}${paramsOf({ ...q, per: n, page: 1 })}`;
// ΟΙ ΕΞΙ ΤΥΠΟΙ, με τη σειρά του σημερινού site (Recommended πρώτο).
const sortLabel: Record<Sort, string> = {
  rec: ui(lang, 'sortRec'),
  price_desc: ui(lang, 'sortPriceDesc'), price_asc: ui(lang, 'sortPriceAsc'),
  sqm_desc: ui(lang, 'sortSqmDesc'), sqm_asc: ui(lang, 'sortSqmAsc'),
  new: ui(lang, 'sortNew'),
};
const cur: Sort = q.sort ?? SORT_DEFAULT;

// ΠΡΟΤΡΟΠΗ ΕΓΓΡΑΦΗΣ — μετά την τρίτη κάρτα, όχι αναδυόμενο παράθυρο, και ΜΟΝΟ
// σε μη συνδεδεμένους. Στο σημείο αυτό ο επισκέπτης έχει ήδη δει τρία ακίνητα
// και ξέρει τι του λείπει: η ακριβής περιοχή, που είναι και ο κανόνας του gate.
const JOIN_AFTER = 3;
const showJoin = wantsJoin && res.items.length >= JOIN_AFTER + 1;

// Πόσα φίλτρα είναι ενεργά — για το σήμα πάνω στο κουμπί και για το «Καθαρισμός».
// ⚠️ Μετρώνται ΜΟΝΟ όσα ήρθαν από παραμέτρους. Ό,τι κλειδώνει η ΔΙΕΥΘΥΝΣΗ (π.χ.
//    ο δήμος στη σελίδα «Κασσάνδρα») δεν είναι επιλογή του χρήστη εδώ.
const fromUrl = queryFromParams(sp);
const activeCount = [
  fromUrl.priceMin, fromUrl.priceMax, fromUrl.sqmMin, fromUrl.sqmMax,
  fromUrl.beds, fromUrl.subcategory, fromUrl.municipality, fromUrl.sea,
  fromUrl.subs, fromUrl.munis, fromUrl.seas, fromUrl.bedsIn,
].filter(Boolean).length;

// ── ΟΙ ΕΠΙΛΟΓΕΣ ΤΩΝ ΤΡΙΩΝ ΝΕΩΝ ΦΙΛΤΡΩΝ ────────────────────────────────────
// 💡 Τα ονόματα ΔΕΝ γράφονται χειροκίνητα σε 9 γλώσσες — διαβάζονται από τα ΙΔΙΑ
//    ΤΑ ΔΕΔΟΜΕΝΑ (`subcategory_i18n`). Έτσι μένουν συνεπή με τους τίτλους των
//    καρτών, και αν ο τροφοδότης προσθέσει μετάφραση, εμφανίζεται μόνη της.
const labelOf = (sub: string) => {
  const hit = items.find((p) => String(p.attributes?.subcategory ?? '').toLowerCase() === sub);
  return hit ? subName(hit.attributes ?? {}, lang) : sub;   // #88: same names as the cards
};
const typeOpts = SUBTYPES.map((x) => ({ v: x.v, label: labelOf(x.v) }));
const muniOpts = MUNIS.map((x) => ({
  v: x.v,
  label: FACETS.find((f) => f.q.municipality === x.v)?.name[lang] ?? x.v,
}));
const seaOpts = SEAS.map((x) => ({ v: x.v, label: seaLabel(x.v, lang) || x.v }));

// Ποια φίλτρα κλειδώνει ήδη η διεύθυνση — αυτά ΔΕΝ επαναλαμβάνονται στη φόρμα.
const lockedBy = (k: keyof Query) => facets.some((f) => f.q[k] !== undefined);
// Η τρέχουσα διεύθυνση με τις παραμέτρους της, για την επιστροφή μετά τη σύνδεση.
const here = `${pathFor(lang)}${paramsOf(q)}`;
// #193: the spec posts take photos of the listings on this page; the by-area block as on the home page;
// guests get the sign-in call of the list (the same text and event as the join tile), members none.
const specPhotos = spec && firstPage ? postPhotos(res.items as any, (spec.body.match(/<h2>/g) ?? []).length, lang) : [];
const byArea = spec && firstPage ? buildAreaTiles(items as any, lang, undefined, 5) : { tiles: [], from: 0 };
const specCta = viewer.member ? null
  : { text: ui(lang, 'joinCta'), href: `${prefix(lang)}/login?next=${encodeURIComponent(here)}`, ev: 'member:join_from_list' as const, gild: true };

// Άλλα θέματα για γρήγορη μετάβαση — μόνο όσα δεν είναι ήδη ενεργά.

// ═══════════════════════════════════════════════════════════════════════════
// DESKTOP REDESIGN (#102, approved by George 2026-11-02). Everything below is
// shown only at ≥1024px; phones keep George's layout above, untouched.
// The design's interactions are mapped onto the REAL list: every filter is a
// URL parameter, applied by a GET form (works without JavaScript); removing a
// filter or a page change is a real link; canonical / noindex rules unchanged.
// ═══════════════════════════════════════════════════════════════════════════
// Top strip: the end of the home photo (the same chosen landscape, CMS first).
// A landscape, not a property → clean is allowed (see Hero.astro). It is a CSS
// background inside a ≥1024px rule, so phones never download it.
const cmsHero = await cmsImage('hero.main').catch(() => null);
const shot = heroShot();
const heroUrl = cmsHero?.url || shot?.url || '';
const heroBg = heroUrl ? `--lhero:url("${clean(heroUrl)}")` : undefined;

// The parameters of this URL (never the facet ones — those live in the path).
const here2 = (drop: string[] = []) => {
  const sp2 = new URLSearchParams(paramsOf({ ...fromUrl, page: undefined }).slice(1));
  for (const k of drop) sp2.delete(k);
  return sp2;
};
/** Hidden inputs that carry the other filters along with one cell's form. */
const keepFields = (drop: string[]) => [...here2([...drop, 'id', 'page']).entries()];
/** This page without some parameters — the link of a tag. */
const without = (drop: string[]) => {
  const s = here2([...drop, 'page']).toString();
  return `${pathFor(lang)}${s ? `?${s}` : ''}`;
};

// The cells of the row, as the mockup (Sergei 02/11: «exactly like the MOCKUP»):
// Municipality · Type · Bedrooms · Sea are MULTI-SELECT ticks, each tick applied at
// once; Price and Size are a From/To pair with a two-thumb slider, applied on release.
// Every tick is a real link to the list with that value added/removed (works without
// JavaScript; `rel=nofollow` — filtered combinations stay out of the index as before).
// A cell whose value the address already fixes (a facet page, e.g. «Kassandra») is
// not repeated — same rule as George's form.
type Opt = { v: string; label: string };
const catLabel: Record<string, string> = {
  residency: t(lang, 'cat.homes'), land: t(lang, 'cat.land'), business: t(lang, 'cat.commercial'),
};
const typeLabel = (v: string) => typeOpts.find((o) => o.v === v)?.label ?? (v === 'hotel' ? t(lang, 'kinds.hotels') : v);
// URL keys that belong to a cell (long aliases included, so a link never sends both).
const cellKeys: Record<string, string[]> = {
  muni: ['muni', 'municipality'], type: ['type', 'subcategory'], beds: ['beds', 'bedrooms', 'bed'],
  sea: ['sea', 'sea_access'], price: ['price_min', 'price_max'], size: ['sqm_min', 'sqm_max'],
};
// What each multi cell has ticked now (one value or several), and the URL key it writes.
const chosen: Record<string, string[]> = {
  muni: fromUrl.munis ?? (fromUrl.municipality ? [fromUrl.municipality] : []),
  type: fromUrl.subs ?? (fromUrl.subcategory ? [fromUrl.subcategory] : []),
  sea: fromUrl.seas ?? (fromUrl.sea ? [fromUrl.sea] : []),
  beds: (fromUrl.bedsIn ?? []).map(String),
};
const writeKey: Record<string, string> = { muni: 'muni', type: 'type', sea: 'sea', beds: 'bed' };
const bedOpts: Opt[] = BED_OPTS.map((n) => ({ v: String(n), label: n >= 5 ? `${n}+` : String(n) }));
const optsOf: Record<string, Opt[]> = { muni: muniOpts, type: typeOpts, sea: seaOpts, beds: bedOpts };
/** This list with one value of a cell ticked or unticked (page 1; a property ID is dropped). */
const toggled = (key: string, v: string) => {
  const cur = chosen[key];
  const next = cur.includes(v) ? cur.filter((x) => x !== v) : [...cur, v];
  const sp2 = here2([...cellKeys[key], 'page', 'id']);
  for (const o of optsOf[key]) if (next.includes(o.v)) sp2.append(writeKey[key], o.v);
  const s2 = sp2.toString();
  return `${pathFor(lang)}${s2 ? `?${s2}` : ''}`;
};
// The two scales of the mockup (price 0 → 10M+, built area 0 → 1,000 m²+); land is
// another world (300–268,000 m²), so when only land is chosen the plot scale (as the
// «More filters» window).
const steps = (...runs: [number, number, number][]) =>
  runs.flatMap(([from, to, by]) => Array.from({ length: Math.floor((to - from) / by) + 1 }, (_, i) => from + i * by));
const PRICE_STEPS = steps([0, 1000000, 25000], [1100000, 3000000, 100000], [3500000, 10000000, 500000]);
const landOnly = q.category === 'land' || (chosen.type.length > 0 && chosen.type.every((v) => v === 'field' || v === 'plot'));
const SIZE_STEPS = landOnly ? steps([0, 10000, 500], [15000, 100000, 5000]) : steps([0, 300, 10], [325, 1000, 25]);
const near = (st: number[], n: number) => st.reduce((b, x, i) => (Math.abs(x - n) < Math.abs(st[b] - n) ? i : b), 0);
type Range = { lo: string; hi: string; loV?: number; hiV?: number; steps: number[]; labels: string[]; loI: number; hiI: number; ends: [string, string] };
const range = (lo: string, hi: string, loV: number | undefined, hiV: number | undefined, st: number[], fmt: (n: number) => string,
               short: (n: number) => string = fmt): Range => ({
  lo, hi, loV, hiV, steps: st, ends: [short(st[0]), `${short(st[st.length - 1])}+`],
  labels: st.map((n, i) => fmt(n) + (i === st.length - 1 ? '+' : '')),
  loI: loV ? near(st, loV) : 0, hiI: hiV ? near(st, hiV) : st.length - 1,
});
const cells: { key: string; label: string; on: boolean; n?: number; opts?: Opt[]; range?: Range; fmt?: (n: number) => string }[] = [];
if (!lockedBy('municipality')) cells.push({ key: 'muni', label: ui(lang, 'muni'), on: chosen.muni.length > 0, n: chosen.muni.length, opts: muniOpts });
if (!lockedBy('subcategory') && !lockedBy('category')) cells.push({ key: 'type', label: ui(lang, 'type'), on: chosen.type.length > 0, n: chosen.type.length, opts: typeOpts });
cells.push({ key: 'price', label: t(lang, 'list.price'), on: !!(fromUrl.priceMin || fromUrl.priceMax), fmt: (n) => money(n, lang),
  range: range('price_min', 'price_max', fromUrl.priceMin, fromUrl.priceMax, PRICE_STEPS, (n) => money(n, lang), (n) => moneyShort(n, lang)) });
cells.push({ key: 'beds', label: ui(lang, 'beds'), on: chosen.beds.length > 0 || !!fromUrl.beds, n: chosen.beds.length, opts: bedOpts });
if (!lockedBy('sea')) cells.push({ key: 'sea', label: ui(lang, 'seaLabel'), on: chosen.sea.length > 0, n: chosen.sea.length, opts: seaOpts });
cells.push({ key: 'size', label: t(lang, 'list.size'), on: !!(fromUrl.sqmMin || fromUrl.sqmMax), fmt: (n) => sqm(n, lang),
  range: range('sqm_min', 'sqm_max', fromUrl.sqmMin, fromUrl.sqmMax, SIZE_STEPS, (n) => sqm(n, lang)) });

// «More filters» = George's full filter form (#fbar). Its number counts what the
// row does not show: the kind (Homes / Land / Commercial) and «with a pool».
const moreN = (fromUrl.category ? 1 : 0) + (fromUrl.pool ? 1 : 0);

// Tags: one per chosen value; each removes itself; the × clears everything incl. sort.
const span = (lo: number | undefined, hi: number | undefined, f: (n: number) => string) =>
  lo && hi ? `${f(lo)} – ${f(hi)}` : lo ? t(lang, 'list.from', { v: f(lo) }) : t(lang, 'list.upto', { v: f(hi ?? 0) });
const tags: { text: string; href: string }[] = [];
if (fromUrl.id) tags.push({ text: `${ui(lang, 'idPh')} ${fromUrl.id}`, href: without(['id']) });
if (fromUrl.category) tags.push({ text: catLabel[fromUrl.category] ?? fromUrl.category, href: without(['category']) });
// one tag per ticked value (as the mockup); each removes only itself
for (const v of chosen.type) tags.push({ text: typeLabel(v), href: toggled('type', v) });
for (const v of chosen.muni) tags.push({ text: muniOpts.find((o) => o.v === v)?.label ?? v, href: toggled('muni', v) });
if (fromUrl.priceMin || fromUrl.priceMax) tags.push({ text: span(fromUrl.priceMin, fromUrl.priceMax, (n) => money(n, lang)), href: without(cellKeys.price) });
// `beds` (at least N) still comes from George's phone form and the «More filters» window
if (fromUrl.beds) tags.push({ text: t(lang, 'list.beds_tag', { n: fromUrl.beds }), href: without(['beds', 'bedrooms']) });
for (const v of chosen.beds) tags.push({
  text: v === '5' ? t(lang, 'list.beds_tag', { n: 5 }) : v === '1' ? t(lang, 'list.bed1') : t(lang, 'list.bedn', { n: v }),
  href: toggled('beds', v) });
for (const v of chosen.sea) tags.push({ text: seaLabel(v, lang) || v, href: toggled('sea', v) });
if (fromUrl.sqmMin || fromUrl.sqmMax) tags.push({ text: t(lang, 'list.size_tag', { v: span(fromUrl.sqmMin, fromUrl.sqmMax, (n) => sqm(n, lang)) }), href: without(cellKeys.size) });
if (fromUrl.pool) tags.push({ text: t(lang, 'coll.pool'), href: without(['pool']) });
const sorted = !!fromUrl.sort && fromUrl.sort !== SORT_DEFAULT;
if (sorted) tags.push({ text: `${ui(lang, 'sort')}: ${sortLabel[fromUrl.sort!]}`, href: without(['sort']) });

// «Do you want to save this search?» — only for guests with a real filter. YES is
// the existing «save search» door (sign-in, then back with the query); NO hides
// it. Members have no saved-search call on the site yet, so they do not see it.
const filtered = activeCount > 0 || !!fromUrl.category || !!fromUrl.pool;
const showSave = !viewer.member && filtered && !fromUrl.id;
const saveHref = `${prefix(lang)}/login?next=${encodeURIComponent(here)}&save=1`;

// Pager numbers: 1 … n-1 n n+1 … last (as the design).
const pgList = (() => {
  const L = res.pages, c = res.page;
  if (L <= 7) return Array.from({ length: L }, (_, i) => i + 1);
  if (c <= 4) return [1, 2, 3, 4, 5, 0, L];
  if (c >= L - 3) return [1, 0, L - 4, L - 3, L - 2, L - 1, L];
  return [1, 0, c - 1, c, c + 1, 0, L];
})();

// The free-account tile: a blurred, WATERMARKED photo of a card on this page.
const tilePhoto = (() => {
  const p = res.items[Math.min(6, res.items.length - 1)];
  const c = p ? coverOf(p.attributes ?? {}) : null;
  return c ? marked(c.url, 400) : '';
})();
