        <span class="lghost__c"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 4.5h12M4.5 8h7M6.8 11.5h2.4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" /></svg>{t(lang, 'search.filters')}</span>
        <span class="lghost__c"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>{t(lang, 'search.id_ph')}</span>
        <span class="lghost__go"><svg width="18" height="18" viewBox="0 0 18 18"><circle cx="7.8" cy="7.8" r="5.2" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M11.6 11.6 16 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></span>
      </div>
      <div class="lrow">
        <div class="lrow__f">
          {cells.map((c) => (
            <details class:list={['lc', c.on && 'lc--on', c.range && 'lc--rng']} data-lc data-ck={c.key}>
              <summary class="lc__s">
                <span class="lc__t">{c.label}</span>
                {!!c.n && <span class="lc__n">{c.n}</span>}
