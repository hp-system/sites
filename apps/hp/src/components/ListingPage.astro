                  <span class="join__lock" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.4">
                      <rect x="4" y="10.5" width="16" height="10.5" rx="1" />
                      <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
                    </svg>
                  </span>
                  <b class="join__h t-h3">{ui(lang, 'joinH')}</b>
                  <ul class="join__list">
                    <li><svg class="join__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21ZM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" /></svg><span>{ui(lang, 'joinB1')}</span></li>
                    <li><svg class="join__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18v13H3zM8 6l1.5-2h5L16 6M12 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" /></svg><span>{ui(lang, 'joinB2')}</span></li>
                    <li><svg class="join__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4l2-2ZM10 21h4" /></svg><span>{ui(lang, 'joinB3')}</span></li>
                  </ul>
                  </div>
                  <a class="join__b l-gild" href={`${prefix(lang)}/login?next=${encodeURIComponent(here)}`}
                     data-ev="member:join_from_list">
                    {ui(lang, 'joinCta')}
