  {/* Sergei 02/11 (live): on desktop «More filters» opens the same filter window as on the home page */}
  <FilterSheet lang={lang} total={res.total} munis={munis.map((m) => ({ name: m.name, n: 0, key: m.key }))} />

  <main id="main" class="list-main" data-home-path={prefix(lang) || "/"}>
