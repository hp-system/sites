      The class goes away after the move, so in-place filtering never replays it. */}
  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem('hpFromHome');
        localStorage.removeItem('hpFromHome');
        var n = raw ? JSON.parse(raw) : null;
        if (!n || !n.t || Date.now() - n.t > 10000) return;
        if (!matchMedia('(min-width: 1024px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var r = document.documentElement;
        // start from the exact frame the home page showed: hero height on screen, same photo, same focal point
        if (n.h) r.style.setProperty('--lf-h', n.h + 'px');
        if (n.img && /^https?:\/\//.test(n.img)) r.style.setProperty('--lf-img', 'url("' + String(n.img).replace(/"/g, '') + '")');
        if (n.pos) r.style.setProperty('--lf-pos', String(n.pos).replace(/[^0-9.% a-z-]/gi, ''));
        r.classList.add('hp-lfrom');
        setTimeout(function () { r.classList.remove('hp-lfrom'); }, 1300);
      } catch (e) { /* storage off: no move */ }
    })();
  </script>
  {/* #102 desktop: the top as on the home page — the end of the home photo with
      the breadcrumb and the H1 on it. On phones this box is just George's column. */}
  <div class="ltop" style={heroBg} data-lswap="top">
  <div class="wrap ltop__in">
    {/* 🪤 ΕΠΑΝΕΛΑΜΒΑΝΕ ΤΟΝ ΤΙΤΛΟ. Στη γυμνή λίστα έγραφε «Halkidiki Properties ·
        Ακίνητα προς πώληση στη Χαλκιδική» και ΑΜΕΣΩΣ από κάτω ο H1 έλεγε το ίδιο
        ακριβώς — δύο φορές η ίδια φράση, η μία σε αχνό γκρι. Τώρα το τελευταίο
