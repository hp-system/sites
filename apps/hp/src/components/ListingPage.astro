---
// ═══════════════════════════════════════════════════════════════════════════
// Η ΣΕΛΙΔΑ ΛΙΣΤΑΣ. Δύο πρόσωπα, μία σελίδα (απόφαση George, 29/7).
//
//  · Ήρθε από ΑΝΑΖΗΤΗΣΗ (γυμνή λίστα)  → αποτελέσματα αμέσως, φίλτρα ένα κλικ
//  · Ήρθε σε ΘΕΜΑΤΙΚΗ σελίδα (Κασσάνδρα, Βίλες) → editorial κεφαλίδα με τον τόπο
//    ως τίτλο, και μετά το ίδιο πλέγμα.
//
// 📊 Η δομή δεν είναι γούστο — βγήκε από 32 μέρες logs: το 41% δεν αγγίζει
//    κανένα φίλτρο, και όσοι τα αγγίζουν χρησιμοποιούν πέντε από τα δέκα. Μόνιμη
//    πλαϊνή στήλη θα έτρωγε το ένα τέταρτο της οθόνης για μειοψηφία.
//
// ⚠️ ΤΟ ΦΙΛΤΡΑΡΙΣΜΑ ΓΙΝΕΤΑΙ **ΤΟΠΙΚΑ**, ΠΟΤΕ ΜΕ ΠΡΟΩΘΗΣΗ ΣΤΟ API.
//    Το EALIDA API αγνοεί ΣΙΩΠΗΛΑ ό,τι δεν αναγνωρίζει: `?luxury=1` γυρίζει
//    και τα 527 χωρίς σφάλμα, `?pool=1` γυρίζει 0, και ο δήμος σε ονομαστική
//    γυρίζει 3 αντί για 250. Δες τα σχόλια στο lib/listing.ts.
// ═══════════════════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Footer from './Footer.astro';
import PropertyCard from './PropertyCard.astro';
import { allProperties, refOf, priceOf, priceVisible, pick } from '../lib/api';
import { viewerOf, muniKey, municipalityOf } from '../lib/gate';
import { prefix, propertyUrl, type Lang } from '../lib/i18n';
import { num, seaLabel } from '../lib/format';
import {
  runQuery, queryFromParams, paramsOf, indexable as isIndexable,
  facetUrl, ui, FACETS, SORTS, SORT_DEFAULT, PER_PAGE, PER_PAGE_OPTIONS,
  cardsPerPage, SUBTYPES, MUNIS, SEAS,
  type Facet, type Query, type Sort,
} from '../lib/listing';

interface Props { lang: Lang; facets: Facet[] }
const { lang, facets } = Astro.props;

const viewer = await viewerOf(Astro.cookies);
const memberToken = Astro.cookies.get('member_token')?.value;

// ── Το ερώτημα: τα θέματα του URL + οι επιτρεπτές παράμετροι.
// 🛡️ ΡΗΤΗ ALLOW-LIST. Το `queryFromParams` δέχεται ΜΟΝΟ έξι παραμέτρους. Το
//    `area` λείπει σκόπιμα: το EALIDA API φιλτράρει κανονικά σε περιοχή, οπότε
//    ένα «περνάω ό,τι έρθει» θα άφηνε μη συνδεδεμένο να μάθει με `?area=Σάνη`
//    ποια ακίνητα είναι στη Σάνη — παρακάμπτοντας ολόκληρο το lib/gate.ts.
const sp = Astro.url.searchParams;
const q: Query = Object.assign({}, ...facets.map((f) => f.q), queryFromParams(sp));

let items: Awaited<ReturnType<typeof allProperties>> = [];
let apiDown = false;
try {
  items = await allProperties(memberToken);
} catch {
  apiDown = true;
}

// ── ΠΟΣΑ ΑΝΑ ΣΕΛΙΔΑ, ΚΑΙ ΓΙΑΤΙ ΜΙΑ ΛΙΓΟΤΕΡΗ ΓΙΑ ΤΟΝ ΕΠΙΣΚΕΠΤΗ ─────────────
// 🪤 «Το τελευταίο το έχεις μόνο του» (George, 30/7). Δεν έφταιγε το 24 — είναι
//    πολλαπλάσιο του 3. Έφταιγε ότι το ΚΟΥΤΙ ΕΓΓΡΑΦΗΣ πιάνει κι αυτό ένα κελί
//    του πλέγματος: 24 κάρτες + 1 κουτί = 25 = οκτώ σειρές και ένα ορφανό.
//    Τώρα το κουτί ΠΑΙΡΝΕΙ τη θέση μιας κάρτας αντί να προστίθεται.
const per = q.per ?? PER_PAGE;
const wantsJoin = !viewer.member;
const res = runQuery(items, q, cardsPerPage(per, wantsJoin));

// ── Κεφαλίδα: τα ονόματα των θεμάτων, στη γλώσσα του επισκέπτη.
const names = facets.map((f) => f.name[lang]);
const heading = names.length ? names.join(' · ') : ui(lang, 'all');
const isThemed = facets.length > 0;

// ── SEO ────────────────────────────────────────────────────────────────────
const pathFor = (l: Lang) => facetUrl(l, ...facets.map((f) => f.key));
const noindex = !isIndexable(facets.map((f) => f.key), sp);

const title = isThemed
  ? `${heading} — ${ui(lang, 'all')}`
  : ui(lang, 'all');
const desc = isThemed
  ? `${heading}. ${ui(lang, 'all')}.`
  : ui(lang, 'all');

// 🪤 ΤΟ URL ΜΕΣΑ ΣΤΟ JSON-LD ΠΕΡΝΑΕΙ ΑΠΟ `propertyUrl(lang, …)`.
//    Στην αρχική ήταν σκληροκωδικοποιημένο `/ακινητο/<id>` και δήλωνε ΕΛΛΗΝΙΚΟ
//    URL σε ΚΑΙ ΤΙΣ ΕΝΝΕΑ γλώσσες — URL που στην αγγλική εκδοχή δεν υπάρχει καν.
const jsonLd = res.items.length ? [{
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: heading,
  itemListElement: res.items.slice(0, 12).map((p, i) => ({
    '@type': 'ListItem', position: i + 1,
    url: `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${propertyUrl(lang, refOf(p))}`,
  })),
}] : [];

// ── Δήμοι για το υποσέλιδο (ίδιο μοτίβο με την αρχική).
const munis = [...new Set(items.map((p) => muniKey(p.attributes ?? {})).filter(Boolean))]
  .slice(0, 4)
  .map((k) => {
    const src = items.find((p) => muniKey(p.attributes ?? {}) === k);
    return { name: municipalityOf(src?.attributes ?? {}, lang) || k, key: k };
  });

// ── Σελιδοποίηση: κρατάει τις παραμέτρους, αλλάζει μόνο τη σελίδα.
const pageUrl = (n: number) => `${pathFor(lang)}${paramsOf({ ...q, page: n })}`;
const sortUrl = (s: Sort) => `${pathFor(lang)}${paramsOf({ ...q, sort: s, page: 1 })}`;
// Αλλαγή «ανά σελίδα» → πάντα πίσω στην πρώτη σελίδα: η σελίδα 7 των 12 δεν
// αντιστοιχεί σε τίποτα όταν γίνουν 48.
const perUrl = (n: number) => `${pathFor(lang)}${paramsOf({ ...q, per: n, page: 1 })}`;
// ΟΙ ΕΞΙ ΤΥΠΟΙ, με τη σειρά του σημερινού site (Recommended πρώτο).
const sortLabel: Record<Sort, string> = {
  rec: ui(lang, 'sortRec'),
  price_desc: ui(lang, 'sortPriceDesc'), price_asc: ui(lang, 'sortPriceAsc'),
  sqm_desc: ui(lang, 'sortSqmDesc'), sqm_asc: ui(lang, 'sortSqmAsc'),
  new: ui(lang, 'sortNew'),
};
const cur: Sort = q.sort ?? SORT_DEFAULT;

// ΠΡΟΤΡΟΠΗ ΕΓΓΡΑΦΗΣ — μετά την τρίτη κάρτα, όχι αναδυόμενο παράθυρο, και ΜΟΝΟ
// σε μη συνδεδεμένους. Στο σημείο αυτό ο επισκέπτης έχει ήδη δει τρία ακίνητα
// και ξέρει τι του λείπει: η ακριβής περιοχή, που είναι και ο κανόνας του gate.
const JOIN_AFTER = 3;
const showJoin = wantsJoin && res.items.length >= JOIN_AFTER + 1;

// Πόσα φίλτρα είναι ενεργά — για το σήμα πάνω στο κουμπί και για το «Καθαρισμός».
// ⚠️ Μετρώνται ΜΟΝΟ όσα ήρθαν από παραμέτρους. Ό,τι κλειδώνει η ΔΙΕΥΘΥΝΣΗ (π.χ.
//    ο δήμος στη σελίδα «Κασσάνδρα») δεν είναι επιλογή του χρήστη εδώ.
const fromUrl = queryFromParams(sp);
const activeCount = [
  fromUrl.priceMin, fromUrl.priceMax, fromUrl.sqmMin, fromUrl.sqmMax,
  fromUrl.beds, fromUrl.subcategory, fromUrl.municipality, fromUrl.sea,
].filter(Boolean).length;

// ── ΟΙ ΕΠΙΛΟΓΕΣ ΤΩΝ ΤΡΙΩΝ ΝΕΩΝ ΦΙΛΤΡΩΝ ────────────────────────────────────
// 💡 Τα ονόματα ΔΕΝ γράφονται χειροκίνητα σε 9 γλώσσες — διαβάζονται από τα ΙΔΙΑ
//    ΤΑ ΔΕΔΟΜΕΝΑ (`subcategory_i18n`). Έτσι μένουν συνεπή με τους τίτλους των
//    καρτών, και αν ο τροφοδότης προσθέσει μετάφραση, εμφανίζεται μόνη της.
const labelOf = (sub: string) => {
  const hit = items.find((p) => String(p.attributes?.subcategory ?? '').toLowerCase() === sub);
  return pick(hit?.attributes?.subcategory_i18n, lang) || sub;
};
const typeOpts = SUBTYPES.map((x) => ({ v: x.v, label: labelOf(x.v) }));
const muniOpts = MUNIS.map((x) => ({
  v: x.v,
  label: FACETS.find((f) => f.q.municipality === x.v)?.name[lang] ?? x.v,
}));
const seaOpts = SEAS.map((x) => ({ v: x.v, label: seaLabel(x.v, lang) || x.v }));

// Ποια φίλτρα κλειδώνει ήδη η διεύθυνση — αυτά ΔΕΝ επαναλαμβάνονται στη φόρμα.
const lockedBy = (k: keyof Query) => facets.some((f) => f.q[k] !== undefined);
// Η τρέχουσα διεύθυνση με τις παραμέτρους της, για την επιστροφή μετά τη σύνδεση.
const here = `${pathFor(lang)}${paramsOf(q)}`;

// Άλλα θέματα για γρήγορη μετάβαση — μόνο όσα δεν είναι ήδη ενεργά.
---
<Base lang={lang} title={title} description={desc} pathFor={pathFor} noindex={noindex} jsonLd={jsonLd}>
  {/* 🔴 `solid` — ΑΛΛΙΩΣ Η ΚΕΦΑΛΙΔΑ ΕΙΝΑΙ ΛΕΥΚΗ ΠΑΝΩ ΣΕ ΛΕΥΚΟ.
      Δες το σχόλιο στην κορυφή του Header.astro: εδώ δεν υπάρχει φωτογραφία. */}
  <Header lang={lang} solid pathFor={pathFor} />
  <MobileMenu lang={lang} pathFor={pathFor} munis={munis.map((m) => ({ name: m.name, n: 0, key: m.key }))} total={res.total} />

  <main id="main" class="wrap list">
    {/* 🪤 ΕΠΑΝΕΛΑΜΒΑΝΕ ΤΟΝ ΤΙΤΛΟ. Στη γυμνή λίστα έγραφε «Halkidiki Properties ·
        Ακίνητα προς πώληση στη Χαλκιδική» και ΑΜΕΣΩΣ από κάτω ο H1 έλεγε το ίδιο
        ακριβώς — δύο φορές η ίδια φράση, η μία σε αχνό γκρι. Τώρα το τελευταίο
        σκαλί μπαίνει ΜΟΝΟ όταν υπάρχει θέμα, δηλαδή όταν λέει κάτι διαφορετικό. */}
    <nav class="crumb" aria-label="breadcrumb">
      <a href={prefix(lang) || '/'}>Halkidiki Properties</a>
      {isThemed && (
        <>
          <span aria-hidden="true">·</span>
          <a href={facetUrl(lang)}>{ui(lang, 'all')}</a>
          {names.map((n) => (<><span aria-hidden="true">·</span><span>{n}</span></>))}
        </>
      )}
    </nav>

    {/* ΤΟ ΠΛΗΘΟΣ ΤΕΡΜΑ ΔΕΞΙΑ, ΣΤΗ ΓΡΑΜΜΗ ΤΟΥ ΤΙΤΛΟΥ (George, 30/7: «μπορείς να
        το πας τέρμα δεξιά στη σελίδα, π.χ. πάνω από την ταξινόμηση ή ακόμη πιο
        πάνω, σε όποιο σημείο να είναι όμορφο»).
        Μέσα στη μπάρα εργαλείων έμενε 459px μακριά από το δεξί άκρο — δεξιά
        μεριά μεν, «τέρμα δεξιά» όχι: το έσπρωχναν μέσα η ταξινόμηση και το «ανά
        σελίδα». Εδώ δεν το σπρώχνει τίποτα, και διαβάζεται μαζί με τον τίτλο:
        «Ακίνητα προς πώληση στη Χαλκιδική … Βρέθηκαν 527». */}
    <div class="head">
      <h1 class={isThemed ? 't-display head__h' : 't-h2 head__h'}>{heading}</h1>
      {apiDown && <p class="count t-data">—</p>}
    </div>

    {/* ΔΥΟ ΟΜΑΔΕΣ, ΟΧΙ ΠΕΝΤΕ ΣΚΟΡΠΙΑ ΣΤΟΙΧΕΙΑ (George, 30/7):
          ΑΡΙΣΤΕΡΑ  = ΕΝΕΡΓΕΙΕΣ  → φίλτρα · αποθήκευση · κωδικός
          ΔΕΞΙΑ     = ΟΨΗ        → πλήθος · ταξινόμηση · ανά σελίδα
        «Το βρέθηκαν 527 μπορείς να το πας τέρμα δεξιά, π.χ. πάνω από την
         ταξινόμηση» + «το αποθήκευση ζήτησης θα το χωρίσεις αριστερά δίπλα στα
         φίλτρα». Το πλήθος κάθεται ΔΙΠΛΑ στην ταξινόμηση: είναι το αποτέλεσμα
         των φίλτρων, άρα ανήκει στην ίδια πλευρά με το πώς το βλέπεις.
        🪤 Η ΠΑΝΩ ΓΡΑΜΜΗ ΕΦΥΓΕ: ήταν `border-block` (πάνω ΚΑΙ κάτω) και μαζί με
           τη γραμμή του `.head` έκανε δύο παράλληλες γραμμές με 12px ανάμεσα. */}
    <div class="tools">
      <div class="tools__l">
        <button class="btn" id="ftog" aria-expanded="false" aria-controls="fbar">
          {ui(lang, 'filters')}{activeCount > 0 && <b class="badge">{activeCount}</b>}
        </button>
        {/* 🔐 Η ΑΠΟΘΗΚΕΥΣΗ ΑΝΑΖΗΤΗΣΗΣ ΟΔΗΓΕΙ ΣΕ ΕΓΓΡΑΦΗ — και κρατά ΤΟ ΕΡΩΤΗΜΑ μαζί
            της, ώστε μετά τη σύνδεση να συνεχίσει από εκεί που ήταν και όχι από την αρχή. */}
        {!viewer.member && (
          <a class="btn btn--save" href={`${prefix(lang)}/login?next=${encodeURIComponent(here)}&save=1`}
             data-ev="member:save_search">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 3h14v18l-7-5-7 5V3z" />
            </svg>
            {ui(lang, 'saveSearch')}
          </a>
        )}

      </div>

      {/* 🔑 ΑΝΑΖΗΤΗΣΗ ΜΕ ΚΩΔΙΚΟ — ΣΤΟ ΚΕΝΤΡΟ ΤΗΣ ΜΠΑΡΑΣ (George, 30/7: «βάλ'
          το κάπου πιο κεντραρισμένα»). Τρίτη ομάδα ανάμεσα στις δύο, όχι μέλος
          της αριστερής: αριστερά ΕΝΕΡΓΕΙΕΣ · κέντρο ΚΩΔΙΚΟΣ · δεξιά ΟΨΗ.
          Δική της φόρμα GET, όχι πεδίο των φίλτρων: ο κωδικός ΔΕΝ στενεύει
          αναζήτηση, την αντικαθιστά — αλλιώς «5496» μέσα σε φίλτρο «Σιθωνία»
          θα έβγαζε κενό για ακίνητο που υπάρχει. */}
      <form class="idform" method="get" action={pathFor(lang)} role="search">
        <label class="idform__l" for="idq">{ui(lang, 'idLabel')}</label>
        <svg class="idform__i" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
        <input class="idform__in" id="idq" name="id" type="text" inputmode="numeric"
               maxlength="6" autocomplete="off" value={q.id ?? ''} placeholder={ui(lang, 'idPh')} />
        <button class="idform__go" type="submit">{ui(lang, 'idGo')}</button>
      </form>

      <div class="tools__r">
        <details class="sortbox">
          <summary class="btn"><span class="sort__k">{ui(lang, 'sort')}: </span>{sortLabel[cur]}</summary>
          <ul>
            {SORTS.map((s) => (
              <li><a href={sortUrl(s)} aria-current={s === cur ? 'true' : undefined}>{sortLabel[s]}</a></li>
            ))}
          </ul>
        </details>
        {/* Πόσα ανά σελίδα — όλα πολλαπλάσια του 3, όσες κι αν είναι οι στήλες. */}
        <details class="sortbox sortbox--per">
          <summary class="btn"><span class="sort__k">{ui(lang, 'perPage')}: </span>{per}</summary>
          <ul>
            {PER_PAGE_OPTIONS.map((n) => (
              <li><a href={perUrl(n)} aria-current={n === per ? 'true' : undefined}>{n}</a></li>
            ))}
          </ul>
        </details>
      </div>
    </div>

    {/* Τα φίλτρα ανοίγουν με κλικ. Είναι φόρμα GET: δουλεύει και χωρίς JavaScript.
        ΤΑ ΘΕΜΑΤΑ ΤΗΣ ΔΙΕΥΘΥΝΣΗΣ ΔΕΝ ΕΙΝΑΙ ΕΔΩ — αν κάποιος είναι στη σελίδα
        «Κασσάνδρα», ο δήμος είναι ήδη κλειδωμένος από το URL και δεν επαναλαμβάνεται. */}
    <form class="fbar" id="fbar" hidden method="get" action={pathFor(lang)}>
      {!lockedBy('subcategory') && !lockedBy('category') && (
        <label class="f"><span>{ui(lang, 'type')}</span>
          <select name="type">
            <option value="">{ui(lang, 'any')}</option>
            {typeOpts.map((o) => (
              <option value={o.v} selected={fromUrl.subcategory === o.v}>{o.label}</option>
            ))}
          </select>
        </label>
      )}
      {!lockedBy('municipality') && (
        <label class="f"><span>{ui(lang, 'muni')}</span>
          <select name="muni">
            <option value="">{ui(lang, 'any')}</option>
            {muniOpts.map((o) => (
              <option value={o.v} selected={fromUrl.municipality === o.v}>{o.label}</option>
            ))}
          </select>
        </label>
      )}
      {!lockedBy('sea') && (
        <label class="f"><span>{ui(lang, 'seaLabel')}</span>
          <select name="sea">
            <option value="">{ui(lang, 'any')}</option>
            {seaOpts.map((o) => (
              <option value={o.v} selected={fromUrl.sea === o.v}>{o.label}</option>
            ))}
          </select>
        </label>
      )}
      <label class="f"><span>{ui(lang, 'priceFrom')}</span>
        <input type="number" name="price_min" min="0" step="10000" value={q.priceMin ?? ''} inputmode="numeric" /></label>
      <label class="f"><span>{ui(lang, 'priceTo')}</span>
        <input type="number" name="price_max" min="0" step="10000" value={q.priceMax ?? ''} inputmode="numeric" /></label>
      <label class="f"><span>{ui(lang, 'areaFrom')}</span>
        <input type="number" name="sqm_min" min="0" step="10" value={q.sqmMin ?? ''} inputmode="numeric" /></label>
      <label class="f"><span>{ui(lang, 'areaTo')}</span>
        <input type="number" name="sqm_max" min="0" step="10" value={q.sqmMax ?? ''} inputmode="numeric" /></label>
      {/* 🛏️ «Τουλάχιστον», όχι «ακριβώς» — δες το σχόλιο στο lib/listing.ts */}
      <label class="f f--beds"><span>{ui(lang, 'beds')}</span>
        <select name="beds">
          <option value="">{ui(lang, 'any')}</option>
          {[1, 2, 3, 4, 5].map((n) => (
            <option value={n} selected={q.beds === n}>{n}+</option>
          ))}
        </select>
      </label>
      {q.sort && q.sort !== 'new' && <input type="hidden" name="sort" value={q.sort} />}
      <button class="btn btn--go" type="submit">{ui(lang, 'apply')}</button>
      {activeCount > 0 && <a class="btn btn--clear" href={pathFor(lang)}>{ui(lang, 'clear')}</a>}
    </form>

    {res.items.length === 0 ? (
      /* Δύο ΔΙΑΦΟΡΕΤΙΚΑ αδιέξοδα, δύο διαφορετικά μηνύματα. Το «δοκιμάστε να
         αφαιρέσετε ένα φίλτρο» είναι λάθος συμβουλή όταν ψάχνει με κωδικό:
         δεν υπάρχει φίλτρο να αφαιρεθεί, ο κωδικός απλώς δεν αντιστοιχεί σε
         ακίνητο — και ο επισκέπτης πρέπει να το ακούσει καθαρά. */
      <div class="empty">
        <p class="t-h3">{q.id ? ui(lang, 'idNone') : ui(lang, 'none')}</p>
        {!q.id && <p>{ui(lang, 'noneHint')}</p>}
        <a class="btn" href={facetUrl(lang)}>{ui(lang, 'all')}</a>
      </div>
    ) : (
      <>
        <ul class="grid">
          {res.items.map((p, i) => (
            <>
              <li><PropertyCard p={p} lang={lang} viewer={viewer} eager={i < 3} /></li>
              {showJoin && i === JOIN_AFTER - 1 && (
                <li class="join">
                  {/* 🔐 ΟΣΟ ΨΗΛΟ ΟΣΟ ΜΙΑ ΚΑΡΤΑ, ΟΧΙ ΛΩΡΙΔΑ (George, 30/7).
                      Στέκεται μέσα στη ροή των αποτελεσμάτων, στη θέση όπου ο
                      επισκέπτης έχει ήδη δει τρία ακίνητα και ξέρει τι χάνει —
                      όχι αναδυόμενο παράθυρο που τον διακόπτει. */}
                  <span class="join__lock" aria-hidden="true">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.4">
                      <rect x="4" y="10.5" width="16" height="10.5" rx="1" />
                      <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
                    </svg>
                  </span>
                  <b class="join__h t-h3">{ui(lang, 'joinH')}</b>
                  <ul class="join__list">
                    <li>{ui(lang, 'joinB1')}</li>
                    <li>{ui(lang, 'joinB2')}</li>
                    <li>{ui(lang, 'joinB3')}</li>
                  </ul>
                  <a class="join__b" href={`${prefix(lang)}/login?next=${encodeURIComponent(here)}`}
                     data-ev="member:join_from_list">
                    {ui(lang, 'joinCta')}
                  </a>
                </li>
              )}
            </>
          ))}
        </ul>

        {res.pages > 1 && (
          <nav class="pager" aria-label="pagination">
            {res.page > 1 && <a class="btn" href={pageUrl(res.page - 1)} rel="prev">{ui(lang, 'prev')}</a>}
            <span class="t-data">{ui(lang, 'pageOf', { a: res.page, b: res.pages })}</span>
            {res.page < res.pages && <a class="btn" href={pageUrl(res.page + 1)} rel="next">{ui(lang, 'next')}</a>}
          </nav>
        )}
      </>
    )}

    {/* 🚫 ΕΔΩ ΥΠΗΡΧΕ ΣΕΙΡΑ ΘΕΜΑΤΙΚΩΝ ΣΥΝΔΕΣΜΩΝ (Κασσάνδρα, Σιθωνία…) ΜΕΤΑ ΤΗ
        ΣΕΛΙΔΟΠΟΙΗΣΗ — «αν είναι για SEO, τράβα και βάλ' τα στο footer· δεν τα
        θέλω εκεί, φαίνονται πάρα πολύ άσχημα» (George, 30/7). Μετακόμισαν στο
        υποσέλιδο (Footer.astro), που έτσι κι αλλιώς είναι σε ΚΑΘΕ σελίδα — άρα
        το SEO κερδίζει, όχι μόνο δεν χάνει. */}
  </main>

  <Footer lang={lang} munis={munis} />
</Base>

<style>
  .list { padding-block: var(--s5) var(--s7); }
  /* 🪤 ΗΤΑΝ ΣΧΕΔΟΝ ΑΟΡΑΤΟ — «σαν σβησμένα με σβηστήρα» (George, 30/7).
     12px σε `--faint` πάνω σε λευκό δίνει 5,13:1: περνά το πρότυπο, αλλά σε
     ΜΙΚΡΟ μέγεθος και κεφαλαία διαβάζεται σαν ξεθωριασμένο. Το ανέβασα σε
     `--muted` (6,50:1) και 13px, και οι σύνδεσμοι παίρνουν υπογράμμιση στο
     πέρασμα ώστε να φαίνεται ότι είναι σύνδεσμοι. */
  .crumb { font-size: 13px; color: var(--muted); display: flex; gap: 7px; flex-wrap: wrap; }
  .crumb a { color: var(--ink-2); text-decoration: none; }
  .crumb a:hover { text-decoration: underline; }
  /* Τίτλος αριστερά, πλήθος τέρμα δεξιά, στην ίδια οπτική γραμμή.
     `baseline` και όχι `center`: τα δύο κείμενα κάθονται στην ίδια γραμμή
     γραφής, όσο κι αν διαφέρουν σε μέγεθος. Σε στενή οθόνη το πλήθος πέφτει
     από κάτω μόνο του — δεν στριμώχνεται δίπλα στον τίτλο. */
  .head {
    margin: var(--s4) 0 0;
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: var(--s2) var(--s4);
