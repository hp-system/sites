        <nav class="lpg" aria-label={t(lang, 'home.pages')}>
          <span class="lpg__side"></span>
          <div class="lpg__c">
            {res.pages > 1 && (
              <>
                {res.page > 1
                  ? <a class="pgw" href={pageUrl(res.page - 1)} aria-label={ui(lang, 'prev')} data-lx data-top><i class="pgd"></i><svg class="pga pga--l" width="7" height="12" viewBox="0 0 7 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 1L1 6l5 5" /></svg></a>
                  : <span class="pgw" aria-disabled="true"><i class="pgd"></i></span>}
                <span class="lpg__nums">
                  {pgList.map((n) => n === 0
                    ? <span class="pgn pgg" aria-hidden="true">…</span>
                    : n === res.page
                      ? <span class="pgn" aria-current="page">{n}</span>
                      : <a class="pgn" href={pageUrl(n)} aria-label={t(lang, 'home.page', { n })} data-lx data-top>{n}</a>)}
                </span>
                {res.page < res.pages
                  ? <a class="pgw" href={pageUrl(res.page + 1)} aria-label={ui(lang, 'next')} data-lx data-top><i class="pgd"></i><svg class="pga pga--r" width="7" height="12" viewBox="0 0 7 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M1 1l5 5-5 5" /></svg></a>
                  : <span class="pgw" aria-disabled="true"><i class="pgd"></i></span>}
              </>
            )}
          </div>
        </nav>
      </>
    )}

    {/* 🚫 ΕΔΩ ΥΠΗΡΧΕ ΣΕΙΡΑ ΘΕΜΑΤΙΚΩΝ ΣΥΝΔΕΣΜΩΝ (Κασσάνδρα, Σιθωνία…) ΜΕΤΑ ΤΗ
        ΣΕΛΙΔΟΠΟΙΗΣΗ — «αν είναι για SEO, τράβα και βάλ' τα στο footer· δεν τα
        θέλω εκεί, φαίνονται πάρα πολύ άσχημα» (George, 30/7). Μετακόμισαν στο
        υποσέλιδο (Footer.astro), που έτσι κι αλλιώς είναι σε ΚΑΘΕ σελίδα — άρα
        το SEO κερδίζει, όχι μόνο δεν χάνει. */}
  </div>
  {/* #160 spec rule 9: … grid → the H2 body → FAQ → links. Page 1 only; the box is always
      there (empty on page N) so the in-place list swap can update it. */}
  {/* #193 (D-20261110-SS-1): the spec text in the Sell layout — posts with photos of this page's own listings,
      the side menu of the sections, a sign-in call for guests, the FAQ after the text (rule 9), then the spec's
      links out in columns (anchors word for word, rule 15) and the home's by-area block. Same words, same H2s. */}
  <div data-lswap="spec">{spec && firstPage && (
    <>
      <SpecPosts page={spec} lang={lang} photos={specPhotos} faqH={FAQ_H[lang]} member={viewer.member} cta={specCta} />
      <SpecText page={spec} part="rest" lang={lang} body="none" faq="none" links="columns" />
      {byArea.tiles.length > 0 && <Areas lang={lang} items={byArea.tiles} from={byArea.from} headHref={listUrl(lang)} />}
    </>
  )}</div>
  </main>

  {/* #102 desktop: back to top — a square that appears after the first screen. */}
  <button type="button" id="toTop" class="l-totop" aria-label={t(lang, 'home.top')}>
    <svg width="14" height="16" viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.6"
         stroke-linecap="square" aria-hidden="true"><path d="M7 15V2M1.5 7.5L7 2l5.5 5.5"></path></svg>
  </button>

  <Footer lang={lang} munis={munis} />
</Base>

<style>
  .lres { display: none; }

  /* #102: the column is split in two boxes (top strip · results); phones see the
     same paddings as before — top on the first box, bottom on the second. */
  .ltop__in { padding-top: var(--s5); }
  .list { padding-block: 0 var(--s7); }
  /* 🪤 ΗΤΑΝ ΣΧΕΔΟΝ ΑΟΡΑΤΟ — «σαν σβησμένα με σβηστήρα» (George, 30/7).
     12px σε `--faint` πάνω σε λευκό δίνει 5,13:1: περνά το πρότυπο, αλλά σε
     ΜΙΚΡΟ μέγεθος και κεφαλαία διαβάζεται σαν ξεθωριασμένο. Το ανέβασα σε
     `--muted` (6,50:1) και 13px, και οι σύνδεσμοι παίρνουν υπογράμμιση στο
     πέρασμα ώστε να φαίνεται ότι είναι σύνδεσμοι. */
  .crumb { font-size: var(--fs-s-1); color: var(--muted); display: flex; gap: 7px; flex-wrap: wrap; }
  .crumb a { color: var(--ink-2); text-decoration: none; }
  .crumb a:hover { text-decoration: underline; }
  /* Τίτλος αριστερά, πλήθος τέρμα δεξιά, στην ίδια οπτική γραμμή.
     `baseline` και όχι `center`: τα δύο κείμενα κάθονται στην ίδια γραμμή
     γραφής, όσο κι αν διαφέρουν σε μέγεθος. Σε στενή οθόνη το πλήθος πέφτει
     από κάτω μόνο του — δεν στριμώχνεται δίπλα στον τίτλο. */
  .head {
    margin: var(--s4) 0 0;
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: var(--s2) var(--s4);
  }
  .head__h { margin: 0; max-width: 56ch; }

  /* 🚫 Η ΠΑΝΩ ΓΡΑΜΜΗ ΕΦΥΓΕ (George, 30/7: «η πάνω γραμμή θέλω να φύγει τελείως»).
     Ήταν `border-block`, που σημαίνει ΠΑΝΩ ΚΑΙ ΚΑΤΩ — δύο παράλληλες γραμμές με
     λίγα pixel ανάμεσα, χωρίς να χωρίζουν τίποτα. Μένει μόνο η κάτω, που όντως
     χωρίζει τα εργαλεία από τα αποτελέσματα. Έφυγε και το πάνω padding μαζί,
     αλλιώς θα έμενε το κενό της γραμμής που δεν υπάρχει πια. */
  .tools {
    display: flex; align-items: center; gap: var(--s3) var(--s4); flex-wrap: wrap;
    justify-content: space-between;
    margin: var(--s5) 0 0; padding: 0 0 var(--s3);
    border-bottom: 1px solid var(--line-soft);
  }
  /* ΤΡΕΙΣ ΟΜΑΔΕΣ: αριστερά ενέργειες · ΚΕΝΤΡΟ κωδικός · δεξιά όψη.
     🪤 Το σκέτο `space-between` ΔΕΝ κεντράρει το μεσαίο: μοιράζει τα κενά, και
        με αριστερή ομάδα φαρδύτερη από τη δεξιά ο κωδικός έπεφτε 86px αριστερά
        του κέντρου. Με `flex: 1` και στις δύο ακρινές ομάδες, οι δύο πλευρές
        έχουν ΙΔΙΟ πλάτος και το μεσαίο κάθεται στο πραγματικό κέντρο. */
  .tools__l, .tools__r { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; flex: 1; }
  .tools__r { justify-content: flex-end; }
  .count { margin: 0; color: var(--muted); }

  /* ── ΑΝΑΖΗΤΗΣΗ ΜΕ ΚΩΔΙΚΟ ──────────────────────────────────────────────── */
  .idform {
    display: flex; align-items: center; border: 1px solid var(--line);
    height: var(--toolh); box-sizing: border-box;
  }
  /* Η ετικέτα υπάρχει για τους αναγνώστες οθόνης· οπτικά την αντικαθιστά το
     εικονίδιο και το placeholder, όπως στο σημερινό site. */
  .idform__l { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .idform__i { width: 14px; height: 14px; margin-inline-start: 10px; color: var(--faint); flex: none; }
  .idform__in {
    border: 0; background: none; color: var(--ink); font: inherit; font-size: var(--fs-s0);
    padding: 0 8px; width: 104px; min-width: 0;
  }
  .idform__in::placeholder { color: var(--faint); }
  .idform:focus-within { border-color: var(--ink); }
  .idform__go {
    appearance: none; border: 0; background: var(--ink); color: var(--paper);
    font: inherit; font-size: var(--fs-s-1); letter-spacing: .08em; text-transform: uppercase;
    padding: 0 13px; align-self: stretch; cursor: pointer; white-space: nowrap;
  }
  .idform__go:hover { opacity: .86; }
  /* 📏 ΕΝΑ ΚΟΙΝΟ ΥΨΟΣ ΓΙΑ ΟΛΗ ΤΗ ΜΠΑΡΑ (George, 30/7: «το πεδίο κωδικός δεν
     έχει το ίδιο ύψος με τα άλλα κουμπιά — όλο αυτό πρέπει να έχει το ίδιο ύψος»).
     Το πεδίο ήταν καρφωμένο 34px ενώ τα κουμπιά έβγαιναν 36 από το padding τους.
     Ίδιο μάθημα με τα φίλτρα σήμερα το πρωί: ύψος ΔΗΛΩΜΕΝΟ σε μία μεταβλητή,
     όχι προϊόν εσωτερικών περιθωρίων που ο καθένας υπολογίζει αλλιώς.
     ⚠️ 44 ΚΑΙ ΟΧΙ 38: δοκιμάστηκε 38 και τα κουμπιά έμειναν 44 — ο καθολικός
        κανόνας στόχου αφής (`min-height: 44px`) ΝΙΚΑΕΙ το `height`, όπως
        ακριβώς και στα φίλτρα το πρωί. Το 44 είναι και το σωστό για δάχτυλο. */
  .tools { --toolh: 44px; }
  .btn {
    appearance: none; border: 1px solid var(--line); background: none; color: var(--ink);
    font: inherit; font-size: var(--fs-s-1); padding: 0 15px; cursor: pointer; text-decoration: none;
    white-space: nowrap;
    display: inline-flex; align-items: center;
  }
  .tools .btn { height: var(--toolh); box-sizing: border-box; }
  .btn--go { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn--save { display: inline-flex; align-items: center; gap: 6px; }
  .badge {
    display: inline-grid; place-items: center; min-width: 17px; height: 17px;
    margin-inline-start: 7px; padding: 0 4px; background: var(--ink); color: var(--paper);
    font-size: var(--fs-s-1); font-weight: 700; line-height: 1;
  }
  /* 🔴 ΕΙΧΑ ΒΑΛΕΙ ΟΡΙΖΟΝΤΙΑ ΚΥΛΙΣΗ — ΛΑΘΟΣ, ΑΦΑΙΡΕΘΗΚΕ (George, 30/7):
     «δεν μου αρέσει η λογική του scroll δεξιά-αριστερά· φτιάξε 2 σειρές και
     χώρεσέ τα όλα να φαίνονται καθαρά».
     Είχε δίκιο και για δεύτερο λόγο: το «Αποθήκευση» έμενε κρυμμένο έξω από την
     οθόνη, δηλαδή το κουμπί που οδηγεί σε **εγγραφή** δεν το έβλεπε κανείς.
     ΔΥΟ ΡΗΤΕΣ ΣΕΙΡΕΣ: πάνω τα δύο κουμπιά ενεργειών, κάτω πλήθος και ταξινόμηση. */
  /* ΔΥΟ ΣΕΙΡΕΣ ΣΤΟ ΚΙΝΗΤΟ, ΟΧΙ ΟΡΙΖΟΝΤΙΑ ΚΥΛΙΣΗ (George, 30/7: «δεν μου αρέσει
     η λογική του scroll δεξιά-αριστερά· φτιάξε 2 σειρές»). Είχε δίκιο και για
     δεύτερο λόγο: το «Αποθήκευση» έμενε κρυμμένο έξω από την οθόνη — δηλαδή το
     κουμπί που οδηγεί σε ΕΓΓΡΑΦΗ δεν το έβλεπε κανείς.
     Οι δύο ομάδες γίνονται απλώς οι δύο σειρές· δεν χρειάζονται πια ρητές
     περιοχές πλέγματος, η δομή τις δίνει μόνη της. */
  @media (max-width: 700px) {
    .tools { flex-direction: column; align-items: stretch; gap: var(--s3); }
    /* `flex-start` και όχι `space-between`: με δύο στοιχεία ανά σειρά, το
       «σπρώξ' τα στις άκρες» άφηνε μια τρύπα στη μέση και τα δύο κουμπιά
       έμοιαζαν ασύνδετα. Μαζεμένα αριστερά διαβάζονται ως ομάδα — και ο George
       το είχε προτείνει ρητά για την αποθήκευση («αριστερά δίπλα στα φίλτρα»). */
    .tools__l, .tools__r { justify-content: flex-start; gap: var(--s2) var(--s3); flex: none; }
    /* Ο κωδικός παίρνει δική του γραμμή: με τρία στοιχεία σε 375px το πεδίο θα
       συρρικνωνόταν σε δύο ψηφία.
       🪤 ΗΤΑΝ `flex: 1 0 100%` — σωστό όταν η μπάρα ήταν ΣΕΙΡΑ, αλλά τώρα είναι
          ΣΤΗΛΗ: εκεί ο κύριος άξονας είναι ο κάθετος, οπότε το «100%» έγινε
          ύψος-βάση και ΝΙΚΗΣΕ το δηλωμένο ύψος — το πεδίο βγήκε 27,6px.
          Στη στήλη το πλάτος το δίνει ήδη το `stretch`· δεν χρειάζεται flex. */
    .idform { flex: none; }
    .idform__in { width: 100%; }
    .tools .btn { width: fit-content; }
    /* «Ταξινόμηση: Πρόσφατα» → «Πρόσφατα». Το πρόθεμα είναι περιττό σε 375px:
       έφτανε ως τα 358 από τα 375 διαθέσιμα. */
    .sort__k { display: none; }
  }

  /* Η ταξινόμηση δεξιά και διακριτική: στα logs κανείς δεν την άλλαξε ποτέ.
     🪤 ΕΙΧΕ `margin-inline-start: auto` — από την ΠΑΛΙΑ δομή, όταν καθόταν
        απευθείας μέσα στη μπάρα και έπρεπε να σπρωχτεί μόνη της δεξιά. Τώρα τη
        δεξιά στοίχιση την κάνει η ομάδα `.tools__r`, οπότε το παλιό περιθώριο
        απλώς άνοιγε ένα κενό ΜΕΣΑ στην ομάδα — ορατό στο κινητό, όπου έσπρωχνε
        την ταξινόμηση στη μέση του πουθενά. */
  .sortbox { position: relative; }
  .sortbox summary { list-style: none; }
  .sortbox summary::-webkit-details-marker { display: none; }
  .sortbox ul {
    position: absolute; inset-inline-end: 0; z-index: 5; margin: 4px 0 0; padding: 6px 0;
    list-style: none; background: var(--paper); border: 1px solid var(--line); min-width: 200px;
    box-shadow: 0 8px 26px rgba(14,18,20,.14);
  }
  .sortbox li a { display: block; padding: 8px 14px; font-size: var(--fs-s-1); text-decoration: none; color: var(--ink); }
  .sortbox li a[aria-current] { font-weight: 600; }
  .sortbox li a:hover { background: var(--paper-2); }

  .fbar { display: flex; gap: var(--s3); flex-wrap: wrap; align-items: end; padding: var(--s4) 0 0; }
  .fbar[hidden] { display: none; }
  .f { display: grid; gap: 4px; }
  .f span { font-size: var(--fs-s-1); letter-spacing: .09em; text-transform: uppercase; color: var(--faint); }
  /* 📏 ΟΛΑ ΤΑ ΦΙΛΤΡΑ ΣΤΟ ΙΔΙΟ ΥΨΟΣ (George, 30/7: «κάποια είναι πιο μεγάλα,
     κάποια πιο μικρά σε ύψος· φαίνονται άσχημα»).
     🪤 Η ΑΙΤΙΑ ΗΤΑΝ ΟΤΙ ΤΟ ΥΨΟΣ ΔΕΝ ΗΤΑΝ ΔΗΛΩΜΕΝΟ ΠΟΥΘΕΝΑ. Με σκέτο padding,
        το τελικό ύψος το αποφασίζει ο browser χωριστά για κάθε είδος πεδίου:
        το `<select>` βάζει δικό του εσωτερικό περιθώριο για το βελάκι, το
        `<input type=number>` άλλο — και τα κουμπιά «Εφαρμογή/Καθαρισμός» έχουν
        δικό τους padding από την κλάση `.btn`. Τρία διαφορετικά ύψη στην ίδια
        σειρά. Ένα δηλωμένο ύψος τα ισοφαρίζει σε κάθε browser και γλώσσα.
     ⚠️ 44 ΚΑΙ ΟΧΙ 42: δοκιμάστηκε 42 και τα οκτώ πεδία συμμορφώθηκαν, αλλά το
        κουμπί «Εφαρμογή» έμεινε 44 — έχει `min-height: 44px` από τον καθολικό
        κανόνα στόχου αφής, και το `min-height` κερδίζει πάντα το `height`.
        Το σωστό ήταν να ανέβουν τα πεδία, όχι να κατέβει το κουμπί: το 44 είναι
        το ελάχιστο για δάχτυλο, και τα πεδία το χρειάζονται εξίσου.
     ⚠️ `box-sizing: border-box` ώστε το περίγραμμα να μετράει ΜΕΣΑ στα 44. */
  .f input, .f select, .fbar .btn {
    box-sizing: border-box; height: 44px;
  }
  .f input, .f select {
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    font: inherit; font-size: var(--fs-s0); padding: 0 10px; width: 140px;
  }
  /* Τα κουμπιά κάθονται στη γραμμή των πεδίων, όχι των ετικετών. */
  .fbar .btn { display: inline-flex; align-items: center; }
  .f--beds select { width: 110px; }

  .grid { list-style: none; margin: var(--s5) 0 0; padding: 0; display: grid; gap: var(--s5) var(--s4); }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 520px) and (max-width: 759px) { .grid { grid-template-columns: repeat(2, 1fr); } }

  /* Η προτροπή πιάνει ΟΛΟ το πλάτος, μέσα στη ροή των αποτελεσμάτων. */
  /* 🔐 ΤΟ ΚΟΥΤΙ ΕΓΓΡΑΦΗΣ — όσο ψηλό όσο μια κάρτα, όχι λωρίδα (George, 30/7).
     Καταλαμβάνει μία θέση του πλέγματος σε desktop· σε κινητό απλώνεται. */
  .join {
    grid-column: 1 / -1; background: var(--ink); color: var(--paper);
    padding: var(--s5) var(--s4); display: grid; gap: var(--s3);
    align-content: center; justify-items: start; text-align: start;
  }
  @media (min-width: 760px) {
    .join { grid-column: span 1; padding: var(--s5); }
  }
  .join__ph { display: contents; }
  .join__lock {
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 1px solid rgba(255,255,255,.28); color: var(--paper);
  }
  .join__h { margin: 0; color: var(--paper); }
  .join__list {
    margin: 0; padding: 0; list-style: none; display: grid; gap: 7px;
    font-size: var(--fs-s0); color: rgba(255,255,255,.82);
  }
  .join__list li { display: grid; grid-template-columns: auto 1fr; gap: 8px; align-items: start; }
  .join__list li::before { content: '·'; opacity: .6; }
  .join__b {
    margin-top: var(--s2); border: 1px solid var(--paper); background: var(--paper); color: var(--ink);
    font-size: var(--fs-s-1); letter-spacing: .05em; text-transform: uppercase; padding: 13px 26px;
    text-decoration: none; white-space: nowrap;
  }
  .join__b:hover { background: transparent; color: var(--paper); }

  .empty { margin: var(--s6) 0; text-align: center; display: grid; gap: var(--s3); justify-items: center; }
  .pager { display: flex; gap: var(--s3); align-items: center; justify-content: center; margin: var(--s6) 0 0; }


  /* ═══════════════════════════════════════════════════════════════════════
     #102 PROPERTY LIST — DESKTOP REDESIGN (approved by George 2026-11-02).
     Everything new is hidden below 1024px; phones keep George's layout.
     ═══════════════════════════════════════════════════════════════════════ */
  .lbarwrap, .lpg, .l-totop, .join__bg, .join__ic { display: none; }

  @media (min-width: 1024px) {
    /* ── top strip: the end of the home photo, header + breadcrumb + H1 on it ── */
    .lhead { position: absolute; top: 0; left: 0; right: 0; z-index: 20; }
    .lhead :global(.site-header--solid) { background: transparent; border-bottom: 0; color: #fff; }
    .lhead :global(.lsw > summary) { color: rgba(255,255,255,.78); }
    .lhead :global(.lsw > summary:hover) { color: #fff; }
    .ltop {
      position: relative; height: 242px; display: flex; align-items: flex-end; color: #fff;
      background-color: var(--paper-2); background-image: var(--lhero, none);
      background-size: cover; background-position: 50% 100%;
    }
    .ltop::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(180deg, rgba(10,14,16,.42) 0%, rgba(10,14,16,0) 34%,
                                  rgba(10,14,16,0) 46%, rgba(10,14,16,.5) 100%);
    }
    .ltop__in { position: relative; width: 100%; padding-top: 0; padding-bottom: 52px; }
    .ltop .crumb, .ltop .crumb a { color: rgba(255,255,255,.88); }
    .ltop .head { margin-top: 6px; }
    .ltop .head__h {
      font-size: var(--fs-s3); font-weight: 300; line-height: 1.14; letter-spacing: -.016em; color: #fff; max-width: none;
    }
    .ltop .count { color: rgba(255,255,255,.88); }

    /* George's phone tools and pager give way to the row and the new pager */
    .tools, .pager { display: none; }

    /* ── the filter row: half on the photo, the page width ── */
    .lbarwrap {
      display: block; position: relative; z-index: 30;
      max-width: var(--max); margin: -33px auto 0; padding: 0 var(--gut); box-sizing: border-box;
    }
    .lbar { background: var(--paper); border: 1px solid var(--line); box-shadow: 0 14px 44px rgba(0,0,0,.16); }
    .lrow { display: flex; height: 63px; align-items: stretch; }
    .lrow__f { display: flex; flex: 1 1 auto; min-width: 0; }
    .lc { position: relative; flex: 1 1 0; min-width: 0; border-inline-start: 1px solid var(--line); }
    .lrow__f > .lc:first-child { border-inline-start: 0; }
    .lc__s, .lc--more {
      list-style: none; height: 63px; box-sizing: border-box; padding: 0 6px; width: 100%;
      display: flex; align-items: center; justify-content: center; gap: 5px; white-space: nowrap;
      cursor: pointer; color: var(--muted); font: inherit; font-size: var(--fs-s0);
      transition: color .15s ease, background .15s ease;
    }
    .lc__s::-webkit-details-marker { display: none; }
    .lc__t { overflow: hidden; text-overflow: ellipsis; }
    .lc__chev, .lc__ico { flex: none; color: var(--faint); transition: color .15s ease, transform .2s ease; }
    .lc:hover > .lc__s, .lc--more:hover, .lc:hover .lc__chev, .lc--more:hover .lc__ico { color: var(--ink); }
    .lc[open] > .lc__s { background: var(--paper-2); }
    .lc[open] .lc__chev { transform: rotate(180deg); }
    /* a cell with a value: beige, bold, ink */
    .lc--on > .lc__s, .lc--more.lc--on { background: var(--paper-2); color: var(--ink); font-size: var(--fs-s0); font-weight: 600; }
    .lc--on .lc__chev { color: var(--ink); }
    .lc__n { flex: none; font-size: var(--fs-s-1); font-weight: 400; color: var(--muted); }
    .lc--more {
      appearance: none; border: 0; border-inline-start: 1px solid var(--line); background: none;
      font-size: var(--fs-s-1); gap: 8px; min-height: 0;
    }
    .lc--more[aria-expanded='true'] { background: var(--paper-2); }

    /* the menu of a cell, opening downward */
    .lc__m {
      position: absolute; top: 64px; inset-inline-start: -1px; z-index: 40; min-width: calc(100% + 2px); width: max-content;
      box-sizing: border-box; background: var(--paper); border: 1px solid var(--line); padding: 8px 0 0;
      box-shadow: 0 10px 30px rgba(0,0,0,.10);
    }
    .lc__o { padding-bottom: 0; }
    .lc__m--end { inset-inline-start: auto; inset-inline-end: -1px; min-width: 220px; padding: 6px 0; }
    .lopt {
      all: unset; box-sizing: border-box; cursor: pointer; width: 100%;
      display: flex; align-items: center; gap: 12px; padding: 9px 16px; font-size: var(--fs-s0); color: var(--ink);
    }
    .lopt:hover { background: var(--paper-2); }
    .lopt:focus-visible { outline: 2px solid var(--brand); outline-offset: -2px; }
    .lopt__b {
      flex: none; width: 18px; height: 18px; box-sizing: border-box; border: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center; background: var(--paper); color: var(--paper);
    }
    .lopt[aria-current] .lopt__b, .lopt[aria-checked='true'] .lopt__b { background: var(--ink); border-color: var(--ink); }
    .lopt--tick { justify-content: space-between; gap: 24px; }
    .lopt--tick svg { visibility: hidden; }
    .lopt--tick[aria-current] { font-weight: 600; }
    .lopt--tick[aria-current] svg { visibility: visible; }
    /* Price · Size: From/To + a two-thumb slider (the mockup's 340px menu) */
    .lc--rng .lc__m { width: 340px; }
    .lrng { padding: 8px 18px 6px; }
    .lrng__io { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
    .lrng__io label { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .lrng__l {
      font-size: var(--fs-s-1); letter-spacing: .13em; text-transform: uppercase; color: var(--faint); font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .lrng__io input {
      height: 40px; min-height: 40px; border: 1px solid var(--line); padding: 0 10px; font: inherit; font-size: var(--fs-s0);
      color: var(--ink); background: var(--paper); min-width: 0; width: 100%; box-sizing: border-box;
    }
    /* an empty field shows the end of the scale (€0 · €10,000,000+) as its value does */
    .lrng__io input::placeholder { color: var(--ink); opacity: 1; }
    .lrng__io input:focus { border-color: var(--ink); outline: none; }
    .lrng__io input:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
    .lrng__s { position: relative; height: 24px; }
    .lrng__tr, .lrng__fi { position: absolute; top: 11px; height: 2px; }
    .lrng__tr { left: 9px; right: 9px; background: var(--line); }
    .lrng__fi {
      background: var(--ink);
      left: calc(9px + (100% - 18px) * var(--l, 0)); right: calc(9px + (100% - 18px) * var(--r, 0));
    }
    .lrng__r {
      position: absolute; inset: 0; width: 100%; height: 24px; min-height: 0; margin: 0; padding: 0;
      background: none; pointer-events: none; -webkit-appearance: none; appearance: none;
    }
    .lrng__r::-webkit-slider-runnable-track { background: none; }
    .lrng__r::-webkit-slider-thumb {
      -webkit-appearance: none; appearance: none; pointer-events: auto; width: 18px; height: 18px; border-radius: 50%;
      background: var(--paper); border: 2px solid var(--ink); box-sizing: border-box; cursor: pointer;
    }
    .lrng__r::-moz-range-thumb {
      pointer-events: auto; width: 14px; height: 14px; border-radius: 50%; background: var(--paper);
      border: 2px solid var(--ink); cursor: pointer;
    }
    .lrng__r:focus { outline: none; }
    .lrng__r:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--brand); outline-offset: 2px; }
    .lrng__r:focus-visible::-moz-range-thumb { outline: 2px solid var(--brand); outline-offset: 2px; }
    .lrng__mm { display: flex; justify-content: space-between; gap: 12px; margin-top: 6px; font-size: var(--fs-s-1); color: var(--faint); }
    .lc__f { margin-top: 6px; }
    .lc__f { padding: 10px 16px; border-top: 1px solid var(--line-soft); }
    .lc__f a { font-size: var(--fs-s-1); color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
    .lc__f a:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    /* the multi cells: the number of ticked values after the label (not a property count) */
    .lc--on .lc__n { font-size: var(--fs-s-1); font-weight: 400; color: var(--muted); }

    /* in-place filtering: a light busy state (only after ~150 ms, set by the script) */
    .list { transition: opacity .18s ease; }
    .list[aria-busy='true'] { opacity: .45; pointer-events: none; }
    /* tags/save prompt already open before a change do not slide in again */
    .lslide.lslide--still { animation: none; }
    .lc__f a:hover { color: var(--ink); }

    /* ID and Sort */
    .lc--id { flex: none; width: 170px; display: flex; }
    .lc__idl { flex: 1; display: flex; align-items: center; gap: 10px; padding: 0 18px; cursor: text; min-width: 0; }
    .lc__idin {
      border: 0; padding: 0; background: none; outline: none; font: inherit; font-size: var(--fs-s0); color: var(--ink);
      min-width: 0; width: 100%; min-height: 0;
    }
    .lc__idin::placeholder { color: var(--faint); transition: color .15s ease; }
    .lc--id:hover .lc__idin::placeholder, .lc--id:hover .lc__ico { color: var(--ink); }
    .lc--sort { flex: none; }
    .lc--sort > .lc__s { padding: 0 16px; gap: 10px; font-size: var(--fs-s-1); }
    .lc--sort.lc--on > .lc__s { font-size: var(--fs-s0); }

    /* under the row, inside the box: the save question, then the tags — sliding down */
    /* Sergei 03/11: same curve as the home → list move, quicker; the box grows to its real height
       (interpolate-size: height 0 → auto), the content fades in after it starts */
    @keyframes lslide { from { height: 0; opacity: 0; } 35% { opacity: 0; } to { height: auto; opacity: 1; } }
    .lslide { overflow: hidden; interpolate-size: allow-keywords; animation: lslide .55s cubic-bezier(.65,0,.35,1) both; }
    .lsave {
      display: flex; align-items: center; gap: 16px; padding: 10px 16px 10px 22px;
      background: var(--paper-2); border-top: 1px solid var(--line-soft);
    }
    .lsave[hidden] { display: none; }
    .lsave { justify-content: flex-end; }   /* Sergei 03/11: the question sits on the right, next to its buttons */
    .lsave > svg { flex: none; color: var(--ink); }
    .lsave__q { flex: none; font-size: var(--fs-s0); }
    .lsave__no, .lsave__yes {
      box-sizing: border-box; height: 34px; min-height: 34px; padding: 0 18px; display: inline-flex; align-items: center;
      font: inherit; font-size: var(--fs-s-1); letter-spacing: .09em; text-transform: uppercase; font-weight: 600;
      cursor: pointer; text-decoration: none;
    }
    .lsave__no { border: 1px solid var(--line); background: var(--paper); color: var(--ink); transition: background .2s ease, border-color .2s ease; }
    .lsave__no:hover { background: var(--paper-2); border-color: rgba(14,18,20,.35); }
    /* gilded YES on the light ground */
    .lsave__yes {
      background: transparent; color: var(--gold-lo); border: 1px solid var(--gold);
      border-image: conic-gradient(from var(--gilda), var(--gold-hi), var(--gold) 25%, var(--gold-lo) 50%, var(--gold) 75%, var(--gold-hi)) 1;
      transition: color .9s ease-in-out;
    }
    .lsave__yes:hover, .lsave__yes:focus-visible { color: var(--gold); }
    .lsave__yes:focus-visible { outline: 2px solid var(--gold-dk); outline-offset: 3px; }

    .ltags { display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 22px; border-top: 1px solid var(--line-soft); }
    .ltags__l { display: flex; flex-wrap: wrap; gap: 6px; flex: 1; min-width: 0; }
    .ltag {
      display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 10px 0 12px; box-sizing: border-box;
      background: var(--paper-2); border: 1px solid var(--paper-2); font-size: var(--fs-s-1); color: var(--ink);
      white-space: nowrap; text-decoration: none; transition: border-color .15s ease;
    }
    .ltag svg { color: var(--faint); }
    .ltag:hover { border-color: var(--ink); }
    .ltag:hover svg { color: var(--ink); }
    .lclr {
      position: relative; flex: none; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
      color: var(--muted); transition: color .15s ease;
    }
    .lclr:hover { color: var(--ink); }
    .lclr__tip {
      display: none; position: absolute; top: 50%; inset-inline-end: 40px; transform: translateY(-50%);
      background: var(--ink); color: var(--paper); font-size: var(--fs-s-1); line-height: 1; padding: 6px 9px; white-space: nowrap; z-index: 50;
    }
    .lclr:hover .lclr__tip, .lclr:focus-visible .lclr__tip { display: block; }

    /* results column: the design's 32px under the box */
    .list { padding-top: 32px; }
    /* «More filters» opens George's full form, as a panel at the top of the results */
    .fbar { margin: 0 0 32px; padding: var(--s4) 22px; border: 1px solid var(--line); background: var(--paper); }

    /* ── results: four columns, the design's rhythm ── */
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 20px; margin-top: 0; }
    .grid :global(.row1) { align-items: center; gap: 12px; }
    .grid :global(.price) { font-size: var(--fs-s1); line-height: 1.2; }
    .grid :global(.sea) { padding: 4px 8px; letter-spacing: .12em; }
    .grid :global(.title) { margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .grid :global(.facts) { margin-top: 4px; }
    .grid :global(.card:hover .title a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    /* heart: white circle; on card hover a beige outline a touch bigger; filled beige only on the heart */
    .grid :global(.heart) { background: var(--paper); transition: background .2s ease; }
    .grid :global(.heart svg) { width: 16px; height: 16px; transition: transform .25s ease, color .2s ease, fill .25s ease; }
    .grid :global(.card:hover .heart svg), .grid :global(.heart:hover svg) { transform: scale(1.12); color: var(--gold-soft); }
    .grid :global(.heart:hover svg) { fill: var(--gold-soft); }

    /* the free-account tile: second row, first cell (as the design); photo behind */
    /* Sergei 03/11: the photo part is a card photo (3:2), the button sits below it where a card has its price */
    .join {
      grid-row: 2; grid-column: 1; position: relative; background: none;
      padding: 0; gap: 12px; align-content: start; justify-items: stretch;
    }
    .join__ph {
      display: flex; flex-direction: column; justify-content: center; gap: 12px; position: relative; overflow: hidden;
      aspect-ratio: 3 / 2; padding: 16px 18px; background: var(--ink-deep); color: var(--paper);
    }
    .join__bg {
      display: block; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      filter: blur(7px) saturate(.92); transform: scale(1.08);
    }
    .join__ph::before { content: ''; position: absolute; inset: 0; background: rgba(10,14,16,.46); z-index: 1; }
    .join__ph > :not(.join__bg) { position: relative; z-index: 2; }
    .join__lock { display: none; }
    .join__h { font-size: var(--fs-s0); font-weight: 600; line-height: 1.3; }
    .join__list { gap: 6px; font-size: var(--fs-s-1); line-height: 1.35; }
    .join__list li { grid-template-columns: 18px 1fr; gap: 9px; }
    .join__list li::before { content: none; }
    .join__ic { display: block; color: #fff; }
    .join__b {
      margin-top: 0; height: 40px; padding: 0 12px; box-sizing: border-box; display: flex; align-items: center; justify-content: center;
      font-size: var(--fs-s-1); letter-spacing: .09em; font-weight: 600; background: transparent; color: var(--gold-lo);
      border: 1px solid var(--gold);
      border-image: conic-gradient(from var(--gilda), var(--gold-hi), var(--gold) 25%, var(--gold-lo) 50%, var(--gold) 75%, var(--gold-hi)) 1;
      transition: color .9s ease-in-out;
    }
    .join__b:hover, .join__b:focus-visible { background: transparent; color: var(--gold); }
    .join__b:focus-visible { outline: 2px solid var(--gold-dk); outline-offset: 3px; }
    .acct { transition: transform .35s cubic-bezier(.4,0,.2,1), box-shadow .35s ease; }
    .acct:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(10,14,16,.28), 0 4px 10px rgba(10,14,16,.12); }
    /* Sergei 03/11: no lift — the tile behaves like a card (its photo zooms a little), the button keeps its own gilded turn */
    .join.acct, .join.acct:hover { transform: none; box-shadow: none; }
    .join__bg { transition: transform .45s ease; }
    .join:hover .join__bg { transform: scale(1.11); }

    /* ── pager ── */
    .lpg {
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
      margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--line);
    }
    .lpg__side { flex: 1 1 0; display: flex; }
    .lpg__c { display: flex; gap: 4px; align-items: center; }
    .lpg__nums { display: flex; align-items: center; gap: 2px; margin: 0 18px; }
    .pgn {
      position: relative; min-width: 34px; height: 40px; display: flex; align-items: center; justify-content: center;
      font-size: var(--fs-s0); color: var(--faint); font-variant-numeric: tabular-nums; text-decoration: none; transition: color .2s ease;
    }
    .pgn::after {
      content: ''; position: absolute; left: 50%; bottom: 6px; width: 16px; height: 2px; margin-left: -8px;
      background: var(--ink); transform: scaleX(0); transition: transform .25s ease, background .2s ease;
    }
    a.pgn:hover { color: var(--ink); }
    a.pgn:hover::after { transform: scaleX(1); background: rgba(14,18,20,.25); }
    .pgn[aria-current='page'] { color: var(--ink); font-weight: 600; }
    .pgn[aria-current='page']::after { transform: scaleX(1); width: 22px; margin-left: -11px; background: var(--ink); }
    .pgg::after { display: none; }
    .pgw { position: relative; width: 40px; height: 40px; display: inline-block; color: var(--ink); }
    .pgd {
      position: absolute; top: 50%; width: 6px; height: 2px; margin-top: -1px; background: rgba(14,18,20,.25);
      transition: width .35s cubic-bezier(.4,0,.2,1), background .25s ease;
    }
    .lpg__c > .pgw:first-child .pgd { inset-inline-end: 17px; }
    .lpg__c > .pgw:last-child .pgd { inset-inline-start: 17px; }
    .pga { position: absolute; top: 50%; margin-top: -6px; opacity: 0; transition: opacity .2s ease .12s; }
    .pga--l { left: 3px; }
    .pga--r { right: 3px; }
    [dir='rtl'] .pga { transform: scaleX(-1); }
    [dir='rtl'] .pga--l { left: auto; right: 3px; }
    [dir='rtl'] .pga--r { right: auto; left: 3px; }
    a.pgw:hover .pgd, a.pgw:focus-visible .pgd { width: 20px; background: var(--ink); }
    a.pgw:hover .pga, a.pgw:focus-visible .pga { opacity: 1; }
    .pgw[aria-disabled='true'] .pgd { background: rgba(14,18,20,.12); }
    .lpp { justify-content: flex-end; position: relative; }
    .ppb { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-s-1); color: var(--muted); }
    .ppb::-webkit-details-marker { display: none; }
    .ppb b { font-weight: 600; color: var(--ink); }
    .ppb svg { color: var(--ink); transition: transform .2s ease; }
    .lpp[open] .ppb svg { transform: rotate(180deg); }
    .ppb:hover { color: var(--ink); }
    .lpp__m {
      position: absolute; inset-inline-end: 0; top: 30px; z-index: 20; min-width: 120px; background: var(--paper);
      border: 1px solid var(--line); box-shadow: 0 10px 30px rgba(0,0,0,.10); padding: 6px 0;
    }
    .ppo {
      box-sizing: border-box; width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 20px;
      padding: 8px 14px; font-size: var(--fs-s0); color: var(--ink); text-decoration: none;
    }
    .ppo svg { visibility: hidden; }
    .ppo[aria-current] { font-weight: 600; }
    .ppo[aria-current] svg { visibility: visible; }
    .ppo:hover { background: var(--paper-2); }


    /* ── head row between the filters and the cards (desktop only; phones keep George's tools) ── */
    .lres { display: flex; justify-content: flex-end; align-items: center; gap: 24px; margin: 0 0 18px; }
    .lres__r { display: flex; align-items: center; gap: 28px; }
    .lres__m { min-width: 220px; }

    /* ── Map view: the home search button's square (Sergei 02/11) — black, the pin in gold ── */
    .lc--map {
      flex: none; width: 64px; padding: 0; display: flex; align-items: center; justify-content: center;
      background: var(--ink); color: var(--gold-dk-text); text-decoration: none; box-sizing: border-box;
      /* E8 brass outline (Sergei 02/11): the gilded edge on the dark ground, turns once on hover */
      border: 1px solid var(--gold-dk);
      border-image: conic-gradient(from var(--gilda), var(--gold-dk-hi), var(--gold-dk) 25%, var(--gold-dk-lo) 50%, var(--gold-dk) 75%, var(--gold-dk-hi)) 1;
      transition: background-color .18s ease, color .18s ease;
    }
    .lc--map svg { width: 20px; height: 20px; }
    /* Sergei 08/11: hover swaps black to white (ink pin), no grey */
    .lc--map:hover, .lc--map:focus-visible { background: var(--paper); color: var(--ink); }
    .lc--map:focus-visible { outline: 2px solid var(--gold-dk); outline-offset: 3px; }

    /* ── every menu slides down when it opens and back up when it closes (Sergei 02/11) ── */
    details[data-lc][open] > .lc__m, details[data-lc][open] > .lpp__m { animation: lm-in .2s cubic-bezier(.2,.8,.2,1) both; transform-origin: top; }
    details[data-lc].lm-out > .lc__m, details[data-lc].lm-out > .lpp__m { animation: lm-out .16s ease both; }
    @keyframes lm-in  { from { opacity: 0; transform: translateY(-8px); clip-path: inset(0 0 100% 0); } to { opacity: 1; transform: none; clip-path: inset(0 0 0 0); } }
    @keyframes lm-out { from { opacity: 1; transform: none; clip-path: inset(0 0 0 0); } to { opacity: 0; transform: translateY(-8px); clip-path: inset(0 0 100% 0); } }
    @media (prefers-reduced-motion: reduce) { details[data-lc] > .lc__m, details[data-lc] > .lpp__m { animation: none !important; } }


    /* ── home → list move: no pause — the home photo (same file, height and focal point as the frame
          the home page showed) starts shrinking at once into the 242 px strip; the list's filter bar
          comes in DURING the move, so the change of bar is hidden in the motion; title and cards last ── */
    :global(html.hp-lfrom) .ltop { background-image: var(--lf-img, var(--lhero, none)); animation: l-hero 0.95s cubic-bezier(.55,0,.25,1) both; }
    :global(html.hp-lfrom) .lrow, :global(html.hp-lfrom) .lbar > :not(.lghost) { animation: l-bar 0.95s ease both; }
    .lbar { position: relative; }
    .lghost { display: none; }
    :global(html.hp-lfrom) .lghost {
      display: grid; position: absolute; z-index: 2; top: 0; left: 0; right: 0; height: 63px; background: var(--paper);
      grid-template-columns: minmax(0,1fr) minmax(0,1fr) auto 170px 64px; align-items: stretch; pointer-events: none;
      animation: l-ghost 0.95s ease both;
    }
    .lghost__f { display: grid; grid-template-columns: 1fr auto; align-content: center; column-gap: 8px; padding: 0 22px; color: var(--ink); font-size: var(--fs-s0); }
    .lghost__f small { grid-column: 1 / -1; font-size: var(--fs-s-1); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
    .lghost__f svg { color: var(--faint); align-self: center; }
    .lghost__f + .lghost__f { border-inline-start: 1px solid var(--line); }
    .lghost__c { display: flex; align-items: center; gap: 8px; padding: 0 18px; border-inline-start: 1px solid var(--line); font-size: var(--fs-s-1); color: var(--muted); white-space: nowrap; }
    .lghost__go { display: flex; align-items: center; justify-content: center; background: var(--ink); color: var(--paper); }
    @keyframes l-ghost { 0%, 15% { opacity: 1; } 55%, 100% { opacity: 0; } }
    :global(html.hp-lfrom) .ltop__in { animation: l-in 1.15s ease both; }
    :global(html.hp-lfrom) .list { animation: l-in 1.2s ease both; }
    @keyframes l-hero { from { height: var(--lf-h, max(420px, calc(100vh - 344px))); background-position: var(--lf-pos, 50% 50%); } to { height: 242px; background-position: 50% 100%; } }
    @keyframes l-bar { 0%, 15% { opacity: 0; } 55%, 100% { opacity: 1; } }
    @keyframes l-in { 0%, 65% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: none; } }

    /* ── back to top ── */
    .l-totop {
      all: unset; box-sizing: border-box; position: fixed; right: 24px; bottom: 24px; z-index: 70;
      width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;
      background: var(--paper); border: 1px solid rgba(14,18,20,.16); color: var(--ink); cursor: pointer;
      box-shadow: 0 8px 24px rgba(0,0,0,.10); opacity: 0; transform: translateY(12px); pointer-events: none;
      transition: opacity .3s ease, transform .3s ease, background .2s ease, border-color .2s ease;
    }
    .l-totop.on { opacity: 1; transform: none; pointer-events: auto; }
    .l-totop:hover { background: var(--paper-2); border-color: var(--ink); }
    .l-totop svg { transition: transform .25s ease; }
    .l-totop:hover svg { transform: translateY(-3px); }
    .l-totop:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    [dir='rtl'] .l-totop { right: auto; left: 24px; }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .lslide { animation: none; }
    .acct, .l-totop, .l-totop svg { transition: none; }
    .acct:hover { transform: none; }
  }

  /* #160 spec intro between the H1 and the grid. Phones: four lines and a «+» switch (no JS),
     so the grid stays above the fold (spec rule 9); desktop: the whole intro. */
  .lintro { position: relative; margin: var(--s4) 0 var(--s5); max-width: 68ch; }
  .lintro__t { position: absolute; opacity: 0; pointer-events: none; }
  .lintro__more { display: none; }
  @media (max-width: 759px) {
    .lintro :global(.st-intro) { max-height: 6.8em; overflow: hidden; font-size: var(--fs-s0);
      -webkit-mask-image: linear-gradient(#000 60%, transparent); mask-image: linear-gradient(#000 60%, transparent); }
    .lintro__t:checked ~ :global(.st-intro) { max-height: none; -webkit-mask-image: none; mask-image: none; }
    .lintro__more { display: inline-block; margin-top: var(--s2); padding: 6px 12px; border: 1px solid var(--line); cursor: pointer; }
    .lintro__t:checked ~ .lintro__more { display: none; }
  }
</style>

<style is:global>
  /* #102: the gilded edge turns once on entering its box (same as the home page). */
  @property --gilda { syntax: '<angle>'; inherits: false; initial-value: 315deg; }
  @keyframes l-gturn { from { --gilda: 315deg; } to { --gilda: 675deg; } }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .l-gild.grun { animation: l-gturn 1.1s ease-in-out 1; }
  }
</style>

<script>
  // ⚠️ One catch-all route: this script is bundled into EVERY page. Everything below
  //    acts only where the list is (`[data-lswap="list"]`), and every listener is
  //    delegated on `document`, so it keeps working after the list is swapped in place.
  const desk = window.matchMedia('(min-width: 1024px)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const onList = () => !!document.querySelector('[data-lswap="list"]');

  // ── Τα φίλτρα ανοίγουν/κλείνουν. Η φόρμα δουλεύει και χωρίς αυτό — απλά μένει ανοιχτή.
  // #102: the desktop «More filters» cell ([data-ftog]) opens the filter window (as on
  // the home page); phones keep George's form under the tools.
  const setFbar = (open: boolean) => {
    const b = document.getElementById('fbar');
    if (!b) return;
    b.hidden = !open;
    document.querySelectorAll('#ftog, [data-ftog]').forEach((x) => x.setAttribute('aria-expanded', String(open)));
  };
  // Αν ο επισκέπτης έχει ήδη ενεργό φίλτρο, ανοίγουν από μόνα τους (κινητό).
  {
    const b = document.getElementById('fbar');
    let any = false;
    b?.querySelectorAll<HTMLInputElement>('input[type=number]').forEach((i) => { if (i.value) any = true; });
    if (any && !desk.matches) setFbar(true);
  }
  document.addEventListener('click', (e) => {
    const x = (e.target as Element | null)?.closest?.('#ftog, [data-ftog]') as HTMLElement | null;
    if (!x || !onList()) return;
    const sheet = document.getElementById('filter-sheet') as HTMLDialogElement | null;
    if (desk.matches && sheet && x.hasAttribute('data-ftog')) {
      // pre-filled with the filters already in the URL (several values: each one ticked)
      e.preventDefault();
      const f = sheet.querySelector('form');
      const q = new URLSearchParams(location.search);
      const alias: Record<string, string> = { municipality: 'muni', bedrooms: 'beds', sea_access: 'sea', subcategory: 'type' };
      f?.querySelectorAll<HTMLInputElement>('input[name]').forEach((i) => {
        const all = [...q.getAll(i.name), ...(alias[i.name] ? q.getAll(alias[i.name]) : [])];
        const v = all.length ? all[0] : null;
        if (i.type === 'radio' || i.type === 'checkbox') { if (v !== null) i.checked = all.includes(i.value); }
        else if (v !== null) i.value = v;
      });
      f?.dispatchEvent(new Event('change', { bubbles: true }));
      sheet.showModal();
      document.documentElement.style.overflow = 'hidden';
      return;
    }
    setFbar(!!document.getElementById('fbar')?.hidden);
  });

  // ── #102 desktop: one menu open at a time; a click outside or Esc closes it.
  const menus = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-lc]'));
  // close with the slide-up (Sergei 02/11); instant when motion is reduced
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  const shut = (d: HTMLDetailsElement) => {
    if (!d.open || d.classList.contains('lm-out')) return;
    if (calm.matches) { d.open = false; return; }
    d.classList.add('lm-out');
    setTimeout(() => { d.open = false; d.classList.remove('lm-out'); }, 150);
  };
  document.addEventListener('click', (e) => {
    const s = (e.target as Element | null)?.closest?.('details[data-lc] > summary');
    const d = s?.parentElement as HTMLDetailsElement | undefined;
    if (d && d.open) { e.preventDefault(); shut(d); }
  }, true);
  document.addEventListener('toggle', (e) => {
    const d = e.target as HTMLElement;
    if (!(d instanceof HTMLDetailsElement) || !d.matches('[data-lc]') || !d.open) return;
    menus().forEach((o) => { if (o !== d) shut(o); });
  }, true);
  document.addEventListener('click', (e) => {
    const el = e.target as Node;
    menus().forEach((d) => { if (d.open && !d.contains(el)) shut(d); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus().forEach((d) => { if (d.open) { shut(d); d.querySelector('summary')?.focus(); } });
  });

  // ── «No» hides the save question for this search (this tab only).
  const saveKey = () => `hp-nosave:${location.pathname}${location.search}`;
  const initSave = () => {
    const save = document.querySelector<HTMLElement>('[data-lsave]');
    try { if (save && sessionStorage.getItem(saveKey())) save.hidden = true; } catch { /* storage off */ }
  };
  document.addEventListener('click', (e) => {
    if (!(e.target as Element | null)?.closest?.('[data-lsave-no]')) return;
    const save = document.querySelector<HTMLElement>('[data-lsave]');
    if (save) save.hidden = true;
    try { sessionStorage.setItem(saveKey(), '1'); } catch { /* storage off */ }
  });

  // ── Gilded buttons: the gradient turns once on entering their box (bound once per element).
  const bindGild = () => document.querySelectorAll<HTMLElement>('.l-gild:not([data-gb])').forEach((g) => {
    g.dataset.gb = '1';
    const run = () => {
      if (!desk.matches || still.matches) return;
      g.classList.remove('grun'); void g.offsetWidth; g.classList.add('grun');
    };
    // the tile's button turns on its own hover (Sergei 03/11); the map button too — on the bar's hover it kept turning (Sergei 08/11)
    (g.closest('.join') || g.classList.contains('lc--map') ? g : (g.closest('.lsave') ?? g.parentElement))?.addEventListener('mouseenter', run);
  });

  // ── Back to top: after one screen.
  const top = document.getElementById('toTop');
  const onScroll = () => top?.classList.toggle('on', window.scrollY > window.innerHeight * 0.8);
  if (top) {
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    top.addEventListener('click', () => window.scrollTo({ top: 0, behavior: still.matches ? 'auto' : 'smooth' }));
  }

  // ════════════════════════════════════════════════════════════════════════
  // IN-PLACE FILTERING (Sergei 02/11: «it must simply apply the filter and re-sort
  // the list instantly» — no new page). Progressive enhancement over real links and
  // GET forms: the same URL is fetched in the background, the top (H1), the filter
  // row with its tags and save question, and the results with the pager are swapped
  // in place, the address follows with pushState, Back/Forward work (popstate).
  // The cards stay server-rendered (watermarked photos, the visibility rules).
  // Desktop only — phones keep George's list behaviour (real page loads).
  // ════════════════════════════════════════════════════════════════════════
  let ctrl: AbortController | null = null;
  let pending = '';

  /** Where focus was inside a cell, so it can come back after the swap. */
  const focusMark = () => {
    const a = document.activeElement as HTMLElement | null;
    const cell = a?.closest?.('details[data-ck]') as HTMLElement | null;
    if (!a || !cell) return null;
    const all = Array.from(cell.querySelectorAll<HTMLElement>('summary, a, input:not([type=hidden])'));
    return { ck: cell.dataset.ck!, i: all.indexOf(a) };
  };

  const swapHead = (doc: Document) => {
    document.title = doc.title;
    for (const sel of ['link[rel="canonical"]', 'meta[name="robots"]', 'meta[name="description"]',
                       'meta[property="og:url"]', 'meta[property="og:title"]', 'meta[property="og:description"]']) {
      const a = document.head.querySelector(sel), b = doc.head.querySelector(sel);
      if (a && b) a.replaceWith(document.importNode(b, true));
      else if (a) a.remove();
      else if (b) document.head.append(document.importNode(b, true));
    }
    document.head.querySelectorAll('link[rel="alternate"][hreflang]').forEach((x) => x.remove());
    doc.head.querySelectorAll('link[rel="alternate"][hreflang]').forEach((x) => document.head.append(document.importNode(x, true)));
  };

  async function go(url: string, o: { keep?: string | null; top?: boolean; push?: boolean } = {}) {
    const u = new URL(url, location.href);
    const list = document.querySelector<HTMLElement>('[data-lswap="list"]');
    if (!list || u.origin !== location.origin) { location.assign(u.href); return; }
    if (pending === u.href) return;
    ctrl?.abort();
    ctrl = new AbortController();
    pending = u.href;
    const mark = focusMark();
    // a light busy state — only if the answer takes longer than ~150 ms (no flash)
    const busy = window.setTimeout(() => list.setAttribute('aria-busy', 'true'), 150);
    let html = '';
    try {
      const r = await fetch(u.href, { headers: { 'x-partial': '1' }, signal: ctrl.signal, credentials: 'same-origin' });
      if (!r.ok) throw new Error(String(r.status));
      html = await r.text();
    } catch (err) {
      if ((err as Error)?.name === 'AbortError') return;
      location.assign(u.href);          // anything odd → the real page
      return;
    } finally {
      window.clearTimeout(busy);
      if (pending === u.href) pending = '';
    }
    const doc = new DOMParser().parseFromString(html, 'text/html');
    if (!doc.querySelector('[data-lswap="list"]')) { location.assign(u.href); return; }

    const hadTags = !!document.querySelector('.ltags');
    const hadSave = !!document.querySelector('[data-lsave]:not([hidden])');
    for (const k of ['top', 'bar', 'list', 'spec']) {
      const a = document.querySelector(`[data-lswap="${k}"]`), b = doc.querySelector(`[data-lswap="${k}"]`);
      if (a && b) a.replaceWith(document.importNode(b, true));
    }
    document.dispatchEvent(new Event('hp:swap'));   // the spec posts, side menu and FAQ start on the new parts (#193)
    // the language links follow the page (a «More filters» search can change the path)
    const olds = document.querySelectorAll('details.lsw'), news = doc.querySelectorAll('details.lsw');
    olds.forEach((x, i) => { if (news[i]) x.replaceWith(document.importNode(news[i], true)); });
    swapHead(doc);
    if (hadTags) document.querySelector('.ltags')?.classList.add('lslide--still');
    if (hadSave) document.querySelector('[data-lsave]')?.classList.add('lslide--still');
    if (o.push !== false) history.pushState({ lx: 1 }, '', u.href);

    // the cell that was being used stays open (ticks, sliders), focus back in place
    const ck = o.keep ?? null;
    if (ck) {
      const d = document.querySelector<HTMLDetailsElement>(`details[data-ck="${ck}"]`);
      if (d) {
        d.open = true;
        if (mark && mark.ck === ck && mark.i >= 0) {
          Array.from(d.querySelectorAll<HTMLElement>('summary, a, input:not([type=hidden])'))[mark.i]?.focus({ preventScroll: true });
        }
      }
    }
    afterSwap();
    // pager / per page are under the results: back up to the bar
    if (o.top) {
      const bar = document.querySelector('[data-lbar]');
      if (bar) {
        const y = bar.getBoundingClientRect().top + window.scrollY - 16;
        if (window.scrollY > y) window.scrollTo({ top: y, behavior: still.matches ? 'auto' : 'smooth' });
      }
    }
  }

  const afterSwap = () => {
    initSave();
    bindGild();
    onScroll();
    // cards bind their photo rails once; tell them new cards arrived (PropertyCard.astro)
    document.dispatchEvent(new CustomEvent('hp:list-swap'));
  };

  const inPlace = (e: MouseEvent | SubmitEvent | Event) => desk.matches && onList() && !e.defaultPrevented;

  // links: ticks, tags, clear, sort, per page, pager
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[data-lx]') as HTMLAnchorElement | null;
    if (!a || !inPlace(e) || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    // optimistic tick: the box fills at once, the list follows
    if (a.getAttribute('role') === 'menuitemcheckbox') a.setAttribute('aria-checked', a.getAttribute('aria-checked') === 'true' ? 'false' : 'true');
    const keep = a.hasAttribute('data-keep') ? (a.closest('details[data-ck]') as HTMLElement | null)?.dataset.ck : null;
    if (!keep) menus().forEach((d) => { d.open = false; });
    go(a.href, { keep, top: a.hasAttribute('data-top') });
  });

  // Price · Size: the From/To fields and the slider
  const rangeUrl = (f: HTMLFormElement) => {
    const sp = new URLSearchParams();
    f.querySelectorAll<HTMLInputElement>('input[type=hidden]').forEach((i) => sp.append(i.name, i.value));
    const digits = (v: string) => v.replace(/\D+/g, '');
    const lo = f.querySelector<HTMLInputElement>('[data-lo]')!, hi = f.querySelector<HTMLInputElement>('[data-hi]')!;
    let a = Number(digits(lo.value)) || 0, b = Number(digits(hi.value)) || 0;
    if (a && b && a > b) [a, b] = [b, a];
    if (a > 0) sp.set(lo.name, String(a));
    if (b > 0) sp.set(hi.name, String(b));
    const s = sp.toString();
    return `${f.action.split('?')[0]}${s ? `?${s}` : ''}`;
  };
  const rangeKeep = (f: HTMLFormElement) => (f.closest('details[data-ck]') as HTMLElement | null)?.dataset.ck ?? null;
  // while dragging: the fields and the dark part of the line follow (nothing is fetched yet)
  document.addEventListener('input', (e) => {
    const r = e.target as HTMLInputElement;
    if (!r.matches?.('[data-rlo], [data-rhi]')) return;
    const f = r.closest('form[data-lrng]') as HTMLFormElement;
    const labels: string[] = JSON.parse(f.dataset.labels || '[]');
    const last = labels.length - 1;
    const rlo = f.querySelector<HTMLInputElement>('[data-rlo]')!, rhi = f.querySelector<HTMLInputElement>('[data-rhi]')!;
    let lo = Number(rlo.value), hi = Number(rhi.value);
    if (lo > hi) { if (r === rlo) { lo = hi; rlo.value = String(lo); } else { hi = lo; rhi.value = String(hi); } }
    f.querySelector<HTMLInputElement>('[data-lo]')!.value = lo > 0 ? labels[lo] : '';
    f.querySelector<HTMLInputElement>('[data-hi]')!.value = hi < last ? labels[hi] : '';
    const s = f.querySelector<HTMLElement>('.lrng__s')!;
    s.style.setProperty('--l', String(lo / last));
    s.style.setProperty('--r', String(1 - hi / last));
  });
  // slider released / a field changed → apply
  document.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    const f = el.closest?.('form[data-lrng]') as HTMLFormElement | null;
    if (!f || !inPlace(e)) return;
    if (el.matches('[data-rlo], [data-rhi]')) {
      // the slider writes the step itself (the label in the field is rounded for reading)
      const steps: number[] = JSON.parse(f.dataset.steps || '[]'), last = steps.length - 1;
      const lo = Number(f.querySelector<HTMLInputElement>('[data-rlo]')!.value), hi = Number(f.querySelector<HTMLInputElement>('[data-rhi]')!.value);
      f.querySelector<HTMLInputElement>('[data-lo]')!.value = lo > 0 ? String(steps[lo]) : '';
      f.querySelector<HTMLInputElement>('[data-hi]')!.value = hi < last ? String(steps[hi]) : '';
    }
    go(rangeUrl(f), { keep: rangeKeep(f) });
  });

  // forms: Enter in From/To, the property ID, and the «More filters» window
  document.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement;
    if (!inPlace(e)) return;
    if (f.matches('form[data-lrng]')) { e.preventDefault(); go(rangeUrl(f), { keep: rangeKeep(f) }); return; }
    const sheet = f.closest('#filter-sheet') as HTMLDialogElement | null;
    if (!f.matches('form[data-lxf]') && !sheet) return;
    e.preventDefault();
    const sp = new URLSearchParams();
    new FormData(f).forEach((v, k) => { if (String(v).trim()) sp.append(k, String(v).trim()); });
    const s = sp.toString();
    if (sheet) { sheet.close(); document.documentElement.style.overflow = ''; }
    menus().forEach((d) => { d.open = false; });
    go(`${f.action.split('?')[0]}${s ? `?${s}` : ''}`);
  });

  // Back / Forward between the filter states of this page
  if (onList()) {
    history.replaceState({ ...(history.state ?? {}), lx: 1 }, '');
    window.addEventListener('popstate', (e) => {
      if (!(e.state as { lx?: number } | null)?.lx || !onList()) return;
      go(location.href, { push: false });
    });
  }

  initSave();
  bindGild();
</script>

<script>
  // list → home move (Sergei 02/11): a note that lives 10 s, read once by the home page (desktop only).
  {
    const home = document.getElementById('main')?.dataset.homePath ?? '/';
    const desk = window.matchMedia('(min-width: 1024px)');
    const same = (a: string, b: string) => a.replace(/\/+$/, '') === b.replace(/\/+$/, '');
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a || !desk.matches) return;
      try {
        const u = new URL(a.href, location.href);
        if (u.origin !== location.origin || !same(decodeURI(u.pathname), decodeURI(home)) || u.search) return;
        const top = document.querySelector<HTMLElement>('.ltop')?.getBoundingClientRect();
        // the photo the strip shows now (already in the browser's cache): the home page starts with it
        const bg = getComputedStyle(document.querySelector<HTMLElement>('.ltop') ?? document.body).backgroundImage;
        const img = /^url\(["']?(https?:[^"')]+)/.exec(bg)?.[1] ?? '';
        localStorage.setItem('hpFromList', JSON.stringify({ t: Date.now(), h: top && top.bottom > 0 ? Math.round(top.bottom) : 242, img }));
      } catch { /* storage off */ }
    }, true);
  }
</script>
