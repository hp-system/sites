  .idform__l { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .idform__i { width: 14px; height: 14px; margin-inline-start: 10px; color: var(--faint); flex: none; }
  .idform__in {
