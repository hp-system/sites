     ⚠️ 44 ΚΑΙ ΟΧΙ 42: δοκιμάστηκε 42 και τα οκτώ πεδία συμμορφώθηκαν, αλλά το
        κουμπί «Εφαρμογή» έμεινε 44 — έχει `min-height: 44px` από τον καθολικό
        κανόνα στόχου αφής, και το `min-height` κερδίζει πάντα το `height`.
        Το σωστό ήταν να ανέβουν τα πεδία, όχι να κατέβει το κουμπί: το 44 είναι
        το ελάχιστο για δάχτυλο, και τα πεδία το χρειάζονται εξίσου.
     ⚠️ `box-sizing: border-box` ώστε το περίγραμμα να μετράει ΜΕΣΑ στα 44. */
  .f input, .f select, .fbar .btn {
    box-sizing: border-box; height: 44px;
  }
  .f input, .f select {
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    font: inherit; font-size: 16px; padding: 0 10px; width: 140px;
  }
  /* Τα κουμπιά κάθονται στη γραμμή των πεδίων, όχι των ετικετών. */
  .fbar .btn { display: inline-flex; align-items: center; }
  .f--beds select { width: 110px; }

  .grid { list-style: none; margin: var(--s5) 0 0; padding: 0; display: grid; gap: var(--s5) var(--s4); }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 520px) and (max-width: 759px) { .grid { grid-template-columns: repeat(2, 1fr); } }

  /* Η προτροπή πιάνει ΟΛΟ το πλάτος, μέσα στη ροή των αποτελεσμάτων. */
  /* 🔐 ΤΟ ΚΟΥΤΙ ΕΓΓΡΑΦΗΣ — όσο ψηλό όσο μια κάρτα, όχι λωρίδα (George, 30/7).
     Καταλαμβάνει μία θέση του πλέγματος σε desktop· σε κινητό απλώνεται. */
  .join {
    grid-column: 1 / -1; background: var(--ink); color: var(--paper);
    padding: var(--s5) var(--s4); display: grid; gap: var(--s3);
    align-content: center; justify-items: start; text-align: start;
  }
  @media (min-width: 760px) {
    .join { grid-column: span 1; padding: var(--s5); }
  }
  .join__lock {
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 1px solid rgba(255,255,255,.28); color: var(--paper);
  }
  .join__h { margin: 0; color: var(--paper); }
  .join__list {
    margin: 0; padding: 0; list-style: none; display: grid; gap: 7px;
    font-size: 14px; color: rgba(255,255,255,.82);
  }
  .join__list li { display: grid; grid-template-columns: auto 1fr; gap: 8px; align-items: start; }
  .join__list li::before { content: '·'; opacity: .6; }
  .join__b {
    margin-top: var(--s2); border: 1px solid var(--paper); background: var(--paper); color: var(--ink);
    font-size: 13px; letter-spacing: .05em; text-transform: uppercase; padding: 13px 26px;
    text-decoration: none; white-space: nowrap;
  }
  .join__b:hover { background: transparent; color: var(--paper); }

  .empty { margin: var(--s6) 0; text-align: center; display: grid; gap: var(--s3); justify-items: center; }
  .pager { display: flex; gap: var(--s3); align-items: center; justify-content: center; margin: var(--s6) 0 0; }

</style>

<script>
  // Τα φίλτρα ανοίγουν/κλείνουν. Η φόρμα δουλεύει και χωρίς αυτό — απλά μένει ανοιχτή.
  const t = document.getElementById('ftog');
  const b = document.getElementById('fbar');
  if (t && b) {
    // Αν ο επισκέπτης έχει ήδη ενεργό φίλτρο, ανοίγουν από μόνα τους.
    const active = b.querySelectorAll('input[type=number]');
    let any = false;
    active.forEach((i) => { if ((i as HTMLInputElement).value) any = true; });
    if (any) { (b as HTMLElement).hidden = false; t.setAttribute('aria-expanded', 'true'); }
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') === 'true';
      t.setAttribute('aria-expanded', String(!open));
      (b as HTMLElement).hidden = open;
    });
  }
</script>
