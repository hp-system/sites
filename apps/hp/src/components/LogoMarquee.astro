---
// The partners' logos floating by, held under the pointer: the strip of the About us page, shared since Sergei
// 2026-11-19 put it on Our partners at the full screen width. Grey until hovered; stands still with reduced motion.
interface Props { logos: { src: string; alt: string }[]; full?: boolean }
const { logos, full = false } = Astro.props;
---
<div class:list={['lmq', { 'lmq--full': full }]}>
  <div class="lmq__t">
    {logos.map((l) => <img src={l.src} alt={l.alt} width="120" height="84" loading="lazy" decoding="async" />)}
    {logos.map((l) => <img src={l.src} alt={l.alt} aria-hidden="true" width="120" height="84" loading="lazy" decoding="async" />)}
  </div>
</div>

<style>
  .lmq { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .lmq--full { -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); }
  .lmq__t { display: flex; align-items: center; gap: 12px; width: max-content; animation: lmq 60s linear infinite; }
  .lmq:hover .lmq__t { animation-play-state: paused; }
  .lmq__t img { height: 84px; width: 120px; object-fit: contain; display: block; filter: grayscale(1); opacity: .75; transition: filter .25s ease, opacity .25s ease; }
  .lmq__t img:hover { filter: none; opacity: 1; }
  @keyframes lmq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .lmq__t { animation: none; } }
</style>
