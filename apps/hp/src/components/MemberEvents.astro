---
// Signed-in members' activity to the CRM (sites#305). Rendered by Base only when the member cookie is there, so guests
// never load it. Collects, per page: one page_view (the page kind + its path), one property_view on a property page
// (its public number), one search on a list page (the filters of the list on show, again after an in-place swap), and
// a contact_click for every phone / WhatsApp / e-mail / Viber / Telegram / SMS link clicked. Sent in batches to
// /api/member-events (our server adds the member token) with sendBeacon: after 3 s of quiet and when the page hides.
// The page marks itself: `data-mev-prop="6544"` (PropertyPage), `data-mev-search="{…}"` (ListingPage).
---
<script>
  type Ev = { kind: 'page_view' | 'property_view' | 'search' | 'contact_click'; uid: string; lang?: string; ref?: string; page?: string; slug?: string; channel?: string; filters?: Record<string, string> };
  const queue: Ev[] = [];
  let timer: ReturnType<typeof setTimeout> | undefined;
  const lang = (document.documentElement.lang || '').slice(0, 2);
  const uid = () => (crypto.randomUUID ? crypto.randomUUID() : `${Date.now().toString(16)}-0000-4000-8000-${Math.random().toString(16).slice(2, 14).padEnd(12, '0')}`);

  const flush = () => {
    clearTimeout(timer);
    while (queue.length) {
      const batch = queue.splice(0, 20);
      const body = JSON.stringify({ events: batch });
      if (body.length > 4000) { batch.forEach((e) => { delete e.filters; }); }
      const blob = new Blob([JSON.stringify({ events: batch })], { type: 'application/json' });
      if (!navigator.sendBeacon?.('/api/member-events', blob)) {
        fetch('/api/member-events', { method: 'POST', body: blob, keepalive: true, credentials: 'same-origin' }).catch(() => {});
      }
    }
  };
  const push = (e: Omit<Ev, 'uid' | 'lang'>) => {
    queue.push({ ...e, uid: uid(), lang } as Ev);
    clearTimeout(timer);
    timer = setTimeout(flush, 3000);
  };

  // the page: its kind (a short word) and its path (letters, digits, / _ . -; at most 120)
  const kindOf = () => {
    if (document.querySelector('[data-mev-prop]')) return 'property';
    if (document.querySelector('[data-mev-search]')) return 'list';
    const p = location.pathname.replace(/\/+$/, '');
    if (p === '' || /^\/[a-z]{2}$/.test(p)) return 'home';
    if (/\/panel(\/|$)/.test(p)) return 'panel';
    if (/\/blog(\/|$)|\/articles?(\/|$)/.test(p)) return 'article';
    return 'page';
  };
  const slug = () => { try { return decodeURIComponent(location.pathname).slice(0, 120); } catch { return location.pathname.slice(0, 120); } };

  const pageEvents = () => {
    push({ kind: 'page_view', page: kindOf(), slug: slug() });
    const prop = document.querySelector<HTMLElement>('[data-mev-prop]')?.dataset.mevProp;
    if (prop) push({ kind: 'property_view', ref: prop });
    const s = document.querySelector<HTMLElement>('[data-mev-search]')?.dataset.mevSearch;
    if (s) { try { push({ kind: 'search', filters: JSON.parse(s) }); } catch { /* a bad mark: no search */ } }
  };
  pageEvents();
  // the list swaps its parts in place (filters, pages): that is a new search on the same page
  document.addEventListener('hp:swap', pageEvents);

  // contact clicks: the link's own address says the channel
  const channelOf = (href: string): string | null => {
    const h = href.toLowerCase();
    if (h.startsWith('tel:')) return 'phone';
    if (h.startsWith('mailto:')) return 'email';
    if (h.startsWith('sms:')) return 'sms';
    if (h.startsWith('viber:')) return 'viber';
    if (/^https?:\/\/(wa\.me|api\.whatsapp\.com|chat\.whatsapp\.com|web\.whatsapp\.com)\//.test(h) || h.startsWith('whatsapp:')) return 'whatsapp';
    if (/^https?:\/\/(t\.me|telegram\.me)\//.test(h) || h.startsWith('tg:')) return 'telegram';
    return null;
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    const ch = a && channelOf(a.getAttribute('href') ?? '');
    if (ch) { push({ kind: 'contact_click', channel: ch }); flush(); }
  }, { capture: true });

  addEventListener('pagehide', flush);
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flush(); });
</script>
