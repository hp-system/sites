---
// ═══════════════════════════════════════════════════════════════════════════
// ΤΟ ΜΕΝΟΥ ΣΤΟ ΚΙΝΗΤΟ — 58,4% της επισκεψιμότητας.
//
// Ανοίγει ΟΛΟΚΛΗΡΟ, με τη ΓΕΩΓΡΑΦΙΑ ΠΡΩΤΗ και το πλήθος δίπλα σε κάθε δήμο.
// Ο αριθμός είναι και πληροφορία και απόδειξη — «247 ακίνητα στην Κασσάνδρα»
// λέει περισσότερα από κάθε διαφημιστική φράση.
//
// Το σημερινό μενού ξεκινά με «Κατοικία / Γη / Επαγγελματικό»: λεξιλόγιο βάσης
// δεδομένων. Κανείς δεν ψάχνει «Επαγγελματικό» — ψάχνει τόπο και τιμή.
//
// Χωρίς βιβλιοθήκη: ένα <dialog> και 20 γραμμές. Κλείνει με Esc, με το X,
// και με κλικ έξω. Κλειδώνει το σκρολ από πίσω.
// ═══════════════════════════════════════════════════════════════════════════
import Logo from './Logo.astro';
import { t, listUrl, prefix, type Lang } from '../lib/i18n';
import LangSwitch from './LangSwitch.astro';
import { num } from '../lib/format';
import { company } from '../lib/company';
import { memberOf } from '../lib/member';
import { pageExists } from '../lib/pages';

interface Props { lang: Lang; munis: { name: string; n: number; key?: string }[]; total: number;
  /** Η ίδια σελίδα σε άλλη γλώσσα — μόνο όπου το slug ΜΕΤΑΦΡΑΖΕΤΑΙ (λίστα, ακίνητο).
      Αλλού ο διακόπτης το βρίσκει μόνος του από τη διεύθυνση. Δες `LangSwitch.astro`. */
  pathFor?: (l: Lang) => string;
}
const { lang, munis, total, pathFor } = Astro.props;

const p = prefix(lang);
// English: the old site's URL /en/about-us (the info page); other languages keep /about.
const aboutHref = lang === 'en' ? '/en/about-us' : `${p}/about`;
const url = listUrl(lang);
const co = await company();

// 🔴 ΤΟ ΜΕΝΟΥ ΤΟΥ ΚΙΝΗΤΟΥ ΕΔΕΙΧΝΕ «Εγγραφή» ΚΑΙ ΣΕ ΣΥΝΔΕΔΕΜΕΝΟ ΜΕΛΟΣ, και δεν είχε
//    καμία διέξοδο προς τον λογαριασμό ή έξω από αυτόν. Στο κινητό αυτό είναι ΟΛΟ το
//    μενού — δεν υπάρχει δεύτερη γραμμή συνδέσμων να σε σώσει.
const me = await memberOf(Astro.cookies.get('member_token')?.value);
const inside = !!me && !me.blocked;

const KINDS: [string, string][] = [
  [t(lang, 'kinds.villas'), 'detached house'], [t(lang, 'kinds.maisonettes'), 'maisonette'],
  [t(lang, 'kinds.apartments'), 'apartment'], [t(lang, 'kinds.land'), 'land'],
  [t(lang, 'kinds.hotels'), 'hotel'],
];

// 🛡️ ΔΙΧΤΥ: ΔΕΝ ΔΕΙΧΝΟΥΜΕ ΣΥΝΔΕΣΜΟ ΓΙΑ ΣΕΛΙΔΑ ΠΟΥ ΔΕΝ ΥΠΑΡΧΕΙ.
//    Έτσι γεννήθηκαν οι 124 νεκροί σύνδεσμοι: τα μενού γράφτηκαν πριν τις σελίδες και
//    κανείς δεν ξαναπέρασε. Τώρα η ύπαρξη κρίνεται από το `lib/pages.ts` — αν λείπει
//    το κείμενο, λείπει και ο σύνδεσμος. Δεν μπορεί να ξανασυμβεί σιωπηλά.
const has = (k: string) => pageExists(k as any);
---
<dialog class="mm" id="mobile-menu" aria-label={t(lang, 'ui.menu')}>
  <div class="mm__bar">
    <span class="mm__brand"><Logo variant="brand" size="sm" /></span>
    <button class="mm__x" type="button" data-close aria-label={t(lang, 'ui.close')}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
  </div>

  <nav class="mm__body">
    {/* Η ΓΛΩΣΣΑ ΠΡΩΤΗ. Ο Βούλγαρος επισκέπτης — 28,1% της κίνησης, 2.101 μέλη —
        προσγειώνεται σε ελληνική σελίδα· αν δεν βρει τη γλώσσα αμέσως, φεύγει.
        Ανοίγει ΣΕ ΡΟΗ (`block`), όχι ως αιωρούμενο πάνελ: μέσα σε φύλλο που
        κυλάει, ένα απόλυτο πάνελ σκέπαζε τη λίστα των δήμων. */}
    <p class="mm__lab">{t(lang, 'mm.lang')}</p>
    <LangSwitch lang={lang} block pathFor={pathFor} />

    {/* Η γεωγραφία μετά — ο τόπος είναι η κατηγορία. */}
    <p class="mm__lab">{t(lang, 'mm.where')}</p>
    <ul class="mm__list">
      {munis.map((m) => (
        <li><a href={`${url}?municipality=${encodeURIComponent(m.key ?? m.name)}`}>
          <span>{m.name}</span>
        </a></li>
      ))}
      <li><a href={url}><span>{t(lang, 'ui.all_halkidiki')}</span></a></li>
    </ul>

    <p class="mm__lab">{t(lang, 'mm.what')}</p>
    <ul class="mm__list">
      {KINDS.map(([label, v]) => (
        <li><a href={`${url}?subcategory=${encodeURIComponent(v)}`}><span>{label}</span></a></li>
      ))}
    </ul>

    <p class="mm__lab">{t(lang, 'mm.company')}</p>
    <ul class="mm__list mm__list--plain">
      <li>{has('sell') && <a href={`${p}/sell`}>{t(lang, 'nav.sell')}</a>}</li>
      <li>{has('services') && <a href={`${p}/services`}>{t(lang, 'nav.services')}</a>}</li>
      <li>{has('about') && <a href={aboutHref}>{t(lang, 'nav.company')}</a>}</li>
      <li><a href="/en/articles/all-news">{t(lang, 'nav.blog')}</a></li>
      <li>{has('contact') && <a href={`${p}/contact`}>{t(lang, 'foot.contact')}</a>}</li>
    </ul>

    <div class="mm__foot">
      {inside
      ? <a class="btn" href={`${p}/panel`} data-ev="panel:menu">{t(lang, 'pnl.title')}</a>
      : <a class="btn" href={`${p}/login`} data-ev="register:menu">{t(lang, 'nav.login')}</a>}
      {inside && (
      <form method="post" action="/api/auth/logout" class="mm__out">
        <button type="submit">Αποσύνδεση</button>
      </form>
    )}
    <a class="mm__tel num" href={co.phoneHref} data-ev="call:menu"><bdi dir="ltr">{co.phone}</bdi></a>
    </div>
  </nav>
</dialog>

<script>
  const dlg = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const open = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dlg && open) {
    open.addEventListener('click', () => {
      dlg.showModal();
      open.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
    });
    const close = () => {
      dlg.close();
      open.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    };
    dlg.querySelector('[data-close]')?.addEventListener('click', close);
    dlg.addEventListener('close', () => {
      open.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    });
    // Κλικ στο backdrop — το <dialog> δίνει το κλικ στον εαυτό του, όχι στα παιδιά.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  }
</script>

<style>
  /* Το `display` ΜΟΝΟ στο [open] — δες τη σημείωση στο FilterSheet.astro:
     ένας κανόνας `display` στο ίδιο το <dialog> ακυρώνει το κρύψιμο του browser. */
  .mm {
    width: 100%; max-width: none; height: 100%; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--paper); color: var(--ink);
  }
  .mm::backdrop { background: rgba(14, 18, 20, .5); }
  .mm[open] { display: flex; flex-direction: column; }

  .mm__bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px var(--gut); border-bottom: 1px solid var(--line); flex: none;
  }
  .mm__x { background: none; border: 0; padding: 8px; margin: -8px; cursor: pointer; color: var(--ink); }
  .mm__x svg { width: 20px; height: 20px; }

  .mm__body { padding: var(--s5) var(--gut) var(--s7); overflow-y: auto; flex: 1; }
  .mm__lab {
    margin: var(--s5) 0 var(--s2); font-size: 10.5px; font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase; color: var(--faint);
  }
  .mm__lab:first-child { margin-top: 0; }
  .mm__list { list-style: none; margin: 0; padding: 0; }
  .mm__list a {
    display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3);
    padding: 13px 0; min-height: 48px; border-bottom: 1px solid var(--line-soft);
    font-size: 19px; font-weight: 300; letter-spacing: -.012em;
  }
  .mm__list b { font-size: 12px; font-weight: 400; color: var(--faint); }
  .mm__list--plain a { font-size: 16px; }

  .mm__foot { margin-top: var(--s7); display: flex; flex-direction: column; gap: var(--s4); align-items: flex-start; }
  .mm__tel { font-size: 15px; color: var(--muted); }

  /* 🔴🔴 ΤΟ ΚΑΤΩΦΛΙ ΠΡΕΠΕΙ ΝΑ ΤΑΥΤΙΖΕΤΑΙ ΜΕ ΤΟΥ BURGER (Header.astro: 1080px).
     ΗΤΑΝ 760 ΚΑΙ ΠΑΓΩΝΕ ΟΛΟΚΛΗΡΗ ΤΗ ΣΕΛΙΔΑ σε κάθε πλάτος 760-1079:
     το burger φαινόταν (κρύβεται στα ≥1080), το πάτημα άνοιγε το <dialog>
     (`open=true`, `:modal=true`) — αλλά αυτός ο κανόνας το έκανε `display:none`
     με `!important`. Αποτέλεσμα: **αόρατο modal, όλο το έγγραφο inert**.
     Μετρήθηκε σε 768/834/900/1024/1079: μηδέν scroll, `elementFromPoint` =
     `<html>`, δεύτερο πάτημα αδύνατο, `::backdrop` επίσης κρυμμένο άρα ΚΑΜΙΑ
     οπτική ένδειξη. Μόνο το Escape ξεκλείδωνε — που το tablet δεν έχει.
     Δηλαδή: **iPad portrait (768), iPad Pro (834) και iPad landscape (1024)
     πάγωναν αθόρυβα** μέχρι να κάνει ο χρήστης reload.
     ⛔ ΑΝ ΑΛΛΑΞΕΙ ΤΟ ΚΑΤΩΦΛΙ ΣΤΟ Header.astro, ΑΛΛΑΞΕ ΚΑΙ ΕΔΩ. */
  @media (min-width: 1080px) { .mm { display: none !important; } }
</style>

<style>
  /* Η έξοδος υπάρχει και εδώ: στο κινητό ο πίνακας είναι δύο πατήματα μακριά, και
     όποιος θέλει να βγει το θέλει ΤΩΡΑ — συνήθως επειδή δεν είναι δικό του τηλέφωνο. */
  .mm__out { margin-top: 14px; }
  .mm__out button { all: unset; cursor: pointer; text-decoration: underline;
                    font-size: 14px; opacity: .7; }
  .mm__out button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
