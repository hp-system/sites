---
// ═══════════════════════════════════════════════════════════════════════════
// ΜΠΛΟΚ 5 — ΕΚΤΟΣ ΔΗΜΟΣΙΕΥΣΗΣ.
//
// Η ΙΣΤΟΡΙΑ ΤΟΥ (για να μην ξαναγίνει ο κύκλος):
//  · v1 «Ιδιωτική συλλογή» με κλειδωμένες κάρτες → ο George: «δεν μου αρέσει που
//    έχει αγροτεμάχια και κενές παύλες και τιμές από κάτω». Σωστά.
//  · v2 «Χάρτης ζωνών» με κωδικούς Ζ-01 → ο George: «δεν βλέπω κάποιο value για
//    τον πελάτη». Επίσης σωστά: ήταν γρίφος χωρίς κλειδί, φτιαγμένος για ΕΜΑΣ.
//  · v3 (αυτό): κανένας γρίφος, καμία κάρτα, καμία παύλα. Ένας αληθινός αριθμός
//    και μία υπηρεσία.
//
//  · v4 (28/7, George): **ΚΑΝΕΝΑΣ ΑΡΙΘΜΟΣ.** «Κανένας άνθρωπος δεν χρειάζεται να
//    ξέρει πόσα είναι τα ακίνητα αυτά. Οι πελάτες μπορούν να μπουν και να τα δουν
//    αν ενδιαφέρονται.» Στη θέση του 79 μπήκε επίθετο. Έφυγαν επίσης η γραμμή
//    «Όχι δικό μας μυστικό — δική τους επιλογή» («σαν πολύ απολογητικό μου
//    φαίνεται»), η υπόσχεση «απαντάμε την ίδια μέρα» («δεν το κάνουμε»), το
//    «ανοίγουν την ίδια στιγμή» («δεν καταλαβαίνει ο πελάτης») και το πλήθος
//    μελών («δεν ενδιαφέρει τον πελάτη πόσοι άλλοι έχουν μπει»).
//
// ΚΑΙ Ο ΚΑΝΟΝΑΣ ΠΟΥ ΒΓΗΚΕ ΑΠΟ ΤΗ ΣΥΖΗΤΗΣΗ:
//   Δεν ζητάμε εγγραφή για να ΔΕΙ. Ζητάμε να μας ΠΕΙ τι ψάχνει.
//   Η εγγραφή είναι η συνέπεια, όχι το διόδιο. Το ξεκλείδωμα περιοχής/φωτογραφιών
//   μένει εκεί που δουλεύει χρόνια: στη ΣΕΛΙΔΑ ΤΟΥ ΑΚΙΝΗΤΟΥ.
// ═══════════════════════════════════════════════════════════════════════════
import { t, prefix, type Lang } from '../lib/i18n';

interface Props { lang: Lang; count: number }
const { lang, count } = Astro.props;

// Ο παλιός φρουρός ήταν «κάτω από 6 δεν αντέχει να είναι ήρωας ο αριθμός».
// Αριθμός δεν υπάρχει πια — μένει μόνο ο έλεγχος αλήθειας: αν δεν έχουμε ούτε
// ένα τέτοιο ακίνητο, το μπλοκ θα έλεγε ψέματα.
if (count < 1) return null;
---
<section class="off" aria-labelledby="off-h">
  {/* #101 desktop: a big faint lock behind the band (as the Free account band of the
      property page); it drifts from the top edge to the bottom one while the band
      crosses the screen — see the script in HomePage.astro. */}
  <svg class="off__biglock" id="offLock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".7"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="4.5" y="10.5" width="15" height="11"></rect><path d="M7.5 10.5V7a4.5 4.5 0 0 1 9 0v3.5"></path>
    <circle cx="12" cy="15.4" r="1.3"></circle><path d="M12 16.7v2.1"></path>
  </svg>
  <div class="wrap">
    <div class="off__grid">
      <div>
        {/* 🔒 Η ΚΛΕΙΔΑΡΙΑ (George, 28/7). Δεν είναι διακόσμηση: είναι το μόνο
            σύμβολο που λέει «υπάρχει κάτι από πίσω» πριν διαβαστεί λέξη. */}
        <span class="off__lock" aria-hidden="true">
          <svg viewBox="0 0 24 30">
            <path d="M6 13V8.5a6 6 0 0 1 12 0V13" fill="none" stroke="currentColor" stroke-width="1.8" />
            <rect x="2.5" y="13" width="19" height="15" rx="0" fill="none" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="19.5" r="1.6" fill="currentColor" />
            <path d="M12 21v3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </span>
        {/* ⚠️ ΞΕΧΩΡΙΣΤΟ ΚΛΕΙΔΙ ΑΠΟ ΤΟ `off.brand`: εκείνο τροφοδοτεί ΚΑΙ το κουμπί
            («Πάρτε πρόσβαση στο {b}»). Αν γραφόταν το ένα πάνω στο άλλο, το κουμπί
            θα έλεγε «...στο Ξεκλειδώστε το Secret Portfolio». */}
        <p class="t-label off__eyebrow">{t(lang, 'off.eyebrow')}</p>
        <p data-h id="off-h" class="off__h">
          <b class="off__adj">{t(lang, 'off.h2a')}</b> {t(lang, 'off.h2b')}
        </p>
      </div>

      <div class="off__act">
        <p class="off__ask">{t(lang, 'off.ask2')}</p>
        <a class="btn h-gild" href={`${prefix(lang)}/login`} rel="nofollow" data-ev="register:off_market">
          {t(lang, 'off.access', { b: t(lang, 'off.brand') })}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .off {
    background: var(--ink-deep); color: #fff;
    padding: var(--s7) 0;
  }
  .off__grid { display: grid; gap: var(--s6); }
  .off__eyebrow { color: rgba(255,255,255,.62); letter-spacing: .22em; }
  .off__lock { display: block; color: rgba(255,255,255,.5); margin-bottom: var(--s4); }
  .off__lock svg { width: 26px; height: 32px; }

  /* Ο τίτλος είναι ΜΙΑ φράση, σε ένα μέγεθος. Όσο ήταν αριθμός, ήθελε δική του
     κλίμακα (72px) — μια λέξη στα 72px θα φώναζε, και ακριβώς αυτό δεν θέλουμε. */
  .off__h {
    margin: var(--s3) 0 0; font-weight: 300; letter-spacing: -.016em;
    font-size: var(--fs-s4); line-height: 1.14; color: #fff; max-width: 20ch;
  }
  /* Το επίθετο κρατά μόνο το βάρος — καμία αλλαγή μεγέθους, κανένα χρώμα. */
  .off__adj { font-weight: 600; }

  .off__act { align-self: end; }
  .off__ask { margin: 0 0 var(--s4); font-size: var(--fs-s0); color: rgba(255,255,255,.86); max-width: 40ch; }
  .off__act .btn { background: #fff; color: var(--ink-deep); border-color: #fff; }
  .off__fine { margin: var(--s3) 0 0; font-size: var(--fs-s-1); color: rgba(255,255,255,.42); }

  .off__seller {
    margin: var(--s6) 0 0; padding-top: var(--s4);
    border-top: 1px solid rgba(255,255,255,.14);
    font-size: var(--fs-s-1); color: rgba(255,255,255,.55);
  }
  .off__seller a { border-bottom: 1px solid rgba(255,255,255,.3); padding-bottom: 1px; color: rgba(255,255,255,.86); }

  @media (min-width: 760px) {
    .off { padding: 74px 0; }
    .off__grid { grid-template-columns: 1.3fr 1fr; gap: var(--s8); align-items: end; }
  }
  .off__biglock { display: none; }

  /* ── #101 desktop ─────────────────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .off { position: relative; overflow: hidden; padding: 48px 0; }
    .off .wrap { position: relative; z-index: 1; }
    .off__grid { align-items: center; }
    .off__lock { display: none; }
    /* Sergei 03/11: the heading in two lines, not three — a wider left column, no ch limit */
    .off__grid { grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 48px; }
    .off__h { margin-top: var(--s3); max-width: none; text-wrap: balance; font-size: var(--fs-s3); }
    .off__biglock {
      display: block; position: absolute; left: calc(50% + 13px); top: 0; width: 100px; height: 100px;
      color: #fff; opacity: .07; pointer-events: none; z-index: 0; will-change: transform;
    }
    /* gilded edge on the dark band; the gradient turns once on entering the band
       and once on entering the button (script + keyframes in HomePage.astro) */
    .off__act .btn {
      background: transparent; color: var(--gold-dk-text); border: 1px solid var(--gold-dk);
      border-image: conic-gradient(from var(--gilda), var(--gold-dk-hi), var(--gold-dk) 25%, var(--gold-dk-lo) 50%, var(--gold-dk) 75%, var(--gold-dk-hi)) 1;
      transition: color .9s ease-in-out;
    }
    .off__act .btn:hover, .off__act .btn:focus-visible { color: var(--gold-dk-hover); opacity: 1; }
    .off__act .btn:focus-visible { outline-color: var(--gold-dk); outline-offset: 3px; }
  }
</style>
