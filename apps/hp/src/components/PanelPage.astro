---
// ═══════════════════════════════════════════════════════════════════════════
// /panel for an agent: the cooperation section, in the panel frame (PanelShell, design E3 — Sergei 2026-11-11
// «AFTER main v3 — no Home page: you land where something waits»). A buyer or a seller never stays on /panel:
// the router sends them where something waits (saved homes, the closed collection, a request, the submit form).
// Before 11/11 this page was the member's home with tabs (Buy / Sell / Cooperation) — see git history.
//
// 🎚️ THE LEVEL COMES FROM THE CRM (lib/member.ts, `/site/member/me`, 30 s), never from the cookie: when George
//    turns an agent into a member, this page is no longer his within half a minute.
// ═══════════════════════════════════════════════════════════════════════════
import PanelShell from './PanelShell.astro';
import { t, type Lang } from '../lib/i18n';
import type { Member } from '../lib/member';
import { company } from '../lib/company';

interface Props { lang: Lang; me: Member }
const { lang, me } = Astro.props;
const co = await company();
---
<PanelShell lang={lang} me={me} current="coop" title={t(lang, 'pnl.tab_coop')}>
  <section class="cp">
    <h1 class="t-h2 cp__h">{t(lang, 'pnl.tab_coop')}</h1>
    <p class="cp__say">{t(lang, 'pnl.ag_say')}</p>
    <div class="cp__rows">
      <a class="cp__row" href="/en/collaboration-order"><span>{t(lang, 'pnl.coop_order')}</span><i aria-hidden="true">›</i></a>
      <a class="cp__row" href={co.phoneHref}><span>{t(lang, 'pnl.ag_talk')}<small><bdi dir="ltr">{co.phone}</bdi></small></span><i aria-hidden="true">›</i></a>
    </div>
    <div class="cp__ask">
      <p class="cp__ask-h">{t(lang, 'pnl.ag_ask_h')}</p>
      <p class="cp__say">{t(lang, 'pnl.ag_ask_s')}</p>
      <a class="k-act cp__go" href={co.phoneHref}>{t(lang, 'pnl.ag_cta')}</a>
    </div>
  </section>
</PanelShell>

<style>
  .cp { display: grid; gap: var(--s4); max-width: 720px; }
  .cp__h { margin: 0; }
  .cp__say { margin: 0; font-size: var(--fs-s0); line-height: 1.6; color: var(--muted); }
  .cp__rows { display: grid; border-top: 1px solid var(--line); }
  .cp__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line);
    color: var(--ink); text-decoration: none; font-size: var(--fs-s0); }
  .cp__row small { display: block; margin-top: 2px; color: var(--muted); font-size: var(--fs-s-1); }
  .cp__row:hover span { text-decoration: underline; text-underline-offset: 3px; }
  .cp__ask { display: grid; gap: 10px; padding: 24px; background: var(--paper-2); }
  .cp__ask-h { margin: 0; font-size: var(--fs-s1); font-weight: 400; color: var(--ink); }
  .cp__go { width: auto; justify-self: start; padding: 0 24px; }
</style>
