---
// In the panel frame (PanelShell, design E3 — Sergei 2026-11-11 «AFTER main v3»). The head of the page as on the
// board (Sergei 2026-11-23): round initials, the name with a pencil, e-mail and mobile under it. The pencil opens
// «how to change them» (only the adviser changes a checked detail, see below). The board's gender, contact ways
// and «how often» are not shown: the CRM holds none of them yet, and a field that does not save is worse than none.
// Sign out lives in the account menu under the name in the side box (every panel page).
import PanelShell from './PanelShell.astro';
// ═══════════════════════════════════════════════════════════════════════════
// ΤΑ ΣΤΟΙΧΕΙΑ ΜΟΥ — `/panel/profile`
//
// 🔴 ΤΙ ΜΠΟΡΕΙ ΚΑΙ ΤΙ ΔΕΝ ΜΠΟΡΕΙ ΝΑ ΚΑΝΕΙ ΑΥΤΗ Η ΣΕΛΙΔΑ, ΚΑΙ ΓΙΑΤΙ.
//    Το API έχει `POST /site/member/complete`, που **προσθέτει ό,τι λείπει** — και
//    στέλνει κωδικό στο νέο στοιχείο πριν το δεχτεί. Δεν έχει «άλλαξε το e-mail μου
//    από το Α στο Β». Είναι σκόπιμο: η αλλαγή υπάρχοντος στοιχείου είναι το κλασικό
//    πρώτο βήμα κατάληψης λογαριασμού, και θέλει σχεδιασμό που δεν έχει γίνει.
//    ⛔ ΜΗΝ φτιάξεις εδώ πεδία που «αποθηκεύουν» χωρίς endpoint — θα δείχνουν ότι
//    δέχτηκαν την αλλαγή και δεν θα έχει αλλάξει τίποτα. Χειρότερο από το να λείπει.
//
// ✅ ΑΥΤΟ ΠΟΥ ΚΑΝΕΙ: δείχνει τι ξέρουμε, και **προσθέτει ό,τι λείπει** με τον
//    υπάρχοντα, επαληθευμένο δρόμο. Για αλλαγή υπάρχοντος, ο σύμβουλος.
//
// 🪤 Η ΜΟΝΗ ΕΞΟΔΟΣ ΑΠΟ ΤΟΝ ΛΟΓΑΡΙΑΣΜΟ ΖΟΥΣΕ ΜΟΝΟ ΜΕΣΑ ΣΤΟΝ ΠΙΝΑΚΑ. Την κρατάμε
//    και εδώ: όποιος ψάχνει «πώς βγαίνω» κοιτάζει τα στοιχεία του, όχι την αρχική.
// ═══════════════════════════════════════════════════════════════════════════
import { prefix, t, type Lang } from '../lib/i18n';
import { company } from '../lib/company';
import WaLink from './WaLink.astro';
import type { Member } from '../lib/member';

interface Props { lang: Lang; me: Member }
const { lang, me } = Astro.props;
const p = prefix(lang);
const isExclusive = me.level === 'exclusive';
const isAgent = me.level === 'agent' || me.role === 'agent' || me.role === 'partner';
// E3 «About you» (Sergei 2026-11-23): gender, contact ways, how often. The CRM has no fields for them yet: each change goes
// to the adviser as a line (/api/panel/request, type «prefs») and the page keeps the choice in this browser.
const WAYS: [string, string][] = [['email', t(lang, 'pf.email')], ['call', t(lang, 'pf.w_call')], ['whatsapp', 'WhatsApp'], ['viber', 'Viber'], ['sms', t(lang, 'pf.w_sms')]];
const OFTEN: [string, string][] = [['now', t(lang, 'pf.o_now')], ['day', t(lang, 'pf.o_day')], ['week', t(lang, 'pf.o_week')], ['never', t(lang, 'pf.o_never')]];
// My details from the CRM (#496); `null` = an older CRM, then the browser copy and the defaults (email + WhatsApp, weekly)
const pr = me.preferences;
const wayOn = (v: string) => pr ? pr.contactWays.includes(v) : v === 'email' || v === 'whatsapp';
const PF_T = { saved: t(lang, 'pf.saved'), fail: t(lang, 'sb.e.fail'), del_done: t(lang, 'pf.del_done') };
const co = await company();

// Το API δίνει ενιαίο `name`· η βάση το κρατά χωριστά. Κόβουμε μόνο για ΕΜΦΑΝΙΣΗ —
// δεν αποθηκεύουμε τίποτα από αυτόν τον χωρισμό.
const parts = (me.name || '').trim().split(/\s+/).filter(Boolean);
const first = parts[0] ?? '';
const last = parts.slice(1).join(' ');

const full = [first, last].filter(Boolean).join(' ');
const ini = (parts.length > 1 ? parts[0][0] + parts[parts.length - 1][0] : (parts[0] ?? me.email ?? '?').slice(0, 2)).toUpperCase();

const missing: string[] = [];
if (!me.name) missing.push(t(lang, 'pf.m_name'));
if (!me.email) missing.push(t(lang, 'pf.m_email'));
if (!me.phone) missing.push(t(lang, 'pf.m_phone'));
---

<PanelShell lang={lang} me={me} current={'profile'} title={t(lang, 'pnl.profile')} description={t(lang, 'pf.meta_desc')}>
  <div class="pf" data-pf data-crm={pr ? '1' : undefined} data-i18n={JSON.stringify(PF_T)}>
    <h1 class="sr-only">{t(lang, 'pnl.profile')}</h1>

    <div class="pf__head">
      <span class="pf__ava" aria-hidden="true">{ini}</span>
      <div class="pf__id">
        <p class="pf__nm">
          <span>{full || <span class="none">{t(lang, 'pf.none')}</span>}</span>
          <button type="button" class="pf__pen" data-pf-chg aria-label={t(lang, 'pf.chg_h')} title={t(lang, 'pf.chg_h')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4"></path></svg>
          </button>
        </p>
        <p class="pf__ln">{me.email || <span class="none">{t(lang, 'pf.none')}</span>}</p>
        <p class="pf__ln"><bdi dir="ltr">{me.phone || ''}</bdi>{!me.phone && <span class="none">{t(lang, 'pf.none')}</span>}</p>
      </div>
    </div>

    {missing.length > 0 && (
      /* Ο ΜΟΝΟΣ δρόμος που υπάρχει σήμερα, και είναι ο σωστός: το νέο στοιχείο
         επαληθεύεται με κωδικό πριν μπει.
         🪤 ΔΥΟ ΚΛΕΙΔΙΑ, ΟΧΙ ΕΝΑ ΜΕ ΑΡΙΘΜΟ: το παλιό «Λείπει {n} στοιχεία» τύπωνε
            «Λείπει 2 στοιχεία». Ο ενικός και ο πληθυντικός είναι άλλη πρόταση. */
      <div class="ask">
        <p class="ask__h">{missing.length === 1
          ? t(lang, 'pf.miss1')
          : t(lang, 'pf.miss_n', { n: missing.length })}</p>
        <p class="ask__s">{t(lang, 'pf.miss_s', { list: missing.join(t(lang, 'pf.and')) })}</p>
        <a class="btn" href={`${p}/login?next=${encodeURIComponent(`${p}/panel/profile`)}`}>{t(lang, 'pf.fill')}</a>
      </div>
    )}

    {/* E3 (Sergei 2026-11-23 «как в макете, гендер в самый низ»): each answer is a small drop-down — the site's own,
        not a native select; it closes on a click outside (Base, details[data-pop]) */}
    <div class="qa">
      <p class="qq">{t(lang, 'pf.ways_q')}</p>
      <details class="dd" data-pop>
        <summary class="dd__b dd__b--tags" aria-label={t(lang, 'pf.ways_q')}><span class="tags" data-ways-tags></span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
        <div class="dd__m" role="group" aria-label={t(lang, 'pf.ways_q')}>
          {WAYS.map(([v, n]) => <label class="dd__i"><input type="checkbox" value={v} data-way data-name={n} checked={wayOn(v)} /><span class="dd__box"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"></path></svg></span><span>{n}</span></label>)}
        </div>
      </details>
    </div>
    <div class="qa">
      <p class="qq">{t(lang, 'pf.often_q')}</p>
      <details class="dd" data-pop>
        <summary class="dd__b" aria-label={t(lang, 'pf.often_q')}><span data-o-val>{t(lang, 'pf.o_week')}</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
        <div class="dd__m" role="radiogroup" aria-label={t(lang, 'pf.often_q')}>
          {OFTEN.map(([v, n]) => <label class="dd__i"><input type="radio" name="pf-often" value={v} data-o data-name={n} checked={v === (pr?.frequency ?? 'week')} /><span class="dd__dot"></span><span>{n}</span></label>)}
        </div>
      </details>
    </div>
    <div class="qa">
      <p class="qq">{t(lang, 'pf.gender')}</p>
      <details class="dd" data-pop>
        <summary class="dd__b" aria-label={t(lang, 'pf.gender')}><span data-g-val>—</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
        <div class="dd__m" role="radiogroup" aria-label={t(lang, 'pf.gender')}>
          {([['female', t(lang, 'pf.g_f')], ['male', t(lang, 'pf.g_m')], ['none', t(lang, 'pf.g_n')]] as [string, string][]).map(([v, n]) => (
            <label class="dd__i"><input type="radio" name="pf-gender" value={v} data-g data-name={n} checked={pr?.gender === v} /><span class="dd__dot"></span><span>{n}</span></label>
          ))}
        </div>
      </details>
    </div>
    <p class="pf__saved" data-pf-saved role="status" aria-live="polite" hidden></p>

    <div class="del" data-pf-del>
      <button type="button" class="del__ask" data-del-ask>{t(lang, 'pf.del')}</button>
      <div class="del__box" data-del-box hidden>
        <p class="del__h">{t(lang, 'pf.del_q')}</p>
        <p class="del__s">{t(lang, 'pf.del_s')}</p>
        <p class="del__acts"><button type="button" class="del__go" data-del-go>{t(lang, 'pf.del')}</button><button type="button" class="del__keep" data-del-keep>{t(lang, 'pf.del_keep')}</button></p>
      </div>
      <p class="del__done" data-del-done role="status" hidden></p>
    </div>

    {/* the pencil's answer: a checked detail changes only through the adviser (see the note at the top) */}
    <dialog class="chg" data-pf-dlg aria-labelledby="pf-chg-h">
      <div class="chg__top">
        <p class="chg__h" id="pf-chg-h">{t(lang, 'pf.chg_h')}</p>
        <button type="button" class="chg__x" data-pf-x aria-label={t(lang, 'ui.close')}><svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.4"></path></svg></button>
      </div>
      <p class="chg__s">{t(lang, 'pf.chg_s')}</p>
      <p class="chg__ways"><WaLink /><a href={co.phoneHref}><bdi dir="ltr">{co.phone}</bdi></a></p>
    </dialog>
  </div>
</PanelShell>

<style>
  .pf { padding: 0 0 var(--s9); max-width: 760px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .pf__head { display: flex; align-items: center; gap: 18px; padding: 0 16px 24px; border-bottom: 1px solid var(--line-soft); }
  .pf__ava { width: 72px; height: 72px; flex: none; border-radius: 50%; background: var(--ink); color: var(--paper); display: flex;
    align-items: center; justify-content: center; font-size: var(--fs-s1); font-weight: 600; }
  .pf__id { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pf__nm { margin: 0; display: flex; align-items: center; gap: 10px; font-size: var(--fs-s2); font-weight: 600; letter-spacing: -.012em; line-height: 1.2; }
  .pf__pen { width: 32px; height: 32px; flex: none; display: flex; align-items: center; justify-content: center; border: 0; background: none;
    color: var(--ink); cursor: pointer; transition: background .15s ease; }
  .pf__pen:hover { background: var(--paper-2); }
  .pf__pen:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .pf__ln { margin: 0; font-size: var(--fs-s-1); color: var(--muted); overflow-wrap: anywhere; }
  .none { color: var(--faint); font-style: italic; font-size: var(--fs-s-1); font-weight: 400; }


  /* E3 questions: a hairline above each, the question in bold, the answer under it */
  .qa { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 18px 16px; border-bottom: 1px solid var(--line-soft); }
  .qq { margin: 0; font-size: var(--fs-s0); font-weight: 600; letter-spacing: -.005em; }
  /* the drop-downs (E3 .ddb): a framed button, the menu under it */
  .dd { position: relative; }
  .dd__b { list-style: none; display: inline-flex; align-items: center; gap: 10px; min-height: 34px; padding: 4px 12px; border: 1px solid var(--line);
    background: var(--paper); font-size: var(--fs-s-1); color: var(--ink); cursor: pointer; transition: background .15s ease, border-color .15s ease; }
  .dd__b::-webkit-details-marker { display: none; }
  .dd__b:hover, .dd[open] > .dd__b { background: var(--paper-2); }
  .dd__b:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .dd__b svg { flex: none; transition: transform .2s ease; }
  .dd[open] > .dd__b svg { transform: rotate(180deg); }
  .dd__b--tags { padding-inline-start: 5px; }
  .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  :global(.tag) { background: var(--paper-2); padding: 3px 9px; font-size: var(--fs-s-1); line-height: 1.4; }
  .dd[open] .dd__b--tags :global(.tag) { background: var(--paper); }
  .dd__m { position: absolute; top: calc(100% + 4px); left: 0; z-index: 40; min-width: 220px; padding: 8px 0; background: var(--paper);
    border: 1px solid var(--line); box-shadow: 0 18px 40px rgba(11,14,16,.12); }
  .dd__i { position: relative; display: flex; align-items: center; gap: 12px; padding: 9px 16px; font-size: var(--fs-s-1); color: var(--ink); cursor: pointer; }
  .dd__i:hover { background: var(--paper-2); }
  .dd__i input { position: absolute; opacity: 0; pointer-events: none; }
  .dd__box { flex: none; width: 18px; height: 18px; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: transparent; }
  .dd__i input:checked + .dd__box { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .dd__dot { flex: none; width: 16px; height: 16px; border-radius: 50%; border: 1px solid var(--line); }
  .dd__i input:checked + .dd__dot { border: 5px solid var(--ink); }
  .dd__i:has(input:focus-visible) { outline: 2px solid var(--brand); outline-offset: -2px; }

  .pf__saved { margin: 8px 16px 0; font-size: var(--fs-s-1); color: var(--muted); }


  .del { padding: 18px 16px 0; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .del__ask { all: unset; cursor: pointer; font-size: var(--fs-s-1); color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .del__ask:hover { color: var(--ink); }
  .del__box { border: 1px solid var(--err); padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; max-width: 560px; }
  .del__box[hidden] { display: none; }
  .del__h { margin: 0; font-size: var(--fs-s0); font-weight: 600; }
  .del__s { margin: 0; font-size: var(--fs-s-1); color: var(--ink-2); line-height: 1.55; }
  .del__acts { margin: 0; display: flex; align-items: center; gap: 16px; }
  .del__go { height: 40px; padding: 0 16px; border: 0; background: var(--err); color: #fff; font: inherit; font-size: var(--fs-s-1); font-weight: 600; cursor: pointer; }
  .del__keep { all: unset; cursor: pointer; font-size: var(--fs-s-1); color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .del__done { margin: 0; font-size: var(--fs-s-1); font-weight: 600; }

  .ask { border: 1px solid var(--ink); padding: 20px 22px; margin-top: 24px; }
  .ask__h { margin: 0 0 6px; font-size: var(--fs-s0); font-weight: 600; }
  .ask__s { margin: 0 0 14px; font-size: var(--fs-s-1); color: var(--muted); }

  .chg { width: 420px; max-width: calc(100vw - 32px); padding: 28px 28px 24px; border: 0; background: var(--paper); color: var(--ink); }
  .chg::backdrop { background: rgba(14,18,20,.5); }
  .chg[open] { display: flex; flex-direction: column; gap: 14px; }
  .chg__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .chg__h { margin: 0; font-size: var(--fs-s1); font-weight: 600; line-height: 1.25; }
  .chg__x { background: none; border: 0; padding: 4px; cursor: pointer; display: flex; color: var(--ink); }
  .chg__s { margin: 0; font-size: var(--fs-s-1); line-height: 1.55; color: var(--muted); }
  .chg__ways { margin: 6px 0 0; display: flex; align-items: center; gap: 18px; }
  .chg__ways > a:not(.wab) { color: var(--muted); font-size: var(--fs-s-1); text-decoration: none; }
  .chg__ways > a:not(.wab):hover { color: var(--ink); }
</style>

<script>
  // the pencil opens «how to change your details»; Esc and the backdrop close it (native <dialog>)
  const dlg = document.querySelector<HTMLDialogElement>('[data-pf-dlg]');
  document.querySelector('[data-pf-chg]')?.addEventListener('click', () => dlg?.showModal());
  dlg?.querySelector('[data-pf-x]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  // About you: kept by the CRM since #496 (the page comes filled from it); an older CRM → this browser + a line to the adviser
  const root = document.querySelector<HTMLElement>('[data-pf]');
  const T: Record<string, string> = JSON.parse(root?.dataset.i18n || '{}');
  const KEY = 'hp.prefs';
  const gs = [...(root?.querySelectorAll<HTMLInputElement>('[data-g]') ?? [])];
  const os = [...(root?.querySelectorAll<HTMLInputElement>('[data-o]') ?? [])];
  const pick = (xs: HTMLInputElement[], v: string) => xs.forEach((x) => { x.checked = x.value === v; });
  const val = (xs: HTMLInputElement[]) => xs.find((x) => x.checked)?.value ?? '';
  const ways = [...(root?.querySelectorAll<HTMLInputElement>('[data-way]') ?? [])];
  const inCrm = root?.dataset.crm === '1';
  // a browser copy from before the CRM kept them (until 2026-11-23) is applied here and, with the CRM, sent there once
  let carry = false;
  try {
    const st = JSON.parse(localStorage.getItem(KEY) || 'null');
    carry = inCrm && !!st;
    if (st) {
      if (st.gender) pick(gs, st.gender);
      if (st.often) pick(os, st.often);
      if (Array.isArray(st.ways)) ways.forEach((w) => { w.checked = st.ways.includes(w.value); });
    }
  } catch { /* storage off: the defaults stay */ }
  // what each drop-down shows closed: the chosen ways as small tags, the chosen frequency / gender as text
  const paint = () => {
    const tags = root?.querySelector<HTMLElement>('[data-ways-tags]');
    if (tags) tags.replaceChildren(...ways.filter((w) => w.checked).map((w) => { const s = document.createElement('span'); s.className = 'tag'; s.textContent = w.dataset.name ?? w.value; return s; }));
    const ov = root?.querySelector<HTMLElement>('[data-o-val]'); const oc = os.find((x) => x.checked); if (ov && oc) ov.textContent = oc.dataset.name ?? oc.value;
    const gv = root?.querySelector<HTMLElement>('[data-g-val]'); const gc = gs.find((x) => x.checked); if (gv) gv.textContent = gc ? (gc.dataset.name ?? gc.value) : '—';
  };
  paint();
  [...gs, ...os].forEach((x) => x.addEventListener('change', () => { const d = x.closest('details'); if (d) d.open = false; }));
  [...gs, ...os, ...ways].forEach((x) => x.addEventListener('change', paint));
  const saved = root?.querySelector<HTMLElement>('[data-pf-saved]');
  let timer: number | undefined;
  const save = () => {
    const st = { gender: val(gs), often: val(os) || 'week', ways: ways.filter((w) => w.checked).map((w) => w.value) };
    if (!inCrm) try { localStorage.setItem(KEY, JSON.stringify(st)); } catch { /* storage off */ }
    window.clearTimeout(timer);
    timer = window.setTimeout(async () => {
      try {
        const r = await fetch('/api/panel/request', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type: 'prefs', ...st, lang: document.documentElement.lang }) });
        const j = await r.json().catch(() => ({}));
        if (saved) { saved.textContent = j?.ok ? T.saved : T.fail; saved.hidden = false; }
      } catch { if (saved) { saved.textContent = T.fail; saved.hidden = false; } }
    }, 700);
  };
  [...gs, ...os].forEach((x) => x.addEventListener('change', save));
  ways.forEach((w) => w.addEventListener('change', save));
  if (carry) { paint(); save(); try { localStorage.removeItem(KEY); } catch { /* storage off */ } }

  // Delete my account: asks first; then the adviser gets the request (the site deletes nothing by itself)
  const box = root?.querySelector<HTMLElement>('[data-del-box]');
  root?.querySelector('[data-del-ask]')?.addEventListener('click', () => { if (box) box.hidden = false; });
  root?.querySelector('[data-del-keep]')?.addEventListener('click', () => { if (box) box.hidden = true; });
  root?.querySelector('[data-del-go]')?.addEventListener('click', async () => {
    const done = root.querySelector<HTMLElement>('[data-del-done]')!;
    try {
      const r = await fetch('/api/panel/request', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type: 'delete', lang: document.documentElement.lang }) });
      const j = await r.json().catch(() => ({}));
      done.textContent = j?.ok ? T.del_done : T.fail;
    } catch { done.textContent = T.fail; }
    done.hidden = false;
    if (box) box.hidden = true;
  });
</script>
