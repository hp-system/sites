    .pr__big span, .pr__line { font-size: 13.5px; color: var(--muted); }
    .pr__line { margin: 0; color: var(--ink-2); font-size: 14px; }
    .pr__bars { display: flex; flex-direction: column; gap: 3px; padding-top: 8px; border-top: 1px solid rgba(14,18,20,.10); }
    .pr__bar { display: grid; grid-template-columns: 124px 1fr 72px; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }
    .pr__bar i { display: block; height: 6px; width: var(--w); background: rgba(14,18,20,.16); }
    .pr__bar span:last-child { text-align: end; }
    .pr__bar--on { color: var(--ink); font-weight: 600; }
    .pr__bar--on i { background: var(--ink); }
    .pr__all { margin-top: auto; align-self: flex-end; font-size: 13.5px; color: var(--ink); white-space: nowrap; }
    :global([dir='rtl']) .pr__all span { display: inline-block; transform: scaleX(-1); }

    /* ── Free account: black, flush under the band, big faint lock ── */
    .full { position: relative; overflow: hidden; margin-top: 0; background: var(--ink-deep); padding: 26px 28px;
            grid-template-columns: 1fr auto; gap: 0 28px; align-items: center; }
    .full > div { display: contents; }
    .full__i { display: none; }
    .full__lock { display: block; position: absolute; inset-inline-end: 218px; top: 0; width: 100px; height: 100px; opacity: .07;
                  color: var(--paper); pointer-events: none; will-change: transform; }
    .full__k { display: block; grid-column: 1; margin-bottom: 8px; font-size: 10.5px; letter-spacing: .13em; text-transform: uppercase;
               font-weight: 600; color: rgba(255,255,255,.62); position: relative; }
    .full__h { grid-column: 1; font-size: 26px; font-weight: 300; line-height: 1.2; letter-spacing: -.012em; position: relative; }
    .full__b { grid-column: 2; grid-row: 1 / 3; position: relative; display: inline-flex; align-items: center; height: 46px; padding: 0 22px;
               font-weight: 600; justify-self: end; }
    .full__l { grid-column: 1 / -1; margin: 18px 0 0; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.12);
               display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 20px; font-size: 13.5px; position: relative; }

    /* ── similar: three columns, the hover of the cards on home and the list ── */
    .sim { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; }
    .sim :global(.title) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sim :global(.card:hover .title a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .sim :global(.card img) { transition: transform .4s ease; }
