    .sim :global(.heart) { background: var(--paper); transition: background .2s ease; }
    .sim :global(.heart svg) { width: 16px; height: 16px; transition: transform .25s ease, color .2s ease, fill .25s ease; }
    .sim :global(.card:hover .heart svg), .sim :global(.heart:hover svg) { transform: scale(1.12); color: var(--gold-soft); }
    .sim :global(.heart:hover svg) { fill: var(--gold-soft); }

    /* ── area zone on beige, edge to edge, fills the column to the price box ── */
    .zone { display: block; position: relative; background: var(--paper-2); padding: 20px 24px 16px; margin-top: 40px; flex: 1 0 auto;
            box-shadow: 0 0 0 100vmax var(--paper-2); clip-path: inset(0 -100vmax); }
    .zone__h { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 14px; }
