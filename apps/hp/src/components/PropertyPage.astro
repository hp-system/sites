---
// ═══════════════════════════════════════════════════════════════════════════
// Η ΚΑΡΤΕΛΑ ΑΚΙΝΗΤΟΥ — Πρόταση Β, εγκεκριμένη από τον George (30/7).
//
// 📐 Η ΔΟΜΗ ΒΓΗΚΕ ΑΠΟ ΤΗΝ ΚΡΙΣΗ ΤΟΥ, ΟΧΙ ΑΠΟ ΓΟΥΣΤΟ:
//   «πουλάμε ακριβά ακίνητα… το κλειδί είναι οι μεγάλες φωτογραφίες»
//   → η γκαλερί πιάνει ΟΛΟ το πλάτος· το περιεχόμενο σπάει σε στήλες ΜΕΤΑ.
//
// 📊 ΚΑΙ ΑΠΟ ΤΑ ΔΕΔΟΜΕΝΑ (logs 10 ημερών + μετρητές ζωής 60 ακινήτων):
//   ✂️ βιντεοκλήση 0 κρατήσεις · callback 3 · καμπανάκι τιμής 2 → ΕΞΩ
//   ✅ why-register 3.074 · 196 saves/282.790 views (43 στα 60 ακίνητα) → ΜΕΣΑ
//
// 🛡️ Ο ΚΑΝΟΝΑΣ ΤΟΥ GATE ΕΙΝΑΙ ΑΥΣΤΗΡΟΤΕΡΟΣ ΕΔΩ ΑΠΟ ΠΑΝΤΟΥ. Το API δίνει
//    `lat`/`lng`/`address`/`area`. ΤΙΠΟΤΑ από αυτά δεν μπαίνει στη σελίδα για μη
//    συνδεδεμένο — ούτε στο JSON-LD, ούτε σε alt, ούτε σε σχόλιο. Ο χάρτης δεν
//    «θολώνει» συντεταγμένες: **δεν τις τυπώνει καθόλου**. Θόλωμα με CSS είναι
//    διακόσμηση — ό,τι υπάρχει στο HTML το διαβάζει ο καθένας.
// ═══════════════════════════════════════════════════════════════════════════
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Footer from './Footer.astro';
import PropertyCard from './PropertyCard.astro';
import CallBack from './CallBack.astro';
import { privacyPath } from '../lib/legal';
import type { SiteProperty } from '../lib/api';
import { refOf, priceOf, priceVisible, pick } from '../lib/api';
import { viewerOf, muniKey, municipalityOf, placeOf } from '../lib/gate';
import { memberOf } from '../lib/member';
import { coverOf, orderedPhotos, isPhotoOpen, blurSrc, marked, markedSrcSet, markedSrcSetSmall,
         altOf, shareImage, SHARE_W, SHARE_H, heroReady } from '../lib/photos';
import { priceTables } from '../lib/prices';
import { DIAL, flag } from '../lib/callback';
import { money, num, sqm as sqmFmt, seaLabel, clamp } from '../lib/format';
import { prefix, propertyUrl, listUrl, t, type Lang } from '../lib/i18n';
import { rentalUrl } from '../lib/contact';
import { company } from '../lib/company';
import { ui, facetUrl, FACETS, PAIRS, catKey } from '../lib/listing';
import { AREA_PAGES, areaUrl } from '../content/areas/en';
import { brand } from '../brand/index';
import {
  conditionOf, plotSqmOf,
  descriptionOf, featuresOf, featureIcon, spacesOf, distancesOf,
  energyOf, oldPriceOf, floorName, pui, subName, poiName, seaDistanceText, schemaTypesOf, isLand, landFactsOf,
  isBusiness, homeFactsOf, businessFactsOf, bizSqmOf,
  CIRCLE_M, mapViewOf, videosOf, embedOf, documentsOf, priceHistoryOf, addressOf,
} from '../lib/property';

interface Props { lang: Lang; item: SiteProperty; all: SiteProperty[] }
const { lang, item, all } = Astro.props;

const viewer = await viewerOf(Astro.cookies);
// Favourite state for a signed-in member (#59) and the forms' prefill (#64): from the same
// cached `/member/me` call. Only the member's own details, only on their own request.
const meFav = viewer.member ? await memberOf(Astro.cookies.get('member_token')?.value) : null;
const co = await company();
const a = item.attributes ?? {};
const id = refOf(item);

// ── ΤΑΥΤΟΤΗΤΑ ──────────────────────────────────────────────────────────────
const sub = subName(a, lang);                     // #88: the site's own name where the CRM has none
const muni = municipalityOf(a, lang);
// #88: the municipality from the site's 9-language facets (the CRM gives ru the Bulgarian name)
const muniOwn = FACETS.find((f) => f.q.municipality === muniKey(a))?.name[lang] || muni;
const placeRaw = placeOf(a, lang, viewer);       // δήμος σε επισκέπτη, περιοχή σε μέλος
const place = placeRaw === muni ? muniOwn : placeRaw;
const heading = place ? `${sub} — ${place}` : sub;

const cover = coverOf(a);
const ordered = orderedPhotos(a);

// 🔒 ΠΟΙΕΣ ΦΩΤΟΓΡΑΦΙΕΣ ΒΛΕΠΕΙ ΠΟΙΟΣ — ΑΛΛΑΞΕ 6/8.
//
//    ΠΡΙΝ: ο επισκέπτης έπαιρνε τις 4 πρώτες και οι υπόλοιπες **δεν υπήρχαν** στη
//    σελίδα· ένα πλακίδιο έλεγε «έχετε άλλες 13».
//    ΤΩΡΑ (George 6/8): «Οι υπόλοιπες θα φαίνονται blurred όπως τώρα στο website
//    μας» — άρα εμφανίζονται ΟΛΕΣ, οι κλειδωμένες κατεστραμμένες.
//    Και: «θα κάνουμε επιλογή εμείς ανοιχτές και κλειστές στο photo review» —
//    γι' αυτό η κρίση είναι **ανά φωτογραφία** (`isPhotoOpen`), όχι πλήθος.
//    Μέχρι να υπάρξει το πεδίο, το `isPhotoOpen` κρατά τη ρύθμιση των 4.
//
// 🔴 ΤΟ ΚΡΙΣΙΜΟ: η κλειδωμένη ΔΕΝ είναι η κανονική φωτογραφία με εφέ θολώματος.
//    Είναι άλλο αρχείο, 24 pixel, από τον διακομιστή μας. Δες `lib/blur.ts` —
//    ως τις 6/8 σερβίραμε την πραγματική 800άρα και τη θολώναμε με CSS, δηλαδή
//    ο πηγαίος κώδικας έδινε τη διεύθυνσή της σε όποιον κοίταζε.
const gallery = ordered.map((p, i) => ({ p, i, open: viewer.member || isPhotoOpen(p, i) }));
const hidden = gallery.filter((g) => !g.open).length;
const lockAt = gallery.findIndex((g) => !g.open);   // πού κάθεται η προτροπή

const price = priceOf(a);
const priceOk = priceVisible(a, viewer.exclusive);
const oldPrice = oldPriceOf(a);
// Το επαγγελματικό γράφει το εμβαδόν στο `biz_sq_meters` — χωρίς αυτό, ξενοδοχείο χωρίς τ.μ.
const sqmN = Number(a.sqm ?? 0) || bizSqmOf(a);
const perSqm = priceOk && price > 0 && sqmN > 0 ? Math.round(price / sqmN) : null;

const feats = featuresOf(a, lang);
const spaces = spacesOf(a);
const dists = distancesOf(a);
const energy = energyOf(a, lang);
const desc = descriptionOf(a, lang);
const sea = seaLabel(a.sea_access, lang);
const rental = rentalUrl(id);

// ── ΠΑΡΟΜΟΙΑ: ίδιος δήμος, ίδιο είδος, κοντινή τιμή. Χωρίς το ίδιο το ακίνητο.
const myMuni = muniKey(a);
// Six, not three (George 21/10/2026, after comparing #7729 with the live page, which shows 11):
// same kind in the same municipality first, then the same kind elsewhere — nearest price first.
const byPrice = (x: SiteProperty, y: SiteProperty) =>
  Math.abs(priceOf(x.attributes ?? {}) - price) - Math.abs(priceOf(y.attributes ?? {}) - price);
const sameKind = all.filter((p) => refOf(p) !== id && String(p.attributes?.subcategory ?? '') === String(a.subcategory ?? ''));
const similar = [
  ...sameKind.filter((p) => muniKey(p.attributes ?? {}) === myMuni).sort(byPrice),
  ...sameKind.filter((p) => muniKey(p.attributes ?? {}) !== myMuni).sort(byPrice),
].slice(0, 6);

// ── Luxury badge and the municipality block (#79) ──────────────────────────
const luxury = a.luxury === true;
const muniArea = AREA_PAGES.find((x) => x.kind === 'municipality' && x.q.municipality === myMuni);
const muniList = FACETS.find((f) => f.q.municipality === myMuni);
// the facet carries the name in every language; the CRM's own translation may be missing.
const muniName = muniList?.name[lang] || muni;

// ── SEO ────────────────────────────────────────────────────────────────────
const pathFor = (l: Lang) => propertyUrl(l, id);
const privacyHref = privacyPath(lang);            // the policy in the page language (#94)
// #88: as the old site — "Detached house for sale in Kassandra, Halkidiki, Greece | #7729" — per language.
const title = muniOwn ? pui(lang, 'seoTitle', { t: sub, m: muniOwn, id }) : pui(lang, 'seoTitleNoM', { t: sub, id });
// 🪤 ΤΟ ΙΔΙΟ STRING ΠΑΕΙ ΚΑΙ ΣΤΟ JSON-LD παρακάτω — άρα το κόψιμο πρέπει να είναι
//    σωστό ΜΙΑ φορά, εδώ. Το σκέτο `.slice()` έκοβε στη μέση λέξης («…newly built co»).
const metaDesc = clamp(desc || heading, 155);
const share = shareImage(cover);
const here = pathFor(lang);

// 🛡️ ΤΟ JSON-LD ΔΕΝ ΚΟΥΒΑΛΑ ΘΕΣΗ. Το schema.org δέχεται `geo` και `address` —
//    και ακριβώς γι' αυτό είναι το πιο εύκολο σημείο να διαρρεύσει η τοποθεσία
//    χωρίς να το προσέξει κανείς: δεν φαίνεται στη σελίδα, αλλά είναι στο HTML.
//    Δηλώνουμε ΜΟΝΟ τον δήμο, που είναι έτσι κι αλλιώς δημόσιος.
const SITE_ORIGIN = Astro.site?.toString().replace(/\/$/, '') ?? '';
const abs = (x: string) => SITE_ORIGIN + encodeURI(x);

const land = isLand(a);
const biz = !land && isBusiness(a);
// ── ΧΑΡΤΗΣ ΚΑΙ EXCLUSIVE (#53) — ΜΟΝΟ για μέλη· ο επισκέπτης δεν παίρνει ούτε αριθμό.
const mapView = viewer.member ? mapViewOf(a, viewer.exclusive) : null;
const xVideos = viewer.exclusive ? videosOf(a) : [];
const xDocs = viewer.exclusive ? documentsOf(a) : [];
const xHistory = viewer.exclusive ? priceHistoryOf(a) : [];
const xAddress = viewer.exclusive ? addressOf(a) : '';
const hasExclusive = xVideos.length + xDocs.length + xHistory.length > 0 || !!xAddress;
// Τρία είδη, τρεις λίστες (#45): γη · επαγγελματικό/ξενοδοχείο · κατοικία.
const facts = land ? landFactsOf(a, lang) : biz ? businessFactsOf(a, lang) : homeFactsOf(a, lang);

const types = schemaTypesOf(a);
const isAccommodation = types.length > 1;          // η γη μένει σκέτο Product

// 🍞 ΤΟ BREADCRUMB ΕΛΕΙΠΕ ΕΝΤΕΛΩΣ από τα δομημένα δεδομένα, ενώ υπάρχει **ορατό**
//    στη σελίδα. Είναι αυτό που δίνει στη Google τη γραμμή διαδρομής κάτω από τον
//    τίτλο αντί για γυμνή διεύθυνση. Το τελευταίο σκαλί ΔΕΝ έχει `item`: είναι η
//    σελίδα στην οποία ήδη στέκεσαι.
const muniFacet = FACETS.find((f) => f.q.municipality === myMuni);
const crumbs: { name: string; url?: string }[] = [
  { name: brand.name, url: prefix(lang) || '/' },
  { name: ui(lang, 'all'), url: listUrl(lang) },
  ...(muniFacet ? [{ name: muniFacet.name[lang], url: facetUrl(lang, muniFacet.key) }] : []),
  { name: `#${id}` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name,
      ...(c.url ? { item: abs(c.url) } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': types,
    '@id': `${abs(here)}#listing`,
    name: title,
    description: metaDesc,
    url: abs(here),
    sku: id,
    ...(share ? { image: share } : {}),
    address: { '@type': 'PostalAddress', addressRegion: muni, addressCountry: brand.address.country },
    ...(sqmN > 0
      ? (isAccommodation
        ? { floorSize: { '@type': 'QuantitativeValue', value: sqmN, unitCode: 'MTK' } }
        : { additionalProperty: { '@type': 'PropertyValue', name: 'Plot area', value: sqmN, unitCode: 'MTK' } })
      : {}),
    ...(isAccommodation && Number(a.bedrooms) > 0
      ? { numberOfBedrooms: Number(a.bedrooms), numberOfRooms: Number(a.bedrooms) }
      : {}),
    ...(priceOk && price > 0 ? {
      offers: {
        '@type': 'Offer', price, priceCurrency: brand.market.currency,
        availability: 'https://schema.org/InStock', url: abs(here),
        seller: { '@type': 'RealEstateAgent', name: brand.name },
      },
    } : {}),
  },
];

const munis = [...new Set(all.map((p) => muniKey(p.attributes ?? {})).filter(Boolean))].slice(0, 4)
  .map((k) => {
    const src = all.find((p) => muniKey(p.attributes ?? {}) === k);
    return { name: municipalityOf(src?.attributes ?? {}, lang) || k, key: k };
  });

const loginHref = `${prefix(lang)}/login?next=${encodeURIComponent(here)}`;

// ═══ DESKTOP REDESIGN (#103, approved by George 2026-11-02) ═══════════════════
// Everything below feeds elements that show only at ≥1024px; phones keep George's layout.
// 🔒 Same gate as the rest of the page: guests get the municipality only, never the area.

// Highlight chips — only what the data says. The sea chip is George's sea label
// (front / walking / nearby). «Exclusive access to the beach» and «Sea view» need a feature
// that says so; the CRM sends none today (checked 2026-11-02 on all 525 listings).
const featText = feats.map((f) => `${f.slug ?? ''} ${f.label}`.toLowerCase()).join(' | ');
const highlights = [
  ...(sea ? [{ k: 'sea', label: sea }] : []),
  ...(/exclusive access to the beach|αποκλειστικ\S* πρόσβαση/.test(featText) ? [{ k: 'beach', label: pui(lang, 'beachAccess') }] : []),
  ...(/\bsea[ _-]?view\b|θέα (στη |προς τη )?θάλασσα/.test(featText) ? [{ k: 'view', label: pui(lang, 'seaView') }] : []),
];
// Desktop six-fact row (Sergei 01/11): living area · bedrooms · to the sea · energy class · plot · condition.
const plotN = !land && !biz ? plotSqmOf(a) : 0;
const seaTxt = seaDistanceText(a, lang, num) ?? sea;
const sheet = land || biz ? [] : [
  ...(sqmN > 0 ? [{ k: pui(lang, 'livAreaL'), v: sqmFmt(sqmN, lang), n: true }] : []),
  ...(Number(a.bedrooms) > 0 ? [{ k: pui(lang, 'bedsL'), v: String(a.bedrooms), n: true }] : []),
  ...(seaTxt ? [{ k: pui(lang, 'toSeaL'), v: seaTxt, n: true }] : []),
  ...(energy ? [{ k: pui(lang, 'energyClsL'), v: energy, n: false }] : []),
  ...(plotN > 0 ? [{ k: pui(lang, 'plotL'), v: sqmFmt(plotN, lang), n: true }] : []),
  ...(conditionOf(a, lang) ? [{ k: pui(lang, 'condL'), v: conditionOf(a, lang), n: false }] : []),
];
const FEAT_SHOWN = 11;                       // «All N features» after 11, the button is the 12th cell
const featsMore = feats.length > FEAT_SHOWN + 1;

// Photo order for the popup is the gallery's (`gallery`) — same index → same blurred file.
const nPhotos = gallery.length;

// Country-code picker: George's DIAL list; the names in the page language from the runtime.
const regionName = (() => {
  try { const d = new Intl.DisplayNames([lang], { type: 'region' }); return (cc: string) => d.of(cc) ?? cc; }
  catch { return (cc: string) => cc; }
})();
const dial = DIAL.map((d) => ({ ...d, name: regionName(d.cc), flag: flag(d.cc) }));

// Price guide of the municipality (George's live guide, lib/prices.ts — the same numbers as
// /en/halkidiki-property-prices). Municipalities only: the guide's area rows stay off this page.
const guide = priceTables(all, lang);
const gHome = guide.homes.find((r) => r.key === myMuni);
const gLand = guide.land.find((r) => r.key === myMuni);
const gMax = Math.max(1, ...guide.homes.map((r) => r.perSqm));
const gMonth = new Date().toLocaleDateString(lang, { month: 'long', year: 'numeric' });
const pricesHref = '/en/halkidiki-property-prices';

// One photo per tile: the best cover of a listing that matches (watermarked, never this one).
const usedPh = new Set<string>([item.id]);
const pickPhoto = (keep: (x: SiteProperty) => boolean) => {
  const pool = all.filter((p) => !usedPh.has(p.id) && keep(p));
  const hit = pool.filter((p) => heroReady(p.attributes) && priceVisible(p.attributes ?? {}))
    .sort((x, y) => priceOf(y.attributes ?? {}) - priceOf(x.attributes ?? {}))[0] ?? pool[0];
  if (hit) usedPh.add(hit.id);
  return hit ? coverOf(hit.attributes ?? {}) : null;
};
const inMuni = (k: string) => (p: SiteProperty) => muniKey(p.attributes ?? {}) === k;
// About band photo: a seafront/view cover from the same municipality.
const bandPhoto = myMuni ? pickPhoto((p) => inMuni(myMuni)(p) && (p.attributes?.sea_access === 'front')) ?? pickPhoto(inMuni(myMuni)) : null;

// Area zone («Property for sale in Halkidiki»): links that are not elsewhere on the page —
// the municipality's two topic pages, the other municipalities, homes / land, Greece.
type ZoneCard = { t: string; href: string; photo: ReturnType<typeof coverOf>; about?: string };
const zone: ZoneCard[] = [];
for (const [m, k] of PAIRS) {
  if (muniFacet && m === muniFacet.key) {
    const f = FACETS.find((x) => x.key === k);
    const q = f?.q ?? {};
    const photo = pickPhoto((p) => inMuni(myMuni)(p) && (q.luxury ? p.attributes?.luxury === true : p.attributes?.sea_access === 'front'));
    if (f && photo) zone.push({ t: `${f.name[lang]} — ${muniFacet.name[lang]}`, href: facetUrl(lang, m, k), photo });
  }
}
for (const f of FACETS.filter((x) => x.q.municipality && x.q.municipality !== myMuni)) {
  const ap = AREA_PAGES.find((x) => x.kind === 'municipality' && x.q.municipality === f.q.municipality);
  const photo = pickPhoto(inMuni(f.q.municipality as string));
  if (photo) zone.push({ t: f.name[lang], href: facetUrl(lang, f.key), photo, about: lang === 'en' && ap ? areaUrl(ap.slug) : undefined });
}
for (const k of ['homes', 'land']) {
  const f = FACETS.find((x) => x.key === k);
  const photo = f && pickPhoto((p) => catKey(p.attributes ?? {}) === f.q.category);
  if (f && photo) zone.push({ t: f.name[lang], href: facetUrl(lang, k), photo });
}
{
  const photo = pickPhoto(() => true);
  if (photo) zone.push({ t: t(lang, 'home.greece'), href: '/en/property-for-sale-in-greece', photo });
}
const zonePages = Math.max(1, Math.ceil(zone.length / 3));
// Το WhatsApp ανοίγει με έτοιμο μήνυμα — ο agent ξέρει αμέσως για ποιο μιλάμε.
const waText = encodeURIComponent(pui(lang, 'interest', { id }));
// 📱 Ξεχωριστός αριθμός WhatsApp όταν δηλωθεί· αλλιώς το σταθερό.
const waHref = `https://wa.me/${co.whatsappE164.replace('+', '')}?text=${waText}`;
---
<Base lang={lang} title={title} description={metaDesc} pathFor={pathFor} jsonLd={jsonLd}
      ogImage={share} ogImageW={SHARE_W} ogImageH={SHARE_H} ogImageAlt={altOf(cover, lang, heading)}>
  <Header lang={lang} solid pathFor={pathFor} />
  <MobileMenu lang={lang} pathFor={pathFor} munis={munis.map((m) => ({ name: m.name, n: 0, key: m.key }))} total={all.length} />

  <main id="main" class="prop">
    <div class="wrap">
      <nav class="crumb" aria-label="breadcrumb">
        <a href={prefix(lang) || '/'}>{brand.name}</a>
        <span aria-hidden="true">·</span>
        <a href={listUrl(lang)}>{ui(lang, 'all')}</a>
        <span aria-hidden="true">·</span>
        {/* #103 (SEO): the municipality level, as in the BreadcrumbList JSON-LD. */}
        {muniFacet && (<><a href={facetUrl(lang, muniFacet.key)}>{muniFacet.name[lang]}</a><span aria-hidden="true">·</span></>)}
        <span aria-current="page">#{id}</span>
      </nav>

      <div class="tt">
        <div class="tt__l">
          <h1 class="t-h2 tt__h">{heading}</h1>
          {luxury && <span class="lux">{pui(lang, 'luxury')}</span>}
          {/* Ο κλειδωμένος τόπος δηλώνεται ΡΗΤΑ — ο επισκέπτης πρέπει να ξέρει
              ότι υπάρχει κάτι πιο συγκεκριμένο, αλλιώς νομίζει ότι αυτό είναι όλο. */}
          {!viewer.member && (
            <a class="chip p-gild" href={loginHref} data-ev="register:unlock_area"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10.5" rx="1"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>{pui(lang, 'lockChip')}</a>
          )}
        </div>
        <div class="tt__r">
          {/* 📊 ΟΙ ΠΡΟΒΟΛΕΣ ΜΕΝΟΥΝ, ΟΙ ΑΠΟΘΗΚΕΥΣΕΙΣ ΕΠΕΣΤΡΕΨΑΝ.
              Είχα προτείνει να κοπεί ο μετρητής αποθηκεύσεων· ο George διαφώνησε
              και ζήτησε 3 μήνες δεδομένα. Δεν υπάρχουν (ο διακομιστής κρατά 10
              μέρες), οπότε μετρήθηκαν οι ΜΕΤΡΗΤΕΣ ΖΩΗΣ σε 60 ακίνητα:
              196 αποθηκεύσεις / 282.790 προβολές, 43 στα 60 με τουλάχιστον μία.
              Είχε δίκιο. ⏭️ Οι πραγματικοί μετρητές έρχονται από το EALIDA (Φ2)·
              μέχρι τότε δεν τυπώνεται ΨΕΥΤΙΚΟΣ αριθμός — απλώς λείπει. */}
          {meFav ? (
            /* Member: a real toggle (#59). Guest: the same look, but it leads to sign-up. */
            <button class="btn btn--fav" id="fav" type="button" data-ref={id} aria-pressed={meFav.favorites.includes(id) ? 'true' : 'false'}
                    data-on={pui(lang, 'saved')} data-off={pui(lang, 'favorite')} data-ev="member:favorite_property">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 21C7 16.6 3 13.3 3 9.3A4.6 4.6 0 0 1 12 7.6 4.6 4.6 0 0 1 21 9.3c0 4-4 7.3-9 11.7Z"/></svg>
              <span>{pui(lang, meFav.favorites.includes(id) ? 'saved' : 'favorite')}</span>
            </button>
          ) : (
            <a class="btn btn--fav" href={loginHref} data-ev="member:favorite_property">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 21C7 16.6 3 13.3 3 9.3A4.6 4.6 0 0 1 12 7.6 4.6 4.6 0 0 1 21 9.3c0 4-4 7.3-9 11.7Z"/></svg>
              {pui(lang, 'favorite')}
            </a>
          )}
          <button class="btn" id="share" type="button" data-copied={pui(lang, 'copied')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="6" cy="12" r="2.4"/><circle cx="18" cy="6" r="2.4"/><circle cx="18" cy="18" r="2.4"/><path d="M8 11l8-4M8 13l8 4"/></svg>
            {pui(lang, 'shareL')}
          </button>
        </div>
      </div>
    </div>

    {/* ═══ ΓΚΑΛΕΡΙ — ΟΛΟ ΤΟ ΠΛΑΤΟΣ ═══════════════════════════════════════
        DESKTOP: μία μεγάλη + τέσσερα πλακίδια.
        ΚΙΝΗΤΟ: **ΜΙΑ φωτογραφία που σύρεται** — ρητή οδηγία George (30/7):
        «στο κινητό θα φαίνεται μόνο μια φωτογραφία και θα κάνει swap και όχι
        πολλές». Ίδιο HTML, άλλη διάταξη: σε στενή οθόνη η ίδια σειρά γίνεται
        ράγα με scroll-snap. Καμία διπλή απόδοση, καμία δεύτερη γκαλερί. */}
    {/* 🪤 ΤΟ `sizes` ΕΛΕΓΕ 60vw/20vw ΕΝΩ ΤΑ ΠΛΑΚΙΔΙΑ ΕΙΝΑΙ 592/296px.
        Το πλέγμα είναι `2fr 1fr 1fr` μέσα σε στήλη 1.200: μεγάλο 592, μικρά 296.
        Το 20vw σε οθόνη 1280 δίνει 256 — δηλαδή δήλωνα στον browser ΜΙΚΡΟΤΕΡΗ
        ανάγκη από την πραγματική, και πάνω από 1280 η απόκλιση μεγαλώνει επειδή
        η στήλη ΔΕΝ μεγαλώνει (κόβεται στα 1.200) ενώ το vw συνεχίζει.
        Τώρα δηλώνονται τα πραγματικά pixel — «το κλειδί είναι οι μεγάλες
        φωτογραφίες» (George), και αυτό αρχίζει από το να ζητάμε το σωστό αρχείο. */}
    <div class="galwrap">
      <div class="gal" id="gal">
        {gallery.map(({ p, i, open }) => (
          <a class:list={['cell', !open && 'cell--locked']} href={loginHref} data-gi={i}
             data-ev={open ? 'property:photo_open' : 'register:unlock_photos'}
             aria-label={open ? altOf(p, lang, heading) : pui(lang, 'morePhotos', { n: hidden })}>
            {open ? (
              <img src={marked(p.url, i === 0 ? 1920 : 800)} srcset={markedSrcSet(p.url)}
                   sizes={i === 0
                     ? '(min-width: 1024px) 50vw, (min-width: 900px) calc(50vw - 48px), 100vw'
                     : '(min-width: 1024px) 25vw, (min-width: 900px) calc(25vw - 24px), 100vw'}
                   alt={i === 0 ? altOf(p, lang, heading) : ''} width="800" height="533"
                   loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            ) : (
              /* 24 pixel από τον δικό μας διακομιστή. Καμία διεύθυνση της
                 πραγματικής φωτογραφίας δεν γράφεται στη σελίδα. Χωρίς srcset:
                 δεν υπάρχει δεύτερο μέγεθος να ζητηθεί, ούτε λόγος να υπάρξει. */
              <img src={blurSrc(id, i)} alt="" width="800" height="533"
                   loading="lazy" decoding="async" aria-hidden="true" />
            )}
            {i === lockAt && (
              /* Η προτροπή κάθεται πάνω στην ΠΡΩΤΗ κλειδωμένη — δηλαδή ακριβώς
                 εκεί που κόβεται η δωρεάν θέα, όχι σε ξεχωριστό πλακίδιο. */
              <span class="lockover">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10.5" rx="1"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
                <b>{pui(lang, 'morePhotos', { n: hidden })}</b>
                <em data-reg>{pui(lang, 'freeReg')}</em>
              </span>
            )}
            {!open && i !== lockAt && (
              /* 🪤 ΧΩΡΙΣ ΑΥΤΟ, οι υπόλοιπες κλειδωμένες είναι σκέτες θολούρες.
                 Στο κινητό ο επισκέπτης σέρνει και βλέπει 12 θαμπές εικόνες χωρίς
                 καμία εξήγηση — διαβάζεται ως **χαλασμένη σελίδα**, όχι ως
                 κλείδωμα, και η θολή φωτογραφία χάνει τη μόνη δουλειά που έχει:
                 να δείχνει ότι υπάρχει κάτι από κάτω. Μια κλειδαριά αρκεί. */
              <span class="lockmark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="10.5" width="16" height="10.5" rx="1"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
              </span>
            )}
          </a>
        ))}
      </div>
      {/* Οι τελίτσες φαίνονται ΜΟΝΟ στο κινητό, όπου η γκαλερί είναι ράγα.
          🪤 ΔΙΚΟ ΤΟΥΣ ΟΝΟΜΑ, ΟΧΙ ΣΚΕΤΟ `.dots`. Οι κάρτες «παρόμοια ακίνητα»
             στο κάτω μέρος έχουν κι εκείνες `.dots i` — το script έπιανε ΚΑΙ
             αυτές: μετρούσε 17 τελίτσες αντί για 5, και θα κουνούσε το σημάδι
             σε ξένες κάρτες σπάζοντας το δικό τους. Το CSS δεν το έδειξε
             (ο Astro το απομονώνει), το JavaScript όμως ΔΕΝ απομονώνεται. */}
      <span class="dots" id="galdots" aria-hidden="true">
        {Array.from({ length: gallery.length }).map((_, i) => (
          <i data-on={i === 0 ? '' : undefined}></i>
        ))}
      </span>
    </div>

    <div class="wrap">
      <div class="cols">
        <div class="main">
          {/* ΓΡΑΜΜΗ ΒΑΣΙΚΩΝ — χωρίς έτος (George: «δεν με ενδιαφέρει»). */}
          {/* #103: H2 «Details» for search engines (hidden on screen) + the highlight chips (desktop). */}
          <h2 class="sr-only">{pui(lang, 'detailsH')}</h2>
          <div class="hl">
            {highlights.map((h) => (
              <span class="hl__c">
                {h.k === 'sea' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 12c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 17c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/></svg>}
                {h.k === 'beach' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11a9 9 0 0 1 18 0z"/><path d="M12 11v10"/><path d="M2 21h20"/></svg>}
                {h.k === 'view' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.6"/></svg>}
                {h.label}
              </span>
            ))}
          </div>
          <div class:list={['strip', sheet.length > 0 && 'strip--ph']}>
            {sqmN > 0 && <div><b class="num">{sqmFmt(sqmN, lang)}</b><span>{pui(lang, 'sqmL')}</span></div>}
            {/* 🪤 ΥΠΝΟΔΩΜΑΤΙΑ ΣΕ ΧΩΡΑΦΙ. Η γη είναι το **40%** του καταλόγου (207 από 517)
                και έδειχνε τα ίδια κουτιά με μια βίλα. Όπου η βάση είχε τυχαία τιμή,
                ο επισκέπτης διάβαζε «2 υπνοδωμάτια» σε αγροτεμάχιο. */}
            {!land && Number(a.bedrooms) > 0 && <div><b class="num">{a.bedrooms}</b><span>{pui(lang, 'bedsL')}</span></div>}
            {!land && Number(a.bathrooms) > 0 && <div><b class="num">{a.bathrooms}{Number(a.wc) > 0 ? ' + WC' : ''}</b><span>{pui(lang, 'bathsL')}</span></div>}
            {/* Ο ΑΡΙΘΜΟΣ, ΟΧΙ Ο ΧΑΡΑΚΤΗΡΙΣΜΟΣ. Έγραφε «Μπροστά στη θάλασσα» με
                ετικέτα «Από θάλασσα» — η ίδια πληροφορία δύο φορές, και μάλιστα
                η αόριστη εκδοχή της. Το «14 μ.» δεν το αμφισβητεί κανείς.
                Ο χαρακτηρισμός μένει ως εφεδρεία όταν λείπει η μέτρηση. */}
            {(seaDistanceText(a, lang, num) ?? sea) && (
              <div><b class="num">{seaDistanceText(a, lang, num) ?? sea}</b><span>{pui(lang, 'seaL')}</span></div>
            )}
            {!land && energy && <div><b>{energy}</b><span>{pui(lang, 'energyL')}</span></div>}
          </div>

          {/* Desktop, homes (Sergei 01/11 mockup): six facts in one row in this order, no list below.
              A cell without data is left out; land and hotels keep the strip + list above. */}
          {sheet.length > 0 && (
            <div class="strip strip6">
              {sheet.map((c) => <div><b class:list={[c.n && 'num']}>{c.v}</b><span>{c.k}</span></div>)}
            </div>
          )}

          {facts.length > 0 && (
            /* Ό,τι ρωτάει πρώτο όποιος αγοράζει γη: χτίζεται; τι δρόμο έχει;
               ρεύμα, νερό; Η ίδια σειρά με το σημερινό site. Για σπίτι: κατάσταση,
               θέρμανση, στάθμευση· για ξενοδοχείο: αστέρια, δωμάτια, κλίνες (#45). */
            <dl class:list={['lfacts', sheet.length > 0 && 'lfacts--ph']}>
              {facts.map((f) => (
                <div class="lfact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
              ))}
            </dl>
          )}

          {desc && (<>
            <h2 class="sec">{pui(lang, 'desc')}</h2>
            <p class="desc">{desc}</p>
          </>)}

          {feats.length > 0 && (<>
            <h2 class="sec">{pui(lang, 'feats')}</h2>
            <ul class:list={['feats', featsMore && 'feats--more']} id="feats">
              {feats.map((f) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d={featureIcon(f)} /></svg>
                  <span>{f.label}</span>
                </li>
              ))}
              {featsMore && (
                <li class="feats__all">
                  <button type="button" class="fall" aria-controls="feats" aria-expanded="false"
                          data-more={pui(lang, 'allFeats', { n: feats.length })} data-less={pui(lang, 'fewerFeats')}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4zM8 12h8M12 8v8"/></svg>
                    <span>{pui(lang, 'allFeats', { n: feats.length })}</span>
                  </button>
                </li>
              )}
            </ul>
          </>)}

          {spaces.length > 0 && (<>
            <h2 class="sec">{pui(lang, 'floors')}</h2>
            <div class="floors">
              {spaces.map((s) => (
                <div class="fl">
                  <b class="fl__h">{floorName(lang, s.level + 1)}</b>
                  <dl>
                    {Number(s.level_sqm) > 0 && (<><dt>{pui(lang, 'sqmL')}</dt><dd class="num">{sqmFmt(Number(s.level_sqm), lang)}</dd></>)}
                    {Number(s.rooms) > 0 && (<><dt>{pui(lang, 'roomsL')}</dt><dd class="num">{s.rooms}</dd></>)}
                    {Number(s.living_rooms) > 0 && (<><dt>{pui(lang, 'livingL')}</dt><dd class="num">{s.living_rooms}</dd></>)}
                    {Number(s.bathrooms) > 0 && (<><dt>{pui(lang, 'bathsL')}</dt><dd class="num">{s.bathrooms}</dd></>)}
                    {Number(s.wc) > 0 && (<><dt>{pui(lang, 'wcL')}</dt><dd class="num">{s.wc}</dd></>)}
                  </dl>
                </div>
              ))}
            </div>
          </>)}

          {/* ═══ ΤΟΠΟΘΕΣΙΑ — ΤΟ ΔΕΥΤΕΡΟ ΣΠΡΩΞΙΜΟ ══════════════════════════
              🛡️ ΚΑΜΙΑ ΣΥΝΤΕΤΑΓΜΕΝΗ ΣΤΟ HTML. Δεν υπάρχει χάρτης που «θολώνει»:
              υπάρχει πλαίσιο που ΔΕΝ περιέχει τη θέση. Οι αποστάσεις όμως
              φαίνονται — δίνουν αξία χωρίς να προδίδουν το σημείο. */}
          <h2 class="sec">{pui(lang, 'location')}</h2>
          {viewer.member && <p class="place">{place}{muni && place !== muni ? ` · ${muni}` : ''}</p>}
          {/* #103: map (members) or the lock (guests) with the distances as a «Nearby» panel on desktop.
              Every distance is in the HTML at load; the panel only shows/hides them. */}
          <div class:list={['loc', dists.length > 0 && 'loc--near', viewer.member && !mapView && 'loc--nomap']} id="loc">
            {viewer.member ? (<>
              {mapView && (
                /* Μέλος: κύκλος 2 χλμ γύρω από το ΜΕΤΑΚΙΝΗΜΕΝΟ σημείο του CRM — ποτέ πινέζα.
                   Exclusive: πινέζα στο ακριβές σημείο. Ο χάρτης φορτώνει μόνο αν ανοίξει η ενότητα. */
                <figure class="pmap">
                  <div class="pmap__map" id="pmap" data-lat={mapView.lat} data-lng={mapView.lng}
                       data-exact={mapView.exact ? '1' : ''} data-r={CIRCLE_M}
                       role="img" aria-label={pui(lang, mapView.exact ? 'mapExact' : 'mapCircle')}></div>
                  <figcaption class="pmap__cap">
                    <span>{pui(lang, mapView.exact ? 'mapExact' : 'mapCircle')}</span>
                    {mapView.exact && (
                      <a href={`https://www.google.com/maps/search/?api=1&query=${mapView.lat},${mapView.lng}`}
                         target="_blank" rel="noopener" data-ev="property:map_open">{pui(lang, 'mapOpen')}</a>
                    )}
                  </figcaption>
                </figure>
              )}
            </>) : (
              <div class="maplock">
                <span class="maplock__bg" aria-hidden="true"></span>
                <span class="maplock__in">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10.5" rx="1"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
                  <b>{pui(lang, 'unlockH')}</b>
                  <em>{pui(lang, 'unlockP')}</em>
                  <a class="btn btn--go p-gild" href={loginHref} data-ev="register:unlock_area">{pui(lang, 'freeReg')}</a>
                </span>
              </div>
            )}

            {dists.length > 0 && (<>
              <div class="near" id="near">
                <div class="near__h">
                  <span>{pui(lang, 'nearby')}</span>
                  <button type="button" class="near__x" data-near aria-controls="near" aria-expanded="true" aria-label={pui(lang, 'closeList')}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
                  </button>
                </div>
                <ul class="dists">
                  {/* 🪤 ΕΓΡΑΦΑ «ΠΕΡΠΑΤΗΜΑ» ΚΑΙ ΕΒΓΑΙΝΕ «ΑΕΡΟΔΡΟΜΙΟ 105,8 ΧΛΜ ΠΕΡΠΑΤΗΜΑ».
                      Ο τροφοδότης βάζει την απόσταση στο πεδίο `walk_km` ΠΑΝΤΑ, και το
                      `drive_km` μένει 0 όταν δεν το μέτρησε. Το διάβασα ως «0 οδικώς
                      σημαίνει ότι πάει με τα πόδια» — που είναι λάθος: σημαίνει «δεν
                      ξέρω». Ίδιο και σε τράπεζα 12,7 χλμ, νοσοκομείο 8,8 χλμ.
                      Η ένδειξη τρόπου ΕΦΥΓΕ: δεν την ξέρουμε, δεν προσθέτει τίποτα, και
                      όταν βγαίνει λάθος υπονομεύει ΟΛΑ τα υπόλοιπα νούμερα της σελίδας.
                      🌍 Και η μονάδα ΔΕΝ γράφεται εδώ — ήταν «χλμ» καρφωτό, δηλαδή θα
                         έλεγε «105,8 χλμ» και στα γερμανικά. */}
                  {dists.map((d) => {
                    const poi = poiName(d, lang);
                    const km = Math.max(d.drive_km ?? 0, d.walk_km ?? 0);
                    return <li><span>{poi}</span><b class="num">{num(km, lang)} {pui(lang, 'kmU')}</b></li>;
                  })}
                </ul>
              </div>
              <button type="button" class="near__open" data-near aria-controls="near" aria-expanded="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                <span>{pui(lang, 'nearbyN', { n: dists.length })} ›</span>
              </button>
            </>)}
          </div>

          {hasExclusive && (
            /* ═══ EXCLUSIVE (#53) — ΜΟΝΟ με έγκριση George από το EALIDA ═══
               Το CRM στέλνει αυτά τα πεδία ΜΟΝΟ στο επίπεδο exclusive· ο έλεγχος εδώ
               είναι δεύτερη ζώνη, όχι η μόνη. */
            <section class="xcl" aria-labelledby="xcl-h">
              <h2 class="sec" id="xcl-h">{pui(lang, 'exclH')}</h2>
              {xAddress && (<p class="xcl__addr"><b>{pui(lang, 'addressL')}</b> {xAddress}</p>)}
              {xVideos.length > 0 && (<>
                <h3 class="xcl__h">{pui(lang, 'videoL')}</h3>
                {xVideos.map((v) => embedOf(v.url) ? (
                  <div class="xcl__vid"><iframe src={embedOf(v.url)} title={v.label || pui(lang, 'videoL')} loading="lazy"
                    allow="fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
                ) : (
                  <p><a href={v.url} target="_blank" rel="noopener">{v.label || pui(lang, 'videoL')}</a></p>
                ))}
              </>)}
              {xDocs.length > 0 && (<>
                <h3 class="xcl__h">{pui(lang, 'docsL')}</h3>
                <ul class="xcl__docs">{xDocs.map((d) => <li><a href={d.url} target="_blank" rel="noopener">{d.label}</a></li>)}</ul>
              </>)}
              {xHistory.length > 0 && (<>
                <h3 class="xcl__h">{pui(lang, 'priceHistL')}</h3>
                <dl class="lfacts">{xHistory.map((h) => <div class="lfact"><dt class="num">{h.date}</dt><dd class="num">{money(h.price, lang)}</dd></div>)}</dl>
              </>)}
            </section>
          )}

          {(muniArea || muniList) && muniName && (
            /* About the municipality, with links (as on the live page). The text exists in English
               only for now; other languages get the links until the translations come. */
            <section class="muni" aria-labelledby="muni-h" id="band">
              {/* #103 desktop: the area photo runs edge to edge behind two glass cards («window»: the
                  photo stays still, the page scrolls over it). Loaded by the script only on desktop
                  and only when the band comes near — phones never download it. */}
              {bandPhoto && (
                <div class="band__win" aria-hidden="true"><div class="band__ph">
                  <img data-src={marked(bandPhoto.url, 1920)} alt={altOf(bandPhoto, lang, t(lang, 'home.area_alt', { name: muniName }))} decoding="async" />
                </div></div>
              )}
              <div class="band__cards" id="bandCards">
                <div class="muni__card">
                  <div>
                    <h2 class="sec" id="muni-h">{pui(lang, 'aboutMuni', { m: muniName })}</h2>
                    {lang === 'en' && muniArea && <p class="muni__p">{muniArea.intro}</p>}
                  </div>
                  <ul class="muni__l">
                    {lang === 'en' && muniArea && <li><a href={areaUrl(muniArea.slug)}>{muniArea.h1}</a></li>}
                    {muniList && <li class="muni__go"><a href={facetUrl(lang, muniList.key)}>{pui(lang, 'allInMuni', { m: muniName })}</a></li>}
                    <li><a href="/en/articles/business-news/taxes-foreigners-properties-greece">{pui(lang, 'costs')}</a></li>
                  </ul>
                </div>
                {gHome && (
                  /* George's live price guide (lib/prices.ts), municipality level only. */
                  <div class="muni__pr">
                    <h3 class="pr__h">{pui(lang, 'pricesIn', { m: muniName })} <span>· {gMonth}</span></h3>
                    <div class="pr__big">
                      <div><b class="num">{money(gHome.perSqm, lang)}</b><span>{pui(lang, 'medSqm')}</span></div>
                      <div><b class="num">{money(gHome.typical, lang)}</b><span>{pui(lang, 'medPrice')}</span></div>
                    </div>
                    <p class="pr__line">
                      {pui(lang, 'midHalf', { lo: money(gHome.low, lang), hi: num(gHome.high, lang) })}
                      {gLand && <> · {pui(lang, 'landLine', { v: money(gLand.perSqm, lang), p: sqmFmt(gLand.typical, lang) })}</>}
                    </p>
                    <div class="pr__bars">
                      {guide.homes.map((r) => (
                        <div class:list={['pr__bar', r.key === myMuni && 'pr__bar--on']}>
                          <span>{FACETS.find((f) => f.q.municipality === r.key)?.name[lang] ?? r.name}</span>
                          <i style={`--w:${Math.round((r.perSqm / gMax) * 100)}%`}></i>
                          <span class="num">{money(r.perSqm, lang)}</span>
                        </div>
                      ))}
                    </div>
                    <a class="pr__all" href={pricesHref}>{pui(lang, 'allPrices')} <span aria-hidden="true">→</span></a>
                  </div>
                )}
              </div>
            </section>
          )}

          {/* ═══ ΤΡΙΤΟ ΣΠΡΩΞΙΜΟ ═══ */}
          {!viewer.member && (
            <div class="full" id="full">
              <svg class="full__lock" id="fullLock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="11"/><path d="M7.5 10.5V7a4.5 4.5 0 0 1 9 0v3.5"/><circle cx="12" cy="15.4" r="1.3"/><path d="M12 16.7v2.1"/></svg>
              <span class="full__i" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="10.5" width="16" height="10.5" rx="1"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
              </span>
              <div>
                <span class="full__k">{pui(lang, 'freeAcct')}</span>
                <b class="t-h3 full__h">{ui(lang, 'joinH')}</b>
                <ul class="full__l">
                  <li>{ui(lang, 'joinB1')}</li><li>{ui(lang, 'joinB2')}</li><li>{ui(lang, 'joinB3')}</li>
                </ul>
              </div>
              <a class="full__b p-gild p-gild--dk" href={loginHref} data-ev="register:property_block">{ui(lang, 'joinCta')}</a>
            </div>
          )}

          {similar.length > 0 && (<>
            <h2 class="sec">{pui(lang, 'similar')}</h2>
            <ul class="sim">
              {similar.map((p) => <li><PropertyCard p={p} lang={lang} viewer={viewer} plain /></li>)}
            </ul>
          </>)}

          {zone.length > 0 && (
            /* #103 desktop: «Property for sale in Halkidiki» — links not elsewhere on the page,
               three cards at a time, a page every 5 s. Not a heading (headings stay as they were). */
            <section class="zone" id="zone" aria-label={ui(lang, 'all')}>
              <div class="zone__h">
                <p class="zone__t">{ui(lang, 'all')}</p>
                {zonePages > 1 && (
                  <div class="rdash" role="group" aria-label={t(lang, 'home.pages')}>
                    {Array.from({ length: zonePages }).map((_, k) => (
                      <button type="button" class:list={[k === 0 && 'on']} data-zp={k} aria-label={t(lang, 'home.page', { n: k + 1 })} aria-current={k === 0 ? 'true' : 'false'}><span></span></button>
                    ))}
                  </div>
                )}
              </div>
              <div class="zone__rail"><div class="zone__track" id="zoneTrack">
                {zone.map((c) => (
                  <div class="pc">
                    <a class="pci" href={c.href} tabindex="-1" aria-hidden="true">
                      {c.photo && <img src={marked(c.photo.url, 800)} srcset={markedSrcSetSmall(c.photo.url)} sizes="300px"
                                       alt={altOf(c.photo, lang, c.t)} width="800" height="533" loading="lazy" decoding="async" />}
                    </a>
                    <a class="pct" href={c.href}>{c.t}</a>
                    <span class="pca">
                      <a class="pcb" href={c.href}>{pui(lang, 'viewProps')}</a>
                      {c.about && <a class="pcl" href={c.about}>{pui(lang, 'aboutArea')} ›</a>}
                    </span>
                  </div>
                ))}
              </div></div>
            </section>
          )}
        </div>

        {/* ═══ Η ΚΑΡΤΑ ΕΝΕΡΓΕΙΩΝ ══════════════════════════════════════════
            ΤΡΕΙΣ ενέργειες, όχι δύο — ο George κράτησε ρητά τη φόρμα:
            «φοβάμαι πραγματικά να αφαιρέσω τελείως το request form».
            Η σειρά ΔΕΝ είναι οριστική: κάθε κουμπί έχει δικό του `data-ev`,
            μετράμε 2-3 μήνες και μετά αποφασίζουμε τι πάει πρώτο. */}
        <aside class="side" id="side">
          <div class="card">
            {/* #103 desktop: one line, level with the highlight chips. */}
            <div class="pbp">
              {priceOk && price > 0 ? (<>
                {oldPrice && <span class="old num">{money(oldPrice, lang)}</span>}
                <p class="price num t-price">{money(price, lang)}</p>
                {perSqm && <p class="per num">{money(perSqm, lang)} {pui(lang, 'perSqm')}</p>}
              </>) : (
                <p class="price t-h3">{t(lang, 'card.price_request')}</p>
              )}
            </div>

            <button class="cta" type="button" data-tour data-ev="lead:tour_open">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
              {pui(lang, 'reqTour')}
            </button>
            <a class="cta cta--wa" href={waHref} target="_blank" rel="noopener" data-ev="lead:whatsapp">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.6-1.1-4.3-3.8-4.4-4-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9.9-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.1.3.6 1.1 1.4 1.7 1 .9 1.8 1.1 2.1 1.3.3.1.4.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.2.1.4.2.4.3 0 .1 0 .7-.2 1.2Z"/></svg>
              WhatsApp
            </a>
            {rental && (
              <a class="cta cta--sec" href={rental} target="_blank" rel="noopener" data-ev="lead:rent_it">
                {t(lang, 'week.rent')}
              </a>
            )}
            {/* «να σε καλέσουμε» next to the office phone (#82, placement B of the approved mockup) */}
            <p class="tel num">
              {/* desktop (Sergei 03/11): the number as in the header — icon + digits, no «or», no «we call you» */}
              <a href={co.phoneHref} data-ev="call:property"><span class="tel__or">{pui(lang, 'or')} </span><svg class="tel__ic" viewBox="0 0 18 18" aria-hidden="true"><path d="M5.2 2.6h2.1l1.1 2.8-1.5 1.1a8.4 8.4 0 0 0 4.6 4.6l1.1-1.5 2.8 1.1v2.1a1.3 1.3 0 0 1-1.4 1.3A12.6 12.6 0 0 1 3.9 4A1.3 1.3 0 0 1 5.2 2.6Z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" /></svg><bdi dir="ltr">{co.phone}</bdi></a>
              <span class="tel__cb">{' · '}<button type="button" class="cb-open" aria-expanded="false" aria-controls="cb-d" data-ev="lead:callback_open">{pui(lang, 'callMe')}</button></span>
            </p>
            <CallBack lang={lang} id={id} k="d" phone={meFav?.phone} tel={co.phone} telHref={co.phoneHref} hidden />

            {/* Η ΑΠΛΗ ΦΟΡΜΑ — τέσσερα πεδία, χωρίς βήματα, πάντα ορατή. */}
            <form class="qf" id="qf" data-ev="lead:form_submit" data-ev-defer>
              <span class="qf__h lab">{pui(lang, 'reqInfo')}</span>
              <label class="sr-only" for="qf-n">{pui(lang, 'fName')}</label>
              <input id="qf-n" name="name" required maxlength="120" autocomplete="name" placeholder={pui(lang, 'fName')} value={meFav?.name || undefined} />
              {/* #103 desktop: name and surname apart (sent together as `name`); phones keep the one field. */}
              <input class="qf__d" id="qf-f" name="first" maxlength="60" autocomplete="given-name" placeholder={pui(lang, 'fFirst')} aria-label={pui(lang, 'fFirst')}
                     value={meFav?.name ? meFav.name.split(' ')[0] : undefined} />
              <input class="qf__d" id="qf-l" name="last" maxlength="60" autocomplete="family-name" placeholder={pui(lang, 'fSurname')} aria-label={pui(lang, 'fSurname')}
                     value={meFav?.name && meFav.name.includes(' ') ? meFav.name.slice(meFav.name.indexOf(' ') + 1) : undefined} />
              <label class="sr-only" for="qf-p">{pui(lang, 'fPhone')}</label>
              <div class="qf__ph" id="qf-ph">
                {/* #103 desktop: country code with search (George's DIAL list). */}
                <button type="button" class="dial" id="dialBtn" aria-haspopup="listbox" aria-expanded="false" aria-controls="dialPop" aria-label={pui(lang, 'cbCountry')}>
                  <span id="dialL" data-dial-l>🇬🇷 +30</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
                </button>
                <input id="qf-p" name="phone" type="tel" maxlength="40" autocomplete="tel" placeholder={pui(lang, 'fPhone')} value={meFav?.phone || undefined} />
                <div class="dial__pop" id="dialPop" hidden>
                  <div class="dial__s">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
                    <input type="search" id="dialQ" data-dial-q placeholder={pui(lang, 'dialSearch')} aria-label={pui(lang, 'dialSearch')} autocomplete="off" />
                  </div>
                  <div class="dial__l" role="listbox" aria-label={pui(lang, 'cbCountry')}>
                    {dial.map((d) => (
                      <button type="button" role="option" aria-selected="false" data-cc={d.cc} data-code={d.code} data-q={`${d.name} ${d.cc} ${d.code}`.toLowerCase()}>
                        <span class="dial__f">{d.flag}</span><span class="dial__n">{d.name}</span><span class="dial__c num"><bdi dir="ltr">+{d.code}</bdi></span>
                      </button>
                    ))}
                    <p class="dial__none" hidden>{pui(lang, 'dialNone')}</p>
                  </div>
                </div>
              </div>
              <label class="sr-only" for="qf-e">{pui(lang, 'fEmail')}</label>
              <input id="qf-e" name="email" type="email" required maxlength="200" autocomplete="email" placeholder={pui(lang, 'fEmail')} value={meFav?.email || undefined} />
              <p class="qf__int">{pui(lang, 'interest', { id })}</p>
              <textarea class="qf__d qf__msg" id="qf-m" name="message" rows="3" maxlength="2000" aria-label={pui(lang, 'msgL')}>{pui(lang, 'interest', { id }) + '. '}</textarea>
              {/* 🛡️ Παγίδα-μέλι: κρυφό για άνθρωπο, ορατό για ρομπότ. Δες api/inquiry.ts */}
              <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button type="submit">{pui(lang, 'send')}</button>
              <p class="qf__ok" hidden>{pui(lang, 'sent')}</p>
              <p class="qf__fine">{pui(lang, 'answers')}</p>
              <p class="qf__fine qf__priv">{pui(lang, 'privNote')} <a href={privacyHref}>{pui(lang, 'privLink')}</a></p>
            </form>
          </div>
        </aside>
      </div>
    </div>

    {/* ═══ ΚΙΝΗΤΟ: Η ΜΠΑΡΑ ΠΟΥ ΔΕΝ ΦΕΥΓΕΙ ΠΟΤΕ (μοτίβο Compass) ═══ */}
    <div class="bar" aria-label={pui(lang, 'reqTour')}>
      <button class="bar__go" type="button" data-tour data-ev="lead:tour_open_bar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        {pui(lang, 'reqTour')}
      </button>
      <a class="bar__i" href={waHref} target="_blank" rel="noopener" data-ev="lead:whatsapp_bar">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Z"/></svg>WhatsApp
      </a>
      {/* Call opens a choice (#82): call us now, or we call you. */}
      <button class="bar__i" type="button" data-callsheet aria-controls="callsheet" data-ev="lead:callsheet_open">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h3l2 5-2.5 1.5a11 11 0 0 0 5 5L15 12l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 4 5a2 2 0 0 1 2-2Z"/></svg>{pui(lang, 'call')}
      </button>
    </div>

    {/* ═══ ΤΟ ΠΑΡΑΘΥΡΟ ΤΗΣ ΕΠΙΣΚΕΨΗΣ — δύο βήματα, χωρίς λογαριασμό ═══
        `<dialog>` και όχι δικό μας παράθυρο: το κλείσιμο με Esc, η παγίδα
        πληκτρολογίου και το «πίσω» τα δίνει ο browser σωστά, δωρεάν. */}
    <dialog class="modal" id="tour">
      <form method="dialog" class="modal__x"><button aria-label="×">×</button></form>
      <b class="modal__h t-h3">{pui(lang, 'reqTour')} — #{id}</b>
      <p class="modal__s">{pui(lang, 'whenSuits')}</p>
      <form class="tf" id="tf" data-ev="lead:tour_submit" data-ev-defer>
        <div class="when" role="group">
          <label><input type="radio" name="when" value="sat" checked /><span data-day="0"></span></label>
          <label><input type="radio" name="when" value="sun" /><span data-day="1"></span></label>
          <label><input type="radio" name="when" value="other" /><span>{pui(lang, 'otherDay')}</span></label>
          <label><input type="radio" name="when" value="video" /><span>{pui(lang, 'videocall')}</span></label>
        </div>
        <label class="sr-only" for="tf-n">{pui(lang, 'fName')}</label>
        <input id="tf-n" name="name" required maxlength="120" autocomplete="name" placeholder={pui(lang, 'fName')} />
        <label class="sr-only" for="tf-c">{pui(lang, 'tourContact')}</label>
        <input id="tf-c" name="contact" required maxlength="200" placeholder={pui(lang, 'tourContact')} value={meFav?.phone || meFav?.email || undefined} />
        <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit">{pui(lang, 'reqTour')}</button>
        <p class="tf__ok" hidden>{pui(lang, 'sent')}</p>
        <p class="qf__fine">{pui(lang, 'answers')}</p>
        <p class="qf__fine qf__priv">{pui(lang, 'privNote')} <a href={privacyHref}>{pui(lang, 'privLink')}</a></p>
      </form>
    </dialog>

    {/* ═══ ALL PHOTOS (#103, desktop) ═══════════════════════════════════════
        Opens from the gallery. Rendered at load, hidden; its images are lazy, so nothing
        downloads until it opens. 🔒 Same rule as the gallery: a locked photo is the 24-pixel
        file from our server (`blurSrc`) — the real photo's address is never in the page.
        Guest: every tile is a sign-in link (George's login dialog opens over the popup).
        Member: a tile opens the photo larger inside the popup. */}
    <dialog class="gpop" id="gpop" aria-label={pui(lang, 'allPhotos')}>
      <div class="gpop__bar">
        <span class="gpop__t">{heading} <span>· {pui(lang, 'photosN', { n: nPhotos })}</span></span>
        <button type="button" class="gpop__x" data-gpop-x aria-label={t(lang, 'ui.close')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
        </button>
      </div>
      <div class="gpop__grid">
        {gallery.map(({ p, i, open }) => {
          const label = pui(lang, 'photoOf', { a: i + 1, b: nPhotos });
          const img = open
            ? <img src={marked(p.url, 800)} srcset={markedSrcSetSmall(p.url)} sizes="300px" alt={altOf(p, lang, heading)}
                   width="800" height="533" loading="lazy" decoding="async" />
            : <img class="gpop__bl" src={blurSrc(id, i)} alt="" width="800" height="533" loading="lazy" decoding="async" />;
          return viewer.member ? (
            <button type="button" class="gpop__ph" data-big={open ? marked(p.url, 1920) : undefined} aria-label={label}>{img}</button>
          ) : (
            <a class="gpop__ph" href={loginHref} aria-label={open ? label : pui(lang, 'morePhotos', { n: hidden })}
               data-ev={open ? 'property:photo_open' : 'register:unlock_photos'}>
              {img}
              {!open && (
                <span class="gpop__lk" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </span>
              )}
            </a>
          );
        })}
      </div>
      {viewer.member && (
        <div class="gpop__big" id="gbig" hidden>
          <img alt="" />
          <button type="button" class="gpop__x gpop__bx" data-gbig-x aria-label={t(lang, 'ui.close')}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
          </button>
        </div>
      )}
    </dialog>

    {/* Back to top (#103, as on home and the list). */}
    <button type="button" id="toTop" class="p-totop" aria-label={t(lang, 'home.top')}>
      <svg width="14" height="16" viewBox="0 0 14 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M7 15V2M1.5 7.5L7 2l5.5 5.5"/></svg>
    </button>

    {/* ═══ ΚΙΝΗΤΟ: ΤΟ «ΚΛΗΣΗ» — πάρε μας τώρα ή να σε καλέσουμε (#82) ═══ */}
    <dialog class="sheet" id="callsheet">
      <form method="dialog" class="sheet__x"><button aria-label="×">×</button></form>
      <a class="sheet__now num" href={co.phoneHref} data-ev="call:property_bar"><span>{pui(lang, 'callNow')}</span><small><bdi dir="ltr">{co.phone}</bdi></small></a>
      <span class="lab">{pui(lang, 'orWeCall')}</span>
      <CallBack lang={lang} id={id} k="m" phone={meFav?.phone} tel={co.phone} telHref={co.phoneHref} />
    </dialog>
  </main>

  <Footer lang={lang} munis={munis} />
</Base>

<style>
  .strip.strip6 { display: none; }

  .lux { display: inline-block; margin-left: 10px; vertical-align: 6px; font-size: 10.5px; font-weight: 600; letter-spacing: .14em;
         text-transform: uppercase; padding: 4px 9px; background: var(--ink); color: var(--paper); }
  .muni__p { margin: 0 0 12px; color: var(--ink-2); font-size: 15px; max-width: 64ch; }
  .muni__l { margin: 0 0 8px; padding-left: 18px; display: grid; gap: 4px; font-size: 14.5px; }
  .muni__l a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  /* ── ΤΑ ΣΤΟΙΧΕΙΑ ΤΗΣ ΓΗΣ ─────────────────────────────────────────────── */
  .lfacts { margin: 0 0 var(--s5); border-top: 1px solid var(--line-soft);
            display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .lfact { display: flex; justify-content: space-between; align-items: baseline; gap: 14px;
           padding: 11px 0; border-bottom: 1px solid var(--line-soft); min-width: 0; }
  .lfact dt { font-size: 12.5px; color: var(--faint); flex: none; }
  .lfact dd { margin: 0; font-size: 14.5px; text-align: right; min-width: 0;
              overflow-wrap: anywhere; }
  /* Δύο στήλες θέλουν κενό ανάμεσα, αλλιώς οι τιμές της αριστερής ακουμπούν
     τις ετικέτες της δεξιάς. */
  @media (min-width: 700px) { .lfacts { column-gap: var(--s5); } }

  .prop { padding-block: var(--s5) 0; }
  .wrap { max-width: var(--max); margin: 0 auto; padding-inline: var(--gut); }
  .crumb { font-size: 13px; color: var(--muted); display: flex; gap: 7px; flex-wrap: wrap; }
  .crumb a { color: var(--ink-2); text-decoration: none; }
  .crumb a:hover { text-decoration: underline; }

  .tt { display: flex; align-items: flex-start; justify-content: space-between;
        gap: var(--s4); flex-wrap: wrap; margin: var(--s3) 0 var(--s4); }
  .tt__h { margin: 0; }
  .tt__l { min-width: 0; }
  .tt__r { display: flex; gap: var(--s2); flex: none; }
  .chip { display: inline-flex; align-items: center; gap: 6px; margin-top: 7px;
          border: 1px solid var(--line); padding: 4px 10px; font-size: 11.5px; color: var(--ink-2); }
  .chip svg { width: 12px; height: 12px; flex: none; }

  .btn { appearance: none; border: 1px solid var(--line); background: none; color: var(--ink);
         font: inherit; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase;
         padding: 0 14px; height: 44px; box-sizing: border-box; cursor: pointer; text-decoration: none;
         display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .btn svg { width: 13px; height: 13px; flex: none; }
  .btn--fav:hover, .btn:hover { border-color: var(--ink); }
  .btn--fav[aria-pressed='true'] svg { fill: currentColor; }
  .btn--fav[aria-busy='true'] { opacity: .6; }
  .btn--go { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  /* ═══ ΓΚΑΛΕΡΙ ═══════════════════════════════════════════════════════════
     ΚΙΝΗΤΟ ΠΡΩΤΑ: ΜΙΑ φωτογραφία, σύρσιμο (ρητή οδηγία George 30/7).
     🪤 Το `scroll-snap` θέλει `overflow-y: hidden` ΡΗΤΑ — αλλιώς το iOS κάνει
        και τον κάθετο άξονα κυλιόμενο και η φωτό γλιστράει μέσα στο πλαίσιο
        (το πληρώσαμε στις κάρτες της λίστας). */
  .galwrap { position: relative; margin: 0 0 var(--s5); }
  .gal {
    display: grid; grid-auto-flow: column; grid-auto-columns: 100%;
    overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none;
  }
  .gal::-webkit-scrollbar { display: none; }
  .cell { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden;
          background: var(--paper-2); scroll-snap-align: start; scroll-snap-stop: always; }
  .cell img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Η εικόνα είναι ΗΔΗ κατεστραμμένη (24px). Το `blur` εδώ είναι μόνο για να
     μη φαίνονται τετραγωνάκια στη μεγέθυνση — καλλωπισμός, όχι κλείδωμα. */
  .cell--locked img { filter: blur(7px) saturate(.92); transform: scale(1.06); }
  .lockmark { position: absolute; inset: 0; display: grid; place-content: center;
              color: #fff; background: rgba(10,14,16,.24); }
  .lockmark svg { width: 26px; height: 26px; opacity: .85;
                  filter: drop-shadow(0 1px 3px rgba(0,0,0,.45)); }
  .lockover { position: absolute; inset: 0; display: grid; place-content: center; gap: 8px;
              text-align: center; color: #fff; background: rgba(10,14,16,.46); padding: 14px; }
  .lockover svg { width: 24px; height: 24px; margin: 0 auto; }
  .lockover b { font-size: 15px; font-weight: 600; text-wrap: balance; }
  .lockover em { font-style: normal; font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
                 border: 1px solid rgba(255,255,255,.75); padding: 8px 13px; margin: 2px auto 0; }

  .dots { position: absolute; inset: auto 0 12px 0; display: flex; gap: 6px;
          justify-content: center; pointer-events: none; }
  .dots i { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.55);
            box-shadow: 0 0 0 1px rgba(0,0,0,.2); transition: background .18s ease; }
  .dots i[data-on] { background: #fff; }

  @media (min-width: 900px) {
    /* DESKTOP: μία μεγάλη αριστερά, τέσσερα πλακίδια δεξιά. Η ίδια σειρά
       στοιχείων — αλλάζει μόνο η διάταξη, ώστε να μην υπάρχει δεύτερη γκαλερί
       στο HTML (διπλό κατέβασμα εικόνων και διπλή συντήρηση). */
    .galwrap { padding-inline: var(--gut); max-width: var(--max); margin-inline: auto; }
    .gal {
      grid-auto-flow: row; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: 1fr;
      gap: 8px; overflow: visible; scroll-snap-type: none; height: 520px;
    }
    .cell { aspect-ratio: auto; }
    .cell:first-child { grid-row: span 2; }
    /* 🪤 ΠΕΝΤΕ ΠΛΑΚΙΔΙΑ, ΟΧΙ ΟΣΑ ΤΥΧΕΙ. Το πλέγμα είναι `2fr 1fr 1fr` μέσα σε
       ύψος 520px: με 17 φωτογραφίες θα έφτιαχνε έξι σειρές στριμωγμένες στο ίδιο
       ύψος — δηλαδή λωρίδες 60 pixel. Δεν φαινόταν ως τώρα επειδή ο επισκέπτης
       έπαιρνε ακριβώς 4+1· θα έσπαγε την ΠΡΩΤΗ μέρα που θα έμπαινε μέλος.
       Στο κινητό η ίδια σειρά είναι ράγα και τις θέλουμε ΟΛΕΣ — γι' αυτό το
       κόψιμο ζει μόνο εδώ. */
    .cell:nth-child(n + 6) { display: none; }
    .dots { display: none; }
  }

  /* ═══ ΔΥΟ ΣΤΗΛΕΣ ΜΕΤΑ ΤΙΣ ΦΩΤΟΓΡΑΦΙΕΣ ═══ */
  .cols { display: grid; gap: var(--s5); padding-bottom: var(--s7); }
  @media (min-width: 900px) {
    .cols { grid-template-columns: minmax(0,1fr) 300px; gap: var(--s6); align-items: start; }
  }
  .main { min-width: 0; }

  .strip { display: flex; flex-wrap: wrap; border: 1px solid var(--line-soft); }
  .strip div { flex: 1 1 auto; padding: 12px 16px; border-inline-end: 1px solid var(--line-soft); min-width: 92px; }
  .strip div:last-child { border-inline-end: 0; }
  .strip b { display: block; font-size: 15.5px; font-weight: 600; }
  .strip span { font-size: 10px; letter-spacing: .11em; text-transform: uppercase; color: var(--faint); }

  .sec { font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--faint);
         margin: var(--s6) 0 var(--s3); font-weight: 600; }
  .desc { margin: 0; font-size: 15px; color: var(--ink-2); max-width: 70ch; white-space: pre-line; }

  /* Χαρακτηριστικά με εικονίδια — «αισθητικά πολύ γλυκό» (George). */
  .feats { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px var(--s4);
           grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
  .feats li { display: flex; gap: 10px; align-items: center; font-size: 14px; color: var(--ink-2); }
  .feats svg { width: 19px; height: 19px; flex: none; color: var(--ink); }

  .floors { display: grid; gap: var(--s3); grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
  .fl { border: 1px solid var(--line-soft); padding: 14px 16px; }
  .fl__h { display: block; font-size: 13.5px; font-weight: 600; margin-bottom: 8px; }
  .fl dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; font-size: 13px; }
  .fl dt { color: var(--muted); }
  .fl dd { margin: 0; text-align: end; }

  .place { margin: 0; font-size: 15px; color: var(--ink-2); }
  .pmap { margin: 12px 0 0; }
  .pmap__map { height: 300px; background: var(--line); }
  .pmap__cap { display: flex; justify-content: space-between; gap: 12px; margin-top: 8px; font-size: 13px; color: var(--muted); }
  .pmap__cap a { color: var(--ink); text-decoration: underline; }
  .xcl { margin-top: 8px; }
  .xcl__h { font-size: 15px; font-weight: 600; margin: 18px 0 8px; }
  .xcl__addr { margin: 0; font-size: 15px; }
  .xcl__vid { position: relative; aspect-ratio: 16 / 9; }
  .xcl__vid iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .xcl__docs { margin: 0; padding-left: 18px; }
  .xcl__docs a { color: var(--ink); }
  .maplock { position: relative; height: 240px; overflow: hidden; }
  .maplock__bg { position: absolute; inset: 0;
    background:
      linear-gradient(90deg, transparent 47%, rgba(0,0,0,.06) 47% 51%, transparent 51%),
      linear-gradient(0deg, transparent 62%, rgba(0,0,0,.06) 62% 66%, transparent 66%),
      linear-gradient(38deg, transparent 29%, rgba(0,0,0,.04) 29% 32%, transparent 32%),
      var(--paper-2);
    filter: blur(1.5px); }
  .maplock__in { position: absolute; inset: 0; display: grid; place-content: center; gap: 9px;
                 text-align: center; padding: 16px; }
  .maplock__in svg { width: 25px; height: 25px; margin: 0 auto; color: var(--ink); }
  .maplock__in b { font-size: 16px; font-weight: 600; }
  .maplock__in em { font-style: normal; font-size: 13px; color: var(--muted); max-width: 42ch; }
  .maplock__in .btn { margin: 4px auto 0; }

  .dists { list-style: none; margin: var(--s4) 0 0; padding: 0; display: grid; gap: 10px var(--s4);
           grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); font-size: 13.5px; }
  .dists li { display: flex; align-items: baseline; gap: 8px; border-bottom: 1px solid var(--line-soft); padding-bottom: 7px; }
  .dists span { color: var(--ink-2); flex: 1 1 auto; min-width: 0; }
  .dists b { font-weight: 600; }
  .dists em { font-style: normal; font-size: 11px; color: var(--faint); }

  .full { background: var(--ink); color: var(--paper); padding: var(--s5);
          display: grid; gap: var(--s3); align-items: center; margin-top: var(--s6); }
  @media (min-width: 700px) { .full { grid-template-columns: auto 1fr auto; gap: var(--s4); } }
  .full__i { display: grid; place-items: center; width: 44px; height: 44px;
             border: 1px solid rgba(255,255,255,.28); }
  .full__i svg { width: 22px; height: 22px; }
  .full__h { margin: 0; color: var(--paper); display: block; }
  .full__l { margin: 6px 0 0; padding: 0; list-style: none; display: flex; gap: var(--s4);
             flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,.82); }
  .full__l li::before { content: '· '; opacity: .6; }
  .full__b { background: var(--paper); color: var(--ink); padding: 13px 24px; font-size: 11.5px;
             letter-spacing: .09em; text-transform: uppercase; text-decoration: none; white-space: nowrap;
             justify-self: start; }
  .full__b:hover { background: transparent; color: var(--paper); box-shadow: inset 0 0 0 1px var(--paper); }

  .sim { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4);
         grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }

  /* ═══ Η ΚΑΡΤΑ ΕΝΕΡΓΕΙΩΝ ═══ */
  .card { border: 1px solid var(--line); padding: var(--s4); background: var(--paper); }
  @media (min-width: 900px) { .card { position: sticky; top: var(--s3); } }
  .old { font-size: 13px; color: var(--faint); text-decoration: line-through; }
  .price { margin: 0; }
  .per { margin: 2px 0 var(--s3); font-size: 12px; color: var(--muted); }
  .cta { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%;
         box-sizing: border-box; padding: 13px; margin-bottom: 7px; cursor: pointer;
         border: 1px solid var(--ink); background: var(--ink); color: var(--paper);
         font: inherit; font-size: 11.5px; font-weight: 600; letter-spacing: .09em;
         text-transform: uppercase; text-decoration: none; }
  .cta svg { width: 15px; height: 15px; flex: none; }
  .cta:hover { opacity: .88; }
  .cta--wa { background: none; color: #1faa53; border-color: #1faa53; }
  .cta--sec { background: none; color: var(--ink); }
  .tel { display: block; text-align: center; font-size: 13px; color: var(--ink-2); margin: 9px 0 0; }
  .tel a { color: inherit; text-decoration: none; }
  .tel__ic { display: none; }
  .cb-open { border: 0; background: none; padding: 4px 2px; font: inherit; color: var(--brand); cursor: pointer;
             text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }

  .qf { border-top: 1px solid var(--line-soft); margin-top: var(--s4); padding-top: var(--s3);
        display: grid; gap: 7px; }
  .qf__h { display: block; }
  .lab { font-size: 10.5px; letter-spacing: .13em; text-transform: uppercase; color: var(--faint); font-weight: 600; }
  .qf input, .tf input { border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    font: inherit; font-size: 16px; padding: 0 11px; height: 44px; box-sizing: border-box; width: 100%; }
  .qf input:focus-visible, .tf input:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  .qf__int { margin: 0; font-size: 12px; color: var(--muted); background: var(--paper-2);
             border: 1px dashed var(--line); padding: 9px 11px; }
  .qf button, .tf button { border: 0; background: var(--ink); color: var(--paper); font: inherit;
    font-size: 11.5px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
    padding: 13px; cursor: pointer; }
  .qf__fine { margin: 0; font-size: 10.5px; color: var(--faint); }
  .qf__priv a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .qf__ok, .tf__ok { margin: 0; font-size: 13px; color: var(--ink); }
  /* Η παγίδα-μέλι φεύγει από την ΟΘΟΝΗ αλλά όχι από το DOM — τα ρομπότ
     διαβάζουν HTML, δεν κοιτούν pixel. `display:none` το προσπερνούν πολλά. */
  /* B-23: no physical offset — `left: -9999px` widened every RTL (he) page to ~11,000 px.
     Clipped to 1 px in place; the selector matches `.qf input` so its padding/border cannot win. */
  .hp, .qf .hp, .tf .hp { position: absolute; inset-inline-start: 0; top: 0; width: 1px; height: 1px;
    padding: 0; margin: 0; border: 0; opacity: 0; overflow: hidden; clip-path: inset(50%); pointer-events: none; }

  /* ═══ ΚΙΝΗΤΗ ΜΠΑΡΑ ═══ */
  .bar { position: fixed; inset: auto 0 0 0; z-index: 30; display: flex;
         background: var(--paper); border-top: 1px solid var(--line);
         box-shadow: 0 -8px 30px rgba(10,14,16,.10);
         padding-bottom: env(safe-area-inset-bottom); }
  .bar__go, .bar__i { flex: 1; display: grid; place-items: center; gap: 3px; padding: 9px 6px;
    font: inherit; font-size: 9.5px; letter-spacing: .08em; text-transform: uppercase;
    border: 0; border-inline-end: 1px solid var(--line-soft); background: none;
    color: var(--ink); text-decoration: none; cursor: pointer; min-height: 56px; }
  .bar__i:last-child { border-inline-end: 0; }
  .bar__go { flex: 1.5; background: var(--ink); color: var(--paper); }
  .bar svg { width: 17px; height: 17px; }
  .bar__i[href^='https://wa.me'] { color: #1faa53; }
  @media (min-width: 900px) { .bar { display: none; } }
  /* Χώρος ώστε η μπάρα να μην κρύβει το τέλος της σελίδας. */
  @media (max-width: 899px) { .prop { padding-bottom: 60px; } }

  /* ═══ ΠΑΡΑΘΥΡΟ ΕΠΙΣΚΕΨΗΣ ═══ */
  .modal { border: 1px solid var(--line); padding: var(--s5); max-width: 380px; width: calc(100% - 2 * var(--gut));
           background: var(--paper); color: var(--ink); box-shadow: 0 24px 70px rgba(10,14,16,.22); }
  .modal::backdrop { background: rgba(10,14,16,.45); }
  .modal__x { display: flex; justify-content: flex-end; margin: calc(-1 * var(--s3)) calc(-1 * var(--s3)) 0 0; }
  .modal__x button { border: 0; background: none; font-size: 22px; line-height: 1; cursor: pointer;
                     color: var(--muted); padding: 4px 8px; }
  .modal__h { display: block; margin: 0; }
  .modal__s { margin: 4px 0 var(--s3); font-size: 13px; color: var(--muted); }
  .tf { display: grid; gap: 8px; }
  .when { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 2px; }
  .when label { cursor: pointer; }
  .when input { position: absolute; opacity: 0; pointer-events: none; }
  .when span { display: inline-block; border: 1px solid var(--line); padding: 8px 13px; font-size: 12.5px; }
  .when input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .when input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* ═══ ΚΙΝΗΤΟ: ΦΥΛΛΟ «ΚΛΗΣΗ» (#82) ═══ */
  .sheet { margin: auto 0 0; inset-inline: 0; width: 100%; max-width: 100%; box-sizing: border-box; border: 0;
           border-radius: 14px 14px 0 0; padding: 14px var(--gut) calc(18px + env(safe-area-inset-bottom));
           background: var(--paper); color: var(--ink); max-height: 92dvh; overflow: auto; }
  .sheet[open] { display: grid; gap: 9px; }
  .sheet::backdrop { background: rgba(10,14,16,.45); }
  .sheet__x { display: flex; justify-content: flex-end; margin: -6px -8px -6px 0; }
  .sheet__x button { border: 0; background: none; font-size: 22px; line-height: 1; cursor: pointer;
                     color: var(--muted); padding: 4px 8px; }
  .sheet__now { border: 1px solid var(--ink); padding: 13px 12px; display: flex; justify-content: space-between;
                align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-size: 15px; }
  .sheet__now small { color: var(--muted); font-size: 13px; }

  /* ═══════════════════════════════════════════════════════════════════════
     #103 — DESKTOP REDESIGN of the property page (approved by George 2026-11-02).
     Everything new is hidden below 1024px; phones keep George's layout above.
     ═══════════════════════════════════════════════════════════════════════ */
  .chip { text-decoration: none; }
  .hl, .feats .feats__all, .near__h, .near__open, .band__win, .muni__pr, .full__lock, .full__k, .zone,
  .qf__d, .dial, .dial__pop, .p-totop { display: none; }
  .qf__ph { display: contents; }
  .gpop:not([open]) { display: none; }

  @media (min-width: 1024px) {
    .prop { padding-top: 0; overflow-x: clip; }

    /* ── title block ── */
    .crumb { padding-top: 28px; gap: 6px; }
    .crumb a { color: var(--muted); }
    .tt { align-items: flex-end; margin: 12px 0 16px; }
    .tt__l { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 10px; }
    .tt__h { flex: 1 0 100%; font-size: 36px; font-weight: 300; line-height: 1.14; letter-spacing: -.016em; }
    .lux { margin: 0; vertical-align: 0; padding: 5px 9px; }
    .chip { margin: 0 0 0 6px; padding: 4px 8px; gap: 6px; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
    .chip svg { width: 11px; height: 11px; }
    .tt__r { align-self: flex-end; gap: 8px; }
    .tt__r .btn { height: auto; min-height: 0; padding: 4px 8px; gap: 6px; font-size: 10.5px; letter-spacing: .14em; font-weight: 500; line-height: 1.6;
                  border-color: rgba(14,18,20,.30); background: var(--paper); transition: background .2s ease, border-color .2s ease; }
    .tt__r .btn svg { width: 11px; height: 11px; transition: transform .25s ease; }
    .tt__r .btn:hover { opacity: 1; background: var(--paper-2); border-color: var(--ink); }
    .tt__r .btn:hover svg { transform: scale(1.12); }
    .tt__r .btn--fav svg * { transition: stroke .2s ease, fill .25s ease; }
    .tt__r .btn--fav:hover svg { color: var(--gold-soft); fill: var(--gold-soft); }

    /* ── gallery: edge to edge, rows grow with the width so the photos keep their shape ── */
    .galwrap { max-width: none; padding-inline: 0; margin: 0; }
    /* Sergei 03/11: the first screen ends under the facts row. The gallery starts at 246 px and the
       chips + facts take 144 px under it, so two rows share 100vh - 414 px (8 px gap, 16 px air);
       never taller than before (width-based), never below 200 px a row. */
    .gal { height: auto; grid-auto-rows: auto;
           grid-template-rows: repeat(2, min(calc((100vw - 16px) / 4 * .79), max(200px, calc((100vh - 414px) / 2)))); }
    .gal:not(:has(.cell)) { display: none; }
    .cell img { transition: transform .45s ease; }
    .cell:not(.cell--locked) { cursor: zoom-in; }
    .cell:not(.cell--locked):hover img { transform: scale(1.02); }
    .cell--locked:has(.lockover) { cursor: pointer; }
    .lockover { gap: 12px; }
    .lockover em { border: 1px solid var(--gold-dk);
      border-image: conic-gradient(from var(--gilda), var(--gold-dk-hi), var(--gold-dk) 25%, var(--gold-dk-lo) 50%, var(--gold-dk) 75%, var(--gold-dk-hi)) 1;
      color: var(--gold-dk-text); transition: color .9s ease-in-out; }
    .lockover em:hover { color: var(--gold-dk-hover); }

    /* ── two columns: content + sticky price box (the box = the last gallery column) ── */
    .cols { grid-template-columns: minmax(0, 1fr) calc((100% - 16px) / 4); gap: 8px; padding: 16px 0 0; align-items: start; }
    .main { display: flex; flex-direction: column; padding-inline-end: 24px; align-self: stretch; }
    .main > * { flex: none; }

    /* highlights + facts: fixed heights, so the price box lines up (chips 40 · facts 77) */
    .hl { display: flex; flex-wrap: wrap; gap: 8px; min-height: 40px; margin-bottom: 10px; }
    .hl__c { display: inline-flex; align-items: center; gap: 8px; height: 40px; box-sizing: border-box; padding: 7px 12px;
             border: 1px solid var(--line); font-size: 13.5px; font-weight: 600; }
    .hl__c svg { width: 18px; height: 18px; flex: none; }
    .strip { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); border: 0;
             border-top: 1px solid var(--line); border-inline-end: 1px solid var(--line); }
    .strip div { min-width: 0; height: 77px; box-sizing: border-box; padding: 14px 6px; border: 0;
                 border-inline-start: 1px solid var(--line); border-bottom: 1px solid var(--line);
                 display: flex; flex-direction: column-reverse; align-items: center; justify-content: center; gap: 6px; text-align: center; }
    .strip div:last-child { border-inline-end: 0; }
    .strip span { white-space: nowrap; font-weight: 400; }
    .strip b { line-height: 1.25; }
    .lfacts { margin: 16px 0 0; }
    /* homes: the six-fact row (Sergei 01/11) takes the place of the strip and the list */
    .strip.strip--ph, .lfacts.lfacts--ph { display: none; }
    .strip.strip6 { display: grid; }

    .sec { color: var(--ink); background: var(--paper-2); height: 40px; box-sizing: border-box; line-height: 22px;
           padding: 9px 16px; margin: 32px 0 12px; }
    .desc { line-height: 1.6; max-width: none; }

    .feats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 32px; }
    .feats svg { width: 22px; height: 22px; }
    .feats--more:not(.feats--all) li:nth-child(n + 12):not(.feats__all) { display: none; }
