    .fall { appearance: none; display: flex; gap: 10px; align-items: center; background: none; border: 0; padding: 0; margin: 0;
            font: inherit; font-size: 14px; color: var(--muted); cursor: pointer; text-align: start; transition: color .15s ease; }
    .fall svg { color: currentColor; }
    .fall span { text-decoration: underline; text-underline-offset: 4px; }
    .fall:hover { color: var(--ink); font-weight: 600; }
    .fall:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    .floors { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 0; border: 1px solid var(--line); border-inline-start: 0; }
    .fl { border: 0; border-inline-start: 1px solid var(--line); padding: 18px 16px; text-align: center; }
