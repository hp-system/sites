    .dial__s svg { width: 15px; height: 15px; color: var(--muted); flex: none; }
    .qf .dial__s input { flex: 1; min-width: 0; height: 100%; border: 0; padding: 0; outline: none; font-size: 14px; background: transparent; }
    .dial__l { max-height: 228px; overflow-y: auto; }
    .dial__l button { width: 100%; display: flex; align-items: center; gap: 8px; padding: 8px 10px; background: var(--paper); border: 0;
                      font: inherit; font-size: 13.5px; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--ink); text-align: start; cursor: pointer; }
    .dial__l button:hover, .dial__l button[aria-selected='true'] { background: var(--paper-2); }
    .dial__f { width: 22px; }
    .dial__n { flex: 1; }
    .dial__c { color: var(--muted); }
    .dial__none { margin: 0; padding: 10px; font-size: 13px; color: var(--muted); }
    .qf button[type='submit'] { background: var(--paper); color: var(--ink); border: 1px solid transparent;
                                transition: background .2s ease, border-color .2s ease; }
    .qf button[type='submit']:hover { background: var(--paper-2); border-color: var(--ink); }
    .qf__fine { font-size: 11px; color: var(--muted); line-height: 1.6; }

    /* ── all photos ── */
    .gpop[open] { position: fixed; inset: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
                  background: var(--paper); color: var(--ink); display: flex; flex-direction: column; animation: gpin .3s ease both; }
    .gpop::backdrop { background: var(--paper); }
    .gpop__bar { flex: none; height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px 0 40px;
                 border-bottom: 1px solid var(--line-soft); }
