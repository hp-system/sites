    .gpop__ph img.gpop__bl { filter: blur(9px) saturate(.92); transform: scale(1.08); }
    .gpop__ph:hover img.gpop__bl { transform: scale(1.1); }
    .gpop__lk { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(10,14,16,.28); }
    .gpop__lk svg { width: 20px; height: 20px; }
    .gpop__big:not([hidden]) { position: absolute; inset: 64px 0 0; display: flex; align-items: center; justify-content: center; background: var(--paper); padding: 24px; }
    .gpop__big img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .gpop__bx { position: absolute; top: 12px; inset-inline-end: 24px; }

    /* ── back to top ── */
    .p-totop {
      all: unset; box-sizing: border-box; position: fixed; right: 24px; bottom: 24px; z-index: 70;
      width: 48px; height: 48px; display: flex; align-items: center; justify-content: center;
      background: var(--paper); border: 1px solid rgba(14,18,20,.16); color: var(--ink); cursor: pointer;
      box-shadow: 0 8px 24px rgba(0,0,0,.10); opacity: 0; transform: translateY(12px); pointer-events: none;
      transition: opacity .3s ease, transform .3s ease, background .2s ease, border-color .2s ease;
    }
    .p-totop.on { opacity: 1; transform: none; pointer-events: auto; }
    .p-totop:hover { background: var(--paper-2); border-color: var(--ink); }
    .p-totop svg { transition: transform .25s ease; }
    .p-totop:hover svg { transform: translateY(-3px); }
    .p-totop:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    :global([dir='rtl']) .p-totop { right: auto; left: 24px; }

    /* gilded edge (same accent as home and the list) */
    .p-gild { background: transparent; border: 1px solid var(--gold);
      border-image: conic-gradient(from var(--gilda), var(--gold-hi), var(--gold) 25%, var(--gold-lo) 50%, var(--gold) 75%, var(--gold-hi)) 1;
      color: var(--gold-lo); transition: color .9s ease-in-out; }
    .p-gild:hover { color: var(--gold); }
    .p-gild:focus-visible { outline: 2px solid var(--gold-dk); outline-offset: 3px; }
    .p-gild--dk { border-color: var(--gold-dk);
      border-image: conic-gradient(from var(--gilda), var(--gold-dk-hi), var(--gold-dk) 25%, var(--gold-dk-lo) 50%, var(--gold-dk) 75%, var(--gold-dk-hi)) 1;
      color: var(--gold-dk-text); }
    .p-gild--dk:hover { color: var(--gold-dk-hover); background: transparent; box-shadow: none; }
  }
  @keyframes gpin { from { opacity: 0; } to { opacity: 1; } }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .near, .zone__track, .p-totop, .p-totop svg, .cell img, .gpop__ph img, .band__ph img { transition: none; }
    .gpop[open] { animation: none; }
  }
</style>

<style is:global>
  /* #103: the gilded edge turns once on entering its box (same accent as home and the list). */
  @property --gilda { syntax: '<angle>'; inherits: false; initial-value: 315deg; }
  @keyframes p-gturn { from { --gilda: 315deg; } to { --gilda: 675deg; } }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .p-gild.grun, .lockover em.grun { animation: p-gturn 1.1s ease-in-out 1; }
  }
  @media (min-width: 1024px) { .qf__ph[hidden] { display: none !important; } }
</style>

<script>
  import { checkPhone, phoneLeadEmail, DIAL, LANG_CC } from '../lib/callback';
  import { initDial } from '../lib/dial';
  // ── ΑΓΑΠΗΜΕΝΟ (#59): εναλλαγή χωρίς επαναφόρτωση· σε αποτυχία η κατάσταση μένει ως ήταν.
  const fav = document.getElementById('fav') as HTMLButtonElement | null;
  fav?.addEventListener('click', async () => {
    if (fav.getAttribute('aria-busy') === 'true') return;
    fav.setAttribute('aria-busy', 'true');
    try {
      const r = await fetch('/api/panel/favorite', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ref: fav.dataset.ref }) });
      const d = await r.json();
      if (d?.ok) {
        fav.setAttribute('aria-pressed', d.favorite ? 'true' : 'false');
        const s = fav.querySelector('span');
        if (s) s.textContent = (d.favorite ? fav.dataset.on : fav.dataset.off) ?? '';
      }
    } catch { /* the state stays as it was */ }
    fav.removeAttribute('aria-busy');
  });

  // ── ΧΑΡΤΗΣ (#53): Leaflet + OpenStreetMap, φορτώνεται ΜΟΝΟ αν υπάρχει #pmap (δηλ. μέλος)
  //    και ΜΟΝΟ όταν πλησιάσει στην οθόνη. Ο επισκέπτης δεν κατεβάζει ούτε τη βιβλιοθήκη.
  const pm = document.getElementById('pmap');
  if (pm) {
    const LEAF = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/';
    const start = () => {
      const css = document.createElement('link');
      css.rel = 'stylesheet'; css.href = LEAF + 'leaflet.min.css';
      document.head.appendChild(css);
      const js = document.createElement('script');
      js.src = LEAF + 'leaflet.min.js';
      js.onload = () => {
        const L = (window as unknown as { L: any }).L;
        const lat = Number(pm.dataset.lat), lng = Number(pm.dataset.lng);
        const exact = pm.dataset.exact === '1';
        const map = L.map(pm, { scrollWheelZoom: false }).setView([lat, lng], exact ? 15 : 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: exact ? 18 : 14, attribution: '&copy; OpenStreetMap',
        }).addTo(map);
        if (exact) L.circleMarker([lat, lng], { radius: 8, color: '#0d1114', weight: 2, fillOpacity: .9 }).addTo(map);
        else L.circle([lat, lng], { radius: Number(pm.dataset.r), color: '#0d1114', weight: 1.5, fillOpacity: .12 }).addTo(map);
      };
      document.head.appendChild(js);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '300px' });
      io.observe(pm);
    } else start();
  }

  // ── ΟΙ ΤΕΛΙΤΣΕΣ ΤΗΣ ΓΚΑΛΕΡΙ (μόνο στο κινητό, όπου είναι ράγα) ──────────
  // Άμεσο, ΟΧΙ μέσω requestAnimationFrame: το rAF δεν τρέχει σε καρτέλα που
  // δεν ζωγραφίζεται, οπότε η ενημέρωση έμενε στην ουρά — το πληρώσαμε στις
  // κάρτες της λίστας σήμερα το πρωί.
  const gal = document.getElementById('gal');
  const dots = Array.from(document.getElementById('galdots')?.children ?? []) as HTMLElement[];
  if (gal && dots.length > 1) {
    let last = -1;
    const sync = () => {
      const w = gal.clientWidth;
      if (!w) return;
      // `Math.abs`: σε RTL (εβραϊκά) το scrollLeft είναι αρνητικό.
      const i = Math.min(dots.length - 1, Math.round(Math.abs(gal.scrollLeft) / w));
      if (i === last) return;
      last = i;
      dots.forEach((d, n) => d.toggleAttribute('data-on', n === i));
    };
    gal.addEventListener('scroll', sync, { passive: true });
    sync();
  }

  // ── ΚΟΙΝΟΠΟΙΗΣΗ: το φύλλο του κινητού αν υπάρχει, αλλιώς αντιγραφή ──────
  const sh = document.getElementById('share');
  sh?.addEventListener('click', async () => {
    const url = location.href, title = document.title;
    try {
      if (navigator.share) { await navigator.share({ title, url }); return; }
      await navigator.clipboard.writeText(url);
      const old = sh.textContent;
      sh.textContent = sh.getAttribute('data-copied') || 'OK';
      setTimeout(() => { sh.textContent = old; }, 1600);
    } catch { /* ο χρήστης ακύρωσε — καμία ενέργεια */ }
  });

  // ── ΤΟ ΠΑΡΑΘΥΡΟ ΤΗΣ ΕΠΙΣΚΕΨΗΣ ──────────────────────────────────────────
  const dlg = document.getElementById('tour') as HTMLDialogElement | null;
  document.querySelectorAll('[data-tour]').forEach((b) => {
    b.addEventListener('click', () => dlg?.showModal());
  });

  // Τα δύο πρώτα κουμπιά δείχνουν ΠΡΑΓΜΑΤΙΚΕΣ ημερομηνίες — το επόμενο
  // Σάββατο και Κυριακή. Γράφονται στον browser γιατί ο διακομιστής θα τις
  // «έψηνε» στη σελίδα και μια αποθηκευμένη σελίδα θα έδειχνε περασμένη μέρα.
  const lang = document.documentElement.lang || 'el';
  const now = new Date();
  document.querySelectorAll<HTMLElement>('[data-day]').forEach((el) => {
    const want = el.dataset.day === '0' ? 6 : 0;           // 6 = Σάββατο, 0 = Κυριακή
    const d = new Date(now);
    d.setDate(now.getDate() + ((want - now.getDay() + 7) % 7 || 7));
    el.textContent = d.toLocaleDateString(lang, { weekday: 'short', day: 'numeric', month: 'numeric' });
  });

  // ── ΟΙ ΔΥΟ ΦΟΡΜΕΣ → /api/inquiry ────────────────────────────────────────
  // Μία διαδρομή για τα δύο: η επίσκεψη είναι αίτημα με «πότε» μέσα στο μήνυμα.
  // Έτσι ο George τα βλέπει και τα δύο στο ίδιο σημείο του CRM, με ξεχωριστή
  // σήμανση για να μετρηθεί ποιο δουλεύει (data-ev στα κουμπιά).
  const opened = Date.now();
  const propertyId = location.pathname.split('/').filter(Boolean).pop() || '';

  const wire = (form: HTMLFormElement | null, okSel: string, extra: () => string) => {
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement | null;
      const fd = new FormData(form);
      const body = {
        name: String(fd.get('name') ?? ''),
        email: String(fd.get('email') ?? fd.get('contact') ?? ''),
        phone: String(fd.get('phone') ?? ''),
        message: extra(),
        website: String(fd.get('website') ?? ''),
        propertyId, lang, t: opened,
      };
      // Το πεδίο επαφής της επίσκεψης δέχεται ή email ή τηλέφωνο. A phone gets its own address
      // (one per number, #82): with `<property>@lead.local` the CRM attached every later visitor
      // on the same property to the first one and dropped their phone. The phone also goes in the message.
      // #103 desktop: name + surname, the dialling code in front of the number, the message.
      if (form.id === 'qf' && desk.matches) {
        body.name = `${String(fd.get('first') ?? '').trim()} ${String(fd.get('last') ?? '').trim()}`.trim();
        const ph = body.phone.trim();
        if (ph) body.phone = /^(\+|00)/.test(ph) ? ph : `+${dialW?.code() ?? '30'} ${ph}`;
        body.message = String(fd.get('message') ?? '').trim();
      }
      if (!/.+@.+\..+/.test(body.email)) {
        body.phone = body.email;
        const digits = body.phone.replace(/\D/g, '');
        body.email = digits.length >= 6 ? phoneLeadEmail('+' + digits) : `${propertyId}@lead.local`;
        body.message = `${body.message}; phone=${body.phone}`;
      }
      if (btn) btn.disabled = true;
      try {
        const r = await fetch('/api/inquiry', {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body),
        });
        if (!r.ok) throw new Error('bad');
        form.querySelectorAll('input, button, textarea, .qf__ph').forEach((x) => ((x as HTMLInputElement).hidden = true));
        const ok = form.querySelector(okSel) as HTMLElement | null;
        if (ok) ok.hidden = false;
        // The lead counts only now — after the server accepted it (Q-013), never on click.
        const ev = form.getAttribute('data-ev');
        const track = (window as unknown as { __track?: (n: string, x?: object) => void }).__track;
        if (ev && track) track(ev, { ev_page: location.pathname, property_id: propertyId });
      } catch {
        if (btn) { btn.disabled = false; }
      }
    });
  };
  wire(document.getElementById('qf') as HTMLFormElement, '.qf__ok', () => '');

  // ── «ΝΑ ΣΕ ΚΑΛΕΣΟΥΜΕ» (#82) → /api/callback ─────────────────────────────
  const sheet = document.getElementById('callsheet') as HTMLDialogElement | null;
  document.querySelector('[data-callsheet]')?.addEventListener('click', () => sheet?.showModal());
  const opener = document.querySelector<HTMLButtonElement>('.cb-open');
  const panel = document.getElementById('cb-d');
  const toggle = (open: boolean) => {
    if (!panel || !opener) return;
    panel.hidden = !open; opener.setAttribute('aria-expanded', String(open));
    if (open) (panel.querySelector('input[name=phone]') as HTMLInputElement | null)?.focus();
  };
  opener?.addEventListener('click', () => toggle(!!panel?.hidden));
  panel?.querySelector('[data-cb-close]')?.addEventListener('click', () => { toggle(false); opener?.focus(); });

  // First guess of the country: the browser's region (de-AT → Austria), else the page language.
  const region = (navigator.languages ?? [navigator.language]).map((l) => l.split('-')[1]?.toUpperCase()).find((r) => r && DIAL.some((d) => d.cc === r));
  const guess = region || LANG_CC[lang] || 'GR';
  document.querySelectorAll<HTMLFormElement>('form[data-cb]').forEach((form) => {
    const sel = form.querySelector('select[name=code]') as HTMLSelectElement;
    const inp = form.querySelector('input[name=phone]') as HTMLInputElement;
    const err = form.querySelector('.cb__err') as HTMLElement;
    const pick = (cc: string) => { const o = [...sel.options].find((x) => x.dataset.cc === cc); if (o) sel.value = o.value; };
    pick(guess);
    // A member's number arrives complete (+49…): split it into the list and the field.
    const pre = inp.value.trim();
    if (/^(\+|00)/.test(pre)) {
      const d = pre.replace(/\D/g, '').replace(/^00/, '');
      const hit = DIAL.map((x) => x.code).sort((a, b) => b.length - a.length).find((c) => d.startsWith(c));
      if (hit) { sel.value = hit; inp.value = d.slice(hit.length); }
    }
    const say = (m: string) => { err.textContent = m; err.hidden = !m; inp.setAttribute('aria-invalid', m ? 'true' : 'false'); };
    inp.addEventListener('input', () => say(''));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const c = checkPhone(sel.value, inp.value);
      if (!c.ok) { say(form.dataset[c.code === 'gr' ? 'eGr' : 'eShort'] ?? ''); inp.focus(); return; }
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      btn.disabled = true;
      const fd = new FormData(form);
      try {
        const r = await fetch('/api/callback', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ code: sel.value, phone: inp.value, when: fd.get('when'), website: fd.get('website'), propertyId, lang, t: opened }),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error(j.code || 'bad');
        [...form.children].forEach((x) => { if (!x.classList.contains('cb__done')) (x as HTMLElement).hidden = true; });
        const done = form.querySelector('.cb__done') as HTMLElement;
        (done.querySelector('[data-cb-to]') as HTMLElement).textContent = (form.dataset.to ?? '').replace('{p}', '\u2066' + (/^(\+|00)/.test(inp.value.trim()) ? c.e164 : `+${sel.value} ${inp.value.trim()}`) + '\u2069');
        done.hidden = false;
        const track = (window as unknown as { __track?: (n: string, x?: object) => void }).__track;
        track?.('lead:callback_submit', { ev_page: location.pathname, property_id: propertyId });
      } catch (x) {
        const code = (x as Error).message;
        say(code === 'gr' ? form.dataset.eGr ?? '' : code === 'short' ? form.dataset.eShort ?? '' : form.dataset.eErr ?? '');
        btn.disabled = false;
      }
    });
  });
  wire(document.getElementById('tf') as HTMLFormElement, '.tf__ok', () => {
    const w = (document.querySelector('input[name=when]:checked') as HTMLInputElement | null)?.value ?? '';
    const label = document.querySelector('input[name=when]:checked + span')?.textContent?.trim() ?? w;
    return `TOUR: ${label}`;
  });

  // ═══ #103 DESKTOP (≥1024px) — the property page redesign approved by George 2026-11-02 ═══
  // Phones keep George's behaviour: every handler below checks `desk` first.
  const desk = window.matchMedia('(min-width: 1024px)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ── All photos: a click on a gallery photo (or on the «N more photos» tile outside its
  //    button) opens the popup. The «Free registration» button keeps its sign-in link.
  const gpop = document.getElementById('gpop') as HTMLDialogElement | null;
  const gbig = document.getElementById('gbig');
  const openPop = () => {
    if (!gpop || gpop.open || typeof gpop.showModal !== 'function') return false;
    gpop.showModal();
    document.documentElement.style.overflow = 'hidden';
    return true;
  };
  gpop?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    if (gbig) gbig.hidden = true;
    if (location.hash === '#photos') history.replaceState(null, '', location.pathname + location.search);
  });
  gpop?.querySelector('[data-gpop-x]')?.addEventListener('click', () => gpop.close());
  document.getElementById('gal')?.addEventListener('click', (e) => {
    if (!desk.matches || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const tg = e.target as Element;
    const cell = tg.closest('.cell');
    if (!cell || tg.closest('[data-reg]')) return;          // the button: George's sign-in link
    if (openPop()) e.preventDefault();
  });
  // Member: a tile opens the photo larger inside the popup (watermarked 1920 px).
  if (gpop && gbig) {
    const img = gbig.querySelector('img') as HTMLImageElement;
    gpop.querySelectorAll<HTMLElement>('[data-big]').forEach((b) => b.addEventListener('click', () => {
      img.src = b.dataset.big ?? ''; img.alt = b.querySelector('img')?.alt ?? '';
      gbig.hidden = false;
    }));
    gbig.querySelector('[data-gbig-x]')?.addEventListener('click', () => { gbig.hidden = true; });
    // Esc: the large photo first, then the popup.
    gpop.addEventListener('cancel', (e) => { if (!gbig.hidden) { e.preventDefault(); gbig.hidden = true; } });
  }
  if (location.hash === '#photos' && desk.matches) openPop();

  // ── «All N features»: every feature is already in the HTML; this only shows/hides them.
  document.querySelectorAll<HTMLButtonElement>('.fall').forEach((b) => b.addEventListener('click', () => {
    const ul = document.getElementById('feats');
    const all = !ul?.classList.contains('feats--all');
    ul?.classList.toggle('feats--all', all);
    b.setAttribute('aria-expanded', String(all));
    const s = b.querySelector('span'); if (s) s.textContent = (all ? b.dataset.less : b.dataset.more) ?? '';
    b.querySelector('path')?.setAttribute('d', all ? 'M4 4h16v16H4zM8 12h8' : 'M4 4h16v16H4zM8 12h8M12 8v8');
  }));

  // ── «Nearby» panel over the map / lock: open at load, × closes, the pill reopens.
  const loc = document.getElementById('loc');
  if (loc?.classList.contains('loc--near')) {
    const set = (o: boolean) => {
      loc.classList.toggle('is-open', o);
      loc.querySelectorAll('[data-near]').forEach((x) => x.setAttribute('aria-expanded', String(o)));
    };
    set(true);
    loc.querySelectorAll('[data-near]').forEach((x) => x.addEventListener('click', () => set(!loc.classList.contains('is-open'))));
  }

  // ── Country code with search (George's DIAL list). First guess: browser region, else the language.
  //    The picker logic lives in lib/dial.ts (shared with the desktop sign-in popup, #104).
  const dialW = initDial(document.getElementById('qf-ph'), guess,
    () => (document.getElementById('qf-p') as HTMLInputElement | null)?.focus());

  // ── The form: on desktop «Name» + «Surname» are required, George's one field on phones.
  const qfN = document.getElementById('qf-n') as HTMLInputElement | null;
  const qfF = document.getElementById('qf-f') as HTMLInputElement | null;
  const syncReq = () => { if (qfN) qfN.required = !desk.matches; if (qfF) qfF.required = desk.matches; };
  syncReq(); desk.addEventListener?.('change', syncReq);

  // ── About band: the photo loads only near the screen, only on desktop; the glass cards and
  //    the big lock drift down while the band crosses the screen.
  const band = document.getElementById('band');
  const bandImg = band?.querySelector<HTMLImageElement>('img[data-src]');
  if (band && bandImg && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => {
      if (!desk.matches || !es.some((x) => x.isIntersecting)) return;
      io.disconnect();
      bandImg.addEventListener('load', () => bandImg.classList.add('on'), { once: true });
      bandImg.src = bandImg.dataset.src ?? '';
    }, { rootMargin: '600px 0px' });
    io.observe(band);
  }
  const cards = document.getElementById('bandCards');
  const lock = document.getElementById('fullLock');
  const drift = () => {
    if (!desk.matches || still.matches) { if (cards) cards.style.transform = ''; if (lock) lock.style.transform = ''; return; }
    const vh = window.innerHeight;
    if (band && cards) {
      const r = band.getBoundingClientRect();
      const need = cards.offsetHeight + 48;
      if (band.clientHeight < need) band.style.minHeight = need + 'px';
      const p = Math.min(1, Math.max(0, (vh - r.height - r.top) / Math.max(1, vh - r.height - 96)));
      cards.style.transform = `translateY(${(p * Math.max(0, band.clientHeight - cards.offsetHeight)).toFixed(1)}px)`;
    }
    if (lock?.parentElement) {
      const lr = lock.parentElement.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (vh - lr.height - lr.top) / Math.max(1, vh - lr.height - 96)));
      lock.style.transform = `translateY(${(p * Math.max(0, lock.parentElement.clientHeight - 100)).toFixed(1)}px)`;
    }
  };

  // ── Area zone: a page of three every 5 s (paused under the pointer); the last page is full.
  const track = document.getElementById('zoneTrack');
  const zoneEl = document.getElementById('zone');
  const zdots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-zp]'));
  if (track && zoneEl && zdots.length > 1) {
    const n = track.children.length;
    let page = 0, at = Date.now(), hold = false;
    const go = (k: number) => {
      page = (k + zdots.length) % zdots.length; at = Date.now();
      const first = Math.min(Math.max(0, n - 3), page * 3);
      const sign = document.documentElement.dir === 'rtl' ? 1 : -1;
      track.style.transform = `translateX(calc(${sign * first} * ((100% - 32px) / 3 + 16px)))`;
      zdots.forEach((d, i) => { d.classList.toggle('on', i === page); d.setAttribute('aria-current', String(i === page)); });
    };
    zdots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    zoneEl.addEventListener('mouseenter', () => { hold = true; });
    zoneEl.addEventListener('mouseleave', () => { hold = false; at = Date.now(); });
    zoneEl.addEventListener('focusin', () => { hold = true; });
    zoneEl.addEventListener('focusout', () => { hold = false; at = Date.now(); });
    if (!still.matches) setInterval(() => { if (!hold && !document.hidden && desk.matches && Date.now() - at >= 5000) go(page + 1); }, 250);
  }

  // ── The price box lands on the bottom line of the area zone at the end of the page: over the
  //    last stretch it slides down by the gap that would be left. The real scroller is found
  //    (page or a scrolling parent); the shift is capped so a wrong measure never hides the box.
  const side = document.getElementById('side');
  let dockS = 0, dockRaf = 0;
  const dock = () => {
    if (dockRaf) return;
    dockRaf = requestAnimationFrame(() => {
      dockRaf = 0;
      if (!side) return;
      if (!desk.matches) { if (dockS) { dockS = 0; side.style.transform = ''; } return; }
      let se: Element | null = side.parentElement;
      while (se && se !== document.body && !(/(auto|scroll)/.test(getComputedStyle(se).overflowY) && se.scrollHeight > se.clientHeight + 1)) se = se.parentElement;
      const root = document.scrollingElement || document.documentElement;
      if (!se || se === document.body) se = root;
      const viewH = se === root ? window.innerHeight : se.clientHeight;
      const g = side.parentElement as HTMLElement;
      const ar = side.getBoundingClientRect(), gr = g.getBoundingClientRect();
      const left = Math.max(0, se.scrollHeight - (se.scrollTop + viewH));
      const gapEnd = (gr.bottom + left) - (ar.bottom - dockS);
      const stuck = Math.abs((ar.top - dockS) - (parseFloat(getComputedStyle(side).top) || 0)) < 1.5;
      const s = stuck && gapEnd > 0 && gapEnd < 160 ? Math.min(gapEnd, Math.max(0, gapEnd - left)) : 0;
      if (Math.abs(s - dockS) > 0.5) { dockS = s; side.style.transform = s ? `translateY(${s}px)` : ''; }
    });
  };

  // ── Back to top, after one screen.
  const top = document.getElementById('toTop');
  top?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: still.matches ? 'auto' : 'smooth' }));
  const onScroll = () => {
    top?.classList.toggle('on', desk.matches && window.scrollY > window.innerHeight * 0.8);
    drift(); dock();
  };
  document.addEventListener('scroll', onScroll, { passive: true, capture: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();

  // ── Gilded edges turn once when the pointer enters their box.
  document.querySelectorAll<HTMLElement>('.p-gild, .lockover em').forEach((g) => {
    const run = () => {
      if (!desk.matches || still.matches) return;
      g.classList.remove('grun'); void g.offsetWidth; g.classList.add('grun');
    };
    (g.closest('.tt, .cell, .full') ?? g.parentElement)?.addEventListener('mouseenter', run);
  });
</script>
