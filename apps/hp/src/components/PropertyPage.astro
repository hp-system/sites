    /* ── location: map / lock with the «Nearby» panel ── */
    .place { margin: 0 0 8px; }
    .loc { position: relative; height: 380px; overflow: hidden; border: 1px solid var(--line); background: var(--paper); }
    .loc--nomap { height: auto; overflow: visible; border: 0; }
    .loc .maplock { height: 100%; }
    .loc .maplock__in { transition: padding .25s ease; }
    .loc--near.is-open .maplock__in { padding-inline-end: 324px; }
    .loc .pmap { margin: 0; height: 100%; }
    .loc .pmap__map { height: 100%; }
    .loc .pmap__cap { position: absolute; inset-inline-start: 12px; bottom: 12px; z-index: 500; margin: 0; background: var(--paper);
                      border: 1px solid var(--line); padding: 8px 12px; color: var(--ink-2); gap: 12px; }
    .near { position: absolute; top: 0; bottom: 0; inset-inline-end: 0; width: 300px; z-index: 600; background: var(--paper);
            border-inline-start: 1px solid var(--line); display: flex; flex-direction: column; transform: translateX(101%); transition: transform .25s ease; }
    :global([dir='rtl']) .near { transform: translateX(-101%); }
    .loc--near.is-open .near { transform: none; }
    .loc--nomap .near { position: static; width: auto; transform: none; border: 1px solid var(--line); }
    .near__h { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px 8px 18px; border-bottom: 1px solid var(--line);
               font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
    .loc--nomap .near__h { display: none; }
    .near__x { appearance: none; width: 28px; height: 28px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; padding: 0; color: var(--ink); }
    .near__x svg { width: 11px; height: 11px; }
    .near .dists { flex: 1; overflow-y: auto; margin: 0; padding: 2px 18px; display: block; }
    .near .dists li { padding: 7px 0; border-bottom: 1px solid var(--line-soft); align-items: center; gap: 10px; line-height: 1.3; }
    .near .dists li:last-child { border-bottom: 0; }
    .near .dists span { color: var(--muted); }
    .near__open { position: absolute; inset-inline-end: 12px; bottom: 12px; z-index: 600; display: none; gap: 8px; align-items: center; height: 36px;
                  padding: 0 14px; background: var(--paper); color: var(--ink); border: 1px solid var(--line); font: inherit; font-size: 13px;
                  font-weight: 600; cursor: pointer; }
    .near__open svg { width: 16px; height: 16px; }
    .loc--near:not(.is-open):not(.loc--nomap) .near__open { display: flex; }
    .near__x:focus-visible, .near__open:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    /* ── About <municipality>: the photo band edge to edge, two glass cards, attached to Location ── */
    .muni { position: relative; min-height: 390px; margin-top: 0; }
    .band__win { display: block; position: absolute; top: 0; bottom: 0; left: -100vw; right: -100vw; overflow: hidden; background: var(--paper-2); }
