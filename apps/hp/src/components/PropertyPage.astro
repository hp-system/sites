    .pc { flex: none; width: calc((100% - 32px) / 3); display: flex; flex-direction: column; align-items: center; text-align: center; }
    .pci { display: block; width: 100%; height: 160px; overflow: hidden; background: var(--paper); }
    .pci img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s ease; }
    .pc:hover .pci img { transform: scale(1.03); }
    .pct { display: flex; align-items: flex-start; justify-content: center; color: var(--ink); text-decoration: none; margin: 14px 0 0;
           min-height: 45px; font-size: 18px; font-weight: 600; line-height: 1.25; letter-spacing: -.012em; max-width: 280px; }
    .pca { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: auto; padding-top: 10px; }
    .pcb { display: inline-flex; align-items: center; height: 36px; padding: 0 16px; background: var(--paper); color: var(--ink);
           border: 1px solid var(--line); font-size: 10px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
           text-decoration: none; white-space: nowrap; transition: border-color .15s ease; }
    .pcb:hover { border-color: var(--ink); }
    .pcl { font-size: 13px; color: var(--ink); text-decoration: none; white-space: nowrap; }
    .pcl:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* ── the price box: frosted glass, sticky, lands on the bottom of the area zone ── */
    .side { position: sticky; top: 12px; align-self: start; z-index: 6; transition: top .25s ease; }
    .card { position: relative; top: auto; border: 1px solid var(--line); padding: 7px 18px 28px; display: flex; flex-direction: column; gap: 14px;
            background: linear-gradient(160deg, rgba(255,255,255,.80) 0%, rgba(255,255,255,.64) 45%, rgba(255,255,255,.72) 100%);
            -webkit-backdrop-filter: blur(22px) saturate(170%); backdrop-filter: blur(22px) saturate(170%); }
    .pbp { display: flex; align-items: baseline; gap: 10px; height: 26px; white-space: nowrap; }
    .pbp .price, .pbp .per { font-variant-numeric: lining-nums proportional-nums; }   /* Sergei 03/11: price digits read normally */
    .pbp .price { font-size: 26px; font-weight: 600; line-height: 1; letter-spacing: -.012em; }
    .pbp .price.t-h3 { font-size: 20px; }
    .pbp .per { margin: 0; }
    .pbp .old { order: 3; font-size: 12px; }
    .cta { height: 40px; padding: 0 12px; margin: 0; transition: background .2s ease, color .2s ease, border-color .2s ease; }
    .card > .cta[data-tour] { margin-top: 2px; }
    .cta:hover { opacity: 1; background: var(--paper-2); color: var(--ink); border-color: var(--ink); }
    .cta svg { transition: transform .25s ease; }
    .cta:hover svg { transform: scale(1.12); }
    /* Sergei 03/11: WhatsApp as wide as «Request a tour» */
    .cta--wa { border-color: transparent; align-self: stretch;   /* the green edge shows on hover only (Sergei 03/11) */
               width: 100%; height: 40px; padding: 0 12px; margin: 0; }
    .cta--wa:hover { background: var(--paper-2); color: #1faa53; border-color: #1faa53; }
    /* the phone as in the header: icon + number, proportional digits; no «or», no «we call you» */
    .tel__or, .tel__cb { display: none; }
    /* Sergei 03/11: the number is a button shaped like WhatsApp, in the colours of «Send» */
    .tel { margin: 0; }
    .tel a { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 40px; box-sizing: border-box;
             font-size: 12px; font-weight: 600; letter-spacing: .08em; color: var(--ink); background: var(--paper);
             border: 1px solid transparent; font-variant-numeric: lining-nums proportional-nums;
             transition: background .2s ease, border-color .2s ease; }
    .tel a:hover { background: var(--paper-2); border-color: var(--ink); opacity: 1; }
    .tel a:hover .tel__ic { transform: scale(1.12); }
    .tel__ic { transition: transform .25s ease; }
    .tel__ic { display: block; width: 17px; height: 17px; flex: none; }
    .tel { margin: -4px 0 0; }
    .qf { border-top: 0; margin: 0; padding: 0; gap: 10px; }
    .qf input, .qf__msg { height: 38px; padding: 0 11px; }
    .qf #qf-n, .qf__int { display: none; }
    .qf__d { display: block; }
    .qf__msg { width: 100%; box-sizing: border-box; height: auto; min-height: 72px; padding: 8px 11px; border: 1px solid var(--line); background: var(--paper);
               color: var(--ink); font: inherit; font-size: 14px; line-height: 1.5; resize: vertical; }
    .qf__msg:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
    .qf__ph { position: relative; display: flex; height: 38px; border: 1px solid var(--line); background: var(--paper); box-sizing: border-box; }
    .qf__ph #qf-p { flex: 1; min-width: 0; height: 100%; border: 0; background: transparent; }
    .qf .dial { display: flex; flex: none; width: 88px; height: 100%; align-items: center; justify-content: space-between; gap: 4px; padding: 0 8px;
            background: transparent; border: 0; border-inline-end: 1px solid var(--line); font: inherit; font-size: 13px; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--ink); cursor: pointer; }
    .qf .dial svg { width: 10px; height: 10px; flex: none; }
    .qf .dial:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
    .dial__pop:not([hidden]) { display: block; position: absolute; left: -1px; right: -1px; top: calc(100% + 4px); z-index: 40; background: var(--paper);
                               border: 1px solid rgba(14,18,20,.16); box-shadow: 0 12px 28px rgba(10,14,16,.14); }
