    .gpop__t span { font-weight: 400; color: var(--muted); }
    .gpop__x { appearance: none; width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; cursor: pointer;
               color: var(--ink); transition: background .15s ease; padding: 0; }
    .gpop__x svg { width: 20px; height: 20px; }
    .gpop__x:hover { background: var(--paper-2); }
    .gpop__x:focus-visible, .gpop__ph:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
