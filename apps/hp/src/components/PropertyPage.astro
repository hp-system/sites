  .btn { appearance: none; border: 1px solid var(--line); background: none; color: var(--ink);
         font: inherit; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase;
         padding: 0 14px; height: 44px; box-sizing: border-box; cursor: pointer; text-decoration: none;
         display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .btn svg { width: 13px; height: 13px; flex: none; }
  .btn--fav:hover, .btn:hover { border-color: var(--ink); }
  .btn--fav[aria-pressed='true'] svg { fill: currentColor; }
  .btn--fav[aria-busy='true'] { opacity: .6; }
  .btn--go { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  /* ═══ ΓΚΑΛΕΡΙ ═══════════════════════════════════════════════════════════
     ΚΙΝΗΤΟ ΠΡΩΤΑ: ΜΙΑ φωτογραφία, σύρσιμο (ρητή οδηγία George 30/7).
     🪤 Το `scroll-snap` θέλει `overflow-y: hidden` ΡΗΤΑ — αλλιώς το iOS κάνει
        και τον κάθετο άξονα κυλιόμενο και η φωτό γλιστράει μέσα στο πλαίσιο
        (το πληρώσαμε στις κάρτες της λίστας). */
  .galwrap { position: relative; margin: 0 0 var(--s5); }
  .gal {
    display: grid; grid-auto-flow: column; grid-auto-columns: 100%;
    overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none;
  }
  .gal::-webkit-scrollbar { display: none; }
  .cell { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden;
          background: var(--paper-2); scroll-snap-align: start; scroll-snap-stop: always; }
  .cell img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* Η εικόνα είναι ΗΔΗ κατεστραμμένη (24px). Το `blur` εδώ είναι μόνο για να
     μη φαίνονται τετραγωνάκια στη μεγέθυνση — καλλωπισμός, όχι κλείδωμα. */
  .cell--locked img { filter: blur(7px) saturate(.92); transform: scale(1.06); }
  .lockmark { position: absolute; inset: 0; display: grid; place-content: center;
              color: #fff; background: rgba(10,14,16,.24); }
