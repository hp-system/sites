---
// In the panel frame (PanelShell, design E3). THE MEMBER'S REQUESTS — `/panel/request` (Sergei 2026-11-23).
//
// «Add a request» opens the list's filter window (FilterSheet, request mode). On «Send to my adviser» the request
// goes to the CRM (the adviser sees it in the inquiries), the list below keeps it, and the member lands on the
// property list filtered as chosen. Each saved request: its line, the date, «See the homes» (the list with those
// filters), change (the window filled with it), remove.
//
// 🗄️ WHERE THE LIST LIVES: in this browser (localStorage `hp.requests`), by Sergei's choice of 2026-11-23, until the
//    CRM stores searches and gives them back; then this page reads the CRM instead. The page says so in one line.
//    Nothing private is in it: the filters only. Removing here does not withdraw the request the adviser received.
import PanelShell from './PanelShell.astro';
import { t, listUrl, type Lang } from '../lib/i18n';
import type { Member } from '../lib/member';

interface Props { lang: Lang; me: Member }
const { lang, me } = Astro.props;
const JS_T = { saved: t(lang, 'rq.saved'), see: t(lang, 'rq.see'), change: t(lang, 'sb.change'), del: t(lang, 'rq.del'), any: t(lang, 'rq.any') };
---
<PanelShell lang={lang} me={me} current={'request'} title={t(lang, 'pnl.row_req')} description={t(lang, 'req.sub')}>
  <div class="rs" data-rs data-list={listUrl(lang)} data-lang={lang} data-i18n={JSON.stringify(JS_T)}>
    <div class="rs__top">
      <h1 class="t-h2 rs__h">{t(lang, 'pnl.row_req')}</h1>
      <a class="rs__add" href={listUrl(lang)} data-fs-open>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        <b>{t(lang, 'rq.add')}</b>
      </a>
    </div>

    <div class="rs__list" data-rs-list hidden></div>

    <div class="empty" data-rs-empty>
      <p class="empty__h">{t(lang, 'rq.empty_h')}</p>
      <p class="empty__s">{t(lang, 'rq.empty_s')}</p>
      <a class="btn" href={listUrl(lang)} data-fs-open>{t(lang, 'rq.add')}</a>
    </div>

    <p class="rs__note" data-rs-note hidden>{t(lang, 'rq.device')}</p>
  </div>
</PanelShell>

<script>
  type Req = { id: string; q: string; text: string; at: number };
  const KEY = 'hp.requests';
  const root = document.querySelector<HTMLElement>('[data-rs]');
  const L: Record<string, string> = JSON.parse(root?.dataset.i18n || '{}');
  const read = (): Req[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
  const write = (xs: Req[]) => { try { localStorage.setItem(KEY, JSON.stringify(xs)); } catch { /* storage off */ } };

  const render = () => {
    if (!root) return;
    const xs = read();
    const list = root.querySelector<HTMLElement>('[data-rs-list]')!;
    list.replaceChildren();
    const date = new Intl.DateTimeFormat(root.dataset.lang || 'en', { day: 'numeric', month: 'short', year: 'numeric' });
    const svg = (d: string) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"></path></svg>`;
    xs.forEach((r) => {
      // E3 card (Sergei 2026-11-23 «как карточки, как в мокапе, показывая все детали»): the photo of the first home that
      // fits, the pencil and the bin over it, the place and kind as the title, every other choice under it, the date
      // the values alone read well («Kassandra», «Up to €900,000»); bare numbers keep their group («Bedrooms: 3, 4»)
      const vals = (r.text && r.text !== 'any' ? r.text.split('; ') : []).map((x) => { const v = x.replace(/^[^:]+:\s*/, ''); return /^[\d,\s+]+$/.test(v) ? x : v; });
      const href = `${root.dataset.list}${r.q ? `?${r.q}` : ''}`;
      const card = document.createElement('article');
      card.className = 'rq';
      const ph = document.createElement('div');
      ph.className = 'rq__ph';
      const pa = document.createElement('a');
      pa.className = 'rq__pa'; pa.href = href; pa.setAttribute('aria-label', L.see);
      ph.append(pa);
      const ed = document.createElement('button');
      ed.type = 'button'; ed.className = 'rq__ic'; ed.title = L.change; ed.setAttribute('aria-label', L.change);
      ed.innerHTML = svg('M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4');
      ed.dataset.fsEdit = r.id; ed.dataset.fsQ = r.q;
      const del = document.createElement('button');
      del.type = 'button'; del.className = 'rq__ic'; del.title = L.del; del.setAttribute('aria-label', L.del);
      del.innerHTML = svg('M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13');
      del.addEventListener('click', () => { write(read().filter((x) => x.id !== r.id)); render(); });
      const tools = document.createElement('span'); tools.className = 'rq__tools'; tools.append(ed, del);
      ph.append(tools);
      const top = document.createElement('a');
      top.className = 'rq__t'; top.href = href;
      top.textContent = vals.length ? vals.slice(0, 2).join(' · ') : L.any;
      card.append(ph, top);
      if (vals.length > 2) { const sub = document.createElement('p'); sub.className = 'rq__s'; sub.textContent = vals.slice(2).join(' · '); card.append(sub); }
      const when = document.createElement('p');
      when.className = 'rq__d';
      when.textContent = (L.saved || '{d}').replace('{d}', date.format(new Date(r.at)));
      card.append(when);
      list.append(card);
      // the photo: the first home that fits (watermarked, as on the list); none → a plain plate
      fetch(`/api/count?${r.q}${r.q ? '&' : ''}cover=1`).then((x) => x.json()).then((j) => {
        if (!j?.cover) return;
        const img = document.createElement('img');
        img.src = j.cover; img.alt = ''; img.loading = 'lazy'; img.decoding = 'async';
        pa.append(img);
      }).catch(() => {});
    });
    list.hidden = xs.length === 0;
    root.querySelector<HTMLElement>('[data-rs-empty]')!.hidden = xs.length > 0;
    root.querySelector<HTMLElement>('[data-rs-note]')!.hidden = xs.length === 0;
    // the change buttons are made here, after the filter window wired its openers: hand them over
    list.querySelectorAll<HTMLElement>('[data-fs-edit]').forEach((b) => b.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('fs:edit', { detail: { id: b.dataset.fsEdit, q: b.dataset.fsQ } }));
    }));
  };
  render();
</script>

<style>
  .rs { padding: 0 0 var(--s9); }
  .rs__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 0 0 var(--s4); }
  .rs__h { margin: 0; }
  .rs__add { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; margin-inline-end: -12px; color: var(--ink); text-decoration: none;
    font-size: var(--fs-s-1); transition: background .15s ease; }
  .rs__add:hover { background: var(--paper-2); }
  .rs__add b { font-weight: 600; }

  .rs__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; }
  @media (max-width: 1100px) { .rs__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .rs__list { grid-template-columns: 1fr; } }
  .rs__list[hidden] { display: none; }
  .rs__list :global(.rq) { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .rs__list :global(.rq__ph) { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--paper-2); margin-bottom: 8px; }
  .rs__list :global(.rq__pa) { position: absolute; inset: 0; display: block; }
  .rs__list :global(.rq__pa img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .rs__list :global(.rq:hover .rq__pa img) { transform: scale(1.03); }
  .rs__list :global(.rq__tools) { position: absolute; top: 10px; right: 10px; display: flex; gap: 8px; }
  .rs__list :global(.rq__ic) { width: 34px; height: 34px; border-radius: 50%; border: 0; background: var(--paper); color: var(--ink); cursor: pointer;
    display: flex; align-items: center; justify-content: center; transition: background .2s ease; }
  .rs__list :global(.rq__ic:hover) { background: var(--paper-2); }
  .rs__list :global(.rq__ic:focus-visible) { outline: 2px solid var(--brand); outline-offset: 2px; }
  .rs__list :global(.rq__t) { font-size: var(--fs-s0); font-weight: 600; color: var(--ink); text-decoration: none; line-height: 1.3; }
  .rs__list :global(.rq__t:hover) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .rs__list :global(.rq__s) { margin: 0; font-size: var(--fs-s-1); color: var(--ink-2); line-height: 1.45; }
  .rs__list :global(.rq__d) { margin: 0; font-size: var(--fs-s-1); color: var(--faint); }

  .empty[hidden] { display: none; }
  .empty { border: 1px solid var(--line); padding: 32px 16px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .empty__h { margin: 0; font-size: var(--fs-s1); font-weight: 300; }
  .empty__s { margin: 0 0 6px; font-size: var(--fs-s-1); color: var(--muted); max-width: 46ch; }
  .rs__note { margin: 14px 0 0; font-size: var(--fs-s-1); color: var(--faint); }
</style>
