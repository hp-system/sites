---
// ═══════════════════════════════════════════════════════════════════════════
// Η ΜΠΑΡΑ ΑΝΑΖΗΤΗΣΗΣ — κάθεται πάνω στο κάτω άκρο του hero.
//
// ΑΛΛΑΓΕΣ 28/7 (ανασκόπηση George στο desktop):
//  · ΟΛΑ ΣΕ ΜΙΑ ΕΥΘΕΙΑ. Ήταν δύο σειρές, 146px· τώρα μία, ~72px. Ο κωδικός και
//    τα φίλτρα ανέβηκαν δίπλα στα δύο πεδία — «να το μικρύνουμε και να το
//    συμπιέσουμε λιγάκι, γιατί έχει αρκετή πληροφορία».
//  · ΤΟ ΚΟΥΜΠΙ ΑΦΗΝΕΙ ΤΟ ΙΔΙΟ ΚΕΝΟ ΑΠΟ ΟΛΕΣ ΤΙΣ ΠΛΕΥΡΕΣ. Πριν, το μαύρο
//    ακουμπούσε τη γραμμή στο κάτω μέρος ενώ πάνω/δεξιά είχε το περίγραμμα:
//    «αφήνει ένα λευκό κενό από πάνω και από δεξιά· ίσως θα ήταν ωραίο να
//    αφήνει το ίδιο κενό και από κάτω».
//  · ΤΟ ΜΠΛΕ ΠΛΑΙΣΙΟ ΤΟΥ ΚΩΔΙΚΟΥ ΕΦΥΓΕ. Αιτία: το `<input type=text>` ενεργοποιεί
//    `:focus-visible` ΚΑΙ με ποντίκι, ενώ τα δικά μας dropdown (κουμπιά) μόνο με
//    Tab — γι' αυτό μπλε γινόταν μόνο αυτό. Δες base.css → ένας κανόνας για όλα.
//
// 🔑 ΤΙ ΚΑΝΕΙ ΤΟ ENTER — η ερώτηση του George, απαντημένη ΚΑΙ οπτικά:
//    Ο κωδικός δεν είναι φίλτρο, είναι ΔΙΕΥΘΥΝΣΗ. Αν έχει τιμή, υπερισχύει και
//    πάμε κατευθείαν στο ακίνητο· αλλιώς τρέχει η κανονική αναζήτηση. Για να
//    μη χρειάζεται να το μαντέψει κανείς, μόλις γραφτεί κωδικός τα δύο πεδία
//    χαμηλώνουν και το κουμπί αλλάζει λέξη σε «Άνοιγμα».
// ═══════════════════════════════════════════════════════════════════════════
import Select from './Select.astro';
import { t, listUrl, propertyUrl, type Lang } from '../lib/i18n';

interface Props { lang: Lang; total: number }
const { lang } = Astro.props;

const TYPES = [
  { v: '',           label: t(lang, 'search.what.all') },
  { v: 'residency',  label: t(lang, 'cat.homes') },
  { v: 'land',       label: t(lang, 'cat.land') },
  { v: 'business',   label: t(lang, 'cat.commercial') },
];
// Τα εύρη βγαίνουν από τα δεδομένα. Το σημερινό «Έως € 70.000» δίνει 0 αποτελέσματα.
const PRICES = [
  { v: '',        label: t(lang, 'search.price.any') },
  { v: '300000',  label: '300.000 €' },
  { v: '500000',  label: '500.000 €' },
  { v: '1000000', label: '1.000.000 €' },
  { v: '3000000', label: '3.000.000 €' },
];
// Το πρότυπο της διεύθυνσης ακινήτου — ο κωδικός μπαίνει στη θέση του `0`.
const idTemplate = propertyUrl(lang, '0');
import { ui } from '../lib/listing';
---
<div class="searchwrap">
<form class="search" action={listUrl(lang)} method="get" role="search"
      data-ev="search:submit" data-id-template={idTemplate}>
  <div class="search__row">
    <div class="search__f search__f--what"><Select name="category" label={t(lang, 'search.what')} options={TYPES} /></div>
    <div class="search__f search__f--price"><Select name="price_max" label={t(lang, 'search.price')} options={PRICES} /></div>

    {/* Τα φίλτρα ΔΕΝ είναι πεδίο — είναι ενέργεια. Γι' αυτό χωρίς ετικέτα από
        πάνω: αν έμπαινε, θα διαβαζόταν ως τρίτο κριτήριο που δεν συμπληρώσαμε. */}
    <a class="search__more" href={`${listUrl(lang)}?filters=1`} data-ev="search:filters_open">
      <svg viewBox="0 0 16 16" aria-hidden="true" class="ico">
        <path d="M2 4.5h12M4.5 8h7M6.8 11.5h2.4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      </svg>
      {/* 🪤 ΔΥΟ ΛΕΞΕΙΣ, ΟΧΙ ΜΙΑ. Στο κινητό η θέση του συνδέσμου έχει 108px και
          το «Περισσότερα φίλτρα» θέλει 134 — ξέφευγε 12px αριστερά και ΕΠΕΦΤΕ
          ΠΑΝΩ στη λέξη «Κωδικός». Ήταν έτσι από την αρχή· δεν φαινόταν επειδή
          το `nowrap` δεν προκαλεί ούτε ξεχείλισμα σελίδας ούτε κομμένο κείμενο —
          απλώς δύο κείμενα πατούσαν το ένα το άλλο και οι μετρήσεις έδειχναν «οκ».
          Το `display: none` βγάζει τη μία και από τους αναγνώστες οθόνης, άρα
          δεν ακούγεται διπλή. */}
      <span class="search__more--full">{t(lang, 'search.filters')}</span>
      <span class="search__more--short">{t(lang, 'search.filters_short')}</span>
    </a>

    <label class="search__id">
      <svg viewBox="0 0 16 16" aria-hidden="true" class="ico">
        <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.25" />
        <path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      </svg>
      <span class="sr-only">{t(lang, 'search.id_label')}</span>
      <input class="search__idin" type="text" name="id" inputmode="numeric" maxlength="6"
             autocomplete="off" placeholder={t(lang, 'search.id_ph')} />
    </label>

    <button class="search__go" type="submit" aria-label={t(lang, 'search.go')}>
      {/* Στις μικρές οθόνες το κουμπί γίνεται εικονίδιο: μετρήθηκε ότι η λέξη
          «ΑΝΑΖΗΤΗΣΗ» έτρωγε 101px και έκοβε τις ΔΙΚΕΣ ΜΑΣ προεπιλογές. */}
      <svg class="search__ico" viewBox="0 0 18 18" aria-hidden="true">
        <circle cx="7.8" cy="7.8" r="5.2" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M11.6 11.6 16 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <span class="search__golabel" data-go-search>{t(lang, 'search.go')}</span>
      <span class="search__golabel" data-go-open hidden>{t(lang, 'search.open')}</span>
    </button>
  </div>
</form>
{/* list → home move: a still copy of the list's filter row, cross-faded into this bar while the photo grows */}
<div class="sghost" aria-hidden="true">
  {[ui(lang, 'muni'), ui(lang, 'type'), t(lang, 'list.price'), ui(lang, 'beds'), ui(lang, 'seaLabel'), t(lang, 'list.size')].map((l) => (
    <span class="sghost__c">{l}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9l6 6 6-6" /></svg></span>
  ))}
  <span class="sghost__c sghost__c--n"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M2 4.5h12M4.5 8h7M6.8 11.5h2.4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" /></svg>{t(lang, 'search.filters')}</span>
  <span class="sghost__c sghost__c--n sghost__c--id"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>{t(lang, 'search.id_ph')}</span>
  <span class="sghost__map"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg></span>
</div>
</div>

<script>
  // Ο κωδικός είναι διεύθυνση, όχι φίλτρο: αν υπάρχει, υπερισχύει.
  // ⏭️ Όταν χτιστεί η λίστα, ο server θα δέχεται και `?id=` και θα κάνει 301 —
  //    ώστε να δουλεύει το ίδιο ΧΩΡΙΣ JavaScript. Εδώ είναι μόνο η επιτάχυνση.
  document.querySelectorAll<HTMLFormElement>('form.search').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('.search__idin');
    const tpl = form.dataset.idTemplate ?? '';
    const goSearch = form.querySelector<HTMLElement>('[data-go-search]');
    const goOpen = form.querySelector<HTMLElement>('[data-go-open]');
    if (!input) return;

    const clean = () => input.value.replace(/\D+/g, '');

    // Οπτική απάντηση στο «ποιο θεωρείται το search;»
    const sync = () => {
      const on = clean().length > 0;
      form.toggleAttribute('data-id-mode', on);
      goSearch?.toggleAttribute('hidden', on);
      goOpen?.toggleAttribute('hidden', !on);
    };
    input.addEventListener('input', sync);
    sync();

    form.addEventListener('submit', (e) => {
      const id = clean();
      if (!id) return;                       // κανονική αναζήτηση
      e.preventDefault();
      window.location.href = tpl.replace(/0$/, id);
    });
  });
</script>

<style>
  /* 🪤 Η ΜΠΑΡΑ ΜΠΑΙΝΕΙ ΣΤΗΝ ΙΔΙΑ ΣΤΗΛΗ ΜΕ ΟΛΗ ΤΗ ΣΕΛΙΔΑ.
     Με `max-width: var(--max)` + δικά της περιθώρια έβγαινε 1280 φαρδιά, ενώ κάθε
     άλλο μπλοκ πατάει στα 1200 του `.wrap`. Ο περιτυλιγμός αντιγράφει ΑΚΡΙΒΩΣ τη
     γεωμετρία του `.wrap`, οπότε ευθυγραμμίζεται σε κάθε πλάτος. */
  .searchwrap {
    /* Η μεταβλητή ζει ΕΔΩ και όχι στο `.search`, γιατί τη χρειάζονται ΔΥΟ
       πράγματα: το ύψος της μπάρας (κατεβαίνει με κληρονομιά) και το αρνητικό
       περιθώριο παρακάτω. Οι μεταβλητές κληρονομούνται μόνο προς τα ΚΑΤΩ. */
    --bar: 96px;
    position: relative; z-index: 6;
    max-width: var(--max); margin: 0 auto; padding: 0 var(--gut);
    /* 📐 Η ΜΕΣΗ ΤΟΥ ΚΟΥΤΙΟΥ ΠΕΦΤΕΙ ΑΚΡΙΒΩΣ ΣΤΟ ΚΑΤΩ ΟΡΙΟ ΤΗΣ ΦΩΤΟΓΡΑΦΙΑΣ
       (George, 30/7): «να μην κάθεται ούτε πιο κάτω ούτε πιο πάνω — το μισό
       πάνω στη φωτογραφία, το μισό στο λευκό».
       🪤 ΤΟ `-50%` ΕΙΝΑΙ ΤΟ ΣΩΣΤΟ, ΟΧΙ ΣΤΑΘΕΡΑ px. Στο `transform` το ποσοστό
       μετριέται πάνω στο **ύψος του ίδιου του στοιχείου**, άρα μένει ακριβώς
       στη μέση όσο κι αν αλλάξει το ύψος της μπάρας — σε κινητό, σε desktop,
       ή αν αύριο προστεθεί έκτο πεδίο. Τα παλιά -24px/-30px ήταν εικασίες που
       τύχαινε να μοιάζουν σωστές σε ένα μόνο πλάτος. */
    transform: translateY(-50%);
    /* 🕳️ ΤΟ ΚΕΝΟ ΑΠΟ ΚΑΤΩ ΗΤΑΝ ΦΑΝΤΑΣΜΑ ΤΗΣ ΙΔΙΑΣ ΤΗΣ ΜΕΤΑΚΙΝΗΣΗΣ.
       Το `transform` μετακινεί μόνο ΟΠΤΙΚΑ: η σελίδα συνεχίζει να κρατά ολόκληρο
       το ύψος της μπάρας στη θέση που θα είχε ΧΩΡΙΣ τη μετακίνηση. Άρα από κάτω
       έμενε μισή μπάρα άδεια — 33,5px στο desktop, 49px στο κινητό — που κανείς
       δεν είχε γράψει και κανείς δεν έβλεπε στον κώδικα.
       Το αρνητικό περιθώριο επιστρέφει ακριβώς αυτό το μισό. ΔΕΝ μετακινεί τη
       μπάρα (τα περιθώρια δεν κουνούν το ίδιο το στοιχείο) — άρα η μέση της
       μένει καρφωμένη στο κάτω όριο της φωτογραφίας, όπως ζητήθηκε. */
    margin-bottom: calc((var(--bar) + 2px) / -2);
  }
  /* Το padding του κουτιού ΕΙΝΑΙ το κενό γύρω από το μαύρο κουμπί — ίδιο πάνω,
     δεξιά και κάτω. Γι' αυτό μπαίνει εδώ και όχι στο κουμπί: έτσι δεν μπορεί να
     ξεσυγχρονιστεί καμία πλευρά. */
  .search {
    /* 📐 ΜΙΑ ΤΙΜΗ ΟΡΙΖΕΙ ΤΟ ΥΨΟΣ — και από αυτήν βγαίνει και το τετράγωνο κουμπί.
       `--bar` = το ΕΣΩΤΕΡΙΚΟ ύψος (χωρίς το περίγραμμα 1+1).
       Πριν, το ύψος ΠΡΟΕΚΥΠΤΕ από το padding των πεδίων και το κουμπί είχε δικό
       του σταθερό πλάτος: δύο ανεξάρτητοι αριθμοί που έπρεπε να συμφωνούν με το
       χέρι. Δοκιμάστηκαν 51 και 41 — και τα δύο έβγαλαν ορθογώνιο.
       Τώρα το πλάτος του κουμπιού ΕΙΝΑΙ η ίδια μεταβλητή: δεν μπορούν να
       ξεσυγχρονιστούν, ό,τι κι αν αλλάξει το ύψος.
       ⚠️ Και ΔΕΝ εξαρτάται πια από το περιεχόμενο — άρα η μπάρα έχει το ίδιο
          ύψος και στις 9 γλώσσες, ακόμα κι αν μια γραμματοσειρά αποδώσει ψηλότερα. */
    /* ΚΙΝΗΤΟ: δύο σειρές × 48 → 98 με το περίγραμμα.
       📱 ΤΟ +30% ΔΟΥΛΕΨΕ ΣΤΟ DESKTOP, ΟΧΙ ΕΔΩ. Στα 375px η μπάρα έχει ΔΥΟ
          σειρές, άρα κάθε ποσοστό μετράει διπλά: το ίδιο +30% έβγαλε 67px στο
          desktop αλλά 131px στο κινητό — «φαίνεται άσχημο τόσο χοντρό»
          (George, 30/7). Μικρύνθηκε 25%, μόνο εδώ.
       Γι' αυτό οι δύο τιμές είναι ΧΩΡΙΣΤΕΣ και όχι μία με πολλαπλασιαστή. */
    /* ⬆️ Η τιμή ορίζεται στο `.searchwrap` και κληρονομείται εδώ. */
    background: var(--paper); border: 1px solid var(--line);
    box-shadow: 0 14px 44px rgba(0,0,0,.16);
    /* 🪤 ΕΙΧΕ `padding: 4px` ΚΑΙ ΤΟ ΚΟΥΜΠΙ ΤΟ ΑΚΥΡΩΝΕ ΜΕ ΑΡΝΗΤΙΚΑ ΠΕΡΙΘΩΡΙΑ.
       Δεν δούλευε: σε grid, το αρνητικό περιθώριο ΜΕΤΑΚΙΝΕΙ το στοιχείο αλλά δεν
       το επεκτείνει — κολλούσε πάνω και άφηνε 9px κενό κάτω, όσες παραλλαγές κι
       αν δοκιμάστηκαν (`aspect-ratio`, `height:100%`, `align-self:stretch`).
       ✅ Το κενό μετακόμισε ΜΕΣΑ στα πεδία. Το κουμπί δεν χρειάζεται πια κανένα
          κόλπο: κολλάει φυσικά στο περίγραμμα, από μόνο του. */
    /* 🖤 ΜΗΔΕΝ ΚΕΝΟ, ΠΟΥΘΕΝΑ (George, 30/7): «φτιάξε επιτέλους αυτό το κουμπί
       αναζήτησης να μην αφήνει περιθώριο πουθενά».
       Ήταν `0 4px 0 0` — 4px λευκό δεξιά από το μαύρο, ορατό στη φωτογραφία του.
       Το κενό ζούσε ΕΔΩ, στον γονέα, όχι στο κουμπί: γι' αυτό δεν έφευγε όσο
       πειράζαμε το ίδιο το κουμπί. Με μηδέν, το μαύρο ακουμπά το περίγραμμα
       πάνω, δεξιά και κάτω — και τα πεδία κρατούν το δικό τους εσωτερικό κενό,
       οπότε το κείμενο δεν αγγίζει πουθενά την άκρη. */
    padding: 0;
  }

  /* ── ΚΙΝΗΤΟ: τα δύο πεδία δίπλα-δίπλα, από κάτω η λεπτή γραμμή ────────────
     🪤 ΡΗΤΕΣ ΠΕΡΙΟΧΕΣ, ΟΧΙ `grid-row`/`grid-column` κατά περίπτωση: με σκέτο
     `grid-row: 1` στα τρία δεξιά στοιχεία, το grid τα τοποθετούσε ΠΡΩΤΑ και τα
     δύο dropdown έφευγαν στο τέλος της σειράς — «Φίλτρα · Κωδικός · ΑΝΑΖΗΤΗΣΗ ·
     Τι ψάχνετε · Τιμή». Με `grid-template-areas` η σειρά είναι δηλωμένη, όχι
     αποτέλεσμα αυτόματης τοποθέτησης. */
  .search__row {
    display: grid; align-items: stretch;
    /* 📏 +30% ΥΨΟΣ (George, 30/7). Δηλωμένο, όχι προϊόν του padding:
       κινητό 100,8 → 131 · desktop 51,4 → 67. */
    min-height: var(--bar);
    /* Το τρίτο νούμερο ΕΙΝΑΙ το πλάτος του κουμπιού. Στο κινητό η μπάρα είναι
       διπλή (~93px): τετράγωνο θα έτρωγε το ένα τέταρτο της οθόνης, οπότε εδώ
       μένει ορθογώνιο και ψηλό. Τετράγωνο γίνεται στο desktop, όπου η μπάρα
       είναι χαμηλή — δες το media query παρακάτω. */
    grid-template-columns: minmax(0,1fr) minmax(0,1fr) 64px;
    /* ΔΥΟ ΙΣΕΣ ΣΕΙΡΕΣ (George, 30/7): «δεν μου αρέσει που τρως περισσότερο χώρο
       για το “τι ψάχνετε” και την τιμή, και από κάτω έχεις λιγότερο για τον
       κωδικό». Το `1fr 1fr` το εγγυάται — δεν εξαρτάται από το περιεχόμενο. */
    /* 🪤 `minmax(0,1fr)` ΚΑΙ ΟΧΙ ΣΚΕΤΟ `1fr`. Το `1fr` σημαίνει «ίσο μερίδιο του
       ΔΙΑΘΕΣΙΜΟΥ χώρου», αλλά έχει σιωπηρό κατώτατο όριο `min-content`: αν η
       πάνω σειρά χρειάζεται περισσότερο (ετικέτα + τιμή), απλώς μεγαλώνει και οι
       σειρές ξαναγίνονται άνισες. Μετρήθηκε: 56px πάνω έναντι 34px κάτω, παρότι
       ήταν δηλωμένες ως ίσες. Το `minmax(0,…)` αφαιρεί αυτό το κατώτατο όριο. */
    grid-template-rows: minmax(0,1fr) minmax(0,1fr);
    /* ΚΑΙ ΤΟ ΚΟΥΜΠΙ ΠΙΑΝΕΙ ΚΑΙ ΤΙΣ ΔΥΟ: «ίσως το βάλεις σε όλο το ύψος». */
    grid-template-areas:
      "what price go"
      "id   more  go";
  }
  .search__f--what  { grid-area: what; }
  .search__f--price { grid-area: price; }
  .search__more     { grid-area: more; }
  .search__id       { grid-area: id; }
  .search__go       { grid-area: go; }
  /* Το πεδίο ΓΕΜΙΖΕΙ τη σειρά και κεντράρει το περιεχόμενό του. Με κάθετο
     padding (όπως πριν) το κείμενο θα κολλούσε στην κορυφή μόλις ψήλωσε η
     μπάρα — το padding δίνει απόσταση, όχι κεντράρισμα. */
  .search__f {
    min-width: 0; padding: 0 13px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .search__f--price { border-inline-start: 1px solid var(--line); }

  /* 🪤 ΤΟ ΜΕΝΟΥ ΤΟΥ DROPDOWN ΚΡΕΜΟΤΑΝ ΑΠΟ ΤΟ ΚΕΙΜΕΝΟ, ΟΧΙ ΑΠΟ ΤΟ ΚΟΥΤΙ.
     Το `.sel__list` ανοίγει 11px κάτω από το `.sel` — δηλαδή κάτω από τη ΛΕΞΗ.
     Όσο η λέξη ήταν κολλητά στο κάτω μέρος του πεδίου, το μενού έβγαινε 7px
     κάτω από τη μπάρα και φαινόταν σωστό κατά τύχη. Με το κεντραρισμένο κείμενο
     η λέξη ανεβαίνει, άρα το μενού θα άνοιγε **ΜΕΣΑ στη μπάρα**.
     Μετρήθηκε: πριν 7px κάτω · μετά, χωρίς αυτό, 0,2px ΠΑΝΩ (δηλαδή μέσα).

     ΚΑΙ ΣΤΟ ΚΙΝΗΤΟ ΗΤΑΝ ΗΔΗ ΛΑΘΟΣ, ΠΡΙΝ ΑΠΟ ΕΜΑΣ: εκεί τα δύο πεδία είναι στην
     ΠΑΝΩ σειρά, οπότε το μενού άνοιγε 42px ΜΕΣΑ στη μπάρα και σκέπαζε τη δεύτερη
     σειρά — τον κωδικό και τα φίλτρα.

     Λύση, ένας κανόνας με δύο άγκυρες:
       κινητό  → κρέμεται από ΟΛΗ τη μπάρα (`.search`) — πέφτει κάτω από τη
                 δεύτερη σειρά, σε όλο το πλάτος· στα 375px διαβάζεται καλύτερα
       desktop → κρέμεται από ΤΟ ΠΕΔΙΟ (`.search__f`, positioned πιο κάτω), άρα
                 πέφτει ακριβώς πάνω στις κάθετες γραμμές που χωρίζουν τα πεδία
     Και στα δύο, το μενού είναι δεμένο σε ΚΟΥΤΙ και όχι σε κείμενο: δεν
     ξαναμετακινείται ό,τι ύψος κι αν πάρει η μπάρα αύριο. */
  .search { position: relative; }
  .search :global(.sel) { position: static; }
  .search :global(.sel__list) { left: 0; right: 0; top: calc(100% + 7px); }

  .ico { width: 14px; height: 14px; flex: none; color: var(--faint); }

  /* Στο κινητό ο κωδικός και τα φίλτρα πέφτουν σε δεύτερη γραμμή — σε 390px
     πέντε στοιχεία σε μία σειρά δεν χωρούν χωρίς να κοπούν οι προεπιλογές. */
  .search__more, .search__id {
    display: flex; align-items: center; gap: 7px;
    min-height: 34px; padding: 0 13px; font-size: 13px; color: var(--muted);
    border-top: 1px solid var(--line);
  }
  /* 📐 ΣΤΟΙΧΙΣΜΕΝΑ ΜΕ ΤΟ ΠΕΔΙΟ ΑΠΟ ΠΑΝΩ (George, 30/7): «κεντράρισε τα φίλτρα
     κάτω από το ΤΙΜΗ ΕΩΣ, όπως είναι τα περιθώρια του άνω».
     Ήταν `flex-end` — κολλημένα δεξιά, 43px παράταιρα από τη στήλη τους.
     Με `flex-start` και ίδιο padding (13px) το εικονίδιο πέφτει ΑΚΡΙΒΩΣ στην
     κάθετη του «ΤΙΜΗ ΕΩΣ» — όπως ακριβώς κάνει ήδη ο «Κωδικός» με το
     «ΤΙ ΨΑΧΝΕΤΕ» στην αριστερή στήλη. Δύο στήλες, ένας άξονας η καθεμία. */
  .search__more { justify-content: flex-start; white-space: nowrap; }
  /* +1px: το πεδίο τιμής από πάνω έχει κάθετη γραμμή 1px που σπρώχνει το
     περιεχόμενό του δεξιά. Χωρίς αυτό η στοίχιση βγαίνει 1px παράταιρη —
     αόρατο μεν, αλλά η αριστερή στήλη πέφτει ακριβώς στο 0 και η δεξιά όχι. */
  .search__more { padding-inline-start: 14px; }
  /* Κινητό: «Φίλτρα». Desktop: «Περισσότερα φίλτρα» (δες το media query). */
  .search__more--full { display: none; }
  .search__id { min-width: 0; }
  .search__more:hover { color: var(--ink); }
  .search__idin {
    flex: 1; min-width: 0; width: 100%; border: 0; background: transparent; padding: 0;
    font: inherit; font-size: 16px; color: var(--ink);   /* 16px = χωρίς auto-zoom στο iOS */
  }
  .search__idin::placeholder { color: var(--faint); }
  .search__id:focus-within .ico { color: var(--ink); }

  .search__go {
    border: 0; background: var(--ink); color: var(--paper);
    /* 🪤 ΗΤΑΝ `inline-flex` — ΓΙ' ΑΥΤΟ ΔΕΝ ΓΕΜΙΖΕ. Το `inline-*` δεν τεντώνεται
       στο ύψος του κελιού, οπότε τα αρνητικά περιθώρια το ΜΕΤΑΚΙΝΟΥΣΑΝ αντί να
       το επεκτείνουν: κολλούσε πάνω (1px) αλλά άφηνε 9px κενό κάτω.
       Με `flex` + ρητό `align-self: stretch` το ύψος βγαίνει από το κελί μείον
       τα περιθώρια, δηλαδή φτάνει ως το περίγραμμα και από τις δύο πλευρές. */
    display: flex; align-items: center; justify-content: center;
    align-self: stretch;
    /* 🔲 ΤΕΤΡΑΓΩΝΟ, ΙΣΟ ΜΕ ΤΟ ΥΨΟΣ ΤΗΣ ΜΠΑΡΑΣ (George, 30/7).
       Το `aspect-ratio: 1` πάνω σε στοιχείο που ήδη τεντώνεται σε όλο το ύψος
       δίνει πλάτος = ύψος αυτόματα — δεν χρειάζεται να ξέρουμε τον αριθμό, και
       μένει τετράγωνο ό,τι κι αν αλλάξει παρακάτω. */
    /* 🪤 ΤΟ `width: 100%` ΑΚΥΡΩΝΕ ΤΟ ΠΕΡΙΘΩΡΙΟ. Ένα στοιχείο με ρητό πλάτος
       100% γεμίζει το κελί ΑΝΕΞΑΡΤΗΤΑ από τα περιθώρια — απλώς ξεχειλίζει κατά
       το περιθώριο αντί να συρρικνωθεί. Χωρίς αυτό, το `stretch` του grid κάνει
       τη σωστή δουλειά: πλάτος = κελί μείον περιθώρια. */
    padding: 0; min-width: 0;
    /* 🖤 ΜΗΔΕΝ ΠΕΡΙΘΩΡΙΟ — ΚΑΙ ΣΤΙΣ ΤΕΣΣΕΡΙΣ ΠΛΕΥΡΕΣ (George, 30/7).
       Το κουμπί ΔΕΝ κάνει τίποτα για να το πετύχει: δεν έχει ούτε ύψος, ούτε
       πλάτος, ούτε περιθώρια. Απλώς γεμίζει το κελί του (`align-self: stretch`),
       και το κελί φτάνει ως το περίγραμμα επειδή ο γονέας δεν έχει πια padding.
       🪤 ΚΑΘΕ ΠΡΟΗΓΟΥΜΕΝΗ ΑΠΟΠΕΙΡΑ ΑΠΕΤΥΧΕ ΕΠΕΙΔΗ ΠΡΟΣΠΑΘΟΥΣΕ ΝΑ ΤΟ ΛΥΣΕΙ ΕΔΩ:
          `height: 100%` → το ύψος μετριέται στο κελί ΑΓΝΟΩΝΤΑΣ τα περιθώρια, άρα
          τα αρνητικά περιθώρια το μετακινούσαν αντί να το μεγαλώσουν (κολλούσε
          πάνω, άφηνε 9px κάτω)· `width: 100%` ακύρωνε ό,τι περιθώριο μπει·
          `aspect-ratio: 1` δημιουργούσε κύκλο (το grid ζητά πλάτος για να βρει
          ύψος, το κουμπί ζητά ύψος για να βρει πλάτος) και **έσπασε τη σελίδα
          δύο φορές** — ξεχείλιζε 2px και το iOS ζούμαρε ΟΛΗ την αρχική.
          Το κενό ήταν πάντα του ΓΟΝΕΑ. Εκεί λύθηκε. */
    font: inherit; font-size: 10.5px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
    cursor: pointer; transition: opacity .18s ease;
  }
  .search__ico { width: 18px; height: 18px; }
  .search__golabel { display: none; }
  .search__go:hover { opacity: .86; }

  /* Όταν γράφεται κωδικός, τα κριτήρια σβήνουν: δεν ισχύουν πια. */
  .search[data-id-mode] .search__f { opacity: .38; }
  .search[data-id-mode] .search__more { opacity: .38; }

  @media (min-width: 760px) {
    /* 🪤 ΕΔΩ ΚΡΥΒΟΤΑΝ ΤΟ ΛΑΘΟΣ. Ο βασικός κανόνας πήρε `-50%`, αλλά αυτό το
       media query κρατούσε ακόμα σταθερά `-30px` και ΤΟ ΥΠΕΡΙΣΧΥΕ σε κάθε
       desktop. Μετρήθηκε: η μέση του κουτιού έπεφτε **13px κάτω** από το όριο
       της φωτογραφίας — ακριβώς η διαφορά 42,5 − 30.
       Το ποσοστό δουλεύει σε ΚΑΘΕ πλάτος· δεν χρειάζεται δεύτερη τιμή. */
    .searchwrap { transform: translateY(-50%); }

    /* 📏 +30%: 51,4 → 67 (65 εσωτερικά + περίγραμμα 1+1).
       Μπαίνει στο `.searchwrap` ώστε να τη δει και το αρνητικό περιθώριο. */
    .searchwrap { --bar: 65px; }

    /* ΜΙΑ ΕΥΘΕΙΑ: τι · τιμή · φίλτρα · κωδικός · κουμπί */
    .search__row {
      /* 🔲 ΤΟ ΤΕΤΡΑΓΩΝΟ ΒΓΑΙΝΕΙ ΜΟΝΟ ΤΟΥ: το τελευταίο νούμερο είναι το πλάτος
         του κουμπιού και είναι **η ίδια μεταβλητή** με το εσωτερικό ύψος.
         Πριν ήταν χειροκίνητο (`49px`) και έπρεπε κάποιος να θυμάται να το
         αλλάζει μαζί με το ύψος. Δεν το θυμόταν: δοκιμάστηκαν 51 (→ 51×41) και
         41 (→ τετράγωνο, αλλά με 9px κενό από κάτω).
         Το `aspect-ratio` δεν είναι επιλογή — **έσπασε τη σελίδα δύο φορές**
         (δες το σχόλιο στο `.search__go`). Η μεταβλητή κάνει την ίδια δουλειά
         χωρίς κύκλο: το grid ξέρει το πλάτος από την αρχή. */
      grid-template-columns: minmax(0,1fr) minmax(0,1fr) auto 150px var(--bar);
      grid-template-rows: auto;
      grid-template-areas: "what price more id go";
    }
    /* Εδώ τα πεδία είναι όλα σε ΜΙΑ σειρά, οπότε το μενού μπορεί να κρεμαστεί
       από το ίδιο το πεδίο — πιο κοντά, και στοιχισμένο με τους χωρισμούς.
       Το `position: relative` κάνει το πεδίο τον κοντινότερο άξονα και κερδίζει
       από το `.search` του κινητού, χωρίς να ξαναγραφτεί ο κανόνας του μενού. */
    .search__f { padding: 0 22px; position: relative; }
    .search__more, .search__id {
      border-top: 0; border-inline-start: 1px solid var(--line); padding: 0 18px;
    }
    /* Εδώ ο σύνδεσμος έχει δική του στήλη `auto` — χωράει ολόκληρη η φράση. */
    .search__more--full { display: inline; }
    .search__more--short { display: none; }
    .search__idin { font-size: 14px; }
    .search__go {
      /* 🔲 ΤΕΤΡΑΓΩΝΟ 65×65: το πλάτος το δίνει η στήλη (`var(--bar)`), το ύψος
         το `stretch`. Η λέξη «ΑΝΑΖΗΤΗΣΗ» δεν χωράει σε τόσο πλάτος — μένει το
         εικονίδιο, όπως και στο κινητό. */
      padding: 0; min-width: 0;
    }
    .search__ico { display: block; }
    .search__golabel { display: none; }
  }
  /* #101 desktop redesign: every cell behaves like «More filters» — grey at rest,
     ink on hover; the ID cell a little wider. */
  @media (min-width: 1024px) {
    .search__row { grid-template-columns: minmax(0,1fr) minmax(0,1fr) auto 170px var(--bar); }
    .search__f, .search__more, .search__id { cursor: pointer; transition: color .15s ease; }
    .search__f :global(.sel__btn) { color: var(--muted); transition: color .15s ease; }
    .search__f:hover :global(.sel__caret) { color: var(--ink); }
    .search__f:hover, .search__f:hover :global(.sel__btn), .search__f:hover :global(.sel__val),
    .search__id:hover, .search__id:hover .search__idin::placeholder { color: var(--ink); }
    .search__more:hover .ico, .search__id:hover .ico { color: var(--ink); }
    .search__more .ico { color: var(--faint); }
  }

  /* ── list → home move (Sergei 02/11): the list's row fades out into this bar inside the motion ── */
  .sghost { display: none; }
  :global(html.hp-hfrom) .sghost {
    display: flex; position: absolute; z-index: 2; top: 0; left: var(--gut); right: var(--gut); height: calc(var(--bar) + 2px);
    box-sizing: border-box; background: var(--paper); border: 1px solid var(--line); pointer-events: none;
    animation: h-ghost 0.95s ease both;
  }
  :global(html.hp-hfrom) .search { animation: h-bar 0.95s ease both; }
  .sghost__c { flex: 1 1 0; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 15px; color: var(--muted); white-space: nowrap; }
  .sghost__c + .sghost__c { border-inline-start: 1px solid var(--line); }
  .sghost__c svg { color: var(--faint); flex: none; }
  .sghost__c--n { flex: none; padding: 0 18px; font-size: 13px; }
  .sghost__c--id { width: 170px; justify-content: flex-start; }
  .sghost__map { flex: none; width: 64px; display: flex; align-items: center; justify-content: center; background: var(--ink); color: var(--gold-dk-text); }
  /* mirrored timing of the home → list move (there 15–55 %, here 45–85 %) */
  @keyframes h-ghost { 0%, 45% { opacity: 1; } 85%, 100% { opacity: 0; } }
  @keyframes h-bar { 0%, 45% { opacity: 0; } 85%, 100% { opacity: 1; } }
</style>
