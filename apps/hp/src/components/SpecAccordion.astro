---
// The SEO text block, quiet (#365, Sergei with George 2026-11-24): «the SEO block is the loudest thing on the page».
// Rules: the site's working width (not the full screen), compact, no photos, nothing that pulls the eye. George's spec
// text as an accordion: one quiet line per H2 with a hairline between them; a click opens the section's text and its
// links. SEO: every H2, paragraph and link stays in the HTML in the spec order (closed <details> content is in the
// page and read by search engines); the headings keep their ids (#anchors from elsewhere still open them).
// Trial on the home page; the loud block (SpecPosts) stays for the other pages until this is chosen.
import FaqSearch from './FaqSearch.astro';
import { h2Id, type SpecPage } from '../lib/seo-pages';
import { t, type Lang } from '../lib/i18n';

interface Props {
  page: SpecPage; lang: Lang; faqH: string; faqHref?: string;
  /** George's links per section (the same lists the loud block shows as tiles) */
  sectionLinks?: { href: string; text: string }[][];
  /** the small label over the rows (default «Buying in Halkidiki») */
  label?: string;
}
const { page, lang, faqH, faqHref, sectionLinks = [], label } = Astro.props;

// the spec body cut at each <h2>: [intro?, section 1, section 2, …]
const parts = page.body.split(/(?=<h2>)/);
const intro = parts[0] && !parts[0].startsWith('<h2>') ? parts.shift()! : '';
const sections = parts.map((html, i) => {
  const m = html.match(/^<h2>([\s\S]*?)<\/h2>/);
  const head = (m?.[1] ?? '').replace(/<[^>]+>/g, '').trim();
  return { id: h2Id(head), head, body: html.replace(/^<h2>[\s\S]*?<\/h2>/, ''), links: sectionLinks[i] ?? [] };
});
---
<section class="sa" aria-label={sections[0]?.head ?? ''}>
  <div class="wrap sa__in">
    {intro && <div class="sa__intro" set:html={intro} />}
    {/* small labels as «Three paths» (Sergei 2026-11-24), not big titles */}
    {/* two columns on desktop: the SEO rows left, the questions right (Sergei 2026-11-25: «укоротить длину») */}
    <div class={page.faq.length > 0 ? 'sa__cols sa__cols--2' : 'sa__cols'}>
    <div class="sa__col">
    <p class="t-label sa__lbl">{label ?? t(lang, 'home.seo_lbl')}</p>
    <div class="sa__list">
      {sections.map((s) => (
        <details class="sa__it" id={`${s.id}-box`} name="seo">   {/* one open at a time (Sergei 2026-11-24), as the questions */}
          <summary class="sa__sum"><h2 id={s.id} class="sa__h">{s.head}</h2><span class="sa__pm" aria-hidden="true"></span></summary>
          <div class="sa__body">
            <div class="sa__txt" set:html={s.body} />
            {s.links.length > 0 && (
              <ul class="sa__links">{s.links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
            )}
          </div>
        </details>
      ))}
    </div>
    </div>
    {page.faq.length > 0 && <div class="sa__faq"><FaqSearch lang={lang} h={faqH} href={faqHref} items={page.faq} id="faq" bare search={false} headTag="p" /></div>}
    </div>
  </div>
</section>

<script>
  // an #anchor to one of the headings opens its section (links from elsewhere on the site)
  const open = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const h = id ? document.getElementById(id) : null;
    const d = h?.closest('details.sa__it') as HTMLDetailsElement | null;
    if (d) { d.open = true; h!.scrollIntoView({ block: 'start' }); }
  };
  open();
  window.addEventListener('hashchange', open);

  // Sergei 2026-11-25: «the block itself does not change height» and a short smooth open / close.
  // 1) Desktop: the two columns get a fixed height = the tallest state (each answer opened in turn, measured once,
  //    again on resize), so opening an answer never moves what is below the block.
  // 2) Open and close animate the row's height (220 ms); one open per column, the other closes at the same time.
  //    `name` is removed here so the browser does not snap the other row shut; without JS `name` still works.
  const box = document.querySelector<HTMLElement>('.sa__cols');
  if (box) {
    box.dataset.saAnim = '1';
    const all = Array.from(box.querySelectorAll<HTMLDetailsElement>('details'));
    const cols = Array.from(box.children) as HTMLElement[];
    const wide = matchMedia('(min-width: 1024px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    all.forEach((d) => d.removeAttribute('name'));

    // Sergei 2026-11-27: one height on every page, the same space above and below. The box height is a constant
    // (--sa-h, CSS); an open answer shows in a window of fixed height (--sa-win) and scrolls inside it when longer.
    // Here only: mark a window that scrolls, so it gets a soft fade at its bottom edge.
    const mark = () => box.querySelectorAll<HTMLElement>('.sa__body, .k-faq__a').forEach((el) => {
      el.classList.toggle('is-scroll', el.scrollHeight > el.clientHeight + 2);
    });

    const run = (d: HTMLDetailsElement, from: number, to: number, done?: () => void) => {
      d.getAnimations().forEach((x) => x.cancel());
      if (still.matches) { done?.(); return; }
      d.style.overflow = 'hidden';
      const an = d.animate({ height: [`${from}px`, `${to}px`] }, { duration: 220, easing: 'cubic-bezier(.2,.7,.2,1)' });
      an.onfinish = () => { d.style.overflow = ''; done?.(); };
      an.oncancel = () => { d.style.overflow = ''; };
    };
    const shut = (d: HTMLDetailsElement) => {
      const from = d.offsetHeight;
      const to = d.querySelector('summary')!.offsetHeight + (d.offsetHeight - d.clientHeight);
      d.classList.add('is-shut');
      run(d, from, to, () => { d.open = false; d.classList.remove('is-shut'); });
    };
    const show = (d: HTMLDetailsElement) => {
      const from = d.offsetHeight;
      d.open = true;
      run(d, from, d.offsetHeight);
      mark();
    };

    all.forEach((d) => {
      const sum = d.querySelector('summary');
      sum?.addEventListener('click', (e) => {
        e.preventDefault();
        if (e.detail > 0) sum.blur();   // a mouse click leaves no focus frame; the keyboard keeps it
        if (d.open && !d.classList.contains('is-shut')) { shut(d); return; }
        const col = cols.find((c) => c.contains(d));
        col?.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((x) => { if (x !== d && !x.classList.contains('is-shut')) shut(x); });
        d.classList.remove('is-shut');
        show(d);
      });
    });

    document.fonts?.ready.then(mark);
    let t = 0;
    addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(mark, 150); });
  }
</script>

<style>
  .sa { --sa-h: 720px; --sa-win: 240px; background: var(--paper); padding-block: var(--s8); }
  .sa__in { display: grid; gap: var(--s6); }
  .sa__intro { max-width: 70ch; color: var(--ink-2); font-size: var(--fs-s0); line-height: 1.65; }
  .sa__intro :global(p) { margin: 0 0 var(--s3); }
  .sa__lbl { margin: 0 0 var(--s2); color: var(--faint); }   /* as the questions' label (.fqs__h), so both columns line up */
  /* hairlines between the rows only: none above the first, none under the last (Sergei 2026-11-24) */
  .sa__it + .sa__it { border-top: 1px solid var(--line); }
  .sa__sum { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: var(--s4);
    padding: 18px 0; cursor: pointer; }
  .sa__sum::-webkit-details-marker { display: none; }
  .sa__h { margin: 0; font-size: var(--fs-s0); font-weight: 400; line-height: 1.4; color: var(--ink-2); transition: color .2s ease; }
  .sa__sum:hover .sa__h, .sa__it[open] .sa__h { color: var(--ink); }
  /* a thin plus that turns into a minus */
  .sa__pm { position: relative; flex: none; width: 12px; height: 12px; }
  .sa__pm::before, .sa__pm::after { content: ''; position: absolute; left: 0; top: 50%; width: 12px; height: 1px; background: var(--muted); transition: transform .25s ease; }
  .sa__pm::after { transform: rotate(90deg); }
  .sa__it[open]:not(.is-shut) .sa__pm::after { transform: rotate(0deg); }
  .sa__sum:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .sa__body { padding: 0 0 var(--s5); display: grid; gap: var(--s3); }
  .sa__txt { max-width: 70ch; color: var(--muted); font-size: var(--fs-s0); line-height: 1.65; }
  .sa__txt :global(p) { margin: 0 0 var(--s3); }
  .sa__txt :global(h3) { margin: var(--s4) 0 var(--s2); font-size: var(--fs-s0); font-weight: 600; color: var(--ink-2); }
  .sa__txt :global(ul) { margin: 0 0 var(--s3); padding-left: 1.2em; }
  .sa__txt :global(a) { color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  /* the section links as «Contact us» (Sergei 2026-11-25): quiet at rest, no underline; on hover ink, underline and an
     arrow that fades in and slides (Abroad.astro .abc__more) */
  .sa__links a { color: var(--muted); text-decoration: none; transition: color .15s ease; }
  .sa__links a:is(:hover, :focus-visible) { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  /* the arrow is drawn by CSS, not written in the link: the anchor text stays George's exact words (rule 15) — with a
     «→» inside the <a> the spec check read «property for sale in Greece →» (2026-11-27) */
  .sa__links a::after { content: '→'; display: inline-block; margin-left: .3em; opacity: 0; transform: translateX(-4px); transition: opacity .2s ease, transform .3s ease; }
  .sa__links a:is(:hover, :focus-visible)::after { opacity: 1; transform: translateX(4px); }
  :global([dir='rtl']) .sa__links a::after { margin-left: 0; margin-right: .3em; transform: translateX(4px) scaleX(-1); }
  :global([dir='rtl']) .sa__links a:is(:hover, :focus-visible)::after { transform: translateX(-4px) scaleX(-1); }
  .sa__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); font-size: var(--fs-s-1); }
  /* the questions' look (small label, rows as these): styles/kit.css + FaqSearch.astro, the same on every page */
  .sa__cols { display: grid; gap: var(--s5); }
  .sa__col { min-width: 0; }
  .sa__faq { padding-top: var(--s5); min-width: 0; }
  @media (min-width: 1024px) {
    .sa { padding-block: 80px; }   /* rows stay 18px, the same height as the questions' rows */
    .sa__cols--2 { grid-template-columns: 1fr 1fr; column-gap: 80px; align-items: start; }
    .sa__cols--2 .sa__faq { padding-top: 0; }
    /* Sergei 2026-11-27: the block is one fixed height on every page (720 px = the tallest page, golden-visa-greece: 7 SEO rows closed 475 px + the 240 px answer window; measured 2026-11-27 on all 21 spec pages at 1440 px),
       so the space under it never changes; a long answer scrolls in its own window instead of stretching the block */
    .sa__cols--2 { min-height: var(--sa-h); }
    .sa__cols--2 .sa__body, .sa__cols--2 :global(.k-faq__a) { max-height: var(--sa-win); overflow-y: auto;
      overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
    .sa__cols--2 .sa__body.is-scroll, .sa__cols--2 :global(.k-faq__a.is-scroll) {
      -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 32px), transparent);
              mask-image: linear-gradient(180deg, #000 calc(100% - 32px), transparent); }
  }
  @media (prefers-reduced-motion: reduce) { .sa__pm::before, .sa__pm::after, .sa__h, .sa__links a::after { transition: none; } }
</style>
