---
// The SEO text block, quiet (#365, Sergei with George 2026-11-24): «the SEO block is the loudest thing on the page».
// Rules: the site's working width (not the full screen), compact, no photos, nothing that pulls the eye. George's spec
// text as an accordion: one quiet line per H2 with a hairline between them; a click opens the section's text and its
// links. SEO: every H2, paragraph and link stays in the HTML in the spec order (closed <details> content is in the
// page and read by search engines); the headings keep their ids (#anchors from elsewhere still open them).
// Trial on the home page; the loud block (SpecPosts) stays for the other pages until this is chosen.
import FaqSearch from './FaqSearch.astro';
import { h2Id, type SpecPage } from '../lib/seo-pages';
import { t, type Lang } from '../lib/i18n';

interface Props {
  page: SpecPage; lang: Lang; faqH: string; faqHref?: string;
  /** George's links per section (the same lists the loud block shows as tiles) */
  sectionLinks?: { href: string; text: string }[][];
  /** the small label over the rows (default «Buying in Halkidiki») */
  label?: string;
}
const { page, lang, faqH, faqHref, sectionLinks = [], label } = Astro.props;

// the spec body cut at each <h2>: [intro?, section 1, section 2, …]
const parts = page.body.split(/(?=<h2>)/);
const intro = parts[0] && !parts[0].startsWith('<h2>') ? parts.shift()! : '';
const sections = parts.map((html, i) => {
  const m = html.match(/^<h2>([\s\S]*?)<\/h2>/);
  const head = (m?.[1] ?? '').replace(/<[^>]+>/g, '').trim();
  return { id: h2Id(head), head, body: html.replace(/^<h2>[\s\S]*?<\/h2>/, ''), links: sectionLinks[i] ?? [] };
});
---
<section class="sa" aria-label={sections[0]?.head ?? ''}>
  <div class="wrap sa__in">
    {intro && <div class="sa__intro" set:html={intro} />}
    {/* small labels as «Three paths» (Sergei 2026-11-24), not big titles */}
    <p class="t-label sa__lbl">{label ?? t(lang, 'home.seo_lbl')}</p>
    <div class="sa__list">
      {sections.map((s) => (
        <details class="sa__it" id={`${s.id}-box`} name="seo">   {/* one open at a time (Sergei 2026-11-24), as the questions */}
          <summary class="sa__sum"><h2 id={s.id} class="sa__h">{s.head}</h2><span class="sa__pm" aria-hidden="true"></span></summary>
          <div class="sa__body">
            <div class="sa__txt" set:html={s.body} />
            {s.links.length > 0 && (
              <ul class="sa__links">{s.links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
            )}
          </div>
        </details>
      ))}
    </div>
    {page.faq.length > 0 && <div class="sa__faq"><FaqSearch lang={lang} h={faqH} href={faqHref} items={page.faq} id="faq" bare search={false} headTag="p" /></div>}
  </div>
</section>

<script>
  // an #anchor to one of the headings opens its section (links from elsewhere on the site)
  const open = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const h = id ? document.getElementById(id) : null;
    const d = h?.closest('details.sa__it') as HTMLDetailsElement | null;
    if (d) { d.open = true; h!.scrollIntoView({ block: 'start' }); }
  };
  open();
  window.addEventListener('hashchange', open);
</script>

<style>
  .sa { background: var(--paper); padding-block: var(--s8); }
  .sa__in { display: grid; gap: var(--s6); }
  .sa__intro { max-width: 70ch; color: var(--ink-2); font-size: var(--fs-s0); line-height: 1.65; }
  .sa__intro :global(p) { margin: 0 0 var(--s3); }
  .sa__lbl { margin: 0 0 calc(-1 * var(--s5)); color: var(--faint); }
  /* hairlines between the rows only: none above the first, none under the last (Sergei 2026-11-24) */
  .sa__it + .sa__it { border-top: 1px solid var(--line); }
  /* the questions' look (small label, rows as these): styles/kit.css + FaqSearch.astro, the same on every page */
  .sa__faq { padding-top: var(--s5); }
  @media (min-width: 1024px) { .sa { padding-block: 80px; } .sa__sum { padding: 20px 0; } }
  @media (prefers-reduced-motion: reduce) { .sa__pm::before, .sa__pm::after, .sa__h { transition: none; } }
</style>
