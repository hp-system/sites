---
// The spec's «links out» of a page as photo tiles (Sergei 2026-11-10: «блок ссылок с типами объектов сделать
// как Collections на главной … на всех страницах»), #193.
//   · property-type links (P02, P04–P10) → a row of tiles like the home Collections, each with the cover of a
//     listing of that type (watermarked);
//   · area links (P11–P18 and the municipality pages) → the home's by-area tiles, captioned with the spec's
//     anchor where the spec links that area, with the «from €» line; the other area links (the Greece hub,
//     the area × type pairs) → text links under the tiles;
//   · guides and other pages → text links.
// SEO (rule 15): every link out keeps its exact anchor as the link's only text and its exact target; the
// caption link is stretched over the tile, the photo is decoration, «from €» sits outside the link.
import { type SpecPage, specByPath, LINK_GROUPS } from '../lib/seo-pages';
import { facetBySlug, matches } from '../lib/listing';
import { pickCover, buildAreaTiles } from '../lib/area-tiles';
import { marked, markedSrcSetSmall } from '../lib/photos';
import { t, listUrl, type Lang } from '../lib/i18n';
import { money } from '../lib/format';

interface Props { page: SpecPage; lang: Lang; items: { id: string | number; attributes?: any }[] }
const { page, lang, items } = Astro.props;

const pathOf = (href: string) => { try { return decodeURI(new URL(href, 'https://x').pathname); } catch { return href; } };
const idOf = (href: string) => Number((specByPath(pathOf(href))?.id ?? '').slice(1));
const groupOf = (href: string): 0 | 1 | 2 => {
  const n = idOf(href);
  if (n === 2 || (n >= 4 && n <= 10)) return 0;
  if (n === 3 || (n >= 11 && n <= 18) || n === 58) return 1;
  return 2;
};
// the listings a list URL shows: its facet slugs after the list base, e.g. /en/properties/villas-for-sale
const facetQuery = (href: string) => {
  const segs = pathOf(href).split('/').filter(Boolean).slice(lang === 'el' ? 1 : 2);
  const fs = segs.map((s) => facetBySlug(lang, s)).filter(Boolean);
  return Object.assign({}, ...fs.map((f) => f!.q));
};
const used = new Set<string>();
const pick = (q: object) => pickCover(items as any, (a) => matches({ attributes: a } as any, q as any), used as any);

const links = page.linksOut.filter((l) => pathOf(l.href) !== pathOf(page.path));
const typeTiles = links.filter((l) => groupOf(l.href) === 0)
  .map((l) => ({ ...l, photo: pick(facetQuery(l.href)) }));

// area tiles: the home's five municipalities; the spec's anchor replaces the name where it links that area
const areaLinks = links.filter((l) => groupOf(l.href) === 1);
const { tiles: munis, from } = buildAreaTiles(items as any, lang, (f) => pickCover(items as any, f, used as any), 5);
const taken = new Set<string>();
const areaTiles = munis.map((m) => {
  const hit = areaLinks.find((l) => pathOf(l.href) === pathOf(m.href));
  if (hit) taken.add(hit.href);
  return { href: hit?.href ?? m.href, text: hit?.anchor ?? m.name, sub: m.fromText, photo: m.photo };
});
const areaText = areaLinks.filter((l) => !taken.has(l.href));
const other = links.filter((l) => groupOf(l.href) === 2);
const G = LINK_GROUPS[lang] ?? LINK_GROUPS.en;
---
<section class="sl" aria-label={G.join(' · ')}>
  <div class="wrap sl__in">
    {typeTiles.length > 0 && (
      <div class="sl__grp">
        <p data-h class="t-h2 sl__h">{G[0]}</p>
        <ul class="k-tiles">
          {typeTiles.map((x) => (
            <li class="k-tile">
              {x.photo && <img src={marked(x.photo.url, 800)} srcset={markedSrcSetSmall(x.photo.url)} sizes="(min-width: 1024px) 300px, 50vw"
                               alt="" width="800" height="533" loading="lazy" decoding="async" />}
              <span class="k-tile__t"><a class="k-tile__l" href={x.href}>{x.anchor}</a></span>
            </li>
          ))}
        </ul>
      </div>
    )}
    {areaTiles.length > 0 && (
      <div class="sl__grp">
        <div class="sl__head">
          <h2 data-h class="t-h2 sl__h"><a class="sl__ha" href={listUrl(lang)}>{t(lang, 'home.area_h2')}</a></h2>
          {from > 0 && <p class="sl__sub">{t(lang, 'home.area_sub', { price: money(from, lang) })}</p>}
        </div>
        <ul class="k-tiles sl__areas">
          {areaTiles.map((x) => (
            <li class="k-tile">
              {x.photo && <img src={marked(x.photo.url, 800)} srcset={markedSrcSetSmall(x.photo.url)} sizes="(min-width: 1024px) 240px, 50vw"
                               alt="" width="800" height="533" loading="lazy" decoding="async" />}
              <span class="k-tile__t"><a class="k-tile__l" href={x.href}>{x.text}</a><span class="k-tile__s">{x.sub}</span></span>
            </li>
          ))}
        </ul>
        {areaText.length > 0 && <ul class="sl__links">{areaText.map((l) => <li><a href={l.href}>{l.anchor}</a></li>)}</ul>}
      </div>
    )}
    {other.length > 0 && (
      <div class="sl__grp">
        <p class="t-label sl__lbl">{G[2]}</p>
        <ul class="sl__links">{other.map((l) => <li><a href={l.href}>{l.anchor}</a></li>)}</ul>
      </div>
    )}
  </div>
</section>

<style>
  .sl { padding-block: var(--s7); background: var(--paper); }
  .sl__in { display: grid; gap: var(--s7); }
  .sl__grp { display: grid; gap: var(--s4); }
  .sl__h { margin: 0; }
  .sl__head { display: grid; gap: var(--s2); }
  .sl__sub { margin: 0; font-size: var(--fs-s0); color: var(--muted); }
  .sl__ha { color: inherit; text-decoration: none; }
  .sl__ha:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .sl__lbl { margin: 0; color: var(--faint); }
  .sl__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 24px; font-size: var(--fs-s0); }
  .sl__links a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  @media (min-width: 1024px) { .sl__areas { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .sl__areas > li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 760px) { .sl__areas > li:last-child:nth-child(odd) { grid-column: auto; } }
</style>
