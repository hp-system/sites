---
// The spec body as blocks with photos between them (Sergei 2026-11-09: «нужно что б текста не
// разбрасывались на разные блоки; нужно сделать промежутки картинками между блоками по тематике, а не
// рандомно»). One block per H2 section: its heading, paragraphs and lists stay together. After a
// section, the photo chosen for its topic (the page's `photoThemes`, resolved by the caller from the
// photos' own tags). Rows alternate: text 4 columns + photo 2, then photo 2 + text 4.
// Styles are the home bento's (Construction.astro): white blocks, the stand-out block black
// (as the fact tiles), beige --paper-3 band, 12 px gap; the photo is the property-of-the-week
// «window» on desktop (FeatureProperty.astro).
// Every word of the body stays in the HTML, in the spec order.
// Rejected: one tile per paragraph or list item (variant B of the mockup) — Sergei: the text of a
// section must not be scattered; random photos — they must follow the topic.
export type MosaicPhoto = { src: string; srcset: string; alt: string; style: string };
interface Props { html: string; photos?: (MosaicPhoto | null)[]; standout?: string }
const { html, photos = [], standout = '' } = Astro.props;

const text = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const secs = html.split(/(?=<h2>)/).filter((s) => s.trim()).map((s, i) => {
  const h2 = s.match(/<h2>([\s\S]*?)<\/h2>/)?.[1] ?? '';
  return { h2, rest: s.replace(/<h2>[\s\S]*?<\/h2>/, ''), photo: photos[i] ?? null, dark: !!standout && text(h2) === standout };
});
// alternate the side of the photo only among sections that have one
let k = 0;
const rows = secs.map((s) => ({ ...s, flip: s.photo ? (k++ % 2 === 1) : false }));
---
<div class="sm">
  {rows.map((r) => (
    <div class:list={['sm__row', r.photo && 'sm__row--ph', r.flip && 'sm__row--flip']}>
      <div class:list={['sm__t', r.dark && 'sm__t--fact']}>
        <h2 set:html={r.h2} />
        <div class="sm__tx" set:html={r.rest} />
      </div>
      {r.photo && (
        <div class="sm__ph" style={r.photo.style}>
          <img src={r.photo.src} srcset={r.photo.srcset} sizes="100vw" alt={r.photo.alt}
               width="1920" height="1280" loading="lazy" decoding="async" />
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .sm { display: grid; gap: 12px; }
  .sm__row { display: grid; gap: 12px; }
  .sm__t { min-width: 0; background: var(--paper); padding: var(--s5); display: grid; gap: var(--s3); align-content: start; }
  .sm__t :global(h2) { margin: 0; font-size: var(--fs-s2); font-weight: 300; line-height: 1.12; letter-spacing: -.02em; }
  .sm__tx :global(p) { margin: 0 0 var(--s3); font-size: var(--fs-s0); line-height: 1.55; color: var(--ink-2); max-width: 68ch; }
  .sm__tx :global(p:last-child) { margin-bottom: 0; }
  .sm__tx :global(ul) { margin: 0 0 var(--s3); padding: 0; list-style: none; max-width: 68ch; }
  .sm__tx :global(li) { padding: var(--s2) 0; border-top: 1px solid var(--line); font-size: var(--fs-s0); line-height: 1.5; color: var(--ink-2); }
  .sm__tx :global(strong) { color: var(--ink); font-weight: 600; }
  .sm__t--fact { background: var(--ink-deep); color: #fff; }
  .sm__t--fact .sm__tx :global(p), .sm__t--fact .sm__tx :global(li) { color: rgba(255,255,255,.72); }
  .sm__t--fact .sm__tx :global(li) { border-top-color: rgba(255,255,255,.14); }
  .sm__t--fact .sm__tx :global(strong) { color: #fff; }
  .sm__ph { position: relative; overflow: hidden; min-height: 240px; background: var(--paper-2); }
  .sm__ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--focal, 50% 50%); }
  @media (min-width: 1024px) {
    .sm__row--ph { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .sm__row--flip { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .sm__row--flip .sm__ph { order: -1; }
    .sm__t { padding: var(--s6); }
    .sm__t :global(h2) { font-size: var(--fs-s3); }
    .sm__ph { min-height: 100%; }
    /* the «window» of the property of the week (#101): the tile frames a fixed photo */
    .sm__ph { clip-path: inset(0); }
    .sm__ph img { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .sm__ph { clip-path: none; }
    .sm__ph img { position: absolute; width: 100%; height: 100%; }
  }
</style>
