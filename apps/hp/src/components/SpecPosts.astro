---
// The SEO text block of every page (#365, Sergei with George 2026-11-24: «применяй ети стили как паттерн для всех
// блоков сео и вопросов на ВСЕ страници сайта»). It now draws the quiet accordion (SpecAccordion): the site's working
// width, no photos or tiles, one line per H2, one open at a time, the questions below in the same look. The props
// stay as before so every page keeps its call; the photos / items / cta the loud chapters used are no longer drawn.
// The previous look (chapters, one screen high, a photo per post) is kept in SpecPosts.astro.old_20261124.
import SpecAccordion from './SpecAccordion.astro';
import { linkPath } from '../lib/list-blocks';
import { linksBySection, type SpecPage } from '../lib/seo-pages';
import type { Lang } from '../lib/i18n';

interface Props {
  page: SpecPage; lang: Lang; photos?: unknown[]; faqH: string; faqHref?: string; member?: boolean;
  items?: unknown[]; sectionLinks?: { href: string; text: string }[][]; drop?: Set<string>; facets?: string[];
  cta?: unknown; label?: string;
}
const { page, lang, faqH, faqHref, label } = Astro.props;
const drop = Astro.props.drop ?? new Set<string>();
const sectionLinks = (Astro.props.sectionLinks ?? linksBySection(page)).map((ls) => ls.filter((l) => !drop.has(linkPath(l.href))));
---
<SpecAccordion page={page} lang={lang} faqH={faqH} faqHref={faqHref} sectionLinks={sectionLinks} label={label} />
