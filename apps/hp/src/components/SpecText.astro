---
// The texts of a spec page (#160, plan E-111), in the type of the approved wave-1 pages
// (InfoPage .prose / .faq). Two parts, placed by the template (spec 0_README rule 9):
//   part="intro" → the intro, between the H1 and the grid
//   part="rest"  → the H2 body, the FAQ (questions as H3, answers in the HTML) and the links block
// The HTML comes from the importer's allowlist (p h2 h3 ul li strong, no attributes), so it is
// rendered as is. Links come only from the spec's «links out», with their exact anchors (rule 15).
import type { SpecPage } from '../lib/seo-pages';
import type { Lang } from '../lib/i18n';

interface Props {
  page: SpecPage; part: 'intro' | 'rest'; lang: Lang;
  /** 'tiles': the FAQ as open blocks side by side across the text width (home, Sergei 08/11). */
  faq?: 'list' | 'tiles';
}
const { page, part, lang, faq = 'list' } = Astro.props;

const L: Record<Lang, { faq: string; more: string }> = {
  en: { faq: 'Frequently asked questions', more: 'See also' },
  el: { faq: 'Συχνές ερωτήσεις', more: 'Δείτε επίσης' },
  de: { faq: 'Häufige Fragen', more: 'Siehe auch' },
  sr: { faq: 'Česta pitanja', more: 'Pogledajte i' },
  bg: { faq: 'Често задавани въпроси', more: 'Вижте също' },
  ro: { faq: 'Întrebări frecvente', more: 'Vedeți și' },
  ru: { faq: 'Частые вопросы', more: 'Смотрите также' },
  tr: { faq: 'Sık sorulan sorular', more: 'Ayrıca bakın' },
  he: { faq: 'שאלות נפוצות', more: 'ראו גם' },
};
const ui = L[lang] ?? L.en;
---
{part === 'intro' && page.intro && <div class="st-intro prose" set:html={page.intro} />}

{part === 'rest' && (
  <section class="st wrap" aria-label={page.h1}>
    {page.body && <div class="prose" set:html={page.body} />}
    {page.faq.length > 0 && faq === 'tiles' && (
      <section class="faqt" aria-label={ui.faq}>
        <p class="t-label st-lbl">{ui.faq}</p>
        <div class="faqt__row">
          {page.faq.map((f) => (
            <article class="faqt__it"><h3 class="faq-q">{f.q}</h3><div class="faq-a" set:html={f.a.includes('<') ? f.a : `<p>${f.a}</p>`} /></article>
          ))}
        </div>
      </section>
    )}
    {page.faq.length > 0 && faq === 'list' && (
      <section class="faq" aria-label={ui.faq}>
        <p class="t-label st-lbl">{ui.faq}</p>
        {page.faq.map((f, i) => (
          <details open={i === 0}><summary><h3 class="faq-q">{f.q}</h3></summary><div class="faq-a" set:html={f.a.includes('<') ? f.a : `<p>${f.a}</p>`} /></details>
        ))}
      </section>
    )}
    {page.linksOut.length > 0 && (
      <nav class="st-links" aria-label={ui.more}>
        <p class="t-label st-lbl">{ui.more}</p>
        <ul>{page.linksOut.map((l) => <li><a href={l.href}>{l.anchor}</a></li>)}</ul>
      </nav>
    )}
  </section>
)}

<style>
  .st { padding-block: var(--s8) var(--s9); display: grid; gap: var(--s7); }
  .st-intro { margin-top: var(--s3); }
  .prose { max-width: 68ch; font-size: var(--fs-s0); line-height: 1.7; color: var(--ink-2); min-width: 0; }
  .prose :global(h2) { font-size: var(--fs-s2); font-weight: 400; line-height: 1.25; color: var(--ink); margin: var(--s7) 0 var(--s3); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: var(--fs-s0); font-weight: 600; color: var(--ink); margin: var(--s5) 0 var(--s2); }
  .prose :global(p), .prose :global(ul) { margin: 0 0 var(--s4); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .st-intro.prose :global(p:last-child) { margin-bottom: 0; }
  .st-lbl { margin: 0 0 var(--s3); color: var(--muted); }
  .faq { max-width: 68ch; }
  .faq details { border-top: 1px solid var(--line); padding: var(--s3) 0; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; font-weight: 300; font-size: var(--fs-s1); line-height: 1; color: var(--ink); }
  .faq details[open] summary::after { content: "−"; }
  .faq .faq-q { font-size: var(--fs-s0); font-weight: 600; line-height: 1.4; margin: 0; color: var(--ink); }
  .faq-a { margin: var(--s2) 0 0; font-size: var(--fs-s0); line-height: 1.65; color: var(--ink-2); }
  .faq-a :global(p) { margin: 0 0 var(--s2); }
  /* FAQ as tiles (home): every answer open, the blocks share the text width */
  .faqt__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s3); }
  .faqt__it { background: var(--paper-2); padding: var(--s5); display: flex; flex-direction: column; gap: var(--s3); min-width: 0; }
  .faqt .faq-q { font-size: var(--fs-s0); font-weight: 600; line-height: 1.4; margin: 0; color: var(--ink); }
  .faqt .faq-a { margin: 0; }
  @media (min-width: 760px) { .faqt__row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .faqt__row { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .st-links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); }
  .st-links a { color: var(--ink); font-size: var(--fs-s0); text-underline-offset: 3px; }
</style>
