---
// The texts of a spec page (#160, plan E-111), in the type of the approved wave-1 pages
// (InfoPage .prose / .faq). Two parts, placed by the template (spec 0_README rule 9):
//   part="intro" → the intro, between the H1 and the grid
//   part="rest"  → the H2 body, the FAQ (questions as H3, answers in the HTML) and the links block
// The HTML comes from the importer's allowlist (p h2 h3 ul li strong, no attributes), so it is
// rendered as is. Links come only from the spec's «links out», with their exact anchors (rule 15).
import { specSections, specByPath, type SpecPage } from '../lib/seo-pages';
import type { Lang } from '../lib/i18n';

interface Props {
  page: SpecPage; part: 'intro' | 'rest'; lang: Lang;
  /** 'tiles': the FAQ as open blocks side by side across the text width (home, Sergei 08/11). */
  faq?: 'list' | 'tiles';
  /** 'rotate': the H2 sections in one block of fixed height, one at a time every 3 s, dashes to
   *  pick one (home, Sergei 08/11: «стоять на месте, но перелистывать SEO-текст»). Every section
   *  stays in the HTML, in the spec's order — search engines read all of it. Phones: all shown. */
  body?: 'prose' | 'rotate';
  /** 'columns': the spec's links grouped like the footer — properties / areas / guides (home,
   *  Sergei 08/11); `more` adds the block's own guide links to the guides column. */
  links?: 'inline' | 'columns' | 'sections';
  more?: { href: string; text: string }[];
}
const { page, part, lang, faq = 'list', body = 'prose', links = 'inline', more = [] } = Astro.props;
// Group a spec link by the spec page it points to: P02, P04–P10 property lists; P03, P11–P18 areas
// and the Greece hub; anything else (P19+ guides, other pages) → guides. Anchors stay word for word.
const G: Record<Lang, [string, string, string]> = {
  en: ['Properties', 'Areas', 'Guides'], el: ['Ακίνητα', 'Περιοχές', 'Οδηγοί'], de: ['Immobilien', 'Regionen', 'Ratgeber'],
  sr: ['Nekretnine', 'Oblasti', 'Vodiči'], bg: ['Имоти', 'Райони', 'Наръчници'], ro: ['Proprietăți', 'Zone', 'Ghiduri'],
  ru: ['Недвижимость', 'Районы', 'Гиды'], tr: ['Emlak', 'Bölgeler', 'Rehberler'], he: ['נכסים', 'אזורים', 'מדריכים'],
};
const groupOf = (href: string): 0 | 1 | 2 => {
  let path = href; try { path = new URL(href, 'https://x').pathname; } catch {}
  const n = Number((specByPath(path)?.id ?? '').slice(1));
  if (n === 2 || (n >= 4 && n <= 10)) return 0;
  if (n === 3 || (n >= 11 && n <= 18)) return 1;
  return 2;
};
const secs = body === 'rotate' ? specSections(page.body) : [];
// 'sections' (home, Sergei 08/11): each link goes under the rotating section it belongs to — the one
// sharing the most distinctive words with its anchor (words found in most sections, like the place
// name, do not count; works in every language). No match → the first section.
const words = (x: string) => x.toLowerCase().replace(/<[^>]+>/g, ' ').match(/[\p{L}\p{N}]{4,}/gu) ?? [];
const secWords = secs.map((x) => new Set(words(x.h2 + ' ' + x.html)));
const common = new Set([...new Set(secWords.flatMap((w) => [...w]))].filter((w) => secWords.filter((sw) => sw.has(w)).length > secs.length / 2));
const stem = (w: string) => w.slice(0, 5);
const headStems = secs.map((x) => new Set(words(x.h2).map(stem)));
const bodyStems = secWords.map((sw) => new Set([...sw].map(stem)));
const bySec: { href: string; text: string }[][] = secs.map(() => []);
// score = 2 × words shared with the section's heading + 1 × with its text; a tie goes to the section
// with fewer links so far; no match at all → `fallback`
// words in most anchors («sale», «Halkidiki», «property») say nothing about where a link belongs
const anchorWords = page.linksOut.map((l) => new Set(words(l.anchor).map(stem)));
const anchorCommon = new Set([...new Set(anchorWords.flatMap((w) => [...w]))].filter((w) => anchorWords.filter((aw) => aw.has(w)).length > anchorWords.length / 3));
const secOf = (anchor: string, fallback = 0): number => {
  const a = words(anchor).filter((w) => !common.has(w)).map(stem).filter((w) => !anchorCommon.has(w));
  let best = -1, score = 0;
  secs.forEach((_, i) => {
    const n = a.reduce((t, w) => t + (headStems[i].has(w) ? 2 : bodyStems[i].has(w) ? 1 : 0), 0);
    if (n > score || (n === score && n > 0 && bySec[i].length < bySec[best].length)) { score = n; best = i; }
  });
  return best < 0 ? fallback : best;
};
if (links === 'sections' && secs.length) {
  let guideSec = 0;
  page.linksOut.forEach((l) => {
    const k = secOf(l.anchor);
    bySec[k].push({ href: l.href, text: l.anchor });
    let path = l.href; try { path = new URL(l.href, 'https://x').pathname; } catch {}
    if (specByPath(path)?.id === 'P19') guideSec = k;          // the buying guide's section
  });
  more.forEach((l) => bySec[secOf(l.text, guideSec)].push(l));   // our guides join it unless they match better
}
const cols: { href: string; text: string }[][] = [[], [], []];
if (links === 'columns') {
  page.linksOut.forEach((l) => cols[groupOf(l.href)].push({ href: l.href, text: l.anchor }));
  cols[2].push(...more);
}

const L: Record<Lang, { faq: string; more: string }> = {
  en: { faq: 'Frequently asked questions', more: 'See also' },
  el: { faq: 'Συχνές ερωτήσεις', more: 'Δείτε επίσης' },
  de: { faq: 'Häufige Fragen', more: 'Siehe auch' },
  sr: { faq: 'Česta pitanja', more: 'Pogledajte i' },
  bg: { faq: 'Често задавани въпроси', more: 'Вижте също' },
  ro: { faq: 'Întrebări frecvente', more: 'Vedeți și' },
  ru: { faq: 'Частые вопросы', more: 'Смотрите также' },
  tr: { faq: 'Sık sorulan sorular', more: 'Ayrıca bakın' },
  he: { faq: 'שאלות נפוצות', more: 'ראו גם' },
};
const ui = L[lang] ?? L.en;
---
{part === 'intro' && page.intro && <div class="st-intro prose" set:html={page.intro} />}

{part === 'rest' && (
  <section class="st wrap" aria-label={page.h1}>
    {page.body && body === 'prose' && <div class="prose" set:html={page.body} />}
    {secs.length > 0 && (
      <div class="st-rot" data-rot-hold="seo">
        <div class="h-bars st-rot__bars" role="group" aria-label={page.h1}>
          {secs.map((x, i) => (
            <button type="button" class:list={['h-bar', i === 0 && 'on']} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={x.h2.replace(/<[^>]+>/g, '')}><span></span></button>
          ))}
        </div>
        <div class="h-stack st-rot__stack" data-rot="seo">
          {secs.map((x, i) => (
            <article class:list={['h-sx', 'st-rot__it', i === 0 && 'on']}>
              <h2 set:html={x.h2} />
              <div class="st-rot__tx">
                <div class="prose" set:html={x.html} />
                {bySec[i]?.length > 0 && <ul class="st-rot__links">{bySec[i].map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
    {page.faq.length > 0 && faq === 'tiles' && (
      <section class="faqt" aria-label={ui.faq}>
        <p class="t-label st-lbl">{ui.faq}</p>
        <div class="faqt__row">
          {page.faq.map((f) => (
            <div class="faqt__slot"><article class="faqt__it" tabindex="0"><h3 class="faq-q">{f.q}</h3><div class="faq-a" set:html={f.a.includes('<') ? f.a : `<p>${f.a}</p>`} /></article></div>
          ))}
        </div>
      </section>
    )}
    {page.faq.length > 0 && faq === 'list' && (
      <section class="faq" aria-label={ui.faq}>
        <p class="t-label st-lbl">{ui.faq}</p>
        {page.faq.map((f, i) => (
          <details open={i === 0}><summary><h3 class="faq-q">{f.q}</h3></summary><div class="faq-a" set:html={f.a.includes('<') ? f.a : `<p>${f.a}</p>`} /></details>
        ))}
      </section>
    )}
    {page.linksOut.length > 0 && links === 'columns' && (
      <nav class="st-cols" aria-label={ui.more}>
        {cols.map((c, i) => c.length > 0 && (
          <div class="st-col">
            <p class="t-label st-lbl">{(G[lang] ?? G.en)[i]}</p>
            <ul>{c.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    )}
    {page.linksOut.length > 0 && links === 'inline' && (
      <nav class="st-links" aria-label={ui.more}>
        <p class="t-label st-lbl">{ui.more}</p>
        <ul>{page.linksOut.map((l) => <li><a href={l.href}>{l.anchor}</a></li>)}</ul>
      </nav>
    )}
  </section>
)}

<style>
  .st { padding-block: var(--s8) var(--s9); display: grid; gap: var(--s7); }
  .st:has(.st-rot) { gap: var(--s5); padding-block: var(--s6) var(--s6); }   /* bottom = the links' top padding (32), Sergei 08/11 */   /* home (Sergei 08/11): the SEO blocks closer together */
  .st-intro { margin-top: var(--s3); }
  .prose { max-width: 68ch; font-size: var(--fs-s0); line-height: 1.7; color: var(--ink-2); min-width: 0; }
  .prose :global(h2) { font-size: var(--fs-s2); font-weight: 400; line-height: 1.25; color: var(--ink); margin: var(--s7) 0 var(--s3); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: var(--fs-s0); font-weight: 600; color: var(--ink); margin: var(--s5) 0 var(--s2); }
  .prose :global(p), .prose :global(ul) { margin: 0 0 var(--s4); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .st-intro.prose :global(p:last-child) { margin-bottom: 0; }
  .st-lbl { margin: 0 0 var(--s3); color: var(--muted); }
  .faq { max-width: 68ch; }
  .faq details { border-top: 1px solid var(--line); padding: var(--s3) 0; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; font-weight: 300; font-size: var(--fs-s1); line-height: 1; color: var(--ink); }
  .faq details[open] summary::after { content: "−"; }
  .faq .faq-q { font-size: var(--fs-s0); font-weight: 600; line-height: 1.4; margin: 0; color: var(--ink); }
  .faq-a { margin: var(--s2) 0 0; font-size: var(--fs-s0); line-height: 1.65; color: var(--ink-2); }
  .faq-a :global(p) { margin: 0 0 var(--s2); }
  /* SEO sections rotating in one block (home) */
  .st-rot { position: relative; border-top: 1px solid var(--line); padding-top: var(--s6); }
  .st-rot__bars { display: none; }
  .st-rot__links { list-style: none; margin: var(--s3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s1) var(--s5); }
  /* Sergei 08/11: grey at rest, dark on hover, an arrow after each (CSS, so the anchor text stays the spec's) */
  .st-rot__links a { color: var(--muted); font-size: var(--fs-s0); text-decoration: none; transition: color .15s ease; }
  .st-rot__links a::after { content: " →"; }
  .st-rot__links a:hover, .st-rot__links a:focus-visible { color: var(--ink); }
  .st-rot__it h2 { font-size: var(--fs-s3); font-weight: 300; letter-spacing: -.016em; line-height: 1.14; color: var(--ink); margin: 0 0 var(--s4); max-width: 30ch; }
  .st-rot__it .prose { max-width: 72ch; }
  .st-rot__it + .st-rot__it { margin-top: var(--s7); }
  @media (min-width: 1024px) {
    .st-rot__bars { display: flex; position: absolute; top: 20px; right: 0; margin: 0; }
    .st-rot__it + .st-rot__it { margin-top: 0; }
    /* Sergei 08/11: the «Buying from abroad» band's look — big light heading left, its text right in
       muted, dashes in the top-right corner, the group centred on the band, no rule above */
    .st-rot { border-top: 0; padding: var(--s5) 0; min-height: 260px; box-sizing: border-box; display: flex; align-items: center; }   /* Sergei 08/11: tighter */
    .st-rot__stack { width: 100%; }
    .st-rot__stack > .st-rot__it { align-self: center; }
    .st-rot__it { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 72px; align-items: center; }
    .st-rot__it h2 { margin: 0; max-width: none; font-size: var(--fs-s4); line-height: 1.1; }
    .st-rot__it .prose { max-width: none; color: var(--muted); }
    .st-rot__links { list-style: none; margin: var(--s3) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s1) var(--s5); }
  }
  /* FAQ as tiles (home): every answer open, the blocks share the text width */
  .faqt__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s3); }
  .faqt__it { background: var(--paper-2); padding: var(--s5); display: flex; flex-direction: column; gap: var(--s3); min-width: 0; }
  .faqt .faq-q { font-size: var(--fs-s0); font-weight: 600; line-height: 1.4; margin: 0; color: var(--ink); }
  .faqt .faq-a { margin: 0; }
  /* Sergei 08/11: four horizontal blocks, each the full width — the question left, its answer right */
  @media (min-width: 1024px) {
    .faqt__it { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); column-gap: 72px; align-items: start; padding: var(--s6) var(--s6); }
    .faqt .faq-q { font-size: var(--fs-s1); font-weight: 400; line-height: 1.3; }
  }
  /* Sergei 08/11 (2): with a mouse, each block is one line — the question alone; pointing at it (or
     tabbing to it) opens it: the question moves left, the answer appears right. Without a mouse
     (phones, tablets) every answer stays open. The answers are always in the HTML (FAQPage = the
     page's FAQ, Google reads text in collapsed blocks). */
  @media (min-width: 1024px) and (hover: hover) {
    .faqt__it { padding: var(--s5) var(--s6); cursor: default; transition: background-color .2s ease; }
    .faqt__it .faq-q { grid-column: 1 / -1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .faqt__it .faq-a { display: none; }
    .faqt__it:is(:hover, :focus-within, .is-measure) .faq-q { grid-column: 1; white-space: normal; }
    .faqt__it:is(:hover, :focus-within, .is-measure) .faq-a { display: block; grid-column: 2; grid-row: 1; }
    /* Sergei 08/11 (3): no reserved space — each row sits in a slot of its closed height and opens
       OVER the rows below (a raised card), so nothing on the page moves */
    /* Sergei 08/11 (4): two rows of two, across the WHOLE screen width (--pw measured by the script:
       the page's width without the scrollbar) */
    .faqt__row { grid-template-columns: repeat(2, minmax(0, 1fr)); width: var(--pw, 100%); margin-left: calc((100% - var(--pw, 100%)) / 2); }
    .faqt__slot { position: relative; height: var(--faq-slot, 77px); }
    .faqt__slot > .faqt__it { position: absolute; inset: 0 0 auto 0; }
    .faqt__slot > .faqt__it:is(:hover, :focus-within) { z-index: 3; box-shadow: 0 18px 40px rgba(14, 18, 20, .14); }
    .faqt__it:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  }
  /* the spec links as footer-like columns (home) */
  .st-cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s6); border-top: 1px solid var(--line); padding-top: var(--s6); }
  .st-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  .st-col a { color: var(--ink-2); font-size: var(--fs-s0); text-decoration: none; }
  .st-col a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 760px) { .st-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .st-links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); }
  .st-links a { color: var(--ink); font-size: var(--fs-s0); text-underline-offset: 3px; }
</style>

<script>
  // Sergei 08/11: the FAQ rows open over the rows below; each slot is the closed row's height,
  // measured (not guessed) so it follows the font and the language.
  const fit = () => {
    document.querySelectorAll<HTMLElement>('.faqt__row').forEach((row) => {
      const first = row.querySelector<HTMLElement>('.faqt__it');
      row.style.removeProperty('--faq-slot');
      row.style.removeProperty('--pw');
      if (!first || !matchMedia('(min-width: 1024px) and (hover: hover)').matches) return;
      row.style.setProperty('--pw', `${document.documentElement.clientWidth}px`);
      row.style.setProperty('--faq-slot', `${Math.ceil(first.getBoundingClientRect().height)}px`);
    });
  };
  fit();
  document.fonts?.ready.then(fit);
  window.addEventListener('resize', fit);
</script>
