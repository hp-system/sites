---
// In the panel frame (PanelShell, design E3 — Sergei 2026-11-11 «AFTER main v3»)
import PanelShell from './PanelShell.astro';
// ═══════════════════════════════════════════════════════════════════════════
// ΚΑΤΑΧΩΡΗΣΗ ΑΚΙΝΗΤΟΥ — `/panel/submit`
//
// ✅ ΕΧΕΙ ΠΡΑΓΜΑΤΙΚΟ ΠΡΟΟΡΙΣΜΟ: `POST /site/property-submission` → μπαίνει στο EALIDA
//    ως **draft** (`readiness: 'draft'`), δηλαδή **δεν εμφανίζεται πουθενά** μέχρι να
//    το εγκρίνει άνθρωπος. Ο ιδιοκτήτης δεν δημοσιεύει· υποβάλλει.
//
// 🔑 ΤΟ ΣΗΜΕΡΙΝΟ SITE ΖΗΤΑΕΙ ΠΕΝΤΕ ΒΗΜΑΤΑ, ΜΕ ΧΩΡΟΥΣ ΑΝΑ ΟΡΟΦΟ ΚΑΙ ΝΟΜΙΚΑ ΑΡΧΕΙΑ.
//    Εδώ ζητάμε το ελάχιστο που κάνει το τηλεφώνημα χρήσιμο. Ο μεσίτης παίρνει τα
//    υπόλοιπα στην κουβέντα — και ο ιδιοκτήτης δεν εγκαταλείπει στο βήμα 3.
//    (George, εγγραφή: «τα ελάχιστα στοιχεία από τον πελάτη». Ίδια λογική.)
//
// 🪤 ΤΟ API ΘΕΛΕΙ **name + email** ΥΠΟΧΡΕΩΤΙΚΑ (`site.service.ts:626`) — αλλιώς 404.
//    Τα παίρνουμε από τον ΛΟΓΑΡΙΑΣΜΟ, δεν τα ξαναρωτάμε. Αν λείπει το όνομα (τα
//    περισσότερα μέλη δεν το έχουν), στέλνουμε τον χρήστη να το συμπληρώσει πρώτα
//    αντί να τον αφήσουμε να γράψει τα πάντα και να φάει σφάλμα στο τέλος.
// ═══════════════════════════════════════════════════════════════════════════
import { prefix, t, type Lang } from '../lib/i18n';
import { company } from '../lib/company';
import type { Member } from '../lib/member';

interface Props { lang: Lang; me: Member }
const { lang, me } = Astro.props;
const p = prefix(lang);
const co = await company();

// Ο έλεγχος γίνεται ΠΡΙΝ δει τη φόρμα, όχι μετά τη συμπλήρωση.
const canSubmit = !!me.name && !!me.email;

const KINDS: [string, string][] = [
  ['house', t(lang, 'sb.k.house')], ['apartment', t(lang, 'sb.k.apartment')],
  ['maisonette', t(lang, 'sb.k.maisonette')], ['villa', t(lang, 'sb.k.villa')],
  ['land', t(lang, 'sb.k.land')], ['commercial', t(lang, 'sb.k.commercial')],
];

// 🗣️ ΤΑ ΜΗΝΥΜΑΤΑ ΤΟΥ `<script>` ΠΕΡΝΟΥΝ ΩΣ ΔΕΔΟΜΕΝΑ, ΟΧΙ ΩΣ ΚΩΔΙΚΑΣ.
//    Το script τρέχει στον browser και ΔΕΝ βλέπει το frontmatter ούτε το `t()`.
//    Ίδιο μοτίβο με το `data-family` του FilterSheet.
const JS_T = {
  sending: t(lang, 'auth.sending'),
  e_area: t(lang, 'sb.e.area'),
  e_fail: t(lang, 'sb.e.fail'),
  e_offline: t(lang, 'sb.e.offline'),
  // B-15: texts for the error codes of /api/panel/submit.
  e_expired: t(lang, 'auth.e.expired'),
  e_name_first: t(lang, 'sb.e.name_first'),
  files_n: t(lang, 'sb.files_n'),
  levels: t(lang, 'sb.levels'),
};

// Sergei 2026-11-23: the form fits one screen. Everything beyond the kind sits behind «Details» (a window, as «More
// filters» on the list); after «Done» it shows as one short line. Photos and documents get their own cells; sending
// files is not open on the CRM yet, so the cells keep the choice and say so (the count goes to the adviser).
const ORIENT = ['n', 'ne', 'e', 'se', 's', 'sw', 'w', 'nw'] as const;
const ROAD = ['asphalt', 'paved', 'dirt', 'boat'] as const;
const ICO_DET = 'M2 4.5h12M4.5 8h7M6.8 11.5h2.4';
---

<PanelShell lang={lang} me={me} current={'submit'} title={t(lang, 'sb.title')} description={t(lang, 'sb.meta_desc')}>
  <div class="sb">

      <h1 class="t-h2 sb__h">{t(lang, 'sb.h1')}</h1>
      <p class="sb__s">{t(lang, 'sb.sub')}</p>

      {!canSubmit ? (
        <div class="ask">
          <p class="ask__h">{t(lang, 'sb.need_h')}</p>
          <p class="ask__s">{t(lang, 'sb.need_s')}</p>
          <a class="btn" href={`${p}/panel/profile`}>{t(lang, 'pnl.profile')}</a>
        </div>
      ) : (
        <form id="f" novalidate data-i18n={JSON.stringify(JS_T)}>
          <fieldset>
            <legend class="lg">{t(lang, 'sb.what')}</legend>
            <div class="opts" role="radiogroup" aria-labelledby="kindL">
              <span id="kindL" class="sr-only">{t(lang, 'sb.kind_l')}</span>
              {KINDS.map(([v, label], i) => (
                <label class="opt">
                  <input type="radio" name="kind" value={v} checked={i === 0} />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          {/* the bar: Details · Photos · Documents — the list's «More filters» cell, three times */}
          <div class="bar">
            <button type="button" class="cell" data-det aria-haspopup="dialog">
              <svg class="cell__ic" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d={ICO_DET} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" fill="none" /></svg>
              <span>{t(lang, 'sb.details')}</span>
            </button>
            <label class="cell">
              <input type="file" name="photos" accept="image/*" multiple class="sr-only" data-files="ph" />
              <svg class="cell__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
              <span>{t(lang, 'sb.photos')}</span><span class="cell__n" data-n="ph"></span>
            </label>
            <label class="cell">
              <input type="file" name="docs" accept=".pdf,image/*" multiple class="sr-only" data-files="dc" />
              <svg class="cell__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5M10 13h6M10 17h6"></path></svg>
              <span>{t(lang, 'sb.docs')}</span><span class="cell__n" data-n="dc"></span>
            </label>
          </div>

          {/* what «Details» holds, in one short line once filled */}
          <p class="sum" data-sum hidden><span data-sum-t></span> <button type="button" class="sum__b" data-det>{t(lang, 'sb.change')}</button></p>
          <p class="soon" data-soon hidden>{t(lang, 'sb.files_soon')}</p>

          <p class="err" id="e" role="alert" aria-live="polite" hidden></p>

          <button class="btn go" type="submit">{t(lang, 'sb.send')}</button>

          {/* Το `{b}` είναι το έντονο κομμάτι της πρότασης — μπαίνει ως <b>, γι' αυτό
              η φράση σπάει στα δύο αντί να τυπωθεί με ένα `t()`. */}
          <p class="fine" set:html={t(lang, 'sb.fine', { b: `<b>${t(lang, 'sb.fine_b')}</b>` })}></p>

          <dialog class="dlg" data-dlg aria-labelledby="dlgH">
            <div class="dlg__top">
              <div>
                <p class="dlg__h" id="dlgH">{t(lang, 'sb.d_h')}</p>
                <p class="dlg__s">{t(lang, 'sb.d_s')}</p>
              </div>
              <button type="button" class="dlg__x" data-x aria-label={t(lang, 'ui.close')}><svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.4"></path></svg></button>
            </div>
            <div class="dlg__g">
              <div>
                <label class="fl" for="area">{t(lang, 'sb.area')}</label>
                <input class="fi" id="area" name="area" autocomplete="address-level2" placeholder={t(lang, 'sb.area_ph')} maxlength="120" />
              </div>
              <div>
                <label class="fl" for="address">{t(lang, 'sb.addr')} <span class="opt-t">{t(lang, 'sb.optional')}</span></label>
                <input class="fi" id="address" name="address" placeholder={t(lang, 'sb.addr_ph')} maxlength="160" />
              </div>
              <div>
                <label class="fl" for="sqm">{t(lang, 'sb.sqm')}</label>
                <input class="fi" id="sqm" name="sqm" inputmode="numeric" maxlength="7" />
              </div>
              <div>
                <label class="fl" for="price">{t(lang, 'sb.price')} <span class="opt-t">{t(lang, 'sb.optional')}</span></label>
                <input class="fi" id="price" name="price" inputmode="numeric" maxlength="12" />
              </div>
              <div>
                <label class="fl" for="levels">{t(lang, 'sb.levels')}</label>
                <select class="fi" id="levels" name="levels">
                  <option value="">{t(lang, 'sb.choose')}</option>
                  {[1, 2, 3, 4].map((n) => <option value={n}>{n === 4 ? '4+' : n}</option>)}
                </select>
              </div>
              <div>
                <label class="fl" for="orient">{t(lang, 'sb.orient')}</label>
                <select class="fi" id="orient" name="orient">
                  <option value="">{t(lang, 'sb.choose')}</option>
                  {ORIENT.map((o) => <option value={o}>{t(lang, `sb.o.${o}`)}</option>)}
                </select>
              </div>
              <div class="dlg__w">
                <label class="fl" for="road">{t(lang, 'sb.road')}</label>
                <select class="fi" id="road" name="road">
                  <option value="">{t(lang, 'sb.choose')}</option>
                  {ROAD.map((r) => <option value={r}>{t(lang, `sb.r.${r}`)}</option>)}
                </select>
              </div>
              <div class="dlg__w">
                <label class="fl" for="desc">{t(lang, 'sb.desc')} <span class="opt-t">{t(lang, 'sb.optional')}</span></label>
                <textarea class="fi ta" id="desc" name="desc" rows="3" maxlength="3000"></textarea>
              </div>
            </div>
            <p class="err" data-derr role="alert" hidden></p>
            <button type="button" class="btn go" data-ok>{t(lang, 'sb.done')}</button>
          </dialog>
        </form>
      )}

      <div class="done" id="ok" hidden>
        <p class="done__h">{t(lang, 'sb.ok_h')}</p>
        <p class="done__s">{t(lang, 'sb.ok_s')}</p>
        <a class="btn" href={co.phoneHref}><bdi dir="ltr">{co.phone}</bdi></a>
      </div>
    </div>
</PanelShell>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const form = document.getElementById('f') as HTMLFormElement | null;
  let busy = false;

  // Τα κείμενα έρχονται από το `data-i18n` — δες το `JS_T` στο frontmatter.
  const L: Record<string, string> = JSON.parse(form?.dataset.i18n || '{}');
  const val = (id: string) => ((form?.querySelector(`#${id}`) as HTMLInputElement | null)?.value ?? '').trim();
  const dlg = form?.querySelector<HTMLDialogElement>('[data-dlg]');
  const nOf = (k: string) => (form?.querySelector<HTMLInputElement>(`[data-files="${k}"]`)?.files?.length ?? 0);

  // the short line under the bar: area · m² · price · levels · orientation
  const summary = () => {
    const sel = (id: string) => { const el = form?.querySelector<HTMLSelectElement>(`#${id}`); return el && el.value ? el.options[el.selectedIndex].text : ''; };
    const sqm = val('sqm').replace(/\D/g, ''), price = val('price').replace(/\D/g, '');
    const bits = [val('area'), val('address'), sqm && `${sqm} m²`, price && `€${Number(price).toLocaleString('en-US')}`,
      val('levels') && `${sel('levels')} · ${L.levels.toLowerCase()}`, sel('orient'), sel('road')].filter(Boolean);
    const sum = form?.querySelector<HTMLElement>('[data-sum]');
    const t = form?.querySelector<HTMLElement>('[data-sum-t]');
    if (sum && t) { t.textContent = bits.join(' · '); sum.hidden = bits.length === 0; }
    form?.querySelector('.bar [data-det]')?.classList.toggle('cell--on', bits.length > 0);
  };

  form?.querySelectorAll('[data-det]').forEach((b) => b.addEventListener('click', () => dlg?.showModal()));
  dlg?.querySelector('[data-x]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('close', summary);
  dlg?.querySelector('[data-ok]')?.addEventListener('click', () => {
    const de = dlg.querySelector<HTMLElement>('[data-derr]')!;
    if (!val('area')) { de.textContent = L.e_area; de.hidden = false; (form?.querySelector('#area') as HTMLInputElement).focus(); return; }
    de.hidden = true;
    dlg.close();
  });

  // photos / documents: kept as chosen; the cell shows how many
  form?.querySelectorAll<HTMLInputElement>('[data-files]').forEach((inp) => inp.addEventListener('change', () => {
    const k = inp.dataset.files!;
    const n = inp.files?.length ?? 0;
    const out = form.querySelector<HTMLElement>(`[data-n="${k}"]`);
    if (out) out.textContent = n ? String(n) : '';
    inp.closest('.cell')?.classList.toggle('cell--on', n > 0);
    form.querySelector<HTMLElement>('[data-soon]')!.hidden = nOf('ph') + nOf('dc') === 0;
  }));

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (busy) return;
    const err = $('e');
    err.hidden = true;

    const kind = (form.querySelector('input[name=kind]:checked') as HTMLInputElement)?.value ?? '';
    // Ο ΜΟΝΟΣ υποχρεωτικός έλεγχος. Χωρίς περιοχή η υποβολή δεν είναι αξιοποιήσιμη — the window opens on it.
    if (!val('area')) { dlg?.showModal(); (form.querySelector('#area') as HTMLInputElement).focus(); return; }

    busy = true;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const was = btn.textContent;
    btn.disabled = true; btn.textContent = L.sending;

    try {
      const r = await fetch('/api/panel/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          kind, area: val('area'), address: val('address'), sqm: val('sqm').replace(/\D/g, ''), price: val('price').replace(/\D/g, ''),
          levels: val('levels'), orient: val('orient'), road: val('road'), desc: val('desc'), photosN: nOf('ph'), docsN: nOf('dc'),
        }),
      });
      const b = await r.json().catch(() => ({}));
      if (b?.ok) {
        form.hidden = true;
        $('ok').hidden = false;
        $('ok').scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      // B-15: the endpoint answers with a `code`; its text is in the page language.
      // The CRM's own messages are Greek: only on Greek pages.
      err.textContent = (b?.code && (L as Record<string, string>)[`e_${b.code}`])
        || (document.documentElement.lang.startsWith('el') ? b?.message : '') || L.e_fail;
      err.hidden = false;
    } catch {
      err.textContent = L.e_offline;
      err.hidden = false;
    } finally {
      busy = false; btn.disabled = false; btn.textContent = was;
    }
  });
</script>

<style>
  .sb { padding: var(--s6) 0 var(--s9); }
  .sb .wrap { max-width: 620px; }
  .crumb { font-size: var(--fs-s-1); color: var(--faint); display: flex; gap: 7px; align-items: center;
           margin-bottom: 10px; }
  .crumb a { color: var(--muted); }
  .crumb span { color: var(--line); }
  .sb__h { margin: 0 0 8px; }
  .sb__s { font-size: var(--fs-s0); color: var(--ink-2); margin: 0 0 26px; max-width: 52ch; }

  fieldset { border: 0; padding: 0; margin: 0 0 20px; }
  .lg { font-size: var(--fs-s-1); letter-spacing: .14em; text-transform: uppercase; color: var(--faint);
        font-weight: 600; padding: 0; margin-bottom: 9px; }
  .opts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; }
  @media (max-width: 560px) { .opts { grid-template-columns: 1fr 1fr; } }
  .opt { border: 1px solid var(--line); padding: 11px 12px; font-size: var(--fs-s0); cursor: pointer;
         display: flex; align-items: center; gap: 9px; min-width: 0; }
  .opt input { accent-color: var(--ink); flex: none; }
  .opt:has(input:checked) { border-color: var(--ink); background: var(--paper-2); font-weight: 600; }
  .opt:has(input:focus-visible) { outline: 2px solid var(--brand); outline-offset: 2px; }

  .fl { display: block; font-size: var(--fs-s-1); letter-spacing: .14em; text-transform: uppercase;
        color: var(--faint); font-weight: 600; margin: 0 0 5px; }
  .opt-t { letter-spacing: 0; text-transform: none; font-weight: 400; }
  /* 16px: κάτω από αυτό το iPhone κάνει ζουμ στο πεδίο και ΔΕΝ ξαναμικραίνει. */
  .fi { width: 100%; font: inherit; font-size: var(--fs-s0); padding: 11px 12px; margin-bottom: 16px;
        border: 1px solid var(--line); background: var(--paper); color: var(--ink); }
  .fi:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
  .ta { resize: vertical; min-height: 96px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .two > div { min-width: 0; }

  /* the bar: three cells as the list's «More filters» (63px, hairlines, beige and bold once something is in) */
  .bar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); height: 63px; margin-top: 4px; border: 1px solid var(--line); }
  .cell { position: relative; display: flex; align-items: center; justify-content: center; gap: 8px; min-width: 0; padding: 0 8px;
    border: 0; border-inline-start: 1px solid var(--line); background: none; font: inherit; font-size: var(--fs-s-1); color: var(--muted);
    white-space: nowrap; cursor: pointer; transition: color .15s ease, background .15s ease; }
  .cell:first-child { border-inline-start: 0; }
  .cell__ic { flex: none; color: var(--faint); transition: color .15s ease; }
  .cell:hover, .cell:hover .cell__ic { color: var(--ink); }
  .cell:hover { background: var(--paper-2); }
  .cell--on { background: var(--paper-2); color: var(--ink); font-weight: 600; }
  .cell--on .cell__ic { color: var(--ink); }
  .cell__n { font-size: var(--fs-s-1); font-weight: 400; color: var(--muted); }
  .cell:focus-visible, .cell:has(input:focus-visible) { outline: 2px solid var(--brand); outline-offset: -2px; }

  .sum { margin: 10px 0 0; font-size: var(--fs-s-1); color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sum__b { all: unset; cursor: pointer; margin-inline-start: 8px; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .sum__b:hover { color: var(--ink); }
  .soon { margin: 6px 0 0; font-size: var(--fs-s-1); color: var(--faint); }
  .go { margin-top: 18px; }

  /* the Details window */
  .dlg { width: 640px; max-width: calc(100vw - 32px); padding: 28px; border: 0; background: var(--paper); color: var(--ink); }
  .dlg::backdrop { background: rgba(14,18,20,.5); }
  .dlg__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 18px; }
  .dlg__h { margin: 0 0 4px; font-size: var(--fs-s1); font-weight: 600; }
  .dlg__s { margin: 0; font-size: var(--fs-s-1); color: var(--muted); }
  .dlg__x { background: none; border: 0; padding: 4px; cursor: pointer; display: flex; color: var(--ink); }
  .dlg__g { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; }
  .dlg__g > div { min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; }
  .dlg__w { grid-column: 1 / -1; }
  .dlg .fi { margin-bottom: 12px; }
  .dlg .ta { min-height: 72px; }
  @media (max-width: 560px) { .dlg__g { grid-template-columns: 1fr; } .bar { height: auto; grid-template-columns: 1fr; } .cell { height: 52px; border-inline-start: 0; border-top: 1px solid var(--line); } .cell:first-child { border-top: 0; } }

  .err { color: var(--err); font-size: var(--fs-s-1); margin: 0 0 14px; }
  .go { width: 100%; justify-content: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .fine { font-size: var(--fs-s-1); color: var(--faint); margin: 14px 0 0; }

  .ask { border: 1px solid var(--line); padding: 20px; }
  .ask__h { margin: 0 0 6px; font-size: var(--fs-s0); font-weight: 600; }
  .ask__s { margin: 0 0 15px; font-size: var(--fs-s-1); color: var(--muted); }

  .done { border: 1px solid var(--line); padding: 24px 22px; }
  .done__h { margin: 0 0 8px; font-size: var(--fs-s1); font-weight: 300; }
  .done__s { margin: 0 0 16px; font-size: var(--fs-s0); color: var(--muted); }
</style>
